[org.kde.kdecoration2]
# GOBLINCAKES window frames (Aurorae theme in /usr/share/aurorae/themes/goblincakes)
library=org.kde.kwin.aurorae
theme=__aurorae__svg__goblincakes
# Keep minimise, maximise and close on the right
ButtonsOnLeft=
ButtonsOnRight=IAX

[Plugins]
# Windows turn see-through while you drag or resize them
translucencyEnabled=true
# No big mouse pointer when the mouse is moved fast back and forth ("shake cursor")
# – it gets in the way in games. Back on: System Settings → Desktop Effects → Shake Cursor
shakecursorEnabled=false
# GOBLINCAKES Config opens in the middle of the main screen (/usr/share/kwin/scripts/goblincakes-windows)
goblincakes-windowsEnabled=true

[Effect-translucency]
MoveResize=75
