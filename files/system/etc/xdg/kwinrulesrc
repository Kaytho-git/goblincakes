# GOBLINCAKES window rules (KWin). Your own rules (System Settings → Window Rules) are saved in
# ~/.config/kwinrulesrc and replace this list.

[General]
count=1
rules=goblincakes-config-centered

# GOBLINCAKES Config always opens in the middle of the screen – at login it could land down by the
# dock while the panels and screens were still being set up (10 Oct).
[goblincakes-config-centered]
Description=GOBLINCAKES Config i mitten av skärmen
wmclass=goblincakes-config
wmclassmatch=1
types=1
placement=5
placementrule=2
