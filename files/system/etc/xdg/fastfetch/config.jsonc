// GOBLINCAKES default for fastfetch. Your own ~/.config/fastfetch/config.jsonc wins.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/goblincakes/fastfetch-logo.txt",
        "color": {
            "1": "38;2;230;236;245",   // Frost: goblin head
            "2": "38;2;47;111;237"     // Accent: cupcake
        },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;47;111;237",
            "title": "38;2;230;236;245"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        // Without read-only file systems: / on an atomic system is a tiny read-only layer
        // that always shows "100 %" in red (and a mounted ISO/DVD is read-only too).
        // The system disk is "System" (its label is whatever the installer gave it, e.g. "g4");
        // other disks by their label, not the long mount path (/run/media/<user>/<label>),
        // without a label the mount path. On an atomic system it shows up as /etc and /var.
        { "type": "disk", "folders": "/etc", "key": "Disk (System)" },
        { "type": "disk", "showReadOnly": false, "hideFolders": "/:/etc:/var:/sysroot:/usr:/efi:/boot:/boot/efi:/boot/firmware",
          "key": "Disk ({?name}{name}{?}{/name}{mountpoint}{/})" },
        "break",
        "colors"
    ]
}
