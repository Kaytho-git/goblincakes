[Unit]
Description=GOBLINCAKES: look for updates (the green arrow in the top bar)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/goblincakes-updates check
# Then the Fedora version notice, which reads this check's answer (P7.1)
ExecStartPost=-/usr/bin/systemctl --user start --no-block goblincakes-fedora-check.service
Nice=10
