[Unit]
Description=GOBLINCAKES Spelläge (GameMode, updates wait, Akonadi/Baloo/WoWUp rest while a game runs)
ConditionKernelCommandLine=!rd.live.image
# Runs also with Spelläge off (Config → Inställningar → Spel, the flag gameguard-off): then it only
# looks for games for the local AI and Kakan (gaming.GAME_FILE, P5 step 2)

[Service]
ExecStart=/usr/libexec/goblincakes-gameguard run
Restart=on-failure
RestartSec=10
# On stop it starts what it paused again (Akonadi, Baloo, WoWUp)
TimeoutStopSec=30

[Install]
WantedBy=default.target
