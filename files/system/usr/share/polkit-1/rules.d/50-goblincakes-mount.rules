// GOBLINCAKES: the person at the computer (administrator group wheel) may mount
// internal disks and partitions without a password, so all disks show up at login
// (/usr/libexec/goblincakes-automount) and in Dolphin. Encrypted disks still ask.
// They also become the owner of their own Linux-formatted disks without a password
// (/usr/libexec/goblincakes-disk-owner – otherwise only root could write there).
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.udisks2.filesystem-mount-system" ||
         action.id == "org.freedesktop.udisks2.filesystem-mount" ||
         action.id == "org.freedesktop.udisks2.filesystem-mount-other-seat" ||
         action.id == "org.goblincakes.disk-owner") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
