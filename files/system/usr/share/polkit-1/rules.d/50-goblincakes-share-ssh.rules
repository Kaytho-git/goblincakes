// GOBLINCAKES GoblinShare → Be om hjälp (22 Nov): the SSH server runs only during a help. GoblinShare (a user
// service, outside the login session – polkit can't ask there) starts and stops it through
// goblincakes-share-sshd.service, which only starts sshd when GoblinShare's keys-only settings are in place.
// Only that unit, only start/stop/restart, only administrators (wheel).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "goblincakes-share-sshd.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
