<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GOBLINCAKES</vendor>
  <action id="org.goblincakes.sddm-screens">
    <description>Give the login screen the same screen setup as the desktop</description>
    <message>GOBLINCAKES ger inloggningsskärmen samma skärminställningar som skrivbordet</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/goblincakes-sddm-screens</annotate>
  </action>
</policyconfig>
