// GOBLINCAKES boot screen (Plymouth), after the design's Boot artboard:
// black, logo, "GOBLINCAKES" in Chakra Petch, thin blue progress line.
// Measurements are the design's at 1920x1080; images are drawn at 2x.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Everything is placed by layout(), and placed again when the screen changes size: Plymouth
// starts on the firmware's simple framebuffer, then the graphics driver takes over with
// another resolution – placed only once, the logo ended up off to the left and smaller (10 Oct).
logoImg = Image("logo.png");
titleImg = Image("title.png");
trackImg = Image("bar-bg.png");
fillImg = Image("bar-fg.png");
borderImg = Image("box-border.png");
boxImg = Image("box.png");
lockImg = Image("lock.png");
bulletSrc = Image("bullet.png");

logo = Sprite();
title = Sprite();
track = Sprite();
fill = Sprite();
pwFrame = Sprite();
pwInner = Sprite();
pwLock = Sprite();
progressNow = 0;
laidW = 0;
laidH = 0;

fun layout() {
    global.W = Window.GetWidth();
    global.H = Window.GetHeight();
    global.laidW = global.W;
    global.laidH = global.H;
    global.s = global.H / 1080;                       // scale to the screen
    s = global.s;

    // Column: logo 180, gap 36, title 52, gap 60, line 3  -> 331 high, centred
    top = Math.Int((global.H - 331 * s) / 2);

    img = logoImg.Scale(Math.Int(180 * s), Math.Int(180 * s));
    logo.SetImage(img);
    logo.SetPosition(Math.Int((global.W - img.GetWidth()) / 2), top, 1);
    img = titleImg.Scale(Math.Int(400 * s), Math.Int(52 * s));
    title.SetImage(img);
    title.SetPosition(Math.Int((global.W - img.GetWidth()) / 2), top + Math.Int(216 * s), 1);

    // Progress line: 280 x 3, Deep track with Accent fill
    global.barW = Math.Int(280 * s);
    global.barH = Math.Max(2, Math.Int(3 * s));
    global.barX = Math.Int((global.W - global.barW) / 2);
    global.barY = top + Math.Int(328 * s);
    track.SetImage(trackImg.Scale(global.barW, global.barH));
    track.SetPosition(global.barX, global.barY, 1);
    fill.SetPosition(global.barX, global.barY, 2);
    draw_progress();

    // Disk password (encrypted drives): square box with a padlock and bullets
    global.boxW = Math.Int(360 * s);
    global.boxH = Math.Int(48 * s);
    global.boxX = Math.Int((global.W - global.boxW) / 2);
    global.boxY = global.barY - Math.Int(12 * s);
    pwFrame.SetImage(borderImg.Scale(global.boxW, global.boxH));
    pwFrame.SetPosition(global.boxX, global.boxY, 10);
    pwInner.SetImage(boxImg.Scale(global.boxW - 2, global.boxH - 2));
    pwInner.SetPosition(global.boxX + 1, global.boxY + 1, 11);
    pwLock.SetImage(lockImg.Scale(Math.Int(24 * s), Math.Int(24 * s)));
    pwLock.SetPosition(global.boxX + Math.Int(14 * s), global.boxY + Math.Int(12 * s), 12);
    global.bulletImg = bulletSrc.Scale(Math.Int(8 * s), Math.Int(8 * s));
    for (i = 0; global.bullets[i]; i++) {
        global.bullets[i].SetImage(global.bulletImg);
        global.bullets[i].SetPosition(global.boxX + Math.Int((50 + 14 * i) * s), global.boxY + Math.Int(20 * s), 13);
    }
}

fun draw_progress() {
    w = Math.Int(global.barW * global.progressNow);
    if (w < 1) w = 1;
    fill.SetImage(fillImg.Scale(w, global.barH));
}

fun progress_callback(duration, progress) {
    global.progressNow = progress;
    draw_progress();
}
Plymouth.SetBootProgressFunction(progress_callback);

// Called for every frame: lay out again when the screen size changed
fun refresh_callback() {
    if (Window.GetWidth() != global.laidW || Window.GetHeight() != global.laidH) layout();
}
Plymouth.SetRefreshFunction(refresh_callback);

layout();

fun show_password(visible) {
    o = 0;
    if (visible) o = 1;
    pwFrame.SetOpacity(o);
    pwInner.SetOpacity(o);
    pwLock.SetOpacity(o);
    track.SetOpacity(1 - o);
    fill.SetOpacity(1 - o);
    if (!visible) {
        for (i = 0; global.bullets[i]; i++) global.bullets[i].SetOpacity(0);
    }
}
show_password(0);

fun password_callback(prompt, count) {
    show_password(1);
    maxBullets = Math.Int((global.boxW - 60 * global.s) / (14 * global.s));
    for (i = 0; i < maxBullets; i++) {
        if (!global.bullets[i]) {
            global.bullets[i] = Sprite(global.bulletImg);
            global.bullets[i].SetPosition(global.boxX + Math.Int((50 + 14 * i) * global.s), global.boxY + Math.Int(20 * global.s), 13);
        }
        if (i < count) global.bullets[i].SetOpacity(1);
        else global.bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    show_password(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun quit_callback() {
    global.progressNow = 1;
    draw_progress();
}
Plymouth.SetQuitFunction(quit_callback);
