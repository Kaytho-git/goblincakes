# GOBLINCAKES Plasma theme settings.
# Panels and popups are solid, so there is nothing to see through: no blur and no
# contrast effect behind them. With these on, KWin smears a soft dark edge around
# the dock and the top bar instead of a sharp frame line.
[BlurBehindEffect]
enabled=false

[ContrastEffect]
enabled=false

# Must stay on: without it Plasma reports every panel as "translucent" whatever
# its setting, so the top bar never draws solid/ (white bottom line).
[AdaptiveTransparency]
enabled=true
