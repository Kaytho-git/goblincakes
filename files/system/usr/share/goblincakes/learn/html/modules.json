     "level": 1,
     "title": "En sida om dig",
     "prompt": "Gör en sida med en rubrik (h1) med ditt namn och ett stycke (p) om vad du gillar.",
     "starter": "<!doctype html>\n<html lang=\"sv\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Min sida</title>\n</head>\n<body>\n\n</body>\n</html>\n",
     "check": {
      "has": [
       "<h1",
       "</h1>",
       "<p",
       "</p>"
      ]
     },
     "hints": [
      "En rubrik skrivs <h1>Text</h1>.",
      "Lägg <h1>…</h1> och <p>…</p> mellan <body> och </body>."
     ],
     "solution": "<!doctype html>\n<html lang=\"sv\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Min sida</title>\n</head>\n<body>\n  <h1>Kaytho</h1>\n  <p>Jag gillar bågskytte och WoW.</p>\n</body>\n</html>\n"
    }
   ]
  }
 ]
