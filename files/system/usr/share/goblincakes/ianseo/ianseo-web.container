[Unit]
Description=Ianseo web server
Requires=ianseo-db.service
After=ianseo-db.service

[Container]
ContainerName=ianseo-web
Image=localhost/goblincakes-ianseo:latest
Pod=ianseo.pod
# Ianseo's files, where its install guide puts them
Volume=%h/.local/share/goblincakes/ianseo/www:/opt/ianseo:Z
# The database's socket, so Ianseo can use "localhost"
Volume=ianseo-socket:/run/mysqld

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
