[Desktop Entry]
Type=Application
Name=GoblinAmp
GenericName=Musikspelare
Comment=Liten spelare i Winamps anda – spelar dina musikfiler och spellistor, eller styr Spotify; tid, titel, staplar, play/paus/nästa och volym
Exec=goblin-amp %F
Icon=goblincakes-amp
Categories=AudioVideo;Audio;Player;
Keywords=winamp;spotify;musik;music;spelare;player;mp3;flac;spellista;playlist;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;audio/x-mpegurl;audio/x-scpls;
StartupWMClass=goblin-amp
