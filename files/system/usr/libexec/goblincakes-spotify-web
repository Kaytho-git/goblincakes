#!/usr/bin/env bash
# GOBLINCAKES: Spotify as a web app with GOBLINCAKES' look (21 Oct, the user's wish – Spotify's
# own app felt big and cluttered). The web player in Google Chrome is the window: playlists,
# search, the player bar (the extension "GOBLINCAKES för Spotify", spotify-tillagg/, installed
# through Chrome's policy, hides the rest and takes the colours). The sound comes from Spotify's
# own app, started hidden in the system tray (Spotify Connect – choose this computer once under
# "Anslut till en enhet" in the web app); the app plays in its own quality, Lossless included,
# where the web player itself has at most AAC 256 kbit/s.
#
#   goblincakes-spotify-web           opens the web app (and the hidden Spotify app); the menu
#                                     entry adds --app=… (ignored) to look like a web app
#   goblincakes-spotify-web url       the address it would open (the colours in its #goblincakes=)
#   goblincakes-spotify-web app       only the Spotify app, hidden (GoblinAmp's playlist plays on it)
#
# The colours: the user's accent (GOBLINCAKES Config → Inställningar → Utseende → Färg), read at
# every start – a new colour shows the next time the web app opens.
set -uo pipefail

SPOTIFY_APP=com.spotify.Client
CHROME=com.google.Chrome
START=https://open.spotify.com/

colours() { # color.hover.on.text.dim, hex without # (goblin.js reads them)
    /usr/libexec/goblincakes-accent palette 2>/dev/null | python3 -c '
import json, sys
try:
    p = json.load(sys.stdin)
    print(".".join(p[k].lstrip("#") for k in ("color", "hover", "on", "text", "dim")))
except Exception:
    print("2F6FED.4A82F0.E6ECF5.2F6FED.1B3A78")
'
}

url() {
    printf '%s#goblincakes=%s\n' "$START" "$(colours)"
}

has_flatpak() {
    flatpak info "$1" >/dev/null 2>&1
}

spotify_running() {
    # The Flatpak's app (its main process is called spotify) or a Spotify from elsewhere
    pgrep -x spotify >/dev/null 2>&1 || flatpak ps --columns=application 2>/dev/null | grep -qx "$SPOTIFY_APP"
}

kwin_reconfigure() {
    busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1 || true
}

start_spotify_hidden() {
    has_flatpak "$SPOTIFY_APP" || return 0
    spotify_running && return 0
    # The KWin script goblincakes-windows hides the window that opens now (minimized, not in the
    # dock or Alt+Tab – the tray icon brings it back); the mark is taken away again afterwards
    kwriteconfig6 --file kwinrc --group Script-goblincakes-windows --key spotifyHide true
    kwin_reconfigure
    setsid flatpak run "$SPOTIFY_APP" >/dev/null 2>&1 < /dev/null &
    (
        sleep 40
        kwriteconfig6 --file kwinrc --group Script-goblincakes-windows --key spotifyHide false
        kwin_reconfigure
    ) >/dev/null 2>&1 < /dev/null &
    disown -a
}

case ${1:-open} in
    --app=*) set -- open ;;  # the menu entry's (looks like the other web apps for Config)
esac
case ${1:-open} in
    url)
        url
        ;;
    app)
        # Only the Spotify app, hidden (GoblinAmp's playlist plays on it)
        start_spotify_hidden
        ;;
    open)
        start_spotify_hidden
        if has_flatpak "$CHROME"; then
            exec flatpak run "$CHROME" --app="$(url)"
        fi
        # No Google Chrome: Spotify's web player needs its DRM (Widevine), which Flathub's
        # Chromium lacks – the app itself then
        notify-send -a "GOBLINCAKES" -i com.spotify.Client "Spotify (GOBLINCAKES)" \
            "Webbappen behöver Google Chrome – installera den i GOBLINCAKES Config → Program → Webbläsare." 2>/dev/null
        has_flatpak "$SPOTIFY_APP" && exec flatpak run "$SPOTIFY_APP"
        exit 1
        ;;
    *)
        echo "Användning: goblincakes-spotify-web [open|url|app]" >&2
        exit 2
        ;;
esac
