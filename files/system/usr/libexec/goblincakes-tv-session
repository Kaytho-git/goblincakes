#!/usr/bin/env bash
# GOBLINCAKES TV mode: the whole screen is gamescope running Steam's Big Picture (gamepad UI),
# like a Steam Deck. Started by SDDM as the session "goblincakes-tv" (see goblincakes-tv).
# Steam's own "Switch to Desktop" (power menu) and every other way Steam ends lead back
# to the Plasma desktop – never a loop back into TV mode.
set -uo pipefail

back_to_desktop() {
    pkexec /usr/libexec/goblincakes-session-select desktop || true
}
trap back_to_desktop EXIT

# Steam on SteamOS asks steamos-session-select for "Switch to Desktop" and steamos-update
# for updates; GOBLINCAKES' own versions come first in PATH (only in this session).
export PATH="/usr/libexec/goblincakes-tv:$PATH"

# Laptops with two graphics cards: same choice as the Optimering switch
flags="${XDG_CONFIG_HOME:-$HOME/.config}/goblincakes"
[ -e "$flags/steam-dgpu" ] && while read -r var; do export "$var"; done < "$flags/steam-dgpu"

gamescope -e -f --xwayland-count 2 -- steam -gamepadui -steamos3
