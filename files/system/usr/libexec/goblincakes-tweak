#!/usr/bin/env bash
# Gaming optimisations for the GOBLINCAKES Config window (Optimering tab).
#
#   goblincakes-tweak status <id>        prints on, off or unavailable
#   goblincakes-tweak set <id> on|off    changes it (system ones run as root via pkexec)
#
# System settings go in /etc (writable on the atomic system) and survive updates;
# switching off removes our file again, so the system default is back.
set -euo pipefail

sysctl_file() { echo "/etc/sysctl.d/90-goblincakes-$1.conf"; }

sysctl_status() { # id key wanted
    local now
    now=$(cat "/proc/sys/${2//.//}" 2>/dev/null) || { echo unavailable; return; }
    [ "$now" = "$3" ] && echo on || echo off
}

sysctl_set() { # id key value on|off
    if [ "$4" = on ]; then
        echo "$2 = $3" > "$(sysctl_file "$1")"
        sysctl -q -w "$2=$3"
    else
        rm -f "$(sysctl_file "$1")"
        sysctl -q --system >/dev/null
    fi
}

shader_env="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/90-goblincakes-shadercache.conf"

hw() { /usr/libexec/goblincakes-gpu hw 2>/dev/null; }
json_get() { python3 -c 'import json,sys; v=json.load(sys.stdin).get(sys.argv[1]); print("" if v is None else str(v).lower())' "$1"; }

# Game launchers from Flathub (Steam itself is in the image, see steam_desktop)
GAME_APPS=(net.lutris.Lutris com.heroicgameslauncher.hgl)
NV_PRIME=(__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only)
MESA_PRIME=(DRI_PRIME=1)

# Steam is in the image: its settings go in a user copy of its menu entry
# (~/.local/share/applications/steam.desktop, which wins over /usr/share), with the
# environment for the switches that are on. Flags: ~/.config/goblincakes/steam-<switch>.
flags="${XDG_CONFIG_HOME:-$HOME/.config}/goblincakes"
steam_flag() { [ -e "$flags/steam-$1" ]; }
steam_set_flag() { # name on|off [environment…]
    local name=$1 state=$2; shift 2
    mkdir -p "$flags"
    if [ "$state" = on ]; then printf '%s\n' "$@" > "$flags/steam-$name"; else rm -f "$flags/steam-$name"; fi
    steam_desktop
}
steam_desktop() {
    local src=/usr/share/applications/steam.desktop dst="${XDG_DATA_HOME:-$HOME/.local/share}/applications/steam.desktop" env=()
    for f in "$flags"/steam-*; do [ -e "$f" ] && mapfile -t -O "${#env[@]}" env < "$f"; done
    if [ ${#env[@]} -eq 0 ] || [ ! -e "$src" ]; then
        # Nothing switched on: Steam's own entry as it is
        grep -q '^X-GOBLINCAKES' "$dst" 2>/dev/null && rm -f "$dst"
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    # Our env decides the graphics card, so drop Steam's own "prefer the other card" keys
    sed -e "s|^Exec=|Exec=env ${env[*]} |" -e '/^PrefersNonDefaultGPU=/d' -e '/^X-KDE-RunOnDiscreteGpu=/d' \
        -e 's|^\[Desktop Entry\]$|[Desktop Entry]\nX-GOBLINCAKES-Steam=generated by goblincakes-tweak|' "$src" > "$dst"
    update-desktop-database "$(dirname "$dst")" >/dev/null 2>&1 || true
}

cmd=${1:?command}; id=${2:?id}; value=${3:-}

case $id in
    max-map-count)
        # Some big or modded games (and Proton) need many memory maps
        case $cmd in
            status) now=$(cat /proc/sys/vm/max_map_count)
                    [ "$now" -ge 2147483642 ] && echo on || echo off ;;
            set) sysctl_set "$id" vm.max_map_count 2147483642 "$value" ;;
        esac ;;

    split-lock)
        # The kernel slows down programs that use "split locks" – some Windows games do
        case $cmd in
            status) sysctl_status "$id" kernel.split_lock_mitigate 0 ;;
            set) sysctl_set "$id" kernel.split_lock_mitigate 0 "$value" ;;
        esac ;;

    performance)
        # Power profile (the same as the battery/power menu in the top bar)
        command -v powerprofilesctl >/dev/null || { [ "$cmd" = status ] && echo unavailable; exit 0; }
        case $cmd in
            status) [ "$(powerprofilesctl get 2>/dev/null)" = performance ] && echo on || echo off ;;
            set) powerprofilesctl set "$([ "$value" = on ] && echo performance || echo balanced)" ;;
        esac ;;

    scx-lavd)
        # sched_ext scheduler from the CachyOS project, tuned for games and the desktop
        if ! command -v scx_lavd >/dev/null || ! systemctl cat scx.service >/dev/null 2>&1; then
            [ "$cmd" = status ] && echo unavailable
            exit 0
        fi
        case $cmd in
            status) systemctl is-active --quiet scx.service && echo on || echo off ;;
            set)
                if [ "$value" = on ]; then
                    mkdir -p /etc/default
                    printf 'SCX_SCHEDULER=scx_lavd\nSCX_FLAGS=\n' > /etc/default/scx
                    # irqbalance fights with sched_ext and causes stutter
                    systemctl disable --now irqbalance.service 2>/dev/null || true
                    systemctl enable --now scx.service
                else
                    systemctl disable --now scx.service
                    systemctl enable --now irqbalance.service 2>/dev/null || true
                fi ;;
        esac ;;

    dgpu-games)
        # Laptops with two graphics cards: the desktop stays on the frugal built-in card,
        # games from Steam, Lutris and Heroic start on the powerful one (PRIME render offload).
        info=$(hw)
        if [ "$(echo "$info" | json_get hybrid)" != true ]; then
            [ "$cmd" = status ] && echo unavailable
            exit 0
        fi
        case $cmd in
            status) steam_flag dgpu && echo on || echo off ;;
            set)
                # Nvidia's own offload needs Nvidia's drivers; otherwise Mesa's DRI_PRIME picks the other card
                if [ "$(echo "$info" | json_get dgpu)" = nvidia ] && [ "$(cat /usr/share/goblincakes/variant 2>/dev/null)" = nvidia ]; then
                    env=("${NV_PRIME[@]}")
                else
                    env=("${MESA_PRIME[@]}")
                fi
                steam_set_flag dgpu "$value" "${env[@]}"
                for app in "${GAME_APPS[@]}"; do
                    flatpak info "$app" >/dev/null 2>&1 || continue
                    # Clear both kinds first, so switching variant later can't leave a mix
                    for var in "${NV_PRIME[@]}" "${MESA_PRIME[@]}"; do
                        flatpak override --user --unset-env="${var%%=*}" "$app"
                    done
                    if [ "$value" = on ]; then
                        for var in "${env[@]}"; do flatpak override --user --env="$var" "$app"; done
                    fi
                done ;;
        esac ;;

    mangohud)
        # FPS, temperatures and load on top of games from Steam (in the image), Lutris and Heroic.
        # Settings: GOverlay (or ~/.config/MangoHud/MangoHud.conf); Shift_R+F12 hides it in a game.
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf"
        apps=()
        for app in "${GAME_APPS[@]}"; do flatpak info "$app" >/dev/null 2>&1 && apps+=("$app"); done
        case $cmd in
            status) steam_flag mangohud && echo on || echo off ;;
            set)
                # GOBLINCAKES colours, unless the user already has their own settings
                [ "$value" = on ] && { [ -e "$conf" ] || install -Dm644 /usr/share/goblincakes/mangohud/MangoHud.conf "$conf"; }
                steam_set_flag mangohud "$value" MANGOHUD=1
                # Flatpak launchers need MangoHud as a Flatpak extension too
                [ "$value" = on ] && [ ${#apps[@]} -gt 0 ] && /usr/libexec/goblincakes-config-install vulkan-layer MangoHud >/dev/null
                for app in "${apps[@]}"; do
                    if [ "$value" = on ]; then
                        flatpak override --user --env=MANGOHUD=1 --env=MANGOHUD_CONFIGFILE="$conf" \
                            --filesystem=xdg-config/MangoHud:ro "$app"
                    else
                        flatpak override --user --unset-env=MANGOHUD --unset-env=MANGOHUD_CONFIGFILE "$app"
                    fi
                done ;;
        esac ;;

    low-latency-audio)
        # PipeWire with smaller buffers: ~5 ms instead of ~21 ms between game/voice and the speakers
        audio_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
        audio_conf="$audio_dir/pipewire/pipewire.conf.d/90-goblincakes-lowlatency.conf"
        pulse_conf="$audio_dir/pipewire/pipewire-pulse.conf.d/90-goblincakes-lowlatency.conf"
        case $cmd in
            status) [ -e "$audio_conf" ] && echo on || echo off ;;
            set)
                if [ "$value" = on ]; then
                    install -Dm644 /usr/share/goblincakes/pipewire/90-goblincakes-lowlatency.conf "$audio_conf"
                    # Games through Wine/Proton and Discord are PulseAudio clients
                    install -Dm644 /usr/share/goblincakes/pipewire/90-goblincakes-lowlatency-pulse.conf "$pulse_conf"
                else
                    rm -f "$audio_conf" "$pulse_conf"
                fi
                systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service ;;
        esac ;;

    shader-cache)
        # Nvidia: keep up to 12 GB of compiled shaders instead of 1 GB (less stutter)
        if [ "$(hw | json_get hasNvidia)" != true ]; then
            [ "$cmd" = status ] && echo unavailable
            exit 0
        fi
        case $cmd in
            status) [ -e "$shader_env" ] && echo on || echo off ;;
            set)
                if [ "$value" = on ]; then
                    mkdir -p "$(dirname "$shader_env")"
                    printf '__GL_SHADER_DISK_CACHE_SIZE=12000000000\n__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1\n' > "$shader_env"
                else
                    rm -f "$shader_env"
                fi ;;
        esac ;;

    *) echo "Unknown optimisation: $id" >&2; exit 2 ;;
esac
