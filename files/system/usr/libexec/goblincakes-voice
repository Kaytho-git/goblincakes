#!/usr/bin/python3
"""GOBLINCAKES: Kakan's voice – speech to text and text to speech on the processor (Kakan step 9, 4 Nov).

    goblincakes-voice status                  JSON: installed, place, models, settings
    goblincakes-voice install                 Python environment (faster-whisper + Piper) and the models
                                              into ~/.local/share/goblincakes-voice (~1 GB)
    goblincakes-voice uninstall               everything above
    goblincakes-voice record <wav> [seconds]  the microphone, 16 kHz mono (without seconds: until Ctrl+C/SIGTERM)
    goblincakes-voice hear <wav>              speech → text: JSON {text, load, seconds}
    goblincakes-voice test [seconds]          record (default 5 s), then hear – prints the text and the times
    goblincakes-voice say <text> [--voice kvinna|man] [--out <wav>]
                                              text → speech, played (or saved with --out)
    goblincakes-voice listen                  the service: hold the voice key (F8 – the G502's button 4)
                                              and talk; released → text (step B: shown as a notification)
    goblincakes-voice worker                  (used by listen) the loaded model: a wav path per line in,
                                              JSON {text, seconds} per line out

Nothing goes into the image: the environment and the models live in the home folder and are
fetched when the user turns Röst on. Speech to text = KBLab's Swedish Whisper (kb-whisper-small,
CTranslate2) via faster-whisper, int8 on 4 threads so a game keeps the rest of the processor.
Text to speech = Piper: lisa (Kakan, a woman – a little slower, a little husky via an ffmpeg
filter) and nst (for a male avatar, a little faster). The user chose both by ear 4 Nov.
Settings: ~/.config/goblincakes/voice.json {"voices": {"kvinna": {…}, "man": {…}}}.
Lines starting with "@@ " (and "@@progress {…}") are for the window, as in goblincakes-ollama.

The key: a KDE global shortcut (kglobalaccel, component "goblincakes-voice", changeable in
System Settings → Shortcuts) – kglobalaccel sends both pressed and released, so it works over
games too. Not F20–F23: xkb makes them microphone mute / touchpad keys (F20 held = the mic
toggled on and off, 4 Nov). While the key is held only the microphone TOWARDS Discord is muted
(its PipeWire source-output); what the others say is heard as usual. The ids we muted are kept
in a file so a crash can't leave Discord muted: listen unmutes them when it starts.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import wave
from pathlib import Path

HOME = Path.home()
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "goblincakes/voice.json"
DIR = Path(os.environ.get("GOBLINCAKES_VOICE_DIR")
           or Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "goblincakes-voice")
VENV = DIR / "venv"
PY = VENV / "bin/python3"
MODELS = DIR / "models"
HF = "https://huggingface.co"
# Tested together 4 Nov; newer ones only after a test.
PACKAGES = ["faster-whisper==1.2.1", "piper-tts==1.8.0"]

WHISPER = "kb-whisper-small"
WHISPER_REPO = "KBLab/kb-whisper-small"
WHISPER_FILES = ["model.bin", "config.json", "tokenizer.json", "vocabulary.json", "preprocessor_config.json"]
WHISPER_THREADS = 4
# Words Whisper otherwise hears as Swedish ("Warcraft Logs" → "varmkraft lågs"): given as the
# text "before" the speech, so it leans towards these spellings.
VOCABULARY = ("Kakan, Goblin AI, GOBLINCAKES, Warcraft Logs, WoW, World of Warcraft, CS2, Counter-Strike, "
              "Discord, Spotify, Steam, pull, pullen, senaste pullen, raid, Mythic plus, wipe, parse, lagg, GoblinAmp, GoblinRecorder.")

PIPER_VOICES = {"lisa": "sv/sv_SE/lisa/medium/sv_SE-lisa-medium",
                "nst": "sv/sv_SE/nst/medium/sv_SE-nst-medium"}
HUSKY = ("asetrate=22050*0.94,aresample=22050,lowpass=f=6500,"
         "acrusher=bits=12:mix=0.12,aecho=0.8:0.5:12:0.08")
DEFAULT_VOICES = {
    "kvinna": {"model": "lisa", "length": 1.10, "pause": 0.3, "husky": True},
    "man": {"model": "nst", "length": 0.85, "pause": 0.3, "husky": False},
}


def say(text):
    print(f"@@ {text}", flush=True)


def progress(**fields):
    print("@@progress " + json.dumps(fields), flush=True)


# ── Settings ──────────────────────────────────────────────────────

def load():
    try:
        data = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    voices = data.get("voices") if isinstance(data.get("voices"), dict) else {}
    data["voices"] = {k: {**v, **(voices.get(k) or {})} for k, v in DEFAULT_VOICES.items()}
    return data


def whisper_dir():
    return MODELS / WHISPER


def piper_file(name):
    return MODELS / "piper" / (PIPER_VOICES[name].rsplit("/", 1)[1] + ".onnx")


def installed():
    return (PY.is_file() and all((whisper_dir() / f).is_file() for f in WHISPER_FILES)
            and all(piper_file(n).is_file() and piper_file(n).with_suffix(".onnx.json").is_file()
                    for n in PIPER_VOICES))


def in_venv():
    """Re-run this command with the environment's Python (faster-whisper and Piper live there)."""
    if Path(sys.prefix).resolve() == VENV.resolve():
        return
    if not installed():
        print("Rösten är inte installerad (goblincakes-voice install).", file=sys.stderr)
        sys.exit(1)
    os.execv(str(PY), [str(PY), "-s", os.path.abspath(__file__), *sys.argv[1:]])


def tree_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


# ── Commands ──────────────────────────────────────────────────────

def cmd_status():
    data = load()
    print(json.dumps({
        "installed": installed(),
        "dir": str(DIR),
        "size": tree_size(DIR) if DIR.exists() else 0,
        "whisper": WHISPER,
        "voices": data["voices"],
    }, ensure_ascii=False))
    return 0


def fetch(url, dest, what):
    """One file, with progress; atomically into place."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": "goblincakes"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            done, last = 0, 0.0
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if total > 5 << 20 and time.time() - last > 0.5:
                    last = time.time()
                    progress(what=what, completed=done, total=total)
    except (OSError, urllib.error.URLError) as e:
        tmp.unlink(missing_ok=True)
        raise RuntimeError(f"Kunde inte hämta {dest.name} ({getattr(e, 'reason', e)})") from None
    tmp.replace(dest)


def cmd_install():
    try:
        if not PY.is_file():
            say("Skapar Python-miljön…")
            DIR.mkdir(parents=True, exist_ok=True)
            r = subprocess.run([sys.executable, "-m", "venv", str(VENV)], capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError("Kunde inte skapa Python-miljön: " + r.stderr.strip()[-300:])
        say("Installerar tal till text och uppläsning (faster-whisper, Piper)…")
        r = subprocess.run([str(PY), "-m", "pip", "install", "-q", "--disable-pip-version-check", *PACKAGES],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("pip misslyckades: " + (r.stderr.strip().splitlines() or ["okänt fel"])[-1])
        say("Hämtar den svenska taligenkänningen (KBLab)…")
        for f in WHISPER_FILES:
            if not (whisper_dir() / f).is_file():
                fetch(f"{HF}/{WHISPER_REPO}/resolve/main/{f}", whisper_dir() / f, WHISPER)
        say("Hämtar rösterna…")
        for name, path in PIPER_VOICES.items():
            for ext in (".onnx", ".onnx.json"):
                dest = piper_file(name).with_suffix(ext)
                if not dest.is_file():
                    fetch(f"{HF}/rhasspy/piper-voices/resolve/main/{path}{ext}", dest, name)
    except RuntimeError as e:
        say(str(e))
        return 1
    subprocess.run(["systemctl", "--user", "restart", "goblincakes-voice.service"], capture_output=True)
    say("Rösten är installerad.")
    return 0


def cmd_uninstall():
    subprocess.run(["systemctl", "--user", "stop", "goblincakes-voice.service"], capture_output=True)
    shutil.rmtree(DIR, ignore_errors=True)
    say("Rösten är borttagen.")
    return 0


def record(path, seconds=None):
    """pw-record into a 16 kHz mono wav; stops after seconds, or on SIGINT/SIGTERM."""
    proc = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", str(path)])

    def stop(*_):
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
    old_int = signal.signal(signal.SIGINT, stop)
    old_term = signal.signal(signal.SIGTERM, stop)
    try:
        if seconds:
            try:
                proc.wait(timeout=seconds)
            except subprocess.TimeoutExpired:
                stop()
        proc.wait()
    finally:
        signal.signal(signal.SIGINT, old_int)
        signal.signal(signal.SIGTERM, old_term)
    return proc.returncode


def cmd_record(args):
    if not args:
        print("goblincakes-voice record <wav> [sekunder]", file=sys.stderr)
        return 2
    record(args[0], float(args[1]) if len(args) > 1 else None)
    return 0 if Path(args[0]).is_file() else 1


_model = None


def whisper_model():
    global _model
    if _model is None:
        from faster_whisper import WhisperModel
        _model = WhisperModel(str(whisper_dir()), device="cpu", compute_type="int8",
                              cpu_threads=WHISPER_THREADS)
    return _model


def audio(path):
    """Any sound file → 16 kHz mono float32, read by ffmpeg (faster-whisper's own reader, PyAV,
    broke with PyAV 19 on 4 Nov – ffmpeg is in the image and doesn't change under us)."""
    import numpy
    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-nostdin", "-i", str(path),
                        "-f", "f32le", "-ac", "1", "-ar", "16000", "-"], capture_output=True)
    if r.returncode != 0:
        raise RuntimeError("Kunde inte läsa ljudet: " + r.stderr.decode(errors="replace").strip()[-200:])
    return numpy.frombuffer(r.stdout, dtype=numpy.float32)


def hear(path):
    """Speech → text. Returns (text, seconds spent)."""
    t = time.monotonic()
    segments, _info = whisper_model().transcribe(
        audio(path), language="sv", beam_size=5, vad_filter=True,
        condition_on_previous_text=False, initial_prompt=VOCABULARY)
    text = " ".join(s.text.strip() for s in segments).strip()
    text = re.sub(r"<\|[^|>]*\|>", "", text).strip()     # Whisper's own markers, e.g. <|nospeech|>
    return text, time.monotonic() - t


def cmd_hear(args):
    if not args:
        print("goblincakes-voice hear <wav>", file=sys.stderr)
        return 2
    in_venv()
    t = time.monotonic()
    whisper_model()
    loaded = time.monotonic() - t
    text, secs = hear(args[0])
    print(json.dumps({"text": text, "load": round(loaded, 2), "seconds": round(secs, 2)}, ensure_ascii=False))
    return 0


def cmd_test(args):
    in_venv()
    seconds = float(args[0]) if args else 5.0
    t = time.monotonic()
    whisper_model()
    print(f"Modellen laddad på {time.monotonic() - t:.1f} s.", flush=True)
    with tempfile.TemporaryDirectory(prefix="goblincakes-voice-") as tmp:
        wav = Path(tmp) / "test.wav"
        print(f"Prata nu ({seconds:.0f} s)…", flush=True)
        record(wav, seconds)
        print("Lyssnar…", flush=True)
        text, secs = hear(wav)
    print(f"Text ({secs:.1f} s): {text or '(inget hördes)'}")
    return 0


def speak(text, who="kvinna", out=None):
    """Text → speech with the chosen voice; played with pw-play, or saved to out."""
    from piper import PiperVoice, SynthesisConfig
    v = load()["voices"].get(who) or DEFAULT_VOICES["kvinna"]
    voice = PiperVoice.load(str(piper_file(v["model"])))
    cfg = SynthesisConfig(length_scale=float(v.get("length") or 1.0))
    rate = voice.config.sample_rate
    silence = bytes(int(rate * float(v.get("pause") or 0)) * 2)
    with tempfile.TemporaryDirectory(prefix="goblincakes-voice-") as tmp:
        raw = Path(tmp) / "raw.wav"
        with wave.open(str(raw), "wb") as w:
            w.setframerate(rate)
            w.setsampwidth(2)
            w.setnchannels(1)
            for chunk in voice.synthesize(text, cfg):
                w.writeframes(chunk.audio_int16_bytes)
                w.writeframes(silence)
        final = raw
        if v.get("husky"):
            final = Path(tmp) / "husky.wav"
            r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", str(raw), "-af", HUSKY, str(final)])
            if r.returncode != 0:
                final = raw
        if out:
            shutil.copyfile(final, out)
        else:
            subprocess.run(["pw-play", str(final)])


def cmd_say(args):
    who, out, words = "kvinna", None, []
    it = iter(args)
    for a in it:
        if a == "--voice":
            who = next(it, who)
        elif a == "--out":
            out = next(it, None)
        else:
            words.append(a)
    text = " ".join(words).strip()
    if not text:
        print("goblincakes-voice say <text> [--voice kvinna|man] [--out <wav>]", file=sys.stderr)
        return 2
    in_venv()
    speak(text, who, out)
    return 0


# ── The service: hold the key and talk ────────────────────────────

SHORTCUT = ["goblincakes-voice", "push-to-talk", "Goblin AI röst", "Håll in och prata med Kakan"]
KEY_F8 = 0x01000037
MIN_HOLD = 0.4          # shorter = a slip of the finger
MAX_HOLD = 30           # a stuck key stops by itself
MUTED_FILE = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "goblincakes-voice-muted.json"
START_SOUND = "/usr/share/sounds/ocean/stereo/button-pressed.oga"


def cmd_worker():
    """The model stays loaded; one wav path per line → one JSON line."""
    in_venv()
    whisper_model()
    print(json.dumps({"ready": True}), flush=True)
    for line in sys.stdin:
        path = line.strip()
        if not path:
            continue
        try:
            text, secs = hear(path)
            print(json.dumps({"text": text, "seconds": round(secs, 2)}, ensure_ascii=False), flush=True)
        except Exception as e:  # noqa: BLE001 – one bad recording must not stop the service
            print(json.dumps({"text": "", "error": str(e)}, ensure_ascii=False), flush=True)
    return 0


def discord_inputs():
    """PipeWire source-outputs (microphone streams) that belong to Discord: [(index, muted)]."""
    r = subprocess.run(["pactl", "-f", "json", "list", "source-outputs"], capture_output=True, text=True)
    try:
        outputs = json.loads(r.stdout or "[]")
    except ValueError:
        return []
    found = []
    for o in outputs:
        props = o.get("properties") or {}
        names = " ".join(str(props.get(k) or "") for k in
                         ("application.name", "application.process.binary", "node.name", "application.id"))
        if "discord" in names.lower():
            found.append((o.get("index"), bool(o.get("mute"))))
    return found


def discord_mute():
    """Mute Discord's microphone streams that aren't muted already; remember which."""
    ids = [i for i, muted in discord_inputs() if not muted and i is not None]
    for i in ids:
        subprocess.run(["pactl", "set-source-output-mute", str(i), "1"], capture_output=True)
    if ids:
        MUTED_FILE.write_text(json.dumps(ids))
    return ids


def discord_unmute():
    try:
        ids = json.loads(MUTED_FILE.read_text())
    except (OSError, ValueError):
        return
    for i in ids:
        subprocess.run(["pactl", "set-source-output-mute", str(i), "0"], capture_output=True)
    MUTED_FILE.unlink(missing_ok=True)


def osd(text, icon="audio-input-microphone"):
    """Plasma's own small box in the middle of the screen (as for the volume)."""
    subprocess.Popen(["gdbus", "call", "--session", "--dest", "org.kde.plasmashell",
                      "--object-path", "/org/kde/osdService", "--method", "org.kde.osdService.showText",
                      icon, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify(title, body):
    subprocess.Popen(["notify-send", "-a", "Goblin AI", "-i", "goblincakes-ai", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Listener:
    def __init__(self):
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.rec = None
        self.wav = None
        self.started = 0.0
        self.timer = None
        self.tmp = Path(tempfile.mkdtemp(prefix="goblincakes-voice-"))
        # (a leftover semaphore from the speech library is harmless – its warning is hidden)
        env = {**os.environ, "PYTHONWARNINGS": "ignore::UserWarning:multiprocessing.resource_tracker"}
        self.worker = subprocess.Popen([str(PY), "-s", os.path.abspath(__file__), "worker"], env=env,
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        ready = self.worker.stdout.readline()
        if '"ready"' not in ready:
            raise RuntimeError("Taligenkänningen startade inte.")
        GLib.io_add_watch(self.worker.stdout, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, self.on_text)

    def kga(self, method, sig, args, ret=None):
        return self.bus.call_sync("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", method,
                                  self.GLib.Variant(sig, args), self.GLib.VariantType(ret) if ret else None,
                                  0, -1, None)

    def register(self):
        self.kga("doRegister", "(as)", (SHORTCUT,))
        self.kga("setShortcut", "(asaiu)", (SHORTCUT, [KEY_F8], 1), "(ai)")   # IsDefault
        active = self.kga("setShortcut", "(asaiu)", (SHORTCUT, [KEY_F8], 2), "(ai)").unpack()[0]  # SetPresent
        path = self.kga("getComponent", "(s)", (SHORTCUT[0],), "(o)").unpack()[0]
        self.bus.signal_subscribe("org.kde.kglobalaccel", "org.kde.kglobalaccel.Component", None, path,
                                  None, 0, self.on_signal, None)
        return active

    def unregister(self):
        try:
            self.kga("setInactive", "(as)", (SHORTCUT,))
        except Exception:  # noqa: BLE001 – the session may already be gone
            pass

    def on_signal(self, _conn, _sender, _path, _iface, name, params, _data):
        _component, action, _ts = params.unpack()
        if action != SHORTCUT[1]:
            return
        if name == "globalShortcutPressed":
            self.press()
        elif name == "globalShortcutReleased":
            self.release()

    def press(self):
        if self.rec:
            return
        self.wav = self.tmp / f"{int(time.time() * 1000)}.wav"
        self.rec = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16",
                                     str(self.wav)])
        self.started = time.monotonic()
        discord_mute()
        osd("Kakan lyssnar…")
        if os.path.exists(START_SOUND):
            subprocess.Popen(["pw-play", START_SOUND], stderr=subprocess.DEVNULL)
        self.timer = self.GLib.timeout_add_seconds(MAX_HOLD, self.release)

    def release(self):
        if not self.rec:
            return False
        if self.timer:
            self.GLib.source_remove(self.timer)
            self.timer = None
        held = time.monotonic() - self.started
        self.rec.send_signal(signal.SIGINT)
        try:
            self.rec.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.rec.kill()
        self.rec = None
        discord_unmute()
        if held < MIN_HOLD or not self.wav.is_file():
            self.wav.unlink(missing_ok=True)
            return False
        self.worker.stdin.write(str(self.wav) + "\n")
        self.worker.stdin.flush()
        return False

    def on_text(self, source, condition):
        line = source.readline()
        if not line:
            print("Taligenkänningen stannade.", file=sys.stderr, flush=True)
            self.GLib.MainLoop().quit()
            os._exit(1)        # systemd starts the service again
        try:
            result = json.loads(line)
        except ValueError:
            return True
        for f in self.tmp.glob("*.wav"):
            f.unlink(missing_ok=True)
        self.heard(result.get("text") or "", result)
        return True

    def heard(self, text, result):
        """Step B: show what was heard. (C: simple commands, D: Kakan + read aloud.)"""
        print(f"Hörde ({result.get('seconds')} s): {text or '–'}", flush=True)
        if text:
            notify("Kakan hörde", text)
        else:
            osd("Kakan hörde inget", "audio-input-microphone-muted")

    def close(self):
        if self.rec:
            self.rec.kill()
        discord_unmute()
        self.unregister()
        try:
            self.worker.stdin.close()          # the worker ends its loop and exits by itself
            self.worker.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.worker.kill()
        shutil.rmtree(self.tmp, ignore_errors=True)


def cmd_listen():
    discord_unmute()                       # left from a crash while the key was held
    if not installed():
        print("Rösten är inte installerad (goblincakes-voice install).", file=sys.stderr)
        return 1
    from gi.repository import GLib
    listener = Listener()
    active = listener.register()
    print(f"Lyssnar efter röstknappen ({', '.join(hex(k) for k in active) or 'ingen tangent'}).", flush=True)
    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except ImportError:
        add_signal = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_HIGH, sig, loop.quit)
    try:
        loop.run()
    finally:
        listener.close()
    return 0


def main(argv):
    cmd = argv[0] if argv else "status"
    rest = argv[1:]
    commands = {
        "status": lambda: cmd_status(),
        "install": lambda: cmd_install(),
        "uninstall": lambda: cmd_uninstall(),
        "record": lambda: cmd_record(rest),
        "hear": lambda: cmd_hear(rest),
        "test": lambda: cmd_test(rest),
        "say": lambda: cmd_say(rest),
        "listen": lambda: cmd_listen(),
        "worker": lambda: cmd_worker(),
    }
    if cmd not in commands:
        print(__doc__, file=sys.stderr)
        return 2
    return commands[cmd]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
