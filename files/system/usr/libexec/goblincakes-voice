#!/usr/bin/python3
"""GOBLINCAKES: Kakan's voice – speech to text and text to speech on the processor (Kakan step 9, 4 Nov).

    goblincakes-voice status                  JSON: installed, place, models, settings
    goblincakes-voice install                 Python environment (faster-whisper + Piper) and the models
                                              into ~/.local/share/goblincakes-voice (~1 GB)
    goblincakes-voice uninstall               everything above
    goblincakes-voice stale                   exit 0 when the environment was made for another Python than the
                                              system's now (a new Fedora) – install makes it again (goblin update)
    goblincakes-voice record <wav> [seconds]  the microphone, 16 kHz mono (without seconds: until Ctrl+C/SIGTERM)
    goblincakes-voice hear <wav>              speech → text: JSON {text, load, seconds}
    goblincakes-voice test [seconds]          record (default 5 s), then hear – prints the text and the times
    goblincakes-voice say <text> [--voice kvinna|man] [--out <wav>]
                                              text → speech, played (or saved with --out)
    goblincakes-voice listen                  the service: hold the voice key (F8 – the G502's button 4)
                                              and talk; released → text → a simple command is done at once
                                              (ai/voicecmd.py) and answered aloud; the key again = quiet
    goblincakes-voice lärt                    what she has learned the user means ("strikewild" = Zakk Wylde)
    goblincakes-voice glöm <nummer|alla>      forget one of them (the number from lärt), or all
    goblincakes-voice box                     (used by listen) the box top right: what she heard and her
                                              answer – JSON lines {"state", "heard", "answer", "hold"} in
    goblincakes-voice worker                  (used by listen) the loaded model and the voices: JSON lines
                                              {"hear": wav} / {"say": text, "voice", "out"} in, results out

Nothing goes into the image: the environment and the models live in the home folder and are
fetched when the user turns Röst on. Speech to text = KBLab's Swedish Whisper (kb-whisper-small,
CTranslate2) via faster-whisper, int8 on 4 threads so a game keeps the rest of the processor.
Text to speech = Piper: lisa (Kakan, a woman – Piper's own sound, no filter since 6 Nov: the user
"ta bort filtrena helt") and nst (for a male avatar, a little faster). Chosen by ear 4 Nov.
Names Piper says the Swedish way are spelt for her ear first (SAY_AS).
Settings: ~/.config/goblincakes/voice.json {"voices": {"kvinna": {…}, "man": {…}}}.
Lines starting with "@@ " (and "@@progress {…}") are for the window, as in goblincakes-ollama.

The key: a KDE global shortcut (kglobalaccel, component "goblincakes-voice", changeable in
System Settings → Shortcuts) – kglobalaccel sends both pressed and released, so it works over
games too. Not F20–F23: xkb makes them microphone mute / touchpad keys (F20 held = the mic
toggled on and off, 4 Nov). While the key is held only the microphone TOWARDS Discord is muted
(its PipeWire source-output); what the others say is heard as usual. The ids we muted are kept
in a file so a crash can't leave Discord muted: listen unmutes them when it starts.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import wave
from pathlib import Path

HOME = Path.home()
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "goblincakes/voice.json"
DIR = Path(os.environ.get("GOBLINCAKES_VOICE_DIR")
           or Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "goblincakes-voice")
VENV = DIR / "venv"
PY = VENV / "bin/python3"
MODELS = DIR / "models"
HF = "https://huggingface.co"
# Tested together 4 Nov; newer ones only after a test.
PACKAGES = ["faster-whisper==1.2.1", "piper-tts==1.8.0"]

WHISPER = "kb-whisper-small"
WHISPER_REPO = "KBLab/kb-whisper-small"
WHISPER_FILES = ["model.bin", "config.json", "tokenizer.json", "vocabulary.json", "preprocessor_config.json"]
# The bigger one for questions (7 Nov, the user's test: small 2 s "Anna I'm Ducks", medium 5–6 s "Anaheim Ducks", but
# medium turns "Spela" into "Spelade" – so small hears the commands, medium what goes on to Goblin AI). 1.5 GB, ~1 GB
# memory once used; without it everything is small's, as before.
WHISPER_BIG = "kb-whisper-medium"
WHISPER_BIG_REPO = "KBLab/kb-whisper-medium"
WHISPER_THREADS = 4
# Words Whisper otherwise hears as Swedish ("Warcraft Logs" → "varmkraft lågs"): given as the
# text "before" the speech, so it leans towards these spellings.
VOCABULARY = ("Kakan, Goblin AI, GOBLINCAKES, Warcraft Logs, WoW, World of Warcraft, CS2, Counter-Strike, "
              "Discord, Spotify, Steam, pull, pullen, senaste pullen, raid, Mythic plus, wipe, parse, lagg, GoblinAmp, GoblinRecorder, "
              "BugSack, WowUp, tillägg, addon, addon i WoW, gear planner, CooldownVoice, KeystoneDisplay, IDidWhatWhen, SimpleQuestRemover, "
              "DadJoke.")  # the user's own add-ons: "gear planner" was heard "Gairplaner" (7 Nov)

# What both models still hear wrong (the user's test 7 Nov: "Ardon i Vov", "Adronyvov", "DonnieVov" = addon i WoW)
HEARD_AS = [
    (r"\b(?:ardon|erdon|adron|adon|addån|ardån|donnie)\s*(?:i\s*|y)?(?:vov|wov|vav)\b", "addon i WoW"),
    (r"\b(?:ardon|erdon|adron|addån|ardån)(?:i|y)(?:vov|wov|vav)\b", "addon i WoW"),
    (r"\b(?:ardon|erdon|adron|addån|ardån)\b", "addon"),
    (r"\b(?:i\s+(?:vov|wov|vav)|yvov|ivov)\b", "i WoW"),
]
OWN_ADDON_NAMES = ["gear-planner", "CooldownVoice", "KeystoneDisplay", "IDidWhatWhen", "SimpleQuestRemover",
                   "SimpleSecondaryStats", "DadJoke", "BugSack", "Warcraft Logs", "GoblinAmp", "GoblinRecorder"]
KNOWN_LIKE = 0.75  # how alike a heard word (or 2–3 together) and a known name must be


def _letters(text):
    return re.sub(r"[^a-zåäö0-9]", "", text.lower())


def known_words(text):
    """Heard text corrected against what she knows: the patterns above, then the user's own add-ons and their most
    played artists (voicecmd.whisper_words) – "Gairplaner"/"Gearplanter" → gear-planner, "metalliker" → Metallica.
    Only names of 6 letters or more, and only when nearly the same."""
    import difflib  # noqa: PLC0415
    for pattern, word in HEARD_AS:
        text = re.sub(pattern, word, text, flags=re.I)
    try:
        names = OWN_ADDON_NAMES + list(voicecmd().whisper_words())[:60]
    except Exception:  # noqa: BLE001 – no music list: the add-ons only
        names = OWN_ADDON_NAMES
    names = [(n, _letters(n)) for n in dict.fromkeys(names) if len(_letters(n)) >= 6]
    words = re.findall(r"\S+", text)
    out, i = [], 0
    while i < len(words):
        best = None
        for n in (3, 2, 1):
            part = words[i:i + n]
            if len(part) < n:
                continue
            heard = _letters(" ".join(part))
            if len(heard) < 5 or (n > 1 and any(len(_letters(w)) <= 3 for w in part)):
                continue  # "i", "och", "på" are never part of a name ("bugsack och" → BugSack ate the "och")
            for name, letters in names:
                if heard == letters:
                    best = best or (n, name, 1.0)
                    continue
                if abs(len(heard) - len(letters)) > max(3, len(letters) // 3):
                    continue
                like = difflib.SequenceMatcher(None, heard, letters).ratio()
                if like >= KNOWN_LIKE and (not best or like > best[2]):
                    best = (n, name, like)
        if best and best[2] < 1.0:
            tail = re.search(r"[.,!?:;]+$", words[i + best[0] - 1])
            out.append(best[1] + (tail.group(0) if tail else ""))
            i += best[0]
        else:
            out.append(words[i])
            i += 1
    return " ".join(out)


PIPER_VOICES = {"lisa": "sv/sv_SE/lisa/medium/sv_SE-lisa-medium",
                "nst": "sv/sv_SE/nst/medium/sv_SE-nst-medium"}
DEFAULT_VOICES = {
    "kvinna": {"model": "lisa", "length": 1.0, "pause": 0.3},
    "man": {"model": "nst", "length": 0.85, "pause": 0.3},
}
# How words are written for Piper's ear (only what is spoken; the box shows the real words).
# "Gåbblinn ej-aj" (6 Nov, the user: "nu låter det bra"): ˈɡɔblɪn – "Gåbblin" put the stress last
# (ɡɔblˈiːn, "gooblin" now and then); check a new spelling with PiperVoice.phonemize()
SAY_AS = [
    (r"\bGoblin\s*AI\b", "Gåbblinn ej-aj"),
    (r"\bGoblin\s*Amp\b", "Gåbblinn-amp"),     # the user chose it of four by ear (6 Nov)
]


LAST_SAID = [""]   # the newest line for the window – the repair notice tells why it failed


def say(text):
    LAST_SAID[0] = text
    print(f"@@ {text}", flush=True)


def progress(**fields):
    print("@@progress " + json.dumps(fields), flush=True)


# ── Settings ──────────────────────────────────────────────────────

def load():
    try:
        data = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    voices = data.get("voices") if isinstance(data.get("voices"), dict) else {}
    data["voices"] = {k: {**v, **(voices.get(k) or {})} for k, v in DEFAULT_VOICES.items()}
    return data


def whisper_dir(big=False):
    return MODELS / (WHISPER_BIG if big else WHISPER)


def big_installed():
    return all((whisper_dir(True) / f).is_file() for f in WHISPER_FILES)


def piper_file(name):
    return MODELS / "piper" / (PIPER_VOICES[name].rsplit("/", 1)[1] + ".onnx")


def venv_ok():
    """The environment belongs to the Python that runs now. Its python3 is a link to the system's and its packages
    live in lib/pythonX.Y: after a Fedora with a newer Python (44 → 45: 3.14 → 3.15) the link runs the new one,
    which finds none of them – the service started, crashed and was started again every 10 s, saying nothing.
    The two packages themselves are looked for: an environment made again whose download failed is not ready."""
    site = VENV / f"lib/python{sys.version_info[0]}.{sys.version_info[1]}/site-packages"
    return (site / "faster_whisper").is_dir() and (site / "piper").is_dir()


def stale():
    """Installed, but for another Python: only the environment has to be made again (the models stay)."""
    return PY.is_file() and not venv_ok()


def installed():
    return (PY.is_file() and venv_ok() and all((whisper_dir() / f).is_file() for f in WHISPER_FILES)
            and all(piper_file(n).is_file() and piper_file(n).with_suffix(".onnx.json").is_file()
                    for n in PIPER_VOICES))


def in_venv():
    """Re-run this command with the environment's Python (faster-whisper and Piper live there)."""
    if Path(sys.prefix).resolve() == VENV.resolve():
        return
    if not installed():
        print("Rösten är inte installerad (goblincakes-voice install).", file=sys.stderr)
        sys.exit(1)
    os.execv(str(PY), [str(PY), "-s", os.path.abspath(__file__), *sys.argv[1:]])


def tree_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


# ── Commands ──────────────────────────────────────────────────────

def cmd_status():
    data = load()
    print(json.dumps({
        "installed": installed(),
        "stale": stale(),   # made for another Python (a new Fedora): install makes the environment again
        "dir": str(DIR),
        "size": tree_size(DIR) if DIR.exists() else 0,
        "whisper": WHISPER,
        "voices": data["voices"],
    }, ensure_ascii=False))
    return 0


def fetch(url, dest, what):
    """One file, with progress; atomically into place."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": "goblincakes"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            done, last = 0, 0.0
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if total > 5 << 20 and time.time() - last > 0.5:
                    last = time.time()
                    progress(what=what, completed=done, total=total)
    except (OSError, urllib.error.URLError) as e:
        tmp.unlink(missing_ok=True)
        raise RuntimeError(f"Kunde inte hämta {dest.name} ({getattr(e, 'reason', e)})") from None
    tmp.replace(dest)


def cmd_install(restart=True):
    try:
        if not PY.is_file() or stale():
            # --clear: an environment of another Python is emptied first (the models are beside it, not in it)
            say("Python har bytt version – gör om Python-miljön…" if stale() else "Skapar Python-miljön…")
            DIR.mkdir(parents=True, exist_ok=True)
            r = subprocess.run(["/usr/bin/python3", "-m", "venv", "--clear", str(VENV)], capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError("Kunde inte skapa Python-miljön: " + r.stderr.strip()[-300:])
        say("Installerar tal till text och uppläsning (faster-whisper, Piper)…")
        r = subprocess.run([str(PY), "-m", "pip", "install", "-q", "--disable-pip-version-check", *PACKAGES],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("pip misslyckades: " + (r.stderr.strip().splitlines() or ["okänt fel"])[-1])
        # Said only when something is fetched: after a new Python only the environment was made again
        said = set()

        def once(text):
            if text not in said:
                said.add(text)
                say(text)
        for f in WHISPER_FILES:
            if not (whisper_dir() / f).is_file():
                once("Hämtar den svenska taligenkänningen (KBLab)…")
                fetch(f"{HF}/{WHISPER_REPO}/resolve/main/{f}", whisper_dir() / f, WHISPER)
        for f in WHISPER_FILES:
            if not (whisper_dir(True) / f).is_file():
                once("Hämtar den större taligenkänningen för frågor (1,5 GB)…")
                fetch(f"{HF}/{WHISPER_BIG_REPO}/resolve/main/{f}", whisper_dir(True) / f, WHISPER_BIG)
        for name, path in PIPER_VOICES.items():
            for ext in (".onnx", ".onnx.json"):
                dest = piper_file(name).with_suffix(ext)
                if not dest.is_file():
                    once("Hämtar rösterna…")
                    fetch(f"{HF}/rhasspy/piper-voices/resolve/main/{path}{ext}", dest, name)
    except RuntimeError as e:
        say(str(e))
        return 1
    if restart:
        subprocess.run(["systemctl", "--user", "restart", "goblincakes-voice.service"], capture_output=True)
    say("Rösten är installerad.")
    return 0


def offer_repair():
    """The service found the environment made for another Python (a new Fedora). Nothing is fetched by itself: a
    notice with a button; pressed = the environment is made again (the packages, ~250 MB – the models stay).
    True when the voice works again. Closed without the button = asked again at the next login."""
    version = f"{sys.version_info[0]}.{sys.version_info[1]}"
    print(f"Röstens Python-miljö är gjord för en annan Python än {version} – frågar om den ska göras om.", flush=True)
    try:
        chosen = subprocess.run(
            ["notify-send", "-a", "Goblin AI", "-i", "goblincakes-ai", "-t", "0", "-A", "repair=Laga nu",
             "Kakans röst behöver lagas",
             f"Systemet har fått en ny Python-version ({version}) och röstens delar måste hämtas om (ca 250 MB, "
             "tar någon minut). Röstknappen fungerar inte förrän det är gjort. Går också med goblin update."],
            capture_output=True, text=True, check=False).stdout.strip()
    except OSError:
        chosen = ""
    if chosen != "repair":
        print("Inte lagad nu – frågar igen vid nästa inloggning (eller: goblin update).", flush=True)
        return False
    ok = cmd_install(restart=False) == 0 and installed()
    notify("Kakans röst fungerar igen" if ok else "Kakans röst gick inte att laga",
           "Håll röstknappen och prata." if ok else
           f"{LAST_SAID[0]} Försök igen med goblin update eller Goblin AI → Inställningar → Röst.")
    return ok


def cmd_uninstall():
    subprocess.run(["systemctl", "--user", "stop", "goblincakes-voice.service"], capture_output=True)
    shutil.rmtree(DIR, ignore_errors=True)
    say("Rösten är borttagen.")
    return 0


def record(path, seconds=None):
    """pw-record into a 16 kHz mono wav; stops after seconds, or on SIGINT/SIGTERM."""
    proc = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", str(path)])

    def stop(*_):
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
    old_int = signal.signal(signal.SIGINT, stop)
    old_term = signal.signal(signal.SIGTERM, stop)
    try:
        if seconds:
            try:
                proc.wait(timeout=seconds)
            except subprocess.TimeoutExpired:
                stop()
        proc.wait()
    finally:
        signal.signal(signal.SIGINT, old_int)
        signal.signal(signal.SIGTERM, old_term)
    return proc.returncode


def cmd_record(args):
    if not args:
        print("goblincakes-voice record <wav> [sekunder]", file=sys.stderr)
        return 2
    record(args[0], float(args[1]) if len(args) > 1 else None)
    return 0 if Path(args[0]).is_file() else 1


_model = None
last_sure = []
_prompt = (None, VOCABULARY)    # (the word file's mtime, the prompt made from it)
PROMPT_TOKENS = 212             # Whisper keeps the last ~223 tokens of the prompt
OWN_WORDS = 12                  # 5 Nov: ~30 names made Whisper invent "&nbsp;…" for 6 s (Piper's voice) – few
# Whisper's made-up text: html bits, the same piece over and over
NONSENSE = re.compile(r"&nb|nbsp|&[a-z]+;|(\b\w{2,}\b)(?:\W+\1\b){3,}", re.I)


def prompt():
    """VOCABULARY + the user's own artists and albums (voicecmd.whisper_words, 5 Nov: "Saquald" was
    Zakk Wylde), cut to fit. The most important words last – Whisper drops from the front."""
    global _prompt
    vc = voicecmd()
    try:
        mtime = vc.WORDS_FILE.stat().st_mtime
    except OSError:
        return VOCABULARY
    if _prompt[0] == mtime:
        return _prompt[1]
    tok = whisper_model().hf_tokenizer
    words, text = vc.whisper_words(), VOCABULARY
    for w in words[:OWN_WORDS]:                       # most important first, until it is full
        longer = f"{text.rstrip('.')}, {w}."
        if len(tok.encode(" " + longer).ids) > PROMPT_TOKENS:
            break
        text = longer
    own = text[len(VOCABULARY.rstrip(".")) + 2:].rstrip(".")
    text = (own + ". " + VOCABULARY) if own else VOCABULARY   # the fixed words last (kept if ever too long)
    _prompt = (mtime, text)
    return text


_big = None


def whisper_model(big=False):
    global _model, _big
    if big:
        if _big is None:  # loaded the first time a question needs it (1,5 s), then kept
            from faster_whisper import WhisperModel
            _big = WhisperModel(str(whisper_dir(True)), device="cpu", compute_type="int8", cpu_threads=WHISPER_THREADS)
        return _big
    if _model is None:
        from faster_whisper import WhisperModel
        _model = WhisperModel(str(whisper_dir()), device="cpu", compute_type="int8",
                              cpu_threads=WHISPER_THREADS)
    return _model


def audio(path):
    """Any sound file → 16 kHz mono float32, read by ffmpeg (faster-whisper's own reader, PyAV,
    broke with PyAV 19 on 4 Nov – ffmpeg is in the image and doesn't change under us)."""
    import numpy
    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-nostdin", "-i", str(path),
                        "-f", "f32le", "-ac", "1", "-ar", "16000", "-"], capture_output=True)
    if r.returncode != 0:
        raise RuntimeError("Kunde inte läsa ljudet: " + r.stderr.decode(errors="replace").strip()[-200:])
    return numpy.frombuffer(r.stdout, dtype=numpy.float32)


def hear(path, big=False):
    """Speech → text (big: the bigger model, for a question). Returns (text, seconds spent)."""
    t = time.monotonic()
    sound = audio(path)
    words = prompt()
    segments, _info = whisper_model(big).transcribe(
        sound, language="sv", beam_size=5, vad_filter=True,
        condition_on_previous_text=False, initial_prompt=words)
    segments = list(segments)
    text = " ".join(s.text.strip() for s in segments).strip()
    if words != VOCABULARY and (NONSENSE.search(text) or len(text) > 25 * len(sound) / 16000 + 20):
        print(f"Whisper hittade på ({text[:60]!r}) – igen utan den egna ordlistan", file=sys.stderr, flush=True)
        segments, _info = whisper_model(big).transcribe(
            sound, language="sv", beam_size=5, vad_filter=True,
            condition_on_previous_text=False, initial_prompt=VOCABULARY)
        segments = list(segments)
        text = " ".join(s.text.strip() for s in segments).strip()
    text = re.sub(r"<\|[^|>]*\|>", "", text).strip()     # Whisper's own markers, e.g. <|nospeech|>
    # How sure Whisper was, per part (logged to find a limit for talk in the background, 4 Nov:
    # "hans medicinpris är helt ofelbar" was someone on the phone in the room)
    global last_sure
    last_sure = [(round(s.avg_logprob, 2), round(s.no_speech_prob, 2)) for s in segments]
    return text, time.monotonic() - t


def cmd_hear(args):
    if not args:
        print("goblincakes-voice hear <wav>", file=sys.stderr)
        return 2
    in_venv()
    t = time.monotonic()
    whisper_model()
    loaded = time.monotonic() - t
    text, secs = hear(args[0])
    print(json.dumps({"text": text, "load": round(loaded, 2), "seconds": round(secs, 2)}, ensure_ascii=False))
    return 0


def cmd_test(args):
    in_venv()
    seconds = float(args[0]) if args else 5.0
    t = time.monotonic()
    whisper_model()
    print(f"Modellen laddad på {time.monotonic() - t:.1f} s.", flush=True)
    with tempfile.TemporaryDirectory(prefix="goblincakes-voice-") as tmp:
        wav = Path(tmp) / "test.wav"
        print(f"Prata nu ({seconds:.0f} s)…", flush=True)
        record(wav, seconds)
        print("Lyssnar…", flush=True)
        text, secs = hear(wav)
    print(f"Text ({secs:.1f} s): {text or '(inget hördes)'}")
    return 0


_voices = {}


def speak(text, who="kvinna", out=None):
    """Text → speech with the chosen voice; played with pw-play, or saved to out."""
    from piper import PiperVoice, SynthesisConfig
    v = load()["voices"].get(who) or DEFAULT_VOICES["kvinna"]
    model = str(piper_file(v["model"]))
    if model not in _voices:              # the service keeps the voices loaded
        _voices[model] = PiperVoice.load(model)
    voice = _voices[model]
    cfg = SynthesisConfig(length_scale=float(v.get("length") or 1.0))
    for pattern, word in SAY_AS:
        text = re.sub(pattern, word, text, flags=re.I)
    rate = voice.config.sample_rate
    silence = bytes(int(rate * float(v.get("pause") or 0)) * 2)
    with tempfile.TemporaryDirectory(prefix="goblincakes-voice-") as tmp:
        raw = Path(tmp) / "raw.wav"
        with wave.open(str(raw), "wb") as w:
            w.setframerate(rate)
            w.setsampwidth(2)
            w.setnchannels(1)
            for chunk in voice.synthesize(text, cfg):
                w.writeframes(chunk.audio_int16_bytes)
                w.writeframes(silence)
        final = raw
        if out:
            shutil.copyfile(final, out)
        else:
            subprocess.run(["pw-play", str(final)])


def cmd_say(args):
    who, out, words = "kvinna", None, []
    it = iter(args)
    for a in it:
        if a == "--voice":
            who = next(it, who)
        elif a == "--out":
            out = next(it, None)
        else:
            words.append(a)
    text = " ".join(words).strip()
    if not text:
        print("goblincakes-voice say <text> [--voice kvinna|man] [--out <wav>]", file=sys.stderr)
        return 2
    in_venv()
    speak(text, who, out)
    return 0


# ── The service: hold the key and talk ────────────────────────────

SHORTCUT = ["goblincakes-voice", "push-to-talk", "Goblin AI röst", "Håll in och prata med Kakan"]
KEY_F8 = 0x01000037
MIN_HOLD = 0.4          # shorter = a slip of the finger
MAX_HOLD = 30           # a stuck key stops by itself
# After "Kakan" alone (8 Nov, the user's choice "B", on trial): she greets and listens by herself – no key.
# Ends 1.2 s after the speech stops; nothing said within 6 s = she stops listening.
FOLLOW_WAIT = 6.0
FOLLOW_QUIET = 1.2
FOLLOW_MAX = 20.0
# A question during a game (8 Nov, the user): she asks first – "nu" = Goblin AI (Claude) at once, "vänta"/nothing said =
# saved here and asked when the game has closed
LATER_FILE = DIR / "efter-spelet.json"
ASK_NOW_OR_LATER = "Vill du att Claude tittar på det nu, eller kan det vänta tills du spelat klart?"
WAIT_WORDS = re.compile(r"\b(?:vänta\w*|sen|sedan|senare|efter\w*|nej|nä|inte nu|det kan vänta)\b")
CLAUDE = r"(?:claude|klod|clod|cloud|kloud|klaud|klåd)"   # Whisper's ways of hearing "Claude"
ANSWER_ONLY = re.compile(rf"(?:nu|direkt|vänta|vänta lite|sen|sedan|senare|klart|det kan vänta|inte nu|nu tack|ja nu|"
                         rf"(?:till |skicka till )?{CLAUDE}(?: nu)?)")
# "fel"/"glöm det" to "Claude eller vänta?" (8 Nov: half a question was heard and saved) = thrown away at once
DROP_WORDS = re.compile(r"\b(?:fel|glöm\w*|släng\w*|skippa|strunta i det|nej det var fel|hörde fel)\b")
NOW_WORDS = re.compile(rf"\b(?:ja|japp|jo|nu|direkt|gör det|skicka|titta|kör|gärna|okej|ok|{CLAUDE})\b")
MUTED_FILE = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "goblincakes-voice-muted.json"
START_SOUND = "/usr/share/sounds/ocean/stereo/button-pressed.oga"


def cmd_worker():
    """The model stays loaded. One JSON line in, one out:
    {"hear": wav} → {"hear": wav, "text", "seconds"};  {"say": text, "voice", "out": wav} → {"said": wav}."""
    in_venv()
    whisper_model()
    print(json.dumps({"ready": True}), flush=True)
    for line in sys.stdin:
        try:
            job = json.loads(line)
        except ValueError:
            continue
        try:
            if "hear" in job:
                big = bool(job.get("big")) and big_installed()
                text, secs = hear(job["hear"], big)
                answer = {"hear": job["hear"], "text": text, "seconds": round(secs, 2), "sure": last_sure,
                          **({"big": True, "first": job.get("first", "")} if big else {})}
            elif "say" in job:
                speak(job["say"], job.get("voice") or "kvinna", job["out"])
                answer = {"said": job["out"]}
            else:
                continue
        except Exception as e:  # noqa: BLE001 – one bad job must not stop the service
            answer = {**{k: v for k, v in job.items() if k in ("hear",)}, "text": "", "error": str(e)}
        print(json.dumps(answer, ensure_ascii=False), flush=True)
    return 0


def discord_inputs():
    """PipeWire source-outputs (microphone streams) that belong to Discord: [(index, muted)]."""
    r = subprocess.run(["pactl", "-f", "json", "list", "source-outputs"], capture_output=True, text=True)
    try:
        outputs = json.loads(r.stdout or "[]")
    except ValueError:
        return []
    found = []
    for o in outputs:
        props = o.get("properties") or {}
        names = " ".join(str(props.get(k) or "") for k in
                         ("application.name", "application.process.binary", "node.name", "application.id"))
        if "discord" in names.lower():
            found.append((o.get("index"), bool(o.get("mute"))))
    return found


def discord_mute():
    """Mute Discord's microphone streams that aren't muted already; remember which."""
    ids = [i for i, muted in discord_inputs() if not muted and i is not None]
    for i in ids:
        subprocess.run(["pactl", "set-source-output-mute", str(i), "1"], capture_output=True)
    if ids:
        MUTED_FILE.write_text(json.dumps(ids))
    return ids


def discord_unmute():
    try:
        ids = json.loads(MUTED_FILE.read_text())
    except (OSError, ValueError):
        return
    for i in ids:
        subprocess.run(["pactl", "set-source-output-mute", str(i), "0"], capture_output=True)
    MUTED_FILE.unlink(missing_ok=True)


BOX_QML = Path(__file__).resolve().parent.parent / "share/goblincakes/voice/Box.qml"


def cmd_learned(as_json=False):
    items = sorted(voicecmd().learned().items(), key=lambda kv: -kv[1].get("t", 0))
    if as_json:          # Goblin AI's voice card
        print(json.dumps([{"heard": h, "name": x["name"], "n": x.get("n", 1)} for h, x in items], ensure_ascii=False))
        return 0
    if not items:
        print("Inget inlärt än – hon lär sig när du säger ja till \"Menade du …?\".")
        return 0
    for i, (heard, x) in enumerate(items, 1):
        print(f"{i:3}. \"{heard}\" = {x['name']}  ({x.get('n', 1)} gånger)")
    return 0


def cmd_forget(args):
    items = sorted(voicecmd().learned().items(), key=lambda kv: -kv[1].get("t", 0))
    if args[:1] == ["alla"]:
        for heard, _ in items:
            voicecmd().forget_learned(heard)
        print(f"Glömde alla ({len(items)}).")
        return 0
    if not args or not args[0].isdigit() or not 1 <= int(args[0]) <= len(items):
        print("goblincakes-voice glöm <nummer från lärt> | alla", file=sys.stderr)
        return 2
    heard, x = items[int(args[0]) - 1]
    voicecmd().forget_learned(heard)
    print(f"Glömde \"{heard}\" = {x['name']}.")
    return 0


def cached_qml(path):
    """The window's QML from a copy Qt's QML cache works for (share/goblincakes/qmlcache.py, P23 12 Nov:
    image files are dated 1970 and were compiled again at every start) – or the file itself."""
    try:
        import importlib.util  # noqa: PLC0415
        spec = importlib.util.spec_from_file_location("qmlcache", Path(path).resolve().parents[1] / "qmlcache.py")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module.local(path)
    except Exception:  # noqa: BLE001 – anything wrong: load the file as before
        return str(path)


def cmd_box():
    """Kakan's box (step 9 D1, 5 Nov): one window, shown and hidden by the listener through stdin.
    Its own process, so a broken box never stops the voice (the listener falls back to Plasma's OSD)."""
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.9"   # 90 % (the user 5 Nov: 80 % too small, 100 % a little big)
    if os.environ.get("WAYLAND_DISPLAY"):      # Box.qml's LayerShell settings need it (Plasma's layer shell)
        os.environ["QT_WAYLAND_SHELL_INTEGRATION"] = "layer-shell"
    from PySide6.QtCore import Property, QObject, QUrl, Signal, Slot  # noqa: PLC0415
    from PySide6.QtGui import QGuiApplication, QIcon  # noqa: PLC0415
    from PySide6.QtQml import QQmlApplicationEngine  # noqa: PLC0415
    app = QGuiApplication(sys.argv[:1])
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblincakes-voice-box")
    app.setApplicationDisplayName("Kakan")
    app.setDesktopFileName("goblincakes-voice-box")      # = the window's class for KWin's script
    app.setWindowIcon(QIcon.fromTheme("goblincakes-ai"))
    app.setQuitOnLastWindowClosed(False)

    class Box(QObject):
        changed = Signal()
        incoming = Signal(dict)

        def __init__(self):
            super().__init__()
            self._d = {"state": "nothing", "heard": "", "answer": "", "hold": 6}
            self.incoming.connect(self.take)

        def take(self, d):
            self._d = {**self._d, **d}
            self.changed.emit()

        @Slot()
        def hidden(self):
            self._d["state"] = "nothing"
            self.changed.emit()

        state = Property(str, lambda self: self._d["state"], notify=changed)
        heard = Property(str, lambda self: self._d.get("heard") or "", notify=changed)
        answer = Property(str, lambda self: self._d.get("answer") or "", notify=changed)
        hold = Property(float, lambda self: float(self._d.get("hold") or 6), notify=changed)

    box = Box()

    def read():
        for line in sys.stdin:
            try:
                box.incoming.emit(json.loads(line))
            except ValueError:
                continue
        app.quit()                      # the listener is gone
    threading.Thread(target=read, daemon=True).start()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("box", box)
    sys.path.insert(0, str(BOX_QML.parent.parent))
    try:
        import accent  # noqa: PLC0415
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the box
        engine.rootContext().setContextProperty("accent", {"color": "#2F6FED", "text": "#2F6FED"})
    engine.load(QUrl.fromLocalFile(cached_qml(BOX_QML)))
    if not engine.rootObjects():
        return 1
    print("ready", flush=True)
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    return app.exec()


def in_game():
    """A game runs (gaming.py's rule, the same as the game mode's): then she only shows, never speaks."""
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "share/goblincakes"))
        from gaming import find_game  # noqa: PLC0415
        return find_game() is not None
    except Exception:  # noqa: BLE001 – unsure = speak as usual
        return False


def osd(text, icon="audio-input-microphone"):
    """Plasma's own small box in the middle of the screen (as for the volume)."""
    subprocess.Popen(["gdbus", "call", "--session", "--dest", "org.kde.plasmashell",
                      "--object-path", "/org/kde/osdService", "--method", "org.kde.osdService.showText",
                      icon, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


_voicecmd = None


def voicecmd():
    """Kakan's command module (next to her other files: /usr/share/goblincakes/ai, or the repo's)."""
    global _voicecmd
    if _voicecmd is None:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "share/goblincakes/ai"))
        import voicecmd as module  # noqa: PLC0415
        _voicecmd = module
    return _voicecmd


def voice_for_avatar():
    """The man's voice when the AI is "han" (Goblin AI → name and hon/han/hen), otherwise lisa."""
    try:
        gender = (Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "goblincakes/ai-gender").read_text()
    except OSError:
        gender = ""
    return "man" if gender.strip() == "han" else "kvinna"


def notify(title, body):
    subprocess.Popen(["notify-send", "-a", "Goblin AI", "-i", "goblincakes-ai", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Listener:
    def __init__(self):
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.rec = None
        self.wav = None
        self.started = 0.0
        self.timer = None
        self.player = None       # pw-play while she speaks – the key stops her
        self.follow = False      # "Kakan" alone: listen by herself once she has greeted
        self.auto = None         # that listening's pw-record (follow_listen)
        self.choice = None       # (question, monotonic) while she waits for "nu"/"vänta" during a game
        self.offer_due = True    # saved questions are offered once after each game (and once at the start)
        self.offering = False    # the Skicka/Släng notice is up
        GLib.timeout_add_seconds(30, self.ask_saved)
        self.boxproc = None      # the box top right (cmd_box), started at the first use
        self.tmp = Path(tempfile.mkdtemp(prefix="goblincakes-voice-"))
        # (a leftover semaphore from the speech library is harmless – its warning is hidden)
        env = {**os.environ, "PYTHONWARNINGS": "ignore::UserWarning:multiprocessing.resource_tracker"}
        self.worker = subprocess.Popen([str(PY), "-s", os.path.abspath(__file__), "worker"], env=env,
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        ready = self.worker.stdout.readline()
        if '"ready"' not in ready:
            raise RuntimeError("Taligenkänningen startade inte.")
        GLib.io_add_watch(self.worker.stdout, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, self.on_text)
        # The user's own music (Whisper's word list, what "spela …" means): now, then every 6 h –
        # refresh_own_music itself fetches only when the copy is a day old
        self.own_music()
        GLib.timeout_add_seconds(6 * 3600, self.own_music)

    def own_music(self):
        def work():
            try:
                voicecmd().refresh_own_music()
            except Exception as e:  # noqa: BLE001 – no network / not signed in: the old copy stays
                print(f"Musikbiblioteket hämtades inte: {e}", flush=True)
        threading.Thread(target=work, daemon=True).start()
        return True

    def kga(self, method, sig, args, ret=None):
        return self.bus.call_sync("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", method,
                                  self.GLib.Variant(sig, args), self.GLib.VariantType(ret) if ret else None,
                                  0, -1, None)

    def register(self):
        self.kga("doRegister", "(as)", (SHORTCUT,))
        self.kga("setShortcut", "(asaiu)", (SHORTCUT, [KEY_F8], 1), "(ai)")   # IsDefault
        active = self.kga("setShortcut", "(asaiu)", (SHORTCUT, [KEY_F8], 2), "(ai)").unpack()[0]  # SetPresent
        path = self.kga("getComponent", "(s)", (SHORTCUT[0],), "(o)").unpack()[0]
        self.bus.signal_subscribe("org.kde.kglobalaccel", "org.kde.kglobalaccel.Component", None, path,
                                  None, 0, self.on_signal, None)
        return active

    def unregister(self):
        try:
            self.kga("setInactive", "(as)", (SHORTCUT,))
        except Exception:  # noqa: BLE001 – the session may already be gone
            pass

    def on_signal(self, _conn, _sender, _path, _iface, name, params, _data):
        _component, action, _ts = params.unpack()
        if action != SHORTCUT[1]:
            return
        if name == "globalShortcutPressed":
            self.press()
        elif name == "globalShortcutReleased":
            self.release()

    def box(self, state, heard="", answer="", hold=6.0, fallback=""):
        """The box top right; Plasma's OSD (fallback) if the box can't start."""
        msg = json.dumps({"state": state, "heard": heard, "answer": answer, "hold": hold}, ensure_ascii=False)
        for _try in (1, 2):
            if not self.boxproc or self.boxproc.poll() is not None:
                if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
                    break
                try:
                    self.boxproc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "box"],
                                                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
                                                    bufsize=1)
                    if self.boxproc.stdout.readline().strip() != "ready":
                        raise OSError("rutan startade inte")
                except OSError as e:
                    print(f"Rutan: {e}", flush=True)
                    self.boxproc = None
                    break
            try:
                self.boxproc.stdin.write(msg + "\n")
                self.boxproc.stdin.flush()
                return
            except (OSError, ValueError):
                self.boxproc = None
        if fallback:
            osd(fallback)

    def press(self):
        self.follow = False                    # (a waiting "nu eller vänta?" stays – the key may answer it)
        if self.auto:                          # the key during her own listening: the key takes over
            self.stop_follow(cancel=True)
        if self.rec:
            return
        self.hush()
        self.wav = self.tmp / f"{int(time.time() * 1000)}.wav"
        self.rec = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16",
                                     str(self.wav)])
        self.started = time.monotonic()
        discord_mute()
        self.box("listening", fallback="Kakan lyssnar…")
        if os.path.exists(START_SOUND):
            subprocess.Popen(["pw-play", START_SOUND], stderr=subprocess.DEVNULL)
        self.timer = self.GLib.timeout_add_seconds(MAX_HOLD, self.release)

    def release(self):
        if not self.rec:
            return False
        if self.timer:
            self.GLib.source_remove(self.timer)
            self.timer = None
        held = time.monotonic() - self.started
        print(f"F8 hölls {held:.1f} s", flush=True)    # 8 Nov: half a question heard – was the key let go early?
        self.rec.send_signal(signal.SIGINT)
        try:
            self.rec.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.rec.kill()
        self.rec = None
        discord_unmute()
        if held < MIN_HOLD or not self.wav.is_file():
            self.wav.unlink(missing_ok=True)
            self.box("nothing")
            return False
        self.box("thinking")
        self.send({"hear": str(self.wav)})
        return False

    def follow_listen(self):
        """Listens without the key (after the greeting): records until the speech has stopped, then as a release."""
        self.follow = False
        if self.rec or self.auto:
            return False
        self.wav = self.tmp / f"{int(time.time() * 1000)}.wav"
        words = (ASK_NOW_OR_LATER + " Säg Claude eller vänta.") if self.choice else "Jag lyssnar – säg vad du vill."
        self.box("listening", answer=words, fallback="Kakan lyssnar…")
        discord_mute()
        if os.path.exists(START_SOUND):        # the sound first – it must not count as speech
            subprocess.run(["pw-play", START_SOUND], stderr=subprocess.DEVNULL, timeout=3, check=False)
        self.auto = subprocess.Popen(["pw-record", "--raw", "--rate", "16000", "--channels", "1",
                                      "--format", "s16", "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        proc, wav = self.auto, self.wav

        def work():
            import array
            import math
            chunk = 3200                       # 0.1 s
            got, floor, loud, spoke, quiet, n = [], [], 0, False, 0.0, 0
            while True:
                data = proc.stdout.read(chunk)
                if not data:
                    break                      # stopped (the key, or the service closing)
                got.append(data)
                n += 1
                a = array.array("h", data[: len(data) // 2 * 2])
                rms = math.sqrt(sum(x * x for x in a) / max(1, len(a)))
                if n <= 3:                     # the room's own sound sets the bar (a quiet room ~40–110)
                    floor.append(rms)
                    continue
                bar = max(500.0, 4 * (sorted(floor)[len(floor) // 2]))
                loud = loud + 1 if rms > bar else 0
                if loud >= 2:
                    spoke, quiet = True, 0.0
                elif spoke:
                    quiet += 0.1
                t = n * 0.1
                if (spoke and quiet >= FOLLOW_QUIET) or (not spoke and t >= FOLLOW_WAIT) or t >= FOLLOW_MAX:
                    break
            if proc.poll() is None:
                proc.terminate()
            proc.wait()
            if spoke:
                with wave.open(str(wav), "wb") as w:
                    w.setnchannels(1)
                    w.setsampwidth(2)
                    w.setframerate(16000)
                    w.writeframes(b"".join(got))
            print(f"Lyssnade själv {n * 0.1:.1f} s: " + ("tal" if spoke else "inget sagt"), flush=True)
            self.GLib.idle_add(self.follow_done, proc, spoke)
        threading.Thread(target=work, daemon=True).start()
        return False

    def follow_done(self, proc, spoke):
        if self.auto is not proc:              # the key took over meanwhile
            return False
        self.auto = None
        discord_unmute()
        if spoke and self.wav.is_file():
            self.box("thinking")
            self.send({"hear": str(self.wav)})
        elif self.choice:                      # nothing said to "nu eller vänta?": it waits
            question, self.choice = self.choice[0], None
            self.save_for_later(question, "")
        else:
            self.box("nothing")
        return False

    def save_for_later(self, question, heard):
        try:
            saved = json.loads(LATER_FILE.read_text())
        except (OSError, ValueError):
            saved = []
        saved.append({"q": question, "at": time.strftime("%H:%M")})
        LATER_FILE.parent.mkdir(parents=True, exist_ok=True)
        LATER_FILE.write_text(json.dumps(saved, ensure_ascii=False))
        print(f"Sparad till efter spelet: {question}", flush=True)
        self.box("answer", heard, "Okej, det får vänta. När du spelat klart får du frågan i en notis – Skicka eller Släng.", 5,
                 fallback="Det får vänta tills du spelat klart")

    def ask_saved(self):
        """Every 30 s: saved questions and the game closed → a notice with them, Skicka / Släng (8 Nov, the user:
        half a question went to Goblin AI by itself). Nothing is sent before Skicka; closed without a choice =
        they stay, offered again after the next game."""
        if in_game():
            self.offer_due = True
            return True
        if self.offering or not self.offer_due or not LATER_FILE.is_file():
            return True
        try:
            saved = json.loads(LATER_FILE.read_text())
        except (OSError, ValueError):
            saved = []
        if not saved:
            LATER_FILE.unlink(missing_ok=True)
            return True
        self.offer_due, self.offering = False, True
        body = "\n".join(f"• ({s['at']}) {s['q']}" for s in saved)

        def work():
            try:
                chosen = subprocess.run(
                    # -t 0: stays on screen until a button or the cross (the user 8 Nov: "ibland kan man vara upptagen")
                    ["notify-send", "-a", "Goblin AI", "-i", "goblincakes-ai", "-t", "0", "-A", "send=Skicka till Claude",
                     "-A", "drop=Släng", "Kakan: frågor från spelet", body],
                    capture_output=True, text=True, check=False).stdout.strip()
            except OSError:
                chosen = ""
            self.GLib.idle_add(self.saved_chosen, saved, chosen)
        threading.Thread(target=work, daemon=True).start()
        return True

    def saved_chosen(self, saved, chosen):
        self.offering = False
        print(f"Sparade frågor: {chosen or 'stängd utan val – ligger kvar'}", flush=True)
        if chosen == "drop":
            LATER_FILE.unlink(missing_ok=True)
        if chosen != "send":
            return False
        LATER_FILE.unlink(missing_ok=True)
        if len(saved) == 1:
            text = f"Under spelet ({saved[0]['at']}) sa jag: {saved[0]['q']}"
        else:
            text = "Under spelet sa jag det här – ta det i tur och ordning:\n" + "\n".join(
                f"{n}. ({s['at']}) {s['q']}" for n, s in enumerate(saved, 1))
        print(f"{len(saved)} sparade frågor till Goblin AI", flush=True)
        voicecmd().ask_in_window(text)
        return False

    def stop_follow(self, cancel=False):
        proc, self.auto = self.auto, None
        if proc and proc.poll() is None:
            proc.terminate()
        discord_unmute()
        if cancel and self.wav:
            self.wav.unlink(missing_ok=True)

    def after_speech(self, _pid, _status):
        if self.follow:
            self.GLib.timeout_add(300, self.follow_listen)
        return False

    def send(self, job):
        self.worker.stdin.write(json.dumps(job, ensure_ascii=False) + "\n")
        self.worker.stdin.flush()

    def hush(self):
        if self.player and self.player.poll() is None:
            self.player.terminate()
        self.player = None

    def on_text(self, source, condition):
        line = source.readline()
        if not line:
            print("Taligenkänningen stannade.", file=sys.stderr, flush=True)
            self.GLib.MainLoop().quit()
            os._exit(1)        # systemd starts the service again
        try:
            result = json.loads(line)
        except ValueError:
            return True
        if "said" in result:
            if not self.rec:                   # the key pressed again meanwhile = quiet
                self.hush()
                self.player = subprocess.Popen(["pw-play", result["said"]], stderr=subprocess.DEVNULL)
                if self.follow:                # the greeting: listen when she has said it
                    self.GLib.child_watch_add(self.player.pid, self.after_speech)
            elif self.follow:
                self.GLib.timeout_add(300, self.follow_listen)
            return True
        if self.heard(result.get("text") or "", result) != "again":
            Path(result.get("hear") or self.tmp / "-").unlink(missing_ok=True)
        return True

    def heard(self, text, result):
        """A simple command is done at once (voicecmd.py, part C); anything else is shown (part D: Kakan)."""
        print(f"Hörde ({result.get('seconds')} s, säkerhet {result.get('sure')}): {text or '–'}", flush=True)
        if not text:
            self.box("answer", "", "Jag hörde inget.", 3, fallback="Kakan hörde inget")
            return
        fixed = known_words(text)
        if fixed != text:
            print(f"Rättat mot kända ord: {fixed}", flush=True)
            text = fixed
        self.heard_text = text
        if self.choice and time.monotonic() - self.choice[1] < 60:
            question, self.choice = self.choice[0], None
            said = text.lower()
            if DROP_WORDS.search(said):
                print(f"Slängd: {question}", flush=True)
                self.box("answer", text, "Okej, jag glömmer det. Tryck F8 och säg frågan igen.", 5,
                         fallback="Okej, jag glömmer det")
            elif NOW_WORDS.search(said) and not WAIT_WORDS.search(said):
                voicecmd().ask_in_window(question)
                self.box("answer", text, "Claude tittar på det nu – svaret kommer på andra skärmen.", 6,
                         fallback="Claude tittar på det nu")
            else:
                self.save_for_later(question, text)
            return
        self.choice = None
        commands = voicecmd().match_all(text)
        # "lite till" = the last command again (volume, next song), within a minute
        last, when = getattr(self, "last", (None, 0))
        commands = [last if c[0] == "again" else c for c in commands
                    if c[0] != "again" or (last and time.monotonic() - when < 60)]
        if commands:
            self.last = (commands[-1], time.monotonic())
        self.follow = any(c[0] == "greet" for c in commands)
        if not commands and len(text.split()) <= 3 and (ANSWER_ONLY.fullmatch(voicecmd().fix_words(text))):
            # 8 Nov: a lone "Nu!" with no "nu eller vänta?" asked became a question of its own for Claude
            self.box("answer", text, "Jag väntade inte på något svar – tryck F8 och säg frågan igen.", 5,
                     fallback="Kakan väntade inte på något svar")
            return
        if not commands and not result.get("big") and big_installed() and result.get("hear"):
            # A question, not a command: the bigger model hears the same recording once more (7 Nov) – the box shows
            # small's words meanwhile
            self.box("thinking", text)
            self.send({"hear": result["hear"], "big": True, "first": text})
            return "again"
        if not commands:      # not a simple command: Goblin AI with a proper model (the user's decision 5 Nov)
            if in_game():
                # Under spel (7 Nov, the user: "gear planner funkar inte, kolla det" → Haiku starts working): Goblin
                # AI takes it without coming over the game – the answer and any card on the free screen, a notice
                # says so (goblin-ai _show_in_game). She doesn't speak during a game.
                self.choice = (text, time.monotonic())
                self.box("answer", text, ASK_NOW_OR_LATER, 60, fallback=ASK_NOW_OR_LATER)
                self.GLib.timeout_add(1200, self.follow_listen)
                return
            voicecmd().ask_in_window(text)
            self.answer("Jag tar det i Goblin AI.", "Jag tar det i Goblin AI.")
            return
        self.box("thinking", text)
        print(f"Kommandon: {commands}", flush=True)

        def work():
            shown, spoken = [], []
            for command in commands:
                try:
                    sentence, speak_it = voicecmd().run(*command)
                except Exception as e:  # noqa: BLE001 – a broken command must not stop the service
                    sentence, speak_it = f"Det gick inte: {e}", True
                if sentence:
                    shown.append(sentence)
                    if speak_it:
                        spoken.append(speak_it if isinstance(speak_it, str) else sentence)
            self.GLib.idle_add(self.answer, " ".join(shown), " ".join(spoken))
        threading.Thread(target=work, daemon=True).start()

    def answer(self, shown, spoken):
        """shown in the box, spoken read aloud ("" = only shown)."""
        print(f"Svar: {shown}" + (f"  (säger: {spoken})" if spoken and spoken != shown else ""), flush=True)
        if not shown:
            self.box("nothing")
            return False
        # on screen while she speaks and a little after; while she waits for "ja"/a name: the minute
        waiting = time.monotonic() - getattr(voicecmd(), "_asked", 0) < 60
        hold = 60 if waiting else len(spoken or shown) / 12 + 5
        self.box("answer", getattr(self, "heard_text", ""), shown, hold, fallback=shown)
        if spoken and in_game():
            print("Spel igång – bara i rutan, inget läses upp", flush=True)   # the user 5 Nov: don't intrude
            spoken = ""
        if self.follow and not spoken:         # the greeting only shown (a game): listen at once
            self.GLib.timeout_add(1200, self.follow_listen)
        if spoken:
            out = self.tmp / f"say-{int(time.time() * 1000)}.wav"
            self.send({"say": spoken, "voice": voice_for_avatar(), "out": str(out)})
        return False

    def close(self):
        if self.boxproc and self.boxproc.poll() is None:
            self.boxproc.terminate()
        self.hush()
        if self.rec:
            self.rec.kill()
        self.stop_follow()
        discord_unmute()
        self.unregister()
        try:
            self.worker.stdin.close()          # the worker ends its loop and exits by itself
            self.worker.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            self.worker.kill()
        shutil.rmtree(self.tmp, ignore_errors=True)


def cmd_listen():
    discord_unmute()                       # left from a crash while the key was held
    if stale() and not offer_repair():
        return 0                           # not a failure: systemd doesn't start it again (asked at the next login)
    if not installed():
        print("Rösten är inte installerad (goblincakes-voice install).", file=sys.stderr)
        return 1
    from gi.repository import GLib
    listener = Listener()
    active = listener.register()
    print(f"Lyssnar efter röstknappen ({', '.join(hex(k) for k in active) or 'ingen tangent'}).", flush=True)
    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except ImportError:
        add_signal = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_HIGH, sig, loop.quit)
    try:
        loop.run()
    finally:
        listener.close()
    return 0


def main(argv):
    cmd = argv[0] if argv else "status"
    rest = argv[1:]
    commands = {
        "status": lambda: cmd_status(),
        "install": lambda: cmd_install(),
        "uninstall": lambda: cmd_uninstall(),
        "stale": lambda: 0 if stale() else 1,
        "record": lambda: cmd_record(rest),
        "hear": lambda: cmd_hear(rest),
        "test": lambda: cmd_test(rest),
        "say": lambda: cmd_say(rest),
        "listen": lambda: cmd_listen(),
        "worker": lambda: cmd_worker(),
        "box": lambda: cmd_box(),
        "lärt": lambda: cmd_learned("--json" in rest),
        "glöm": lambda: cmd_forget(rest),
    }
    if cmd not in commands:
        print(__doc__, file=sys.stderr)
        return 2
    return commands[cmd]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
