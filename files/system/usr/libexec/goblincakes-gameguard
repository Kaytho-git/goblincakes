#!/usr/bin/python3
"""GOBLINCAKES Spelläge: more of the computer for the game while one runs (22 Oct, the user's wish).

    goblincakes-gameguard run         the user service: looks for a game every second
    goblincakes-gameguard status      on / off (Config → Inställningar → Spel)
    goblincakes-gameguard set on|off  the switch (off = a flag file: the service undoes and only looks)
    goblincakes-gameguard wait        root's update units (ExecStartPre): wait while a game runs

While a game runs (Steam's game wrapper reaper, a Windows game in Wine/Proton, gamescope –
not the launchers themselves):
  - GameMode for the game (gamemoded: the CPU's performance governor, priorities) – without
    gamemoderun in the launch options
  - automatic updates wait: rpm-ostree, Flatpak (system and user) have a drop-in
    ExecStartPre=… wait that waits until the game is closed (never mid-game downloads)
  - Akonadi (the calendar's background service, ~400 MB) and Baloo (file search) rest
  - WoWUp closes while WoW runs (only updates add-ons) and starts again afterwards
  - Battle.net's Agent (its download service) closes a minute after WoW started, when the
    app itself is gone ("Avsluta Battle.net helt"): it stays otherwise and keeps the prefix's
    wineserver – shared with WoW – busier (4 Nov: 4 % → 15 %); the app starts it again
  - Lenovo IdeaPad/Legion: the fans' "efficient thermal dissipation" mode (fan_mode 4, what
    Lenovo's Windows program calls boost), the previous mode back afterwards; only where
    ideapad_laptop has fan_mode (a udev rule makes it writable), switch: fan-boost-off
  - $XDG_RUNTIME_DIR/goblincakes-gaming exists (touched every look): goblin graph and
    GoblinAmp's bars rest, root's wait() sees it
Everything is undone when the game is closed, when Spelläge is switched off and when the service stops.
The only part that looks for games (P5 step 2, 13 Nov): every second – also with Spelläge off – it
writes gaming.GAME_FILE, which the local AI's watcher (goblincakes-ollama, stops also with Spelläge
off), Kakan and Goblin AI read through gaming.game_running(); the full look (GameMode, WoWUp,
Agent) every 3 s while a game runs.
"""
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(os.environ.get("GOBLINCAKES_SHARE") or
                            Path(__file__).resolve().parents[1] / "share/goblincakes")))
from gaming import WOW, find_game, processes, scan_running, write_game_file  # noqa: E402 – one rule for what a game is

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "goblincakes"
OFF = CONFIG / "gameguard-off"
FAN_OFF = CONFIG / "fan-boost-off"
FAN_BOOST = "4"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
STATE = RUNTIME / "goblincakes-gaming"
FRESH = 30          # seconds: an older state file is left over from a crash
LOOK = 3            # seconds between the full looks while a game runs (the quick check is every second)
AGENT_AFTER = 60    # seconds of WoW before Agent closes: the launch login is long done

def log(*a):
    print(*a, flush=True)


GAMEMODE = ("com.feralinteractive.GameMode", "/com/feralinteractive/GameMode", "com.feralinteractive.GameMode")


def gaming_somewhere():
    """Root: a fresh state file of any user (written only while that user's Spelläge is on)."""
    for f in Path("/run/user").glob("*/goblincakes-gaming"):
        try:
            if time.time() - f.stat().st_mtime < FRESH:
                return True
        except OSError:
            pass
    return False


def fan_mode_file():
    """Lenovo's fan modes (ideapad_laptop), or None on other computers."""
    return next(iter(sorted(Path("/sys/bus/platform/devices").glob("VPC2004:*/fan_mode"))), None)


def run(*cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except OSError:
        return []


HIDDEN = Path(os.environ.get("GOBLINCAKES_START_HIDDEN", "/usr/libexec/goblincakes-start-hidden"))


def wowup_starter(pids):
    """How WoWUp is started again: its menu or autostart entry, always with --hidden (to the
    tray – 24 Oct, the user: it came back maximized when it had been opened from the menu;
    goblincakes-start-hidden minimizes it, WowUp 2.24.1 shows it despite --hidden),
    else its autostart unit (Electron's main process moves to a scope of its own, its helpers
    stay in the unit)."""
    home = Path.home()
    for folder in (CONFIG.parent / "autostart", home / ".local/share/applications"):
        for entry in sorted(folder.glob("*.desktop")):
            try:
                text = entry.read_text(errors="replace")
            except OSError:
                continue
            exec_line = re.search(r"^Exec=(.*)$", text, re.M)
            if exec_line and "wowup" in exec_line.group(1).lower():
                argv = [a for a in shlex.split(exec_line.group(1)) if not re.fullmatch(r"%[a-zA-Z]", a)]
                if argv[0].startswith("/tmp/.mount_"):
                    continue  # WowUp's own entry into its old mount – gone
                if HIDDEN.name not in argv[0]:
                    if "--hidden" not in argv:
                        argv.append("--hidden")
                    if HIDDEN.exists():  # WowUp shows its window despite --hidden
                        argv = [str(HIDDEN), "wowupcf", "--", *argv]
                return ("run", argv)
    for pid in pids:
        try:
            cgroup = Path(f"/proc/{pid}/cgroup").read_text().strip()
        except OSError:
            continue
        unit = re.search(r"/(app-[^/]+\.service)$", cgroup)
        if unit:
            return ("unit", unit.group(1))
    return None


# ── What rests during a game ──────────────────────────────────────

class Guard:
    def __init__(self):
        self.game = None          # the pid registered with GameMode
        self.akonadi = False      # we stopped it
        self.baloo = False        # we suspended it
        self.wowup = None         # how to start it again: ("unit", name) or ("run", [argv])
        self.fan = None           # (file, the mode before the game) while we boost
        self.wow_since = None     # when WoW was first seen this time
        self.agent_done = False   # Agent closed once for this WoW – an app opened later keeps it
        self.gone = 0             # looks without a game (two in a row = closed)

    def start(self, pid, procs):
        log(f"Spel startat ({pid}) – Spelläge på")
        self.register(pid)
        r = run("akonadictl", "status")
        if r and "Akonadi Server: running" in (r.stdout + r.stderr):
            run("akonadictl", "stop")
            self.akonadi = True
        r = run("env", "LC_ALL=C", "balooctl6", "status")   # English: "Indexer state: Suspended"
        if r and r.returncode == 0 and "running" in r.stdout.lower() and "suspended" not in r.stdout.lower():
            run("balooctl6", "suspend")
            self.baloo = True
        self.fan_boost()

    def fan_boost(self):
        fan = fan_mode_file()
        if fan is None or FAN_OFF.exists():
            return
        try:
            before = fan.read_text().strip()
            if before != FAN_BOOST:
                fan.write_text(FAN_BOOST)
                self.fan = (fan, before)
                log(f"Fläktboost på (läge {before} → {FAN_BOOST})")
        except OSError as e:
            log("Fläktläget gick inte att ändra:", e)

    def fan_back(self):
        if self.fan:
            fan, before = self.fan
            self.fan = None
            try:
                fan.write_text(before)
                log(f"Fläktläget tillbaka ({before})")
            except OSError as e:
                log("Fläktläget gick inte att sätta tillbaka:", e)

    def register(self, pid):
        r = run("busctl", "--user", "call", *GAMEMODE, "RegisterGameByPID", "ii", str(os.getpid()), str(pid))
        self.game = pid
        if not r or r.returncode != 0:
            log("GameMode svarade inte:", (r.stderr.strip() if r else ""))

    def unregister(self):
        if self.game:
            run("busctl", "--user", "call", *GAMEMODE, "UnregisterGameByPID", "ii",
                str(os.getpid()), str(self.game))
            self.game = None

    def wowup_check(self, procs):
        """WoWUp only updates add-ons: closed while WoW runs, started again afterwards."""
        wow = any(WOW.match(p[1]) for p in procs)
        mine = [p[0] for p in procs if p[1] == "wowup-cf"]
        if wow and self.wowup is None and mine:
            self.wowup = wowup_starter(mine) or ("none", None)
            # The main process (Electron writes its whole command line as one string): SIGINT
            # = WoWUp quits by itself in ~2 s; SIGTERM made it crash (SIGBUS/SIGTRAP, core dump)
            main = [pid for pid in mine if b"--type=" not in b" ".join(cmdline(pid))]
            for pid in main:
                try:
                    os.kill(pid, signal.SIGINT)
                except OSError:
                    pass
            log("WoW kör – WoWUp stängt tills WoW stängs")
        elif not wow and self.wowup is not None:
            self.wowup_back()

    def agent_check(self, procs):
        """Battle.net's Agent left alone after the app exited: closed once per WoW session."""
        if not any(WOW.match(p[1]) for p in procs):
            self.wow_since, self.agent_done = None, False
            return
        now = time.monotonic()
        if self.wow_since is None:
            self.wow_since = now
        if self.agent_done or now - self.wow_since < AGENT_AFTER:
            return
        self.agent_done = True
        if any(p[1].lower().startswith("battle.net") for p in procs):
            return   # the app is open (or the user opened it): it needs its Agent
        agents = [p[0] for p in procs if p[1].lower() == "agent.exe"]
        for pid in agents:
            try:
                os.kill(pid, signal.SIGTERM)   # Wine ends the process on SIGTERM
            except OSError:
                pass
        if agents:
            log("WoW kör – Battle.nets Agent stängd (Battle.net startar den igen)")

    def wowup_back(self):
        kind, what = self.wowup
        self.wowup = None
        if kind == "none":   # closed, but no way to start it again was found
            return
        if kind == "unit":
            r = run("systemctl", "--user", "start", what)
            if r and r.returncode == 0:
                log("WoWUp startat igen")
                return
            log("WoWUp gick inte att starta igen")
        else:
            run("systemd-run", "--user", "--quiet", "--collect", "--", *what)
            log("WoWUp startat igen")

    def stop(self):
        log("Spelet stängt – allt tillbaka")
        self.unregister()
        if self.akonadi:
            run("akonadictl", "start")
            self.akonadi = False
        if self.baloo:
            run("balooctl6", "resume")
            self.baloo = False
        if self.wowup is not None:
            self.wowup_back()
        self.fan_back()
        STATE.unlink(missing_ok=True)

    def active(self):
        return STATE.exists() or self.game or self.akonadi or self.baloo or self.wowup or self.fan

    def look(self, running=True):
        """The full look. running=False (the quick check found no game): no process list needed."""
        procs = processes() if running else []
        pid = find_game(procs) if running else None
        if pid is None:
            if STATE.exists():
                self.gone += 1
                if self.gone >= 2:
                    self.stop()
            return
        self.gone = 0
        if not STATE.exists():
            STATE.write_text(f"{pid}\n")
            self.start(pid, procs)
        else:
            os.utime(STATE)
            if not Path(f"/proc/{self.game}").exists():   # the wrapper gave way to the game
                self.unregister()
                self.register(pid)
        self.wowup_check(procs)
        self.agent_check(procs)


def serve():
    guard = Guard()
    STATE.unlink(missing_ok=True)   # left over from a crash: nothing of ours is paused
    stop = {"now": False}

    def quit_(*_):
        stop["now"] = True
    signal.signal(signal.SIGTERM, quit_)
    signal.signal(signal.SIGINT, quit_)
    tick = 0
    try:
        while not stop["now"]:
            running = scan_running()
            write_game_file(running)
            if OFF.exists():   # Spelläge off: only the answer for the others
                if guard.active():
                    guard.stop()
            elif tick % LOOK == 0 or (running and not STATE.exists()):
                guard.look(running)   # a game that just started is handled at once
            tick += 1
            for _ in range(4):
                if stop["now"]:
                    break
                time.sleep(0.25)
    finally:
        if guard.active():
            guard.stop()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        serve()
    elif cmd == "status":
        print("off" if OFF.exists() else "on")
    elif cmd == "set" and sys.argv[2:3] in (["on"], ["off"]):
        # The service keeps running either way (it looks for the others) and reads the flag every second
        if sys.argv[2] == "on":
            OFF.unlink(missing_ok=True)
        else:
            CONFIG.mkdir(parents=True, exist_ok=True)
            OFF.touch()
        run("systemctl", "--user", "start", "goblincakes-gameguard.service")
    elif cmd == "wait":
        # Root, before an automatic update: never in the middle of a game
        said = False
        while gaming_somewhere():
            if not said:
                log("Ett spel kör – uppdateringen väntar tills det är stängt")
                said = True
            time.sleep(30)
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
