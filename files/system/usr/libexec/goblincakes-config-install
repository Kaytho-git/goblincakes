#!/usr/bin/env bash
# Installs one step for the GOBLINCAKES Config window (goblincakes-config), Program tab.
# Everything is installed for the current user, so no password is needed.
#
#   goblincakes-config-install <step> [args…]     install
#   goblincakes-config-install check <kind> [args…]  exit 0 if already installed
#
# Lines starting with "@@ " are shown in the window as the current status.
set -euo pipefail

status() { echo "@@ $*"; }

appimage_dir="$HOME/AppImages"

flathub_user() {
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
}

github_latest() { # repo → JSON of the newest release
    curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$1/releases/latest"
}

json_asset() { # JSON on stdin, regex → first matching asset "name url"
    python3 -c '
import json, re, sys
pattern = re.compile(sys.argv[1])
for a in json.load(sys.stdin).get("assets", []):
    if pattern.search(a["name"]):
        print(a["name"], a["browser_download_url"])
        break
' "$1"
}

# Menu entry + icon for an AppImage, taken from the desktop file inside it
# (extracting works without FUSE). Same file name every time, so updates replace it.
integrate_appimage() { # file label
    local file=$1 label=$2 id tmp desktop icon_name icon apps icons
    id=appimage-$(echo "$label" | tr '[:upper:] ' '[:lower:]-')
    apps="$HOME/.local/share/applications"
    icons="$HOME/.local/share/icons/hicolor/512x512/apps"
    mkdir -p "$apps" "$icons"
    tmp=$(mktemp -d)
    (cd "$tmp" && "$file" --appimage-extract '*.desktop' >/dev/null 2>&1 || true)
    desktop=$(find "$tmp/squashfs-root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1)
    icon_name=$( [ -n "$desktop" ] && sed -n 's/^Icon=//p' "$desktop" | head -n1 )
    if [ -n "$icon_name" ]; then
        (cd "$tmp" && "$file" --appimage-extract "$icon_name.png" >/dev/null 2>&1 || true
                      "$file" --appimage-extract "usr/share/icons/*" >/dev/null 2>&1 || true
                      "$file" --appimage-extract ".DirIcon" >/dev/null 2>&1 || true)
        # Biggest PNG with the icon's name, else the AppImage's .DirIcon
        icon=$(find "$tmp/squashfs-root" -name "$icon_name.png" -printf '%s %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
        [ -n "$icon" ] || icon=$(readlink -f "$tmp/squashfs-root/.DirIcon" 2>/dev/null || true)
        [ -f "$icon" ] && cp "$icon" "$icons/$id.png"
    fi
    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=$( [ -n "$desktop" ] && sed -n 's/^Name=//p' "$desktop" | head -n1 || true)"
        echo "Comment=$( [ -n "$desktop" ] && sed -n 's/^Comment=//p' "$desktop" | head -n1 || true)"
        echo "Exec=\"$file\" %U"
        echo "TryExec=$file"
        echo "Icon=$( [ -f "$icons/$id.png" ] && echo "$id" || echo application-x-executable)"
        echo "Categories=$( [ -n "$desktop" ] && sed -n 's/^Categories=//p' "$desktop" | head -n1 || echo Game\;)"
        echo "StartupWMClass=$( [ -n "$desktop" ] && sed -n 's/^StartupWMClass=//p' "$desktop" | head -n1 || true)"
        echo "X-GOBLINCAKES-AppImage=$file"
    } > "$apps/$id.desktop"
    sed -i "s/^Name=$/Name=$label/" "$apps/$id.desktop"
    rm -rf "$tmp"
    update-desktop-database "$apps" >/dev/null 2>&1 || true
}

# Vulkan layer as a Flatpak extension (org.freedesktop.Platform.VulkanLayer.<name>), --user,
# for every runtime branch Steam, Lutris and Heroic use (e.g. 24.08 and 25.08)
vulkan_layer() { # name
    local name=$1 app runtime branches=()
    status "Letar efter Lutris och Heroics Flatpak-versioner…"
    for app in net.lutris.Lutris com.heroicgameslauncher.hgl; do
        runtime=$(flatpak info --show-runtime "$app" 2>/dev/null) || continue
        [[ " ${branches[*]} " == *" ${runtime##*/} "* ]] || branches+=("${runtime##*/}")
    done
    [ ${#branches[@]} -gt 0 ] || { status "Hittade varken Lutris eller Heroic – installera något av dem först"; return 1; }
    flathub_user
    for branch in "${branches[@]}"; do
        flatpak info "org.freedesktop.Platform.VulkanLayer.$name//$branch" >/dev/null 2>&1 && continue
        status "Hämtar $name ($branch) från Flathub…"
        flatpak install --user --noninteractive --assumeyes flathub "org.freedesktop.Platform.VulkanLayer.$name//$branch"
    done
}

check() {
    local kind=$1; shift
    case $kind in
        flatpak) flatpak info "$1" >/dev/null 2>&1 ;;
        appimage) [ -x "$appimage_dir/$1.AppImage" ] ;;
        webapp) [ -e "$HOME/.local/share/applications/goblincakes-webapp-$1.desktop" ] ;;
        gamescope-flatpak) flatpak list --columns=application | grep -qx org.freedesktop.Platform.VulkanLayer.gamescope ;;
        # Installed with today's container setup (see layout in goblincakes-ianseo)
        snap) snap list "$1" >/dev/null 2>&1 ;;
        battlenet) compgen -G "$HOME/Games/battlenet*/drive_c" >/dev/null ;;
        ianseo) [ "$(cat "$HOME/.local/share/goblincakes/ianseo/layout" 2>/dev/null)" = 2 ] \
                    && [ -e "$HOME/.local/share/goblincakes/ianseo/www/index.php" ] ;;
        *) return 1 ;;
    esac
}

step=${1:?step}; shift
case $step in
    check)
        check "$@"
        ;;

    flatpak)
        status "Hämtar $1 från Flathub…"
        flathub_user
        flatpak install --user --noninteractive --assumeyes flathub "$1"
        ;;

    gtk-theme)
        # GTK 3 programs from Flathub can't see the system's themes: give the user a copy
        # of the GOBLINCAKES theme and let the app (if given) read it and use it.
        # Without an app: just refresh the copy (goblin update does that).
        themes="${XDG_DATA_HOME:-$HOME/.local/share}/themes"
        mkdir -p "$themes"
        rm -rf "$themes/GoblinCakes"
        cp -r /usr/share/themes/GoblinCakes "$themes/GoblinCakes"
        if [ -n "${1:-}" ]; then
            status "Ger programmet GOBLINCAKES-temat…"
            flatpak override --user --filesystem=xdg-data/themes:ro --env=GTK_THEME=GoblinCakes "$1"
        fi
        ;;

    dock)
        # Pin the app in the dock, unless it is there already
        status "Lägger till i dockan…"
        /usr/libexec/goblincakes-dock pin "$1" >/dev/null 2>&1 \
            || status "Kunde inte lägga till i dockan (programmet är installerat ändå)"
        ;;

    webapp)
        # A website as its own app: the browser's app window (no address bar), its own icon
        # in AppGrid. Streaming services use Google Chrome (the default) because it has
        # Widevine, the DRM they need; others can name another Flatpak browser, e.g.
        # Chromium for Claude (in the image already). Optional 4th argument: menu categories.
        id=$1 name=$2 url=$3 categories=${4:-AudioVideo;Video;Player;} browser=${5:-com.google.Chrome}
        browser_name=$([ "$browser" = com.google.Chrome ] && echo "Google Chrome" || echo Chromium)
        apps="$HOME/.local/share/applications"
        icons="$HOME/.local/share/icons/hicolor/256x256/apps"
        mkdir -p "$apps" "$icons"
        icon=goblincakes-webapp-$id
        status "Hämtar ikonen för $name…"
        host=${url#*://}; host=${host%%/*}
        if ! curl -fsSL -o "$icons/$icon.png" "https://www.google.com/s2/favicons?domain=$host&sz=256" \
            || [ "$(stat -c %s "$icons/$icon.png" 2>/dev/null || echo 0)" -lt 200 ]; then
            rm -f "$icons/$icon.png"
            icon=applications-internet
        fi
        # Chrome names app windows after the address, so the dock groups them under this icon
        cat > "$apps/goblincakes-webapp-$id.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$name
Comment=$name i ett eget fönster ($browser_name)
Exec=flatpak run $browser --app=$url
Icon=$icon
Categories=$categories
StartupWMClass=chrome-${host}__-Default
DESKTOP
        update-desktop-database "$apps" >/dev/null 2>&1 || true
        status "$name finns nu i AppGrid"
        ;;

    gamescope-flatpak)
        # Lutris and Heroic are Flatpaks: they need gamescope as a Flatpak extension
        # (Steam is in the image and uses the image's gamescope)
        vulkan_layer gamescope
        status "Klart – i Lutris/Heroic: spelets inställningar → Gamescope"
        ;;

    vulkan-layer)
        # A Vulkan layer for the game launchers' Flatpak runtimes (gamescope, MangoHud)
        vulkan_layer "$1"
        ;;

    snap)
        # A snap from the Snap Store (snapd is in the image). Outside a terminal snapd
        # answers "access denied" instead of asking for the password (even `snap wait`),
        # so the whole step runs as root through pkexec: one password window from Plasma.
        status "Hämtar $1 från Snap Store – skriv ditt lösenord i fönstret som öppnas…"
        if ! out=$(pkexec /bin/sh -c '
                snap wait system seed.loaded || exit 1
                if snap info --verbose "$1" 2>/dev/null | grep -q "^ *confinement: *classic"; then
                    snap install --classic "$1"
                else
                    snap install "$1"
                fi' sh "$1" 2>&1); then
            echo "$out" >&2
            status "$(echo "$out" | tail -n1)"
            exit 1
        fi
        # Snap's menu entries live in /var/lib/snapd/desktop (in XDG_DATA_DIRS through
        # goblincakes-snap.sh). If that folder didn't exist at login, Plasma never noticed
        # it – rebuild its app list so the program shows up in AppGrid right away.
        kbuildsycoca6 >/dev/null 2>&1 || true
        ;;

    default-browser)
        # After installing: make it the main browser (the switch under the browser in Config)
        status "Sätter som huvudwebbläsare…"
        /usr/libexec/goblincakes-browser set "$1" >/dev/null
        status "Huvudwebbläsare"
        ;;

    battlenet)
        # Lutris' own Battle.net installer (GE-Proton, with everything Battle.net needs
        # installed inside the Wine prefix). Lutris opens and asks a few questions.
        status "Öppnar Battle.net-installationen i Lutris…"
        (setsid flatpak run net.lutris.Lutris lutris:battlenet-standard >/dev/null 2>&1 &)
        status "Följ Lutris – installera sedan WoW i Battle.net. Mapparna Logs och AddOns dyker upp i ~/Games/WoW"
        ;;

    ge-proton)
        # Newest GE-Proton straight into Steam (in the image; also a Flatpak Steam if there is one)
        status "Letar efter senaste GE-Proton…"
        release=$(github_latest GloriousEggroll/proton-ge-custom)
        # Not the ARM builds (GE-Proton…-aarch64), they don't run on a normal PC
        read -r name url < <(echo "$release" | json_asset '^(?!.*(aarch64|arm64)).*\.tar\.gz$')
        read -r _ sumurl < <(echo "$release" | json_asset '^(?!.*(aarch64|arm64)).*\.sha512sum$') || true
        version=${name%.tar.gz}
        targets=("$HOME/.local/share/Steam/compatibilitytools.d")
        [ -d "$HOME/.var/app/com.valvesoftware.Steam" ] \
            && targets+=("$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d")
        # ARM builds fetched by mistake before (7 Oct): they don't run here, away with them
        for t in "${targets[@]}"; do
            rm -rf "$t"/GE-Proton*-aarch64 "$t"/GE-Proton*-arm64
        done
        if [ -d "${targets[0]}/$version" ]; then
            status "$version finns redan"
            exit 0
        fi
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        status "Hämtar $version…"
        curl -fL --progress-bar -o "$tmp/$name" "$url"
        if [ -n "${sumurl:-}" ]; then
            status "Kontrollerar $version…"
            (cd "$tmp" && curl -fsSL "$sumurl" | sha512sum -c -)
        fi
        for t in "${targets[@]}"; do
            status "Packar upp $version…"
            mkdir -p "$t"
            tar -xzf "$tmp/$name" -C "$t"
        done
        status "$version klar – välj den i Steam under Kompatibilitet"
        ;;

    appimage-github)
        # repo, name → newest x86_64 AppImage in ~/AppImages, added to AppGrid with its own name and icon
        repo=$1 label=$2
        status "Letar efter senaste $label…"
        read -r name url < <(github_latest "$repo" | json_asset '^(?!.*(arm64|aarch64|armv7)).*\.AppImage$')
        mkdir -p "$appimage_dir"
        file="$appimage_dir/$label.AppImage"
        # The download URL contains the version: same URL as last time = already the newest
        release_file="$appimage_dir/.$label.release"
        if [ -x "$file" ] && [ "$(cat "$release_file" 2>/dev/null)" = "$url" ]; then
            status "$label är redan senaste versionen"
            exit 0
        fi
        status "Hämtar $name…"
        curl -fL --progress-bar -o "$file.part" "$url"
        mv "$file.part" "$file"
        chmod +x "$file"
        status "Lägger till $label i AppGrid…"
        integrate_appimage "$file" "$label"
        echo "$url" > "$release_file"
        status "$label installerad (${name})"
        ;;

    open-url)
        status "Öppnar nedladdningssidan…"
        xdg-open "$1" >/dev/null 2>&1 &
        status "Ladda ner Linux-versionen (AppImage) och öppna den med Gear Lever"
        ;;

    ianseo)
        exec /usr/libexec/goblincakes-ianseo install
        ;;

    *)
        echo "Unknown step: $step" >&2
        exit 2
        ;;
esac
