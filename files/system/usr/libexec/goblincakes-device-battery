#!/usr/bin/python3
"""GOBLINCAKES: the battery of wireless mice, keyboards and headsets, for "Spelas nu" in the top bar.

    goblincakes-device-battery  one JSON line: [{"kind": "mouse"|"keyboard"|"headset"|…,
                                "name", "percent", "charging"}, …]

Read from UPower (`upower -d`), the same place Plasma's battery applet looks – Logitech's receivers
(hidpp) and Bluetooth devices land there by themselves. The computer's own battery and the
power cable are left out (power supply: yes). An empty list = nothing wireless with a battery.

A Logitech mouse charging on its cable is a plain USB device: the kernel shows no battery for it then and it
vanished from the top bar (30 Oct, G502 X PLUS). Then the mouse itself is asked over HID++ (hidraw, readable
without root): the Unified Battery feature 0x1004 gives percent and charging.

Logitech's estimate sags right after a full charge: 100 % on the cable, 91 % once unplugged (31 Oct) –
the battery is full but its resting voltage is lower. The first reading after a full charge is kept as the
top in ~/.cache/goblincakes/device-battery.json and top…50 is stretched to 100…50; below 50 the device's own
number is shown, so the widget's colours (green ≥ 50, orange, red ≤ 10) change at the real levels.
"""
import json
import os
import re
import select
import subprocess
import time
from pathlib import Path

# UPower's device types that are things in your hand or on your head
KINDS = {"mouse", "keyboard", "headset", "headphones", "gaming-input", "touchpad",
         "pen", "tablet", "speakers", "remote control"}
# Devices that only know a level, not a percentage (some Logitech mice)
LEVELS = {"full": 100, "high": 80, "normal": 55, "low": 20, "critical": 5}
STATE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "goblincakes/device-battery.json"
FLOOR = 50  # below this the device's own percent is shown (the green/orange line)
# Logitech interfaces that didn't answer HID++ (each costs 0.5 s – 1.6 s per round on her laptop with a
# G502, a PRO X and a receiver, P7.6): not asked again until plugged in anew (a new HID instance in
# /sys, e.g. 0003:046D:C08B.0005 → .0006) or after ASK_AGAIN s, in case one was only busy
SILENT = STATE.with_name("device-battery-silent.json")
ASK_AGAIN = 600


def _hidpp(fd, feature, function, params=b""):
    """One HID++ 2.0 long request to a device on its own cable (index 0xFF) – the answer, or None."""
    try:
        os.write(fd, (bytes([0x11, 0xFF, feature, (function << 4) | 0x0A]) + params).ljust(20, b"\0"))
    except OSError:  # the mouse's other interfaces don't take HID++
        return None
    end = time.monotonic() + 0.5
    while time.monotonic() < end:
        if not select.select([fd], [], [], 0.1)[0]:
            continue
        got = os.read(fd, 64)
        if len(got) >= 7 and got[0] == 0x11 and got[1] == 0xFF and got[2] in (feature, 0x8F) and got[3] & 0x0F == 0x0A:
            return None if got[2] == 0x8F else got
    return None


def wired_logitech():
    """Logitech mice/keyboards on their cable: [{kind, name, percent, charging}] read over HID++."""
    found = []
    try:
        silent = json.loads(SILENT.read_text())
    except (OSError, ValueError):
        silent = {}
    now = time.time()
    still = {}
    for raw in sorted(Path("/sys/class/hidraw").glob("hidraw*")):
        try:
            uevent = (raw / "device/uevent").read_text()
            instance = os.path.basename(os.path.realpath(raw / "device"))
        except OSError:
            continue
        if ":0000046D:" not in uevent.upper() or "HID_NAME=" not in uevent:
            continue
        name = re.search(r"HID_NAME=(.*)", uevent).group(1).strip()
        if any(d["name"] == name for d in found):
            continue
        key = f"{raw.name} {instance}"
        if key in silent and now - silent[key] < ASK_AGAIN:
            still[key] = silent[key]
            continue
        try:
            fd = os.open(f"/dev/{raw.name}", os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            index = _hidpp(fd, 0x00, 0, (0x1004).to_bytes(2, "big"))  # where Unified Battery is
            status = _hidpp(fd, index[4], 1) if index and index[4] else None
        finally:
            os.close(fd)
        if not status:
            still[key] = now
        if status:
            # state of charge, level, charging status (1/2 = charging, 3 = full), external power
            found.append({"kind": "keyboard" if "keyboard" in name.lower() else "mouse",
                          "name": re.sub(r"^Logitech\s+", "", name), "percent": status[4],
                          "charging": status[6] in (1, 2, 3), "full": status[6] == 3})
    # Only the interfaces still plugged in are kept
    if still != silent:
        try:
            SILENT.parent.mkdir(parents=True, exist_ok=True)
            SILENT.write_text(json.dumps(still))
        except OSError:
            pass
    return found


def compensate(devices):
    """Stretch the sag after a full charge: the first reading off the charger counts as 100 % (see top)."""
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    before = dict(state)
    for d in devices:
        key = re.sub(r"^Logitech\s+", "", d["name"])  # the cable and the receiver name it differently
        full = d.pop("full", False) or d["percent"] >= 100
        if d["charging"]:
            state[key] = {"full": full}
            continue
        seen = state.get(key, {})
        if seen.get("full") and not seen.get("top"):
            seen = state[key] = {"full": True, "top": d["percent"]}
        top = seen.get("top")
        if top and FLOOR < d["percent"] <= top < 100:
            d["percent"] = min(100, round(FLOOR + (d["percent"] - FLOOR) * (100 - FLOOR) / (top - FLOOR)))
        elif top and top < d["percent"]:
            state[key] = {"full": True, "top": min(d["percent"], 100)}
    if state != before:
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(json.dumps(state))
        except OSError:
            pass
    return devices


def main():
    try:
        dump = subprocess.run(["upower", "-d"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        dump = ""
    devices = []
    for block in dump.split("\nDevice: "):
        lines = [line.strip() for line in block.splitlines()]
        info = {}
        kind = ""
        for line in lines:
            if ":" in line:
                key, _, value = line.partition(":")
                info[key.strip()] = value.strip()
            elif line in KINDS:
                kind = line
        if not kind or info.get("power supply") != "no" or info.get("present", "yes") != "yes":
            continue
        percent = None
        match = re.match(r"(\d+(?:[.,]\d+)?)%", info.get("percentage", ""))
        if match and "ignored" not in info.get("percentage", ""):
            percent = round(float(match.group(1).replace(",", ".")))
        elif info.get("battery-level") in LEVELS:
            percent = LEVELS[info["battery-level"]]
        if percent is None:
            continue
        devices.append({
            "kind": kind,
            "name": info.get("model") or kind,
            "percent": percent,
            "charging": info.get("state") in ("charging", "fully-charged"),
            "full": info.get("state") == "fully-charged",
        })
    if not any(d["kind"] in ("mouse", "keyboard") for d in devices):
        devices += wired_logitech()
    print(json.dumps(compensate(devices), ensure_ascii=False))


if __name__ == "__main__":
    main()
