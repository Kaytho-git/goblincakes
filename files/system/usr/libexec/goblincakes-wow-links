#!/usr/bin/python3
"""GOBLINCAKES: every installed WoW version linked under ~/Games/WoW, where it really is.

  ~/Games/WoW/World of Warcraft   → the WoW folder itself
  ~/Games/World of Warcraft       → the same, where Raider.IO looks by itself on its first start
  ~/Games/WoW/<Version>/Logs      → that version's Logs (combat logs)
  ~/Games/WoW/<Version>/AddOns    → that version's Interface/AddOns
  Versions: Retail, Classic, Classic Era, Anniversary, PTR, XPTR, Beta, Classic PTR …

WoW is looked for in every Wine prefix (Lutris, ~/.wine, Steam), on the other disks the
prefixes reach through drive letters (D:, E: …) and on the mounted disks; the links follow
WoW if it moves. WowUp, Raider.IO and Archon are told about every version too (WowUp and
Raider.IO in their settings files, Archon in its browser storage), so their version list
stays right. Runs at every login and as `goblin wow` (--verbose).

Text to speech (10 Oct, the user's wish – WoW's read-aloud chat): Proton 9+ speaks with Piper
voices from Steam's tool "Proton Voice Files" (appid 3086180, one English model with 904
speakers), but only puts two of them in the prefix (ProtonTTS_libritts-r_3 / _14). Ten more
speakers are added as SAPI voices (GOBLINCAKES_TTS_*) in every prefix that has Proton's voices,
only while nothing runs in that prefix. Picked by measuring all 904: normal speaking pace, the
same pitch in two sentences, five male (100–140 Hz) and five female (174–231 Hz).
"""
import fcntl
import json
import os
import struct
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
LINKS = HOME / "Games" / "WoW"
VERBOSE = "--verbose" in sys.argv

# WoW's own folder per version → (name here, WowUp's client type number)
FLAVORS = {
    "_retail_": ("Retail", 0),
    "_classic_": ("Classic", 1),
    "_ptr_": ("PTR", 2),
    "_classic_ptr_": ("Classic PTR", 3),
    "_beta_": ("Beta", 4),
    "_classic_beta_": ("Classic Beta", 5),
    "_classic_era_": ("Classic Era", 6),
    "_classic_era_ptr_": ("Classic Era PTR", 7),
    "_xptr_": ("XPTR", 8),
    "_anniversary_": ("Anniversary", 9),
}
MAX_DEPTH = 6


def say(*args):
    if VERBOSE:
        print(*args)


def search_roots():
    prefixes = []
    for pattern in ("Games/*", ".wine", ".local/share/wineprefixes/*",
                    ".local/share/Steam/steamapps/compatdata/*/pfx",
                    ".var/app/net.lutris.Lutris/data/lutris/prefixes/*"):
        prefixes += [p for p in HOME.glob(pattern) if (p / "drive_c").is_dir()]
    roots = []
    for p in prefixes:
        roots.append(p / "drive_c")
        # Other disks that Battle.net reaches through Wine drive letters
        for d in sorted((p / "dosdevices").glob("[d-z]:")):
            target = d.resolve()
            if target.is_dir() and target != Path("/"):
                roots.append(target)
    user = os.environ.get("USER") or HOME.name
    for base in (Path("/run/media") / user, Path("/var/mnt"), Path("/mnt")):
        if base.is_dir():
            roots += [m for m in base.iterdir() if m.is_dir()]
    return roots


def find_versions(roots):
    """{folder name: (folder, exe, mtime)} – the most recently played copy of each version."""
    found = {}
    seen = set()
    for root in roots:
        base_depth = len(root.parts)
        for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
            here = Path(dirpath)
            if len(here.parts) - base_depth >= MAX_DEPTH or here.name == "dosdevices":
                dirnames[:] = []
            # Wine's own Windows folder is big and never has WoW in it
            dirnames[:] = [d for d in dirnames if d.lower() not in ("windows", "dosdevices")]
            real = os.path.realpath(dirpath)
            if real in seen:
                dirnames[:] = []
                continue
            seen.add(real)
            flavor = here.name.lower()
            if flavor not in FLAVORS:
                continue
            dirnames[:] = []  # nothing more to find inside a WoW version
            exes = [f for f in filenames if f.lower().startswith("wow") and f.lower().endswith(".exe")]
            if not exes:
                continue
            exe = here / exes[0]
            mtime = exe.stat().st_mtime
            if flavor not in found or mtime > found[flavor][2]:
                found[flavor] = (here, exe, mtime)
    return found


def link(path: Path, target: Path):
    """Our symlink only – a real file or folder is never touched."""
    if path.is_symlink():
        if os.readlink(path) == str(target):
            return
        path.unlink()
    elif path.exists():
        say(f"  {path} är en riktig mapp – lämnar den orörd.")
        return
    path.symlink_to(target)


def update_links(found):
    LINKS.mkdir(parents=True, exist_ok=True)
    # From the first version of this script: Logs/AddOns straight under ~/Games/WoW
    for old in ("Logs", "AddOns"):
        if (LINKS / old).is_symlink():
            (LINKS / old).unlink()
    for flavor, (folder, _exe, _mtime) in found.items():
        name = FLAVORS[flavor][0]
        (folder / "Logs").mkdir(exist_ok=True)
        (folder / "Interface" / "AddOns").mkdir(parents=True, exist_ok=True)
        (LINKS / name).mkdir(exist_ok=True)
        link(LINKS / name / "Logs", folder / "Logs")
        link(LINKS / name / "AddOns", folder / "Interface" / "AddOns")
    # The WoW folder itself: where Retail is, else the most recently played version
    main = found.get("_retail_") or max(found.values(), key=lambda v: v[2])
    link(LINKS / "World of Warcraft", main[0].parent)
    # Links to versions that are gone (uninstalled) are cleaned up
    for name in [v[0] for v in FLAVORS.values()]:
        for sub in ("Logs", "AddOns"):
            p = LINKS / name / sub
            if p.is_symlink() and not p.exists():
                p.unlink()
        if (LINKS / name).is_dir() and not (LINKS / name).is_symlink() and not any((LINKS / name).iterdir()):
            (LINKS / name).rmdir()
    return main[0].parent


def update_wowup(found):
    """WowUp keeps its WoW versions in its settings file; add new ones, follow moved ones."""
    files = [p for p in (HOME / ".config" / d / "preferences.json"
                         for d in ("WowUpCf", "WowUp", "wowup-cf", "wowup")) if p.is_file()]
    if not files:
        return
    running = subprocess.run(["pgrep", "-i", "^wowup"], capture_output=True).returncode == 0
    if running:
        say("WowUp är igång – stäng den och kör goblin wow igen, så får den alla WoW-versioner.")
        return
    for prefs in files:
        try:
            data = json.loads(prefs.read_text())
        except (OSError, ValueError):
            continue
        installs = data.get("wow_installations") or []
        changed = False
        for flavor, (_folder, exe, _mtime) in found.items():
            name, client_type = FLAVORS[flavor]
            same_type = [i for i in installs if i.get("clientType") == client_type]
            if any(os.path.realpath(i.get("location", "")) == os.path.realpath(exe) for i in same_type):
                continue
            moved = [i for i in same_type if not os.path.exists(i.get("location", ""))]
            if moved:
                moved[0]["location"] = str(exe)
            else:
                installs.append({
                    "id": str(uuid.uuid4()),
                    "clientType": client_type,
                    "defaultAddonChannelType": 0,
                    "defaultAutoUpdate": False,
                    "label": "{defaultName}" + (f" {len(same_type) + 1}" if same_type else ""),
                    "displayName": name,
                    "location": str(exe),
                    "selected": False,
                })
            changed = True
        if changed:
            data["wow_installations"] = installs
            tmp = prefs.with_suffix(".json.goblincakes")
            tmp.write_text(json.dumps(data, indent="\t"))
            tmp.replace(prefs)
            say("WowUp: WoW-versionerna är uppdaterade.")


# Raider.IO's own name for each WoW version (from its code: folderNames in index.cjs)
RAIDERIO_GAMES = {"wowretail": "_retail_", "wowclassic": "_classic_",
                  "wowera": "_classic_era_", "wowforever": "_classic_beta_"}


def update_raiderio(found, wow_folder):
    """Raider.IO (closed source, but its Electron code is readable): settings in
    ~/.config/RaiderIO/config.json, gameConfigs.<game>.wowFolder = the version folder
    (_retail_ …), valid only with a WTF folder in it. Filled in when empty or gone –
    a folder the user picked stays. Before its first start it finds WoW by itself in
    ~/Games/World of Warcraft (detectWowFolder), so that link is made too."""
    link(HOME / "Games" / "World of Warcraft", wow_folder)
    files = [p for p in (HOME / ".config" / d / "config.json" for d in ("RaiderIO", "raiderio-client"))
             if p.is_file()]
    if not files:
        return
    if subprocess.run(["pgrep", "-i", "^raiderio"], capture_output=True).returncode == 0:
        say("Raider.IO är igång – stäng den och kör goblin wow igen, så hittar den WoW.")
        return
    for config in files:
        try:
            data = json.loads(config.read_text())
        except (OSError, ValueError):
            continue
        games = data.get("gameConfigs")
        if not isinstance(games, dict):
            continue
        changed = False
        for game, flavor in RAIDERIO_GAMES.items():
            if flavor not in found or not isinstance(games.get(game), dict):
                continue
            current = games[game].get("wowFolder") or ""
            if current and (Path(current) / "WTF").is_dir():
                continue  # already a working WoW folder – the user's choice stays
            folder = found[flavor][0]
            (folder / "WTF").mkdir(exist_ok=True)  # Raider.IO only accepts a folder with WTF
            games[game]["wowFolder"] = str(folder)
            changed = True
        if changed:
            tmp = config.with_suffix(".json.goblincakes")
            tmp.write_text(json.dumps(data, indent=2))
            tmp.replace(config)
            say("Raider.IO: WoW-mappen är inlagd.")


# Archon's own id for each WoW version → its folder (from its code: getGameDirectoryPath in app.js)
ARCHON_VERSIONS = {"live": "_retail_", "live-ptr": "_ptr_", "live-xptr": "_xptr_",
                   "live-beta": "_beta_", "classic": "_classic_", "classic-ptr": "_classic_ptr_",
                   "classic-fresh": "_anniversary_", "classic-sod": "_classic_era_",
                   "vanilla": "_classic_era_", "classic-sod-ptr": "_classic_era_ptr_",
                   "vanilla-ptr": "_classic_era_ptr_"}
ARCHON_DB = Path(os.environ.get("GOBLINCAKES_ARCHON_DB")
                 or HOME / ".config" / "Archon App" / "Local Storage" / "leveldb")
ARCHON_KEY = b"_file://\x00\x01"  # Chromium localStorage: origin, then the key in Latin-1


def _crc32c(data: bytes):
    crc = 0xFFFFFFFF
    for b in data:
        crc ^= b
        for _ in range(8):
            crc = (crc >> 1) ^ (0x82F63B78 if crc & 1 else 0)
    return crc ^ 0xFFFFFFFF


def _varint(buf, pos):
    shift = result = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if b < 0x80:
            return result, pos
        shift += 7


def _put_varint(n):
    out = bytearray()
    while n >= 0x80:
        out.append(n & 0x7F | 0x80)
        n >>= 7
    out.append(n)
    return bytes(out)


def _log_records(data: bytes):
    """LevelDB's log format: 32 KiB blocks of fragments (crc, length, type FULL/FIRST/MIDDLE/LAST)."""
    pos, parts = 0, b""
    while pos + 7 <= len(data):
        left = 32768 - pos % 32768
        if left < 7:
            pos += left
            continue
        length, kind = struct.unpack_from("<HB", data, pos + 4)
        frag = data[pos + 7:pos + 7 + length]
        pos += 7 + length
        if kind == 0:  # zeroed tail of a block
            continue
        parts = frag if kind in (1, 2) else parts + frag
        if kind in (1, 4):
            yield parts
            parts = b""


def _snappy(data: bytes):
    length, pos = _varint(data, 0)
    out = bytearray()
    while pos < len(data):
        tag = data[pos]
        pos += 1
        kind = tag & 3
        if kind == 0:
            n = tag >> 2
            if n >= 60:
                extra = n - 59
                n = int.from_bytes(data[pos:pos + extra], "little")
                pos += extra
            out += data[pos:pos + n + 1]
            pos += n + 1
            continue
        if kind == 1:
            n, off = 4 + (tag >> 2 & 7), (tag >> 5) << 8 | data[pos]
            pos += 1
        else:
            size = 2 if kind == 2 else 4
            n, off = (tag >> 2) + 1, int.from_bytes(data[pos:pos + size], "little")
            pos += size
        for _ in range(n):
            out.append(out[-off])
    return bytes(out[:length])


def _table_entries(data: bytes):
    """(internal key, value) of every entry in an .ldb/.sst table."""
    def block(offset, size):
        raw = data[offset:offset + size]
        raw = _snappy(raw) if data[offset + size] == 1 else raw
        restarts = struct.unpack_from("<I", raw, len(raw) - 4)[0]
        end, pos, key = len(raw) - 4 - 4 * restarts, 0, b""
        while pos < end:
            shared, pos = _varint(raw, pos)
            unshared, pos = _varint(raw, pos)
            vlen, pos = _varint(raw, pos)
            key = key[:shared] + raw[pos:pos + unshared]
            pos += unshared
            yield key, raw[pos:pos + vlen]
            pos += vlen
    footer = data[-48:]
    _meta_off, p = _varint(footer, 0)
    _meta_size, p = _varint(footer, p)
    index_off, p = _varint(footer, p)
    index_size, p = _varint(footer, p)
    for _key, handle in block(index_off, index_size):
        off, p = _varint(handle, 0)
        size, p = _varint(handle, p)
        yield from block(off, size)


def _manifest_sequence(rec: bytes):
    """The last sequence number in one VersionEdit of LevelDB's MANIFEST (tag 4), or 0."""
    pos, top = 0, 0
    while pos < len(rec):
        tag, pos = _varint(rec, pos)
        if tag in (2, 3, 4, 9):  # log number, next file, last sequence, previous log
            n, pos = _varint(rec, pos)
            if tag == 4:
                top = n
        elif tag == 1:  # comparator name
            n, pos = _varint(rec, pos)
            pos += n
        elif tag == 5:  # compact pointer
            _, pos = _varint(rec, pos)
            n, pos = _varint(rec, pos)
            pos += n
        elif tag == 6:  # deleted file
            _, pos = _varint(rec, pos)
            _, pos = _varint(rec, pos)
        elif tag == 7:  # new file: level, number, size, smallest, largest
            for _ in range(3):
                _, pos = _varint(rec, pos)
            for _ in range(2):
                n, pos = _varint(rec, pos)
                pos += n
        else:
            break
    return top


def _archon_values(db: Path):
    """({localStorage key: (sequence, value or None)} – the newest of each, the highest sequence)."""
    newest, top = {}, 0

    def seen(key, seq, value):
        if key.startswith(ARCHON_KEY) and seq >= newest.get(key, (-1,))[0]:
            newest[key] = (seq, value)

    for table in list(db.glob("*.ldb")) + list(db.glob("*.sst")):
        for ikey, value in _table_entries(table.read_bytes()):
            tag = int.from_bytes(ikey[-8:], "little")
            top = max(top, tag >> 8)
            seen(ikey[:-8], tag >> 8, value if tag & 0xFF == 1 else None)
    for manifest in db.glob("MANIFEST-*"):
        for rec in _log_records(manifest.read_bytes()):
            top = max(top, _manifest_sequence(rec))
    for log in db.glob("*.log"):
        for rec in _log_records(log.read_bytes()):
            seq, count = struct.unpack_from("<QI", rec)
            pos = 12
            for i in range(count):
                kind = rec[pos]
                klen, pos = _varint(rec, pos + 1)
                key = rec[pos:pos + klen]
                pos += klen
                value = None
                if kind == 1:
                    vlen, pos = _varint(rec, pos)
                    value = rec[pos:pos + vlen]
                    pos += vlen
                seen(key, seq + i, value)
            top = max(top, seq + count - 1)
    return newest, top


def _archon_text(value):
    """A localStorage value: 1 + Latin-1 or 0 + UTF-16; Archon's are JSON."""
    if not value:
        return None
    try:
        return json.loads(value[1:].decode("latin-1" if value[0] == 1 else "utf-16-le"))
    except ValueError:
        return None


def _archon_encode(obj):
    text = json.dumps(obj, ensure_ascii=False)
    try:
        return b"\x01" + text.encode("latin-1")
    except UnicodeEncodeError:
        return b"\x00" + text.encode("utf-16-le")


def _log_append(log: Path, batch: bytes):
    """One write batch as a record at the end of a LevelDB log, split at its 32 KiB blocks."""
    with open(log, "ab") as f:
        pos, out, first = f.tell(), b"", True
        while True:
            left = 32768 - pos % 32768
            if left < 7:  # too little room for a header: the block ends in zeros
                out += b"\0" * left
                pos += left
                continue
            frag, batch = batch[:left - 7], batch[left - 7:]
            kind = (1 if not batch else 2) if first else (4 if not batch else 3)
            crc = _crc32c(bytes([kind]) + frag)
            crc = (((crc >> 15) | (crc << 17)) + 0xA282EAD8) & 0xFFFFFFFF  # LevelDB's masked crc
            out += struct.pack("<IHB", crc, len(frag), kind) + frag
            pos += 7 + len(frag)
            first = False
            if not batch:
                break
        f.write(out)


def update_archon(found):
    """Archon (Warcraft Logs, closed source – its Electron code is readable) keeps its folders in
    its browser storage (Chromium localStorage = LevelDB in ~/.config/Archon App/Local Storage),
    not in a file, and finds WoW by itself only on Windows/macOS. Per version:
    warcraft-<version>-gameDirectoryPath = the version folder (_retail_ …) and
    warcraft-<version>-liveLogDirectoryPath = its Logs (Archon looks for the log there, not
    under the game folder), both JSON strings. Filled in when empty or gone – a folder the
    user picked stays. Written as one LevelDB batch at the end of its log, only while Archon
    isn't running (LevelDB's LOCK file is free); Archon reads the log back when it starts."""
    if not (ARCHON_DB / "CURRENT").is_file():
        return  # Archon has never started
    logs = sorted(ARCHON_DB.glob("*.log"), key=lambda p: int(p.stem) if p.stem.isdigit() else -1)
    if not logs:
        return
    try:
        lock = open(ARCHON_DB / "LOCK", "a")
    except OSError:
        return
    with lock:
        try:
            fcntl.lockf(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("Archon är igång – stäng den och kör goblin wow igen, så hittar den WoW.")
            return
        try:
            values, seq = _archon_values(ARCHON_DB)
        except (OSError, IndexError, struct.error) as e:
            say(f"Archon: kunde inte läsa inställningarna ({e}) – lämnar dem orörda.")
            return
        writes = []
        for version, flavor in ARCHON_VERSIONS.items():
            if flavor not in found:
                continue
            folder = found[flavor][0]
            for setting, path in (("gameDirectoryPath", folder), ("liveLogDirectoryPath", folder / "Logs")):
                key = ARCHON_KEY + f"warcraft-{version}-{setting}".encode()
                current = _archon_text(values.get(key, (0, None))[1])
                if isinstance(current, str) and current and Path(current).is_dir():
                    continue  # already a working folder – the user's choice stays
                writes.append((key, _archon_encode(str(path))))
        if not writes:
            return
        batch = struct.pack("<QI", seq + 1, len(writes))
        for key, value in writes:
            batch += b"\x01" + _put_varint(len(key)) + key + _put_varint(len(value)) + value
        _log_append(logs[-1], batch)
        say("Archon: WoW-mappen är inlagd.")


# (speaker id, gender, name) – speakers of en_US-libritts_r-medium, lowest voice first
TTS_VOICES = [(841, "Male", "Male 1"), (369, "Male", "Male 2"), (256, "Male", "Male 3"),
              (883, "Male", "Male 4"), (291, "Male", "Male 5"),
              (430, "Female", "Female 1"), (366, "Female", "Female 2"), (12, "Female", "Female 3"),
              (211, "Female", "Female 4"), (513, "Female", "Female 5")]


def prefix_in_use(pfx: Path):
    """True when a Wine program runs in this prefix (its registry is then Wine's to write)."""
    marks = [f"WINEPREFIX={pfx}".encode(), f"STEAM_COMPAT_DATA_PATH={pfx.parent}".encode()]
    for env in Path("/proc").glob("[0-9]*/environ"):
        try:
            data = env.read_bytes()
        except OSError:
            continue
        if any(m + b"\0" in data or m + b"/\0" in data for m in marks):
            return True
    return False


def add_tts_voices():
    """The ten extra Proton voices in every prefix that has Proton's own; returns how many got them."""
    prefixes = set()
    for pattern in ("Games/*", ".wine", ".local/share/wineprefixes/*",
                    ".local/share/Steam/steamapps/compatdata/*/pfx",
                    ".var/app/net.lutris.Lutris/data/lutris/prefixes/*"):
        prefixes.update(p.resolve() for p in HOME.glob(pattern) if (p / "system.reg").is_file())
    added = 0
    for pfx in sorted(prefixes):
        reg = pfx / "system.reg"
        try:
            text = reg.read_text(encoding="utf-8", errors="surrogateescape")
        except OSError:
            continue
        template = "\n[Software\\\\Microsoft\\\\Speech\\\\Voices\\\\Tokens\\\\ProtonTTS_libritts-r_3]"
        if template not in text or "GOBLINCAKES_TTS_" in text:
            continue
        if prefix_in_use(pfx):
            say(f"Text till tal: {pfx} används just nu – stäng spelet och kör goblin wow igen.")
            continue
        clsid = "{52808AE1-D977-4CD8-92D2-FEACB92FE276}"  # Proton's TTS engine (protontts)
        now = int(time.time())
        lines = []
        for root in ("Speech", "Speech_OneCore"):
            for sid, gender, name in TTS_VOICES:
                key = f"Software\\\\Microsoft\\\\{root}\\\\Voices\\\\Tokens\\\\GOBLINCAKES_TTS_{sid}"
                title = f"GOBLINCAKES Voice - {name}"
                lines += [f"[{key}] {now}", f'@="{title}"', f'"409"="{title}"', f'"CLSID"="{clsid}"',
                          '"LengthScale"="1.4"', '"ModelPath"="en_US-libritts_r-medium.onnx"',
                          f'"SpeakerID"="{sid}"', "",
                          f"[{key}\\\\Attributes] {now}", '"Age"="Adult"', f'"Gender"="{gender}"',
                          '"Language"="409"', f'"Name"="{title}"', '"Vendor"="GOBLINCAKES"', ""]
        tmp = reg.with_name("system.reg.goblincakes-tmp")
        tmp.write_text(text.rstrip("\n") + "\n\n" + "\n".join(lines), encoding="utf-8",
                       errors="surrogateescape")
        tmp.replace(reg)
        added += 1
        say(f"Text till tal: 10 nya röster i {pfx}")
    return added


def main():
    add_tts_voices()
    found = find_versions(search_roots())
    if not found:
        say("Hittade inte WoW. Installera Battle.net och WoW i GOBLINCAKES Config (Spel och WoW) först.")
        return 1 if VERBOSE else 0
    wow_folder = update_links(found)
    update_wowup(found)
    update_raiderio(found, wow_folder)
    update_archon(found)
    if VERBOSE:
        print(f"WoW-mappen: {wow_folder}")
        print(f"  WowUp, Raider.IO och Archon får WoW-mappen automatiskt")
        for flavor, (folder, _exe, _mtime) in sorted(found.items(), key=lambda kv: FLAVORS[kv[0]][1]):
            name = FLAVORS[flavor][0]
            print(f"  ~/Games/WoW/{name}/Logs och AddOns → {folder}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
