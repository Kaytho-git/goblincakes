#!/usr/bin/env bash
# GOBLINCAKES: ~/Games/WoW/Logs and ~/Games/WoW/AddOns point into the WoW install inside
# the Battle.net Wine prefix (Lutris), so Archon, WowUp and the file manager find them.
# Runs at every login (does nothing until WoW is installed) and as `goblin wow`.
set -uo pipefail
shopt -s nullglob

links="$HOME/Games/WoW"
found=0
for retail in "$HOME"/Games/*/drive_c/"Program Files (x86)"/"World of Warcraft"/_retail_ \
              "$HOME"/Games/*/drive_c/"Program Files"/"World of Warcraft"/_retail_; do
    [ -d "$retail" ] || continue
    found=1
    mkdir -p "$links" "$retail/Logs" "$retail/Interface/AddOns"
    for pair in "Logs|$retail/Logs" "AddOns|$retail/Interface/AddOns"; do
        name=${pair%%|*} target=${pair#*|}
        # Only our own links are replaced, never a real folder
        if [ -L "$links/$name" ] || [ ! -e "$links/$name" ]; then
            ln -sfn "$target" "$links/$name"
        fi
    done
    [ "${1:-}" = --verbose ] && printf 'WoW: %s\n  ~/Games/WoW/Logs   → %s/Logs\n  ~/Games/WoW/AddOns → %s/Interface/AddOns\n' "$retail" "$retail" "$retail"
    break
done
if [ "$found" = 0 ] && [ "${1:-}" = --verbose ]; then
    echo "Hittade inte WoW. Installera Battle.net och WoW i GOBLINCAKES Config (Spel och WoW) först."
    exit 1
fi
exit 0
