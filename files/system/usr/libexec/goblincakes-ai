#!/usr/bin/env python3
"""goblin ai in the terminal (the window is /usr/bin/goblin-ai, opened by Meta+A or "goblin ai").

    goblin ai <question>   one question (the answer may suggest commands)
    goblin ai --chat       chat in the terminal until you write nothing or "hej då"
    goblin ai setup        pick services and paste their free keys

Commands the AI suggests are only run when you answer yes to each one, and
their output is sent back so the AI can take the next step.
"""
import getpass
import re
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/share/goblincakes/ai")
from goblinai import (PROVIDERS, DANGER, ServiceError, ask as ask_services, code_blocks,  # noqa: E402
                      has_keys, load_keys, pick_model, save_keys, system_prompt)

MAX_ROUNDS = 8  # command → output → next step, per question

# ── Look ───────────────────────────────────────────────────────────

TTY = sys.stdout.isatty()


def color(code):
    return code if TTY else ""


ACCENT = color("\033[1;38;2;47;111;237m")
FROST = color("\033[38;2;230;236;245m")
MUTED = color("\033[38;2;139;152;173m")
RED = color("\033[1;38;2;220;70;76m")
BOLD = color("\033[1m")
RESET = color("\033[0m")


def muted(text):
    print(f"{MUTED}{text}{RESET}")


def render(markdown):
    """Prints the answer: headings, **bold**, `code` and code blocks in the GOBLINCAKES colors."""
    in_code = False
    for line in markdown.splitlines():
        if line.strip().startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            print(f"  {ACCENT}▌{RESET} {FROST}{line}{RESET}")
            continue
        heading = re.match(r"^#{1,6}\s+(.*)", line)
        if heading:
            print(f"{ACCENT}{heading.group(1)}{RESET}")
            continue
        line = re.sub(r"\*\*(.+?)\*\*", lambda m: f"{BOLD}{m.group(1)}{RESET}", line)
        line = re.sub(r"`([^`]+)`", lambda m: f"{ACCENT}{m.group(1)}{RESET}", line)
        print(line)


class Spinner:
    """"Frågar …" while waiting for an answer."""

    def __init__(self, text):
        self.text, self.stop = text, threading.Event()
        self.thread = threading.Thread(target=self.run, daemon=True)

    def run(self):
        frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        i = 0
        while not self.stop.wait(0.1):
            print(f"\r{MUTED}{frames[i % len(frames)]} {self.text}{RESET}", end="", flush=True)
            i += 1

    def __enter__(self):
        if TTY:
            self.thread.start()
        return self

    def __exit__(self, *exc):
        self.stop.set()
        if TTY:
            self.thread.join()
            print("\r\033[K", end="", flush=True)


def ask(messages, keys):
    with Spinner("Tänker…") as spinner:
        def status(text):
            spinner.text = text

        def notice(text):
            print(f"\r\033[K{MUTED}({text}){RESET}" if TTY else f"({text})")

        return ask_services(messages, keys, status=status, notice=notice)


# ── Commands from the answer ───────────────────────────────────────

def run_blocks(blocks):
    """Asks for each block, runs the ones the user says yes to; returns what happened."""
    results = []
    for block in blocks:
        print()
        warn = f" {RED}(ändrar systemet – läs igenom!){RESET}" if DANGER.search(block) else ""
        print(f"{ACCENT}▌ Kör det här?{RESET}{warn}")
        for line in block.splitlines():
            print(f"  {FROST}{line}{RESET}")
        try:
            answer = input(f"{MUTED}[j/N] {RESET}").strip().lower()
        except EOFError:
            answer = ""
        if answer not in ("j", "ja", "y", "yes"):
            results.append(f"$ {block}\n(användaren valde att inte köra det)")
            continue
        proc = subprocess.run(["bash", "-c", block], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              stdin=sys.stdin, text=True)
        output = proc.stdout or ""
        print(output, end="" if output.endswith("\n") or not output else "\n")
        muted(f"(klart, kod {proc.returncode})")
        # Long output: the AI gets the end, which is usually what matters
        if len(output) > 6000:
            output = "…(början utelämnad)…\n" + output[-6000:]
        results.append(f"$ {block}\n{output}(avslutskod {proc.returncode})")
    return results


def handle(question, messages, keys):
    messages.append({"role": "user", "content": question})
    for _ in range(MAX_ROUNDS):
        answer, service = ask(messages, keys)
        messages.append({"role": "assistant", "content": answer})
        print()
        render(answer.strip())
        muted(f"\n— {service}")
        blocks = code_blocks(answer)
        if not blocks:
            return
        results = run_blocks(blocks)
        if all("(användaren valde att inte köra det)" in r for r in results):
            return
        messages.append({"role": "user", "content": "Så här gick det:\n\n" + "\n\n".join(results)
                         + "\n\nFortsätt med nästa steg, eller säg kort att det är klart."})
    muted("(Slutar här efter många steg – fråga igen om du vill fortsätta.)")


# ── setup ──────────────────────────────────────────────────────────

def setup():
    keys = load_keys()
    print(f"{ACCENT}▌ goblin ai – gratis AI-tjänster{RESET}\n")
    print("Varje tjänst behöver en gratis nyckel. Du behöver bara en, men fler gör att goblin ai")
    print("kan byta när en tjänst har slut på gratisfrågor. De används i den här ordningen.")
    muted("Obs: på gratisnivåerna får tjänsterna oftast använda frågorna för att förbättra sina AI:er –")
    muted("skriv inga lösenord eller annat hemligt i frågorna.\n")
    for p in PROVIDERS:
        have = bool(keys.get(p["env"]))
        state = f"{ACCENT}inställd{RESET}" if have else f"{MUTED}inte inställd{RESET}"
        print(f"{BOLD}{p['name']}{RESET} – {state}")
        prompt = "Byta nyckel?" if have else "Ställa in?"
        if input(f"{MUTED}{prompt} [j/N] {RESET}").strip().lower() not in ("j", "ja", "y"):
            print()
            continue
        print(f"  {p['how']}")
        print(f"  Sidan: {ACCENT}{p['keys_page']}{RESET}")
        subprocess.Popen(["xdg-open", p["keys_page"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        key = getpass.getpass("  Klistra in nyckeln (syns inte när du klistrar, tryck Enter): ").strip()
        if not key:
            print()
            continue
        try:
            model = pick_model(p, key, refresh=True)
            keys[p["env"]] = key
            save_keys(keys)
            print(f"  {ACCENT}Fungerar{RESET} – använder {model}\n")
        except ServiceError as e:
            print(f"  {RED}Fungerade inte:{RESET} {e}\n")
    if has_keys(keys):
        print(f"Klart. Prova: {ACCENT}goblin ai hur mycket diskutrymme har jag kvar?{RESET}")
    else:
        print("Ingen tjänst inställd. Kör goblin ai setup igen när du vill.")


# ── main ───────────────────────────────────────────────────────────

def main(args):
    if args[:1] == ["setup"]:
        setup()
        return 0
    if args[:1] == ["--chat"]:
        args = []
    keys = load_keys()
    if not has_keys(keys):
        print(f"goblin ai behöver minst en gratis AI-tjänst. Kör: {ACCENT}goblin ai setup{RESET}")
        return 1
    messages = [{"role": "system", "content": system_prompt()}]
    try:
        if args:
            handle(" ".join(args), messages, keys)
            return 0
        print(f"{ACCENT}▌ goblin ai{RESET} {MUTED}– skriv din fråga. Tom rad eller \"hej då\" avslutar.{RESET}")
        while True:
            try:
                question = input(f"\n{ACCENT}›{RESET} ").strip()
            except EOFError:
                break
            if not question or question.lower() in ("hej då", "hejdå", "exit", "quit", "q"):
                break
            handle(question, messages, keys)
        return 0
    except ServiceError as e:
        print(f"{RED}{e}{RESET}")
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
