#!/usr/bin/python3 -I
# GOBLINCAKES: the login screen in the accent colour chosen on the desktop (goblincakes-accent).
#   goblincakes-sddm-accent <accent> <dim> <on>   e.g. #C41E3A #5E1627 #E6ECF5
#   goblincakes-sddm-accent standard              back to GOBLINCAKES blue
# Runs as root through pkexec (polkit action org.goblincakes.sddm-accent, no password for the
# person at the computer). Writes /var/lib/goblincakes/sddm-theme.conf, which the theme reads
# as theme.conf.user (a link in /usr/share/sddm/themes/goblincakes); only colours get in.
import os
import re
import sys

TARGET = "/var/lib/goblincakes/sddm-theme.conf"

if "PKEXEC_UID" not in os.environ:
    sys.exit("run through pkexec")
args = sys.argv[1:]
if args == ["standard"]:
    try:
        os.unlink(TARGET)
    except FileNotFoundError:
        pass
    sys.exit(0)
if len(args) != 3 or not all(re.fullmatch(r"#[0-9A-Fa-f]{6}", a) for a in args):
    sys.exit("usage: goblincakes-sddm-accent <accent> <dim> <on> | standard")
os.makedirs(os.path.dirname(TARGET), mode=0o755, exist_ok=True)
tmp = TARGET + ".goblincakes-new"
try:
    os.unlink(tmp)
except FileNotFoundError:
    pass
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
with os.fdopen(fd, "w") as f:
    f.write("[General]\naccent=%s\naccentDim=%s\naccentOn=%s\n" % tuple(a.upper() for a in args))
os.replace(tmp, TARGET)
