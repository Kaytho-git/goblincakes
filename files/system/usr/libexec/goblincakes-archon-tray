#!/usr/bin/python3
"""Our own tray icons for Electron programs whose left click does nothing (Archon 24 Oct; Raider.IO and WowUp
13 Nov, the user: "raiderio funkar med högerklick men inte vänster … samma med wowup"). Electron ignores the
tray's Activate on Linux – only its menu works. So while such a program runs, its own item is hidden in the tray
(systray.js, "<Id>@<process>") and this shows one in its place: left click = the program's own "Open …"/"Show"
menu entry (Activate only when there is none), right click = the program's own menu (read from its dbusmenu, the
click sent back), middle click = SecondaryActivate. Archon's icon is our purple copy (its own is a black macOS
template, only pixels, can't be seen on the dark top bar); the others show their own picture (IconPixmap).
The programs' files and storage are not touched. Run by goblincakes-archon-tray.service (the name from when it was
only Archon).
"""
import json
import os
import subprocess
import sys

SESSION_VARS = ("WAYLAND_DISPLAY", "DISPLAY", "XDG_SESSION_TYPE", "QT_QPA_PLATFORM")


def session_env():
    """The desktop's variables, in case systemd started us before Plasma told it about them."""
    try:
        out = subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:
        return
    for line in out.splitlines():
        key, _, value = line.partition("=")
        if key in SESSION_VARS and not os.environ.get(key):
            os.environ[key] = value


session_env()
if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("DISPLAY"):
    sys.exit(1)  # no screen yet – the service tries again

from PySide6.QtCore import QTimer                                     # noqa: E402
from PySide6.QtGui import QCursor, QIcon                              # noqa: E402
from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon    # noqa: E402

SNI = "org.kde.StatusNotifierItem"
MENU = "com.canonical.dbusmenu"
POLL_MS = 4000
HERE = os.path.dirname(os.path.realpath(__file__))
# Next to /usr/libexec in the image, or in the repo (files/system/usr/…)
ICONS = os.path.join(HERE, "..", "share", "icons", "hicolor", "scalable", "apps")
# The process name (comm, at most 15 characters) → the name shown, our own icon file ("" = the program's own
# picture), its AppImage (only installed ones are looked for). The hidden items in systray.js and the service's
# conditions follow this list.
APPS = {
    "archon": ("Archon", "goblincakes-archon-tray.svg", "Archon.AppImage"),
    "raiderio-client": ("Raider.IO", "", "RaiderIO.AppImage"),
    "wowup-cf": ("WowUp", "", "WowUp.AppImage"),
}
# Not Battle.net (13 Nov, tried and taken out – the user: too tricky): its icon is Wine's old X11 kind through KDE's
# xembedsniproxy and wants a double click; a copy of ours needed the mouse's position, which Wayland hides.
APPIMAGES = os.path.expanduser("~/AppImages")


def busctl(*args):
    """busctl --user --json=short …; None when it fails (the program gone)."""
    try:
        out = subprocess.run(["busctl", "--user", "--json=short", *args], capture_output=True,
                             text=True, timeout=3)
    except Exception:
        return None
    if out.returncode != 0 or not out.stdout.strip():
        return None
    try:
        return json.loads(out.stdout)
    except ValueError:
        return None


def find_items(wanted):
    """{process: (service, path)} for the tray items of the wanted programs – one pass over the tray (our own
    icons are python3 and never match)."""
    found = {}
    items = busctl("get-property", "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                   "org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems")
    for item in (items or {}).get("data", []):
        service, _, path = item.partition("/")
        pid = busctl("call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                     "GetConnectionUnixProcessID", "s", service)
        try:
            with open(f"/proc/{pid['data'][0]}/comm") as f:
                comm = f.read().strip()
        except (OSError, TypeError, KeyError, IndexError):
            continue
        if comm in wanted and comm not in found:
            found[comm] = (service, "/" + (path or "StatusNotifierItem"))
    return found



def entries(node):
    """A program's menu as [(id, label, enabled, separator)] – one level, like theirs."""
    out = []
    for child in node[2]:
        cid, props = child["data"][0], child["data"][1]
        get = lambda key, default: props.get(key, {}).get("data", default)   # noqa: E731
        if not get("visible", True):
            continue
        out.append((cid, get("label", "").replace("_", ""), get("enabled", True),
                    get("type", "") == "separator"))
    return out


# Run in a process of its own: WowUp's picture is 1024×1024 – read as JSON numbers it kept ~120 MB in this
# program for good (13 Nov). The child picks the largest picture, shrinks it to at most 64 px and writes a PNG.
_PICTURE = r"""
import json, struct, subprocess, sys, zlib
out = subprocess.run(["busctl", "--user", "--json=short", "get-property", sys.argv[1], sys.argv[2],
                      "org.kde.StatusNotifierItem", "IconPixmap"], capture_output=True, text=True, timeout=5).stdout
best = None
for w, h, raw in json.loads(out)["data"]:
    if len(raw) == w * h * 4 and (not best or w > best[0]):
        best = (w, h, raw)
w, h, raw = best
step = max(1, (max(w, h) + 63) // 64)
W, H = w // step, h // step
rows = bytearray()
for y in range(H):
    rows.append(0)
    for x in range(W):
        i = ((y * step) * w + x * step) * 4
        a, r, g, b = raw[i:i + 4]
        rows += bytes((r, g, b, a))
chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 6, 0, 0, 0))
       + chunk(b"IDAT", zlib.compress(bytes(rows))) + chunk(b"IEND", b""))
open(sys.argv[3], "wb").write(png)
"""
PICTURES = os.path.expanduser("~/.cache/goblincakes/tray-icons")


def own_picture(item, name):
    """The program's own tray picture (IconPixmap) as a QIcon, or None."""
    os.makedirs(PICTURES, exist_ok=True)
    path = os.path.join(PICTURES, name + ".png")
    try:
        subprocess.run([sys.executable, "-c", _PICTURE, item[0], item[1], path], capture_output=True, timeout=10,
                       check=True)
    except Exception:  # noqa: BLE001 – no picture: the icon stays empty and hidden
        return None
    icon = QIcon(path)
    return None if icon.isNull() else icon


class Proxy:
    """One program's icon of ours."""

    def __init__(self, app, process, name, icon_file):
        self.process, self.name = process, name
        self.item = None
        self.menu_path = None
        self.icon_file = os.path.join(ICONS, icon_file) if icon_file else ""
        # The file itself: fromTheme() shortens a missing name to "goblincakes" (the logo)
        self.tray = QSystemTrayIcon(QIcon(self.icon_file) if self.icon_file else QIcon(), app)
        self.menu = QMenu()
        self.menu.aboutToShow.connect(self.fill_menu)
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.clicked)

    def update(self, item):
        """item = the program's tray item now (None = not found)."""
        if item != self.item:
            self.item, self.menu_path = item, None
            if item and not self.icon_file:
                picture = own_picture(item, self.process)
                if picture:
                    self.tray.setIcon(picture)
            if item:
                self.fill_menu()
        if self.item:
            tip = busctl("get-property", *self.item, SNI, "ToolTip")
            if tip is None:
                self.item = None
            else:
                self.tray.setToolTip(tip["data"][2] or self.name)
        self.tray.setVisible(bool(self.item) and not self.tray.icon().isNull())

    def menu_ready(self):
        """The program's menu path, read again while it is missing: at login this started before Archon had its
        menu, the path stayed empty and a left click fell back to Activate, which Archon ignores (13 Nov)."""
        if not self.menu_path and self.item:
            menu = busctl("get-property", *self.item, SNI, "Menu")
            self.menu_path = menu["data"] if menu else None
        return self.menu_path

    def layout(self):
        service = self.item[0]
        busctl("call", service, self.menu_path, MENU, "AboutToShow", "i", "0")
        layout = busctl("call", service, self.menu_path, MENU, "GetLayout", "iias", "--", "0", "-1", "0")
        return entries(layout["data"][1]) if layout else []

    def fill_menu(self):
        self.menu.clear()
        if not self.item or not self.menu_ready():
            return
        service = self.item[0]
        for cid, label, enabled, separator in self.layout():
            if separator:
                self.menu.addSeparator()
                continue
            action = self.menu.addAction(label)
            action.setEnabled(enabled)
            action.triggered.connect(lambda _=False, cid=cid: busctl(
                "call", service, self.menu_path, MENU, "Event", "isvu", "--",
                str(cid), "clicked", "s", "", "0"))

    def open_from_menu(self):
        """Click the program's own "Open …"/"Show" menu entry; False when there is none."""
        if not self.menu_ready():
            return False
        for cid, label, enabled, separator in self.layout():
            if not separator and enabled and label.lower().startswith(("open", "show", "öppna", "visa")):
                busctl("call", self.item[0], self.menu_path, MENU, "Event", "isvu", "--",
                       str(cid), "clicked", "s", "", "0")
                return True
        return False

    def clicked(self, reason):
        if not self.item:
            return
        if reason in (QSystemTrayIcon.ActivationReason.Trigger,
                      QSystemTrayIcon.ActivationReason.DoubleClick):
            # Electron ignores Activate (Archon 8 Nov, Raider.IO and WowUp 13 Nov) – the menu's "Open …"/"Show"
            # opens the window; Activate only when the menu has no such entry
            if not self.open_from_menu():
                pos = QCursor.pos()
                busctl("call", *self.item, SNI, "Activate", "ii", str(pos.x()), str(pos.y()))
        elif reason == QSystemTrayIcon.ActivationReason.MiddleClick:
            busctl("call", *self.item, SNI, "SecondaryActivate", "ii", "0", "0")


class Trays:
    def __init__(self, app):
        self.proxies = [Proxy(app, process, name, icon) for process, (name, icon, appimage) in APPS.items()
                        if os.path.exists(os.path.join(APPIMAGES, appimage))]
        self.timer = QTimer(interval=POLL_MS, timeout=self.poll)
        self.timer.start()
        self.poll()

    def poll(self):
        # The whole tray is only looked through while one of them isn't found (light when they all run)
        missing = {p.process for p in self.proxies if not p.item}
        found = find_items(missing) if missing else {}
        for p in self.proxies:
            p.update(p.item or found.get(p.process))


def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("goblincakes-archon-tray")
    app.setDesktopFileName("appimage-archon")
    _keep = Trays(app)  # noqa: F841
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
