#!/usr/bin/python3
"""GOBLINCAKES: start Steam games from the terminal by name – always through Steam.

    goblincakes-games list               every game with the words that start it
    goblincakes-games run <word>         start the game (exit 3: no game by that word)
    goblincakes-games steam              every installed game with what to give `add`
    goblincakes-games add <game> <word>  own short word for a game (name, word or .exe)
    goblincakes-games remove <word>      removes an own word
    goblincakes-games dock <game>        pins the game in the dock (own menu entry + icon)
    goblincakes-games undock <game>      unpins it and removes the menu entry

Typing a game's word straight in the terminal (e.g. `wow`, `cs2`, `worldofwarcraft`)
works through bash's command_not_found_handle (/etc/profile.d/zz-goblincakes-games.sh),
so new games work right after Steam installs them – nothing is generated.

Games are started with steam://rungameid/…, exactly like pressing Play in Steam, so
anti-cheat, Proton settings, overlays and play time all work. Both Steam games and
non-Steam games added to Steam (e.g. World of Warcraft through Battle.net/Lutris) count.
"""
import os
import re
import shutil
import json
import struct
import subprocess
import sys
import urllib.request
from pathlib import Path

HOME = Path.home()
# The user's own words (goblin play add): "word=game id" per line
ALIASES = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "goblincakes/game-aliases"
STEAM_ROOTS = [HOME / ".local/share/Steam", HOME / ".steam/steam",
               HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
# Steam's own tools, not games
TOOLS = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common|SteamVR)", re.I)


def steam_roots():
    seen, roots = set(), []
    for root in STEAM_ROOTS:
        try:
            real = root.resolve()
        except OSError:
            continue
        if real.is_dir() and real not in seen:
            seen.add(real)
            roots.append(real)
    return roots


def library_folders(root):
    """Every Steam library folder, also on other disks (libraryfolders.vdf)."""
    folders = {root}
    vdf = root / "steamapps/libraryfolders.vdf"
    try:
        for path in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="replace")):
            folders.add(Path(path.replace("\\\\", "\\")))
    except OSError:
        pass
    return folders


def steam_games(root):
    for folder in library_folders(root):
        for acf in (folder / "steamapps").glob("appmanifest_*.acf"):
            try:
                text = acf.read_text(errors="replace")
            except OSError:
                continue
            appid = re.search(r'"appid"\s+"(\d+)"', text)
            name = re.search(r'"name"\s+"([^"]+)"', text)
            if appid and name and not TOOLS.match(name.group(1)):
                yield name.group(1), appid.group(1)


def read_binary_vdf(data):
    """Steam's binary VDF (shortcuts.vdf) → nested dicts."""
    pos = 0

    def cstring():
        nonlocal pos
        end = data.index(b"\0", pos)
        s = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        return s

    def node():
        nonlocal pos
        out = {}
        while pos < len(data):
            kind = data[pos]
            pos += 1
            if kind == 0x08:
                return out
            key = cstring()
            if kind == 0x00:
                out[key] = node()
            elif kind == 0x01:
                out[key] = cstring()
            elif kind == 0x02:
                out[key] = struct.unpack_from("<i", data, pos)[0]
                pos += 4
            elif kind == 0x07:
                pos += 8
            else:
                return out
        return out

    return node()


def shortcut_games(root):
    """Non-Steam games added to Steam: their game id is (appid << 32) | 0x02000000."""
    for vdf in (root / "userdata").glob("*/config/shortcuts.vdf"):
        try:
            tree = read_binary_vdf(vdf.read_bytes())
        except (OSError, ValueError, struct.error):
            continue
        for entry in tree.get("shortcuts", {}).values():
            if not isinstance(entry, dict):
                continue
            name = entry.get("AppName") or entry.get("appname")
            appid = entry.get("appid")
            if name and isinstance(appid, int):
                gameid = str(((appid & 0xFFFFFFFF) << 32) | 0x02000000)
                exe = (entry.get("Exe") or entry.get("exe") or "").strip().strip('"')
                if exe:
                    EXES[gameid] = Path(exe.replace("\\", "/")).name.lower()
                    EXE_PATHS[gameid] = exe
                icon = (entry.get("icon") or "").strip().strip('"')
                if icon:
                    ICONS[gameid] = icon
                yield name, gameid


EXES = {}  # non-Steam game id → its .exe's file name (filled by shortcut_games)
ICONS = {}  # non-Steam game id → the icon chosen in Steam (filled by shortcut_games)
EXE_PATHS = {}  # non-Steam game id → its .exe (filled by shortcut_games)


def words(name):
    """The words that start a game: full name squashed and initials, e.g.
    "World of Warcraft" → worldofwarcraft, wow; "Counter-Strike 2" → counterstrike2, cs2."""
    clean = re.sub(r"[™®©]", "", name).lower()
    full = re.sub(r"[^a-z0-9]", "", clean)
    parts = [p for p in re.split(r"[^a-z0-9]+", clean) if p]
    initials = "".join(p if p.isdigit() else p[0] for p in parts)
    out = {full}
    if len(parts) > 1 and len(initials) >= 2:
        out.add(initials)
    if full.startswith("the") and len(full) > 3:
        out.add(full[3:])
    return sorted(w for w in out if len(w) >= 2)


def games():
    found = {}
    for root in steam_roots():
        for name, gameid in list(steam_games(root)) + list(shortcut_games(root)):
            found.setdefault(gameid, name)
    return sorted(((name, gameid) for gameid, name in found.items()), key=lambda g: g[0].lower())


def squash(text):
    return re.sub(r"[^a-z0-9]", "", text.lower())


def read_aliases():
    out = {}
    try:
        for line in ALIASES.read_text().splitlines():
            word, _, gameid = line.partition("=")
            if word.strip() and gameid.strip():
                out[word.strip()] = gameid.strip()
    except OSError:
        pass
    return out


def write_aliases(aliases):
    ALIASES.parent.mkdir(parents=True, exist_ok=True)
    ALIASES.write_text("".join(f"{w}={g}\n" for w, g in sorted(aliases.items())))


def find(text, all_games):
    """Games a text means: an own word, a game's word, its name, or its .exe (Wow.exe)."""
    query = squash(text)
    if len(query) < 2:
        return []
    own = read_aliases().get(query)
    if own:
        hit = [(n, g) for n, g in all_games if g == own]
        if hit:
            return hit
    exe = text.lower()
    return [(n, g) for n, g in all_games
            if query in words(n) or query == squash(n) or EXES.get(g) in (exe, exe + ".exe")]


def launch(name, gameid):
    print(f"Startar {name} via Steam…", flush=True)
    # Through the steam:// handler: the running Steam takes it, or Steam starts with it
    # (from GOBLINCAKES' own steam.desktop, so dGPU/MangoHud settings apply too)
    subprocess.Popen(["xdg-open", f"steam://rungameid/{gameid}"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- goblin play dock: the game as an own menu entry, pinned in the dock ----
APPS = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "applications"
ICON_DIR = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "goblincakes/game-icons"
ICON_CDN = "https://cdn.cloudflare.steamstatic.com/steamcommunity/public/images/apps/{}/{}.ico"


def client_icon(appid):
    """The hash of a Steam game's .ico (up to 512 px) from Steam's appinfo.vdf (format 29:
    keys are indexes into a string table at the end of the file)."""
    for root in steam_roots():
        try:
            data = (root / "appcache/appinfo.vdf").read_bytes()
            if struct.unpack_from("<I", data, 0)[0] != 0x07564429:
                continue
            table = struct.unpack_from("<q", data, 8)[0]
            count, pos, keys = struct.unpack_from("<I", data, table)[0], table + 4, []
            for _ in range(count):
                end = data.index(b"\0", pos)
                keys.append(data[pos:end])
                pos = end + 1
            pattern = b"\x01" + struct.pack("<I", keys.index(b"clienticon"))
            pos = 16
            while pos < table:
                app, size = struct.unpack_from("<II", data, pos)
                if app == 0:
                    break
                if app == int(appid):
                    block = data[pos + 8:pos + 8 + size]
                    hit = block.find(pattern)
                    if hit >= 0:
                        return block[hit + 5:block.index(b"\0", hit + 5)].decode()
                    break
                pos += 8 + size
        except (OSError, ValueError, struct.error):
            continue
    return None


def largest_image(data_or_path):
    """The biggest picture in a file (an .ico has several) as a QImage, or None."""
    from PySide6.QtCore import QBuffer, QByteArray
    from PySide6.QtGui import QImageReader
    if isinstance(data_or_path, bytes):
        buffer = QBuffer()
        buffer.setData(QByteArray(data_or_path))
        reader = QImageReader(buffer)
    else:
        reader = QImageReader(str(data_or_path))
    best = None
    while True:
        image = reader.read()
        if not image.isNull() and (best is None or image.width() > best.width()):
            best = image
        if not reader.jumpToNextImage():
            break
    return best


def exe_icon(path):
    """The picture inside a Windows .exe, or None – read only, the game's file is never changed
    (21 Oct, the user: WoW in the dock got Steam's icon). Windows' game explorer picture
    (__GDF_THUMBNAIL, a 256 px PNG – Wow.exe's icons are at most 48 px) if there is one, else
    the first icon group as .ico bytes. PE: the resource table's RT_GROUP_ICON (14) lists the
    pictures, RT_ICON (3) holds them."""
    try:
        with open(path, "rb") as f:
            def at(offset, size):
                f.seek(offset)
                return f.read(size)
            pe = struct.unpack_from("<I", at(0x3C, 4))[0]
            sections, opt_size = struct.unpack_from("<H12xH", at(pe + 6, 16))
            opt = pe + 24
            magic = struct.unpack_from("<H", at(opt, 2))[0]
            res_rva = struct.unpack_from("<I", at(opt + (112 if magic == 0x10B else 128), 4))[0]
            table = []
            for i in range(sections):
                vsize, vaddr, rsize, raw = struct.unpack_from("<IIII", at(opt + opt_size + 40 * i + 8, 16))
                table.append((vaddr, max(vsize, rsize), raw))

            def offset(rva):
                for vaddr, size, raw in table:
                    if vaddr <= rva < vaddr + size:
                        return raw + rva - vaddr
                raise ValueError("rva")
            base = offset(res_rva)

            def entries(directory):
                named, ids = struct.unpack_from("<HH", at(base + directory + 12, 4))
                for i in range(named + ids):
                    name, data = struct.unpack_from("<II", at(base + directory + 16 + 8 * i, 8))
                    yield name, data

            def first_data(data):   # down the tree to the first leaf (language)
                while data & 0x80000000:
                    data = next(entries(data & 0x7FFFFFFF))[1]
                rva, size = struct.unpack_from("<II", at(base + data, 8))
                return at(offset(rva), size)
            def name_of(name):
                if not name & 0x80000000:
                    return name
                length = struct.unpack_from("<H", at(base + (name & 0x7FFFFFFF), 2))[0]
                return at(base + (name & 0x7FFFFFFF) + 2, 2 * length).decode("utf-16-le", "replace")
            types = {name_of(n): d for n, d in entries(0)}
            for data in types.values():
                if data & 0x80000000:
                    for n, d in entries(data & 0x7FFFFFFF):
                        if name_of(n) == "__GDF_THUMBNAIL":
                            thumb = first_data(d)
                            if thumb[:8] == b"\x89PNG\r\n\x1a\n":
                                return thumb
            if 14 not in types or 3 not in types:
                return None
            group = first_data(next(entries(types[14] & 0x7FFFFFFF))[1])
            icons = {name: data for name, data in entries(types[3] & 0x7FFFFFFF)}
            count = struct.unpack_from("<H", group, 4)[0]
            heads, blobs = [], []
            for i in range(count):
                w, h, colors, _, planes, bits, _, nid = struct.unpack_from("<BBBBHHIH", group, 6 + 14 * i)
                if nid in icons:
                    blob = first_data(icons[nid])
                    heads.append((w, h, colors, planes, bits, len(blob)))
                    blobs.append(blob)
    except (OSError, ValueError, StopIteration, struct.error):
        return None
    if not blobs:
        return None
    out, pos = struct.pack("<HHH", 0, 1, len(blobs)), 6 + 16 * len(blobs)
    for (w, h, colors, planes, bits, size) in heads:
        out += struct.pack("<BBBBHHII", w, h, colors, 0, planes, bits, size, pos)
        pos += size
    return out + b"".join(blobs)


def game_icon(gameid):
    """A PNG for the game: Steam's .ico from its CDN, else the small icon in Steam's
    library cache, else the icon of a non-Steam shortcut. None = Steam's own icon."""
    from PySide6.QtCore import Qt
    target = ICON_DIR / f"{gameid}.png"
    image = None
    if gameid not in EXES:
        icon_hash = client_icon(gameid)
        if icon_hash:
            try:
                with urllib.request.urlopen(ICON_CDN.format(gameid, icon_hash), timeout=15) as reply:
                    image = largest_image(reply.read())
            except OSError:
                image = None
        if image is None:
            for root in steam_roots():
                for jpg in (root / "appcache/librarycache" / gameid).glob("*.jpg"):
                    if re.fullmatch(r"[0-9a-f]{40}\.jpg", jpg.name):
                        image = largest_image(jpg)
                        break
    else:
        icon = Path(ICONS.get(gameid, "").replace("\\", "/"))
        if icon.suffix.lower() in (".png", ".ico", ".jpg", ".jpeg", ".svg") and icon.is_file():
            image = largest_image(icon)
        elif EXE_PATHS.get(gameid):   # no icon chosen in Steam: the one inside the .exe
            data = exe_icon(EXE_PATHS[gameid])
            image = largest_image(data) if data else None
    if image is None or image.isNull():
        return None
    if image.width() > 256:
        image = image.scaled(256, 256, Qt.KeepAspectRatio, Qt.SmoothTransformation)
    ICON_DIR.mkdir(parents=True, exist_ok=True)
    image.save(str(target), "PNG")
    return str(target)


def dock_script(launcher, pin):
    """Plasma script: add/remove a launcher in the dock (the bottom panel – not the top bar)."""
    return """
var launcher = %s, pin = %s;
panels().forEach(function (panel) {
    if (panel.location !== "bottom") return;
    panel.widgets().forEach(function (widget) {
        if (widget.type !== "org.kde.plasma.icontasks") return;
        widget.currentConfigGroup = ["General"];
        var list = widget.readConfig("launchers", []);
        if (typeof list === "string") list = list ? list.split(",") : [];
        var at = list.indexOf(launcher);
        if (pin && at < 0) list.push(launcher);
        else if (!pin && at >= 0) list.splice(at, 1);
        else return;
        widget.writeConfig("launchers", list);
    });
});""" % (json.dumps(launcher), "true" if pin else "false")


def plasma(script):
    return subprocess.run(["busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                           "org.kde.PlasmaShell", "evaluateScript", "s", script],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def one_game(text):
    all_games = games()
    matches = find(text, all_games) or [(n, g) for n, g in all_games
                                        if len(squash(text)) >= 3 and squash(n).startswith(squash(text))]
    if not matches:
        print(f"Hittar inget spel i Steam som heter {text}. Se listan: goblin play", file=sys.stderr)
    elif len(matches) > 1:
        print(f"Flera spel passar {text} – skriv hela namnet:", file=sys.stderr)
        for name, _ in matches:
            print(f"  {words(name)[0]:<28} {name}", file=sys.stderr)
    else:
        return matches[0]
    return None


def dock(text, pin):
    game = one_game(text)
    if not game:
        return 1
    name, gameid = game
    if name.lower().endswith(".exe"):
        name = name[:-4]  # shortcut named after its file (Wow.exe) → Wow
    desktop = APPS / f"goblincakes-game-{gameid}.desktop"
    launcher = f"applications:{desktop.name}"
    if not pin:
        plasma(dock_script(launcher, False))
        desktop.unlink(missing_ok=True)
        (ICON_DIR / f"{gameid}.png").unlink(missing_ok=True)
        subprocess.run(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{name} är borttaget ur dockan.")
        return 0
    icon = game_icon(gameid) or "steam"
    lines = ["[Desktop Entry]", "Type=Application", f"Name={name}",
             f"Comment=Startas via Steam",
             f"Exec=xdg-open steam://rungameid/{gameid}", f"Icon={icon}",
             "Terminal=false", "Categories=Game;", f"X-GOBLINCAKES-Game={gameid}"]
    if gameid not in EXES:
        # Proton games' windows are called steam_app_<id> → the dock shows them on the pin
        lines.append(f"StartupWMClass=steam_app_{gameid}")
    APPS.mkdir(parents=True, exist_ok=True)
    desktop.write_text("\n".join(lines) + "\n")
    subprocess.run(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not plasma(dock_script(launcher, True)):
        print(f"Kunde inte nå Plasma – {name} finns i AppGrid men är inte fäst i dockan.", file=sys.stderr)
        return 1
    print(f"Klart: {name} är fäst i dockan" + ("." if icon != "steam" else " (med Steams ikon – spelets hittades inte)."))
    print(f"Ta bort igen: goblin play dock remove {text}")
    return 0


def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd == "list":
        all_games = games()
        if not all_games:
            print("Inga spel i Steam ännu.")
            return 0
        own = {}
        for word, gameid in read_aliases().items():
            own.setdefault(gameid, []).append(word)
        for name, gameid in all_games:
            print(f"  {', '.join(sorted(own.get(gameid, [])) + words(name)):<28} {name}")
        return 0
    if cmd == "steam":
        all_games = games()
        if not all_games:
            print("Inga spel i Steam ännu.")
            return 0
        width = max(len(n) for n, _ in all_games) + 2
        for name, gameid in all_games:
            # What `add` takes for exactly this game: the .exe of a non-Steam shortcut, else
            # the full squashed name (always unique unless two games share a name)
            key = EXES.get(gameid) or words(name)[0]
            if len(find(key, all_games)) != 1:
                key = squash(name)
            kind = "egen genväg" if gameid in EXES else "Steam"
            print(f"  {name:<{width}} {kind:<12} goblin play add {key} <ord>")
        return 0
    if cmd == "add" and len(argv) == 3:
        word = squash(argv[2])
        if len(word) < 2:
            print("Ordet behöver minst två bokstäver eller siffror (a–z, 0–9).", file=sys.stderr)
            return 1
        all_games = games()
        # Also the start of a name: counter-strike → Counter-Strike 2
        matches = find(argv[1], all_games) or [(n, g) for n, g in all_games
                                               if len(squash(argv[1])) >= 3 and squash(n).startswith(squash(argv[1]))]
        if not matches:
            print(f"Hittar inget spel i Steam som heter {argv[1]}. Se listan: goblin play", file=sys.stderr)
            return 1
        if len(matches) > 1:
            print(f"Flera spel passar {argv[1]} – skriv hela namnet:", file=sys.stderr)
            for name, _ in matches:
                print(f"  {words(name)[0]:<28} {name}", file=sys.stderr)
            return 1
        name, gameid = matches[0]
        aliases = read_aliases()
        aliases[word] = gameid
        write_aliases(aliases)
        print(f"Klart: skriv {word} i terminalen för att starta {name}.")
        if shutil.which(word):
            print(f"Obs: {word} är redan ett kommando ({shutil.which(word)}) – det går före. "
                  f"Använd goblin play {word}, eller välj ett annat ord.")
        return 0
    if cmd == "remove" and len(argv) == 2:
        word = squash(argv[1])
        aliases = read_aliases()
        if word not in aliases:
            print(f"{argv[1]} är inget eget ord. Dina ord står först i listan: goblin play", file=sys.stderr)
            return 1
        del aliases[word]
        write_aliases(aliases)
        print(f"Borttaget: {word}")
        return 0
    if cmd == "dock" and len(argv) == 2:
        return dock(argv[1], True)
    if cmd == "undock" and len(argv) == 2:
        return dock(argv[1], False)
    if cmd == "run" and len(argv) >= 2:
        matches = find(argv[1], games())
        if not matches:
            return 3
        if len(matches) == 1:
            launch(*matches[0])
            return 0
        if len(matches) > 1:
            print(f"Flera spel heter {argv[1]} – skriv hela namnet:")
            for name, _ in matches:
                print(f"  {words(name)[0]:<28} {name}")
            return 0
        return 3
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
