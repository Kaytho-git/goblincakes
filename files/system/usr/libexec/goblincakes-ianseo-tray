#!/usr/bin/python3
# GOBLINCAKES: an icon in the system tray while Ianseo can be reached from other devices:
# the local network (`goblincakes-ianseo network on`) and/or the internet through a
# Cloudflare tunnel with a password (`goblincakes-ianseo internet on`). It goes away when
# both are switched off. Started by those commands and at every login (exits at once if off).
# Menu: the addresses (click = copy), the password, open Ianseo, switch access off.
import fcntl
import os
import re
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QTimer
from PySide6.QtGui import QAction, QIcon
from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
POD = CONFIG / "containers/systemd/ianseo.pod"
TUNNEL = CONFIG / "containers/systemd/ianseo-tunnel.container"
INTERNET_ENV = CONFIG / "goblincakes/ianseo-internet.env"
IANSEO = "/usr/libexec/goblincakes-ianseo"


def network_on():
    try:
        lines = POD.read_text().splitlines()
    except OSError:
        return False
    return any(l.startswith("PublishPort=") and not l.startswith("PublishPort=127.0.0.1:") for l in lines)


def internet_on():
    return TUNNEL.exists()


def password():
    try:
        for line in INTERNET_ENV.read_text().splitlines():
            if line.startswith("IANSEO_PASSWORD="):
                return line.split("=", 1)[1]
    except OSError:
        pass
    return ""


def tunnel_url():
    # A new address every time the tunnel starts
    out = subprocess.run(["podman", "logs", "ianseo-tunnel"], capture_output=True, text=True)
    urls = re.findall(r"https://[a-z0-9-]+\.trycloudflare\.com", out.stdout + out.stderr)
    return urls[-1] if urls else ""


def running():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "ianseo-web.service"]).returncode == 0


def addresses():
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    return [f"http://{ip}:8180/ianseo/" for ip in out if ":" not in ip]


# One icon at a time
lock = open(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "goblincakes-ianseo-tray.lock", "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)
if not (network_on() or internet_on()):
    sys.exit(0)

app = QApplication(sys.argv)
app.setQuitOnLastWindowClosed(False)
app.setApplicationName("Ianseo")
tray = QSystemTrayIcon(QIcon.fromTheme("goblincakes-ianseo"))
menu = QMenu()
shown = None  # the state the menu was last built for


def open_ianseo():
    subprocess.Popen([IANSEO, "open"], start_new_session=True)


def switch_off(what):
    # Runs on by itself (network: asks for the password for the firewall);
    # the icon goes on the next update when nothing is left on
    subprocess.Popen([IANSEO, what, "off"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def copy_action(text, value):
    action = QAction(text, menu)
    action.triggered.connect(lambda _=False, v=value: app.clipboard().setText(v))
    menu.addAction(action)


def update():
    global shown
    lan, internet = network_on(), internet_on()
    if not (lan or internet):
        tray.hide()
        app.quit()
        return
    state = (running(), lan, internet, tuple(addresses()) if lan else (), tunnel_url() if internet else "")
    if state == shown:
        return
    shown = state
    is_running, lan, internet, urls, web = state

    if not is_running:
        title = "Ianseo är avstängt"
    elif internet:
        title = "Ianseo nås via internet" + (" och nätverket" if lan else "")
    else:
        title = "Ianseo nås från nätverket"
    tips = [title]
    if internet:
        tips.append(web or "(tunneln startar…)")
    tips += list(urls)
    if lan and not urls:
        tips.append("(ingen nätverksanslutning)")
    tray.setToolTip("\n".join(tips))

    menu.clear()
    menu.addAction(title).setEnabled(False)
    if internet:
        menu.addSection("Internet")
        if web:
            copy_action(f"{web}  (klicka = kopiera)", web)
        else:
            menu.addAction("Tunneln startar…").setEnabled(False)
        copy_action("Kopiera lösenordet (användare: ianseo)", password())
    if lan:
        menu.addSection("Nätverket")
        for url in urls:
            copy_action(f"{url}  (klicka = kopiera)", url)
    menu.addSeparator()
    menu.addAction("Öppna Ianseo", open_ianseo)
    if internet:
        menu.addAction("Stäng av internetåtkomst", lambda: switch_off("internet"))
    if lan:
        menu.addAction("Stäng av nätverksåtkomst", lambda: switch_off("network"))


tray.setContextMenu(menu)
tray.activated.connect(lambda reason: open_ianseo() if reason == QSystemTrayIcon.ActivationReason.Trigger else None)
update()
tray.show()

timer = QTimer()
timer.timeout.connect(update)
timer.start(5000)
sys.exit(app.exec())
