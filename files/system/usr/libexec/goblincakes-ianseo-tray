#!/usr/bin/python3
# GOBLINCAKES: an icon in the system tray while Ianseo can be reached from the network
# (tournament mode, `goblincakes-ianseo network on`). It goes away when that is switched off.
# Started by `goblincakes-ianseo network on` and at every login (exits at once if it's off).
# Menu: the addresses (click = copy), open Ianseo, switch network access off.
import fcntl
import os
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QTimer
from PySide6.QtGui import QAction, QIcon
from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

POD = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "containers/systemd/ianseo.pod"
IANSEO = "/usr/libexec/goblincakes-ianseo"


def network_on():
    try:
        lines = POD.read_text().splitlines()
    except OSError:
        return False
    return any(l.startswith("PublishPort=") and not l.startswith("PublishPort=127.0.0.1:") for l in lines)


def running():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "ianseo-web.service"]).returncode == 0


def addresses():
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    return [f"http://{ip}:8180/ianseo/" for ip in out if ":" not in ip]


# One icon at a time
lock = open(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "goblincakes-ianseo-tray.lock", "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)
if not network_on():
    sys.exit(0)

app = QApplication(sys.argv)
app.setQuitOnLastWindowClosed(False)
app.setApplicationName("Ianseo i nätverket")
tray = QSystemTrayIcon(QIcon.fromTheme("goblincakes-ianseo"))
menu = QMenu()
shown = None  # (running, addresses) the menu was last built for


def open_ianseo():
    subprocess.Popen([IANSEO, "open"], start_new_session=True)


def network_off():
    # Runs on by itself (asks for the password for the firewall); the icon goes now
    subprocess.Popen([IANSEO, "network", "off"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    tray.hide()
    app.quit()


def update():
    global shown
    if not network_on():
        tray.hide()
        app.quit()
        return
    state = (running(), tuple(addresses()))
    if state == shown:
        return
    shown = state
    is_running, urls = state

    title = "Ianseo nås från nätverket" if is_running else "Ianseo är avstängt (nätverksläget är på)"
    tray.setToolTip(title + ("\n" + "\n".join(urls) if urls else "\n(ingen nätverksanslutning)"))

    menu.clear()
    header = menu.addAction(title)
    header.setEnabled(False)
    for url in urls:
        action = QAction(f"{url}  (klicka = kopiera)", menu)
        action.triggered.connect(lambda _=False, u=url: app.clipboard().setText(u))
        menu.addAction(action)
    menu.addSeparator()
    menu.addAction("Öppna Ianseo", open_ianseo)
    menu.addAction("Stäng av nätverksåtkomst", network_off)


tray.setContextMenu(menu)
tray.activated.connect(lambda reason: open_ianseo() if reason == QSystemTrayIcon.ActivationReason.Trigger else None)
update()
tray.show()

timer = QTimer()
timer.timeout.connect(update)
timer.start(5000)
sys.exit(app.exec())
