#!/usr/bin/env python3
"""GoblinRecorder – the service that records WoW automatically (user unit
goblincakes-recorder.service). The window is /usr/bin/goblin-recorder.

  goblincakes-recorder run        follow the combat log and steer OBS (the service)
  goblincakes-recorder start-obs  start OBS hidden, ready for GoblinRecorder
  goblincakes-recorder setup      make OBS's profile/scenes/audio tracks (OBS must run)
  goblincakes-recorder status     what the service sees right now (JSON)

Raid: every boss pull becomes its own video. Mythic+: the whole key. Arena (also Solo
Shuffle): the whole match. OBS starts recording on ENCOUNTER_START / CHALLENGE_MODE_START /
ARENA_MATCH_START and stops a few seconds after the end. WoW
writes the combat log in chunks 10–60 s late, but flushes it at once on a boss pull/end
(measured 11 Oct: 0.00 s) – so the start is on time. Deaths come later and are added
as marks to the video's .json afterwards.
"""
import json
import os
import re
import signal
import threading
import statistics
import sys
import time
import traceback
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.environ.get("GOBLINCAKES_RECORDER_SHARE", "/usr/share/goblincakes/recorder"))
import recorder as R  # noqa: E402

LIVE_LIMIT = 30  # a start line older than this (seconds) is not recorded
LATE_MARKS = 120  # seconds after a video ends that late log lines may still add marks
MAX_LENGTH = {"raid": 45 * 60, "mplus": 3 * 3600, "arena": 45 * 60}
WCL_EVERY = 5 * 60  # look for Warcraft Logs fights this often …
WCL_FOR = 24 * 3600  # … for videos this young
ME = re.compile(r'^(Player-[^,]+),"([^"]+)",0x511,')  # a line by your own character


def log(*a):
    print(datetime.now().strftime("%H:%M:%S"), *a, flush=True)


class Service:
    def __init__(self):
        self.cfg = R.load_config()
        self.cfg_mtime = self.mtime(R.CONFIG_FILE)
        self.obs = None
        self.obs_state = "stopped"
        self.obs_error = ""
        self.obs_ready = False
        self.last_try = 0
        self.wow = False
        self.wow_seen = 0
        # log following
        self.path = None
        self.fh = None
        self.buf = ""
        self.delays = []
        # what is going on in the game
        self.zone = None  # {"name", "difficulty", "kind"}
        self.zone_name = ""  # the last ZONE_CHANGE, also outside raids/dungeons (the arena's name)
        self.current = None  # the pull / key being recorded
        self.stop_at = 0  # wall time to stop OBS (after the end + postRoll)
        self.closing = []  # saved videos that late log lines may still add deaths to
        self.last_video = ""
        self.error = ""
        self.last_status = 0
        self.me = ""  # Name-Realm-Region of the character playing (for Warcraft Logs)
        self.wcl_next = time.time() + 60
        self.wcl_busy = False
        self.tidy = False  # WoW closed: remove non-kills once the last video is saved
        self.screen_ok = None  # KDE told OBS which screen to record?
        self.screen_check = 0

    @staticmethod
    def mtime(p):
        try:
            return p.stat().st_mtime
        except OSError:
            return 0

    # ------------------------------------------------------------ OBS connection
    def connect(self):
        if self.obs:
            return True
        now = time.time()
        if now - self.last_try < 5:
            return False
        self.last_try = now
        if not R.obs_installed():
            self.obs_state = "missing"
            return False
        if not R.obs_running():
            self.obs_state = "stopped"
            self.obs_ready = False
            return False
        if not R.ws_settings().get("server_enabled"):
            self.obs_state = "no-ws"
            return False
        try:
            self.obs = R.OBS().connect()
            self.obs_state = "connected"
            self.obs_error = ""
            log("connected to OBS")
        except (R.OBSError, OSError) as e:
            self.obs = None
            self.obs_state = "error"
            self.obs_error = str(e)
            return False
        if not self.obs_ready:
            try:
                done = R.setup_obs(self.obs, self.cfg)
                if done:
                    log("OBS set up:", ", ".join(done))
                self.obs_ready = True
                if "restart" in done:
                    self.restart_obs()
            except (R.OBSError, OSError) as e:
                self.obs_error = f"Kunde inte ställa in OBS: {e}"
                log(self.obs_error)
        return True

    def restart_obs(self):
        log("restarting OBS for the new settings")
        self.obs.close()
        self.obs = None
        self.last_try = 0
        R.restart_obs()

    def call(self, *a, **kw):
        if not self.connect():
            raise R.OBSError("OBS är inte igång")
        try:
            return self.obs.call(*a, **kw)
        except (OSError, R.OBSError) as e:
            if isinstance(e, R.OBSError) and "stängde" not in str(e):
                raise
            self.obs.close()
            self.obs = None
            self.obs_ready = False
            self.screen_ok = None
            raise R.OBSError("Tappade kontakten med OBS") from e

    # ------------------------------------------------------------ combat log
    def follow(self):
        newest = R.newest_log()
        if newest and newest != self.path:
            self.path = newest
            self.fh = open(newest, "r", errors="replace")
            if newest.stat().st_ctime < time.time() - 60:
                self.fh.seek(0, 2)  # an older file: only what comes from now on
            self.buf = ""
            log("following", newest.name)
        if not self.fh:
            return
        data = self.fh.read()
        if not data:
            return
        now = time.time()
        self.buf += data
        *lines, self.buf = self.buf.split("\n")
        for line in lines:
            p = R.parse_line(line)
            if p:
                self.delays = (self.delays + [now - p[0]])[-2000:]
                self.event(*p, now)

    def event(self, t, ev, rest, now):
        live = now - t < LIVE_LIMIT
        if rest.startswith("Player-") and ",0x511," in rest[:160]:
            m = ME.match(rest)
            if m and m.group(2) != self.me:
                self.me = m.group(2)
        if ev == "ZONE_CHANGE":
            a = R.split_args(rest)
            try:
                diff = int(a[2])
            except (IndexError, ValueError):
                diff = 0
            kind = "raid" if diff in R.RAID_DIFFICULTIES else "dungeon" if diff in R.DUNGEON_DIFFICULTIES else None
            self.zone_name = a[1] if len(a) > 1 else ""
            if self.current and not self.stop_at:
                if self.current["kind"] == "arena":
                    if self.current["zone"] and self.zone_name != self.current["zone"]:
                        self.finish(t, "abandoned")  # left the arena before the end
                elif kind is None or a[1] != (self.zone or {}).get("name"):
                    self.finish(t, "abandoned")  # left the dungeon/raid mid key or pull
            self.zone = {"name": a[1], "difficulty": diff, "kind": kind} if kind else None
        elif ev == "ENCOUNTER_START":
            a = R.split_args(rest)
            diff = int(a[2]) if a[2].isdigit() else 0
            if self.current and self.current["kind"] == "mplus":
                self.marker(t, "boss", a[1])
            elif R.raid_level_wanted(self.cfg, diff) and live and not self.current:
                self.begin(t, now, {"kind": "raid", "name": a[1], "encounter": a[0],
                                    "difficulty": R.RAID_DIFFICULTIES[diff]})
        elif ev == "ENCOUNTER_END":
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "raid" and a[0] == self.current["encounter"]:
                self.finish(t, "kill" if a[4] == "1" else "wipe")
            elif self.current and self.current["kind"] == "mplus":
                self.marker(t, "boss-end", a[1] + (" ✓" if a[4] == "1" else " ✗"))
        elif ev == "CHALLENGE_MODE_START":
            a = R.split_args(rest)
            level = int(a[3]) if len(a) > 3 and a[3].isdigit() else 0
            if self.cfg["mplus"] and live and level >= max(int(self.cfg.get("mplusMin") or 2), 2):
                if self.current:
                    self.stop_now()
                self.begin(t, now, {"kind": "mplus", "name": a[0], "difficulty": "Mythic+", "level": level})
        elif ev == "CHALLENGE_MODE_END":
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "mplus":
                self.finish(t, "timed" if len(a) > 1 and a[1] == "1" else "depleted")
        elif ev == "ARENA_MATCH_START":
            # instance id, (unused), bracket ("2v2", "3v3", "Rated Solo Shuffle", "Skirmish" …), your team
            a = R.split_args(rest)
            if self.cfg.get("arena") and live:
                if self.current:
                    self.stop_now()
                self.begin(t, now, {"kind": "arena", "name": self.zone_name or "Arena",
                                    "difficulty": a[2] if len(a) > 2 else "Arena",
                                    "team": a[3] if len(a) > 3 else "", "zone": self.zone_name})
        elif ev == "ARENA_MATCH_END":
            # winning team, duration, new ratings – Solo Shuffle is won or lost per round, so
            # the whole match only gets "done"
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "arena":
                if "shuffle" in self.current["difficulty"].lower() or not self.current["team"]:
                    self.finish(t, "done")
                else:
                    self.finish(t, "win" if a[0] == self.current["team"] else "loss")
        elif ev == "UNIT_DIED":
            a = R.split_args(rest)
            if len(a) > 5 and a[4].startswith("Player-"):
                self.marker(t, "death", a[5].split("-")[0])

    def marker(self, t, kind, text):
        m = {"t": t, "kind": kind, "text": text}
        if self.current and t >= self.current["wall"] - 5:
            self.current["markers"].append(m)
            return
        for meta in self.closing:  # a death that reached the log after the video was saved
            if meta["_wall"] - 5 <= t <= meta["_wall"] + meta["duration"]:
                meta["markers"].append({"t": round(max(t - meta["_wall"], 0), 2), "kind": kind, "text": text})
                self.write_meta(meta)

    # ------------------------------------------------------------ recording
    def begin(self, t, now, info):
        try:
            if self.call("GetRecordStatus").get("outputActive"):
                self.error = "OBS spelar redan in (startat för hand) – GoblinRecorder hoppar över den här."
                return
            self.call("StartRecord")
            for _ in range(20):  # OBS answers at once and starts the output a moment later
                if self.call("GetRecordStatus").get("outputActive"):
                    wall = time.time()  # the video's first frame
                    break
                time.sleep(0.25)
            else:
                self.error = "OBS startade inte inspelningen – titta i OBS-fönstret om en ruta väntar på svar."
                log(self.error)
                return
        except R.OBSError as e:
            self.error = f"Kunde inte starta inspelningen: {e}"
            log(self.error)
            return
        info.update({"start": t, "wall": wall, "markers": [], "player": self.me,
                     "tracks": R.track_names(self.cfg)})
        self.current = info
        self.stop_at = 0
        self.error = ""
        log("recording", info["kind"], info["name"], f"(log {now - t:.2f} s late)")

    def finish(self, t, result):
        if not self.current or self.stop_at:
            return
        self.current.update({"end": t, "result": result})
        # The end line comes at once for bosses/keys; for "abandoned" it may be late
        self.stop_at = max(time.time(), t) + (self.cfg["postRoll"] if result != "abandoned" else 0)
        log("end", self.current["name"], result)

    def stop_now(self):
        cur, self.current, self.stop_at = self.current, None, 0
        if not cur:
            return
        cur.setdefault("end", time.time())
        cur.setdefault("result", "abandoned")
        try:
            out = self.call("StopRecord").get("outputPath")
        except R.OBSError as e:
            self.error = f"Kunde inte stoppa inspelningen: {e}"
            log(self.error)
            return
        if not out:
            self.error = "OBS sa inte var filmen hamnade."
            return
        try:
            self.save(cur, Path(out), time.time())
        except OSError as e:
            self.error = f"Kunde inte spara {cur['name']}: {e}"
            log(self.error)

    def save(self, cur, video, stopped):
        when = datetime.fromtimestamp(cur["start"])
        if cur["kind"] == "raid":
            title = f"{cur['name']} {cur['difficulty']}"
            result = {"kill": "KILL", "wipe": "WIPE"}.get(cur["result"], "AVBRUTEN")
        elif cur["kind"] == "arena":
            title = f"{cur['difficulty']} {cur['name']}"
            result = {"win": "VINST", "loss": "FÖRLUST", "done": "KLAR"}.get(cur["result"], "AVBRUTEN")
        else:
            title = f"+{cur['level']} {cur['name']}"
            result = {"timed": "I TID", "depleted": "FÖR SENT"}.get(cur["result"], "AVBRUTEN")
        dest = video.with_name(R.safe_name(f"{when:%Y-%m-%d %H.%M.%S} {title} {result}") + video.suffix)
        for _ in range(40):  # OBS finishes the file just after answering
            try:
                video.rename(dest)
                break
            except FileNotFoundError:
                time.sleep(0.25)
        wall = cur["wall"]
        meta = {
            "file": dest.name, "kind": cur["kind"], "name": cur["name"],
            "difficulty": cur["difficulty"], "level": cur.get("level"), "result": cur["result"],
            "started": cur["start"], "fight": cur["end"] - cur["start"], "duration": stopped - wall,
            "fightStart": round(max(cur["start"] - wall, 0), 2),
            "markers": [{"t": round(max(m["t"] - wall, 0), 2), "kind": m["kind"], "text": m["text"]}
                        for m in cur["markers"]],
            "codec": self.cfg["codec"], "fps": self.cfg["fps"], "tracks": cur.get("tracks", R.TRACK_NAMES),
            "player": cur.get("player", ""), "encounterId": cur.get("encounter"),
            "_wall": wall, "_until": time.time() + LATE_MARKS,
        }
        self.write_meta(meta, dest)
        R.make_thumb(dest, min(max(meta["fightStart"] + 20, 0), max(meta["duration"] - 2, 0)),
                     dest.with_suffix(".jpg"))
        self.closing.append(meta)
        self.last_video = dest.name
        log("saved", dest.name)
        if not self.cfg.get("keepWipes"):
            for name in R.drop_old_wipes(dest.parent, dict(meta, path=str(dest))):
                log("older wipe removed:", name)
        R.prune(dest.parent, self.cfg["maxGB"])

    def write_meta(self, meta, dest=None):
        dest = dest or Path(self.cfg["folder"]) / meta["file"]
        meta["_path"] = str(dest.with_suffix(".json"))
        data = {k: v for k, v in meta.items() if not k.startswith("_")}
        try:  # keep what was added to the file since (Warcraft Logs link, kept)
            old = json.loads(Path(meta["_path"]).read_text())
            data.update({k: old[k] for k in ("wcl", "keep") if k in old})
        except (OSError, ValueError):
            pass
        data["markers"] = sorted(data["markers"], key=lambda m: m["t"])
        Path(meta["_path"]).write_text(json.dumps(data, ensure_ascii=False, indent=1))

    def check_recording(self):
        if not self.current:
            return
        if self.stop_at and time.time() >= self.stop_at:
            self.stop_now()
            return
        if time.time() - self.current["wall"] > MAX_LENGTH[self.current["kind"]]:
            self.finish(time.time(), "abandoned")
            return
        try:
            if not self.call("GetRecordStatus").get("outputActive"):
                log("OBS stopped recording by itself")
                self.current = None
                self.stop_at = 0
                self.error = "OBS slutade spela in (stängt?) – filmen kan vara ofullständig."
        except R.OBSError:
            self.current = None
            self.stop_at = 0
            self.error = "OBS stängdes under inspelningen."

    def tidy_up(self):
        """WoW closed (or the computer shuts down): only kills stay – no heaps of wipes."""
        if self.cfg.get("keepWipes"):
            return
        for name in R.drop_non_kills(self.cfg["folder"]):
            log("removed (not a kill):", name)
        self.last_video = f"tidy {time.time()}"  # the window reloads its list

    def shutdown(self, *_):
        """Logout/shutdown: save what is being recorded, tidy up, quit."""
        log("stopping")
        if self.current:
            self.finish(time.time(), "abandoned")
            self.stop_now()
        self.tidy_up()
        self.status()
        sys.exit(0)

    # ------------------------------------------------------------ Warcraft Logs
    def wcl_check(self):
        """Videos from the last day without a Warcraft Logs link: ask again (the upload
        comes some minutes after the fight). Runs beside the main loop."""
        if self.wcl_busy or time.time() < self.wcl_next or not R.wcl_configured():
            return
        self.wcl_next = time.time() + WCL_EVERY
        todo = [v for v in R.video_files(self.cfg["folder"])
                if v.get("kind") in ("raid", "mplus") and not v.get("wcl") and v.get("player") and time.time() - v["started"] < WCL_FOR]
        if not todo:
            return
        self.wcl_busy = True
        threading.Thread(target=self.wcl_run, args=(todo,), daemon=True).start()

    def wcl_run(self, todo):
        try:
            for v in todo:
                found = R.wcl_find(v)
                if found:
                    R.set_meta(v["path"], wcl=found)
                    self.last_video = Path(v["path"]).name + "#wcl"
                    log("Warcraft Logs:", v["file"], found["url"])
        except Exception as e:  # noqa: BLE001 – no network etc.: try again later
            log("Warcraft Logs:", e)
        finally:
            self.wcl_busy = False

    # ------------------------------------------------------------ main loop
    def tick(self):
        now = time.time()
        # A change during a recording waits until it is done (OBS is not touched while recording)
        if self.mtime(R.CONFIG_FILE) != self.cfg_mtime and not self.current:
            self.cfg_mtime = self.mtime(R.CONFIG_FILE)
            self.cfg = R.load_config()
            if self.obs:
                try:
                    if R.apply_settings(self.obs, self.cfg) == "restart":
                        self.restart_obs()
                    log("settings applied")
                except R.OBSError as e:
                    self.obs_error = str(e)
        if now - self.wow_seen > 5:
            self.wow_seen = now
            running = R.wow_running()
            if running and not self.wow:
                log("WoW started")
                if self.cfg["autoStartObs"] and not R.obs_running():
                    R.start_obs()
            if not running and self.wow:
                log("WoW stopped")
                self.finish(now, "abandoned")
                self.zone = None
                self.tidy = True
            self.wow = running
        self.follow()
        self.check_recording()
        if self.tidy and not self.current:
            self.tidy = False
            self.tidy_up()
        self.closing = [m for m in self.closing if m["_until"] > now]
        self.wcl_check()
        if self.wow or self.current or R.obs_running():
            self.connect()
            if self.obs and not self.screen_ok and now - self.screen_check > 5:
                self.screen_check = now
                self.screen_ok = R.screen_chosen_live(self.obs)
        elif self.obs:
            self.obs.close()
            self.obs = None
        if now - self.last_status >= 1:
            self.last_status = now
            self.status()

    def status(self):
        delays = self.delays[-500:]
        log_fresh = self.path is not None and time.time() - self.mtime(self.path) < 300
        R.write_status({
            "time": time.time(), "pid": os.getpid(), "wow": self.wow, "logging": log_fresh,
            "logFile": self.path.name if self.path else "",
            "logDelay": round(statistics.median(delays), 1) if delays else None,
            "obs": self.obs_state if self.obs or self.obs_state != "connected" else "stopped",
            "obsError": self.obs_error,
            "zone": self.zone["name"] if self.zone else "",
            "recording": bool(self.current),
            "current": {k: self.current[k] for k in ("kind", "name", "difficulty", "start")
                        } if self.current else None,
            "lastVideo": self.last_video, "error": self.error, "player": self.me,
            "screen": self.screen_ok,
        })

    def run(self):
        log("GoblinRecorder service started")
        signal.signal(signal.SIGTERM, self.shutdown)
        while True:
            try:
                self.tick()
            except Exception:  # noqa: BLE001 – the service must keep going
                log(traceback.format_exc())
            time.sleep(0.25 if (self.wow or self.current) else 2)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        Service().run()
    elif cmd == "start-obs":
        err = R.start_obs()
        print(err or "OBS startat")
        sys.exit(1 if err else 0)
    elif cmd == "setup":
        with R.OBS() as obs:
            print(", ".join(R.setup_obs(obs, R.load_config())) or "redan klart")
    elif cmd == "status":
        print(json.dumps(R.read_status(), ensure_ascii=False, indent=1))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
