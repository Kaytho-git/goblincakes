#!/usr/bin/env python3
"""GoblinRecorder – the service that records WoW automatically (user unit
goblincakes-recorder.service). The window is /usr/bin/goblin-recorder.

  goblincakes-recorder run        follow the combat log and steer OBS (the service)
  goblincakes-recorder start-obs  start OBS hidden, ready for GoblinRecorder
  goblincakes-recorder setup      make OBS's profile/scenes/audio tracks (OBS must run)
  goblincakes-recorder status     what the service sees right now (JSON)
  goblincakes-recorder cs2-clips <video>  the 2K–ACE clips and the reel of a CS2 match again
  goblincakes-recorder cs2-demo <demo> [<video>]  read a CS2 demo into its match (step 2)

Raid: every boss pull becomes its own video. Mythic+: the whole key. Arena (also Solo
Shuffle): the whole match. Counter-Strike 2: the match from the end of the warm-up to the end,
from what CS2 sends itself (Game State Integration, recorder.cs2_*). OBS starts recording on ENCOUNTER_START / CHALLENGE_MODE_START /
ARENA_MATCH_START and stops a few seconds after the end. WoW
writes the combat log in chunks 10–60 s late, but flushes it at once on a boss pull/end
(measured 11 Oct: 0.00 s) – so the start is on time. Deaths come later and are added
as marks to the video's .json afterwards.
"""
import json
import os
import queue
import re
import signal
import threading
import statistics
import subprocess
import sys
import time
import traceback
from datetime import datetime
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

sys.path.insert(0, os.environ.get("GOBLINCAKES_RECORDER_SHARE", "/usr/share/goblincakes/recorder"))
import recorder as R  # noqa: E402

LIVE_LIMIT = 30  # a start line older than this (seconds) is not recorded
LATE_MARKS = 120  # seconds after a video ends that late log lines may still add marks
MAX_LENGTH = {"raid": 45 * 60, "mplus": 3 * 3600, "arena": 45 * 60, "cs2": 3 * 3600, "test": 5 * 60}
WCL_EVERY = 5 * 60  # look for Warcraft Logs fights this often …
WCL_LIVE_EVERY = 30  # … and this often while a report is live logged (or just after a recording)
WCL_LIVE_FOR = 20 * 60  # live = a live-logged report seen this recently
WCL_FOR = 24 * 3600  # … for videos this young
WCL_FRESH = 15 * 60  # a video this young without a link is looked for …
REPORT_AGAIN = 30 * 60  # a report from tonight is read again this often (it grows during the evening)
REPORT_FRESH = 12 * 3600  # … while its newest video is this young
DEMO_EVERY = 30  # look for new CS2 demos this often (while a match waits for one)
DEMO_SETTLE = 15  # a demo unchanged this long is whole (downloaded / `stop` given)
WCL_FRESH_EVERY = 15  # … this often (only the fresh ones: Live Log has the fight within seconds)
WCL_UNRANKED_SOON = 5 * 60  # parses not ranked yet: asked again this often the first hour, then hourly
ME = re.compile(r'^(Player-[^,]+),"([^"]+)",0x511,')  # a line by your own character


def log(*a):
    print(datetime.now().strftime("%H:%M:%S"), *a, flush=True)


def notify(title, text):
    try:
        subprocess.Popen(["notify-send", "-a", "GoblinRecorder", "-i", "goblincakes-recorder", title, text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def load_seen():
    """The demos already looked at (path → mtime) – they stay in CS2's folders."""
    try:
        return json.loads(R.DEMO_SEEN.read_text())
    except (OSError, ValueError):
        return {}


def save_seen(seen):
    R.DEMO_SEEN.parent.mkdir(parents=True, exist_ok=True)
    R.DEMO_SEEN.write_text(json.dumps(seen))


class GSIHandler(BaseHTTPRequestHandler):
    """CS2 posts the game state here; the main loop takes it from the queue."""
    def do_POST(self):
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
        except ValueError:
            body = None
        self.send_response(200)
        self.end_headers()
        if isinstance(body, dict) and (body.get("auth") or {}).get("token") == self.server.token:
            self.server.inbox.put((time.time(), body))

    def log_message(self, *a):
        pass


class Service:
    def __init__(self):
        self.cfg = R.load_config()
        self.cfg_mtime = self.mtime(R.CONFIG_FILE)
        self.obs = None
        self.obs_state = "stopped"
        self.obs_error = ""
        self.obs_ready = False
        self.last_try = 0
        self.wow = False
        self.wow_seen = 0
        # log following
        self.path = None
        self.fh = None
        self.buf = ""
        self.delays = []
        # what is going on in the game
        self.zone = None  # {"id", "name", "difficulty", "kind"}
        self.zone_name = ""  # the last ZONE_CHANGE, also outside raids/dungeons (the arena's name)
        self.current = None  # the pull / key being recorded
        self.resume = None  # a key already going when the service started (CHALLENGE_MODE_START's args)
        self.stop_at = 0  # wall time to stop OBS (after the end + postRoll)
        self.closing = []  # saved videos that late log lines may still add deaths to
        self.last_video = ""
        self.error = ""
        self.last_status = 0
        self.me = ""  # Name-Realm-Region of the character playing (for Warcraft Logs)
        self.wcl_next = time.time() + 60
        self.wcl_busy = False
        self.tidy = False  # WoW closed: remove non-kills once the last video is saved
        self.screen_ok = None  # KDE told OBS which screen to record?
        self.screen_check = 0
        self.stall_check = 0  # last look for a frozen screen capture / OBS restart for it
        # OBS that we started with WoW/CS2 is closed a minute after the game (22 Oct, the user's
        # wish: it drew ~7 % of a CPU core and ~370 MB between games). One the user opened stays.
        self.obs_ours = False
        self.obs_close_at = 0
        self.test_wait = 0  # when a test recording was asked for (waiting for OBS)
        # Counter-Strike 2
        self.cs2 = False
        self.cs2_seen = 0  # last look for the cs2 process
        self.cs2_server = None
        self.cs2_inbox = queue.Queue()
        self.cs2_last = 0  # when CS2 last sent something
        self.cs2_error = ""
        self.cs2_map = ""
        self.gs = {}  # what the last messages said: own team, kills this round, health, phases
        self.demo_next = time.time() + 20
        self.demo_busy = False

    @staticmethod
    def mtime(p):
        try:
            return p.stat().st_mtime
        except OSError:
            return 0

    # ------------------------------------------------------------ OBS connection
    def connect(self):
        if self.obs:
            return True
        now = time.time()
        if now - self.last_try < 5:
            return False
        self.last_try = now
        if not R.obs_installed():
            self.obs_state = "missing"
            return False
        if not R.obs_running():
            self.obs_state = "stopped"
            self.obs_ready = False
            return False
        if not R.ws_settings().get("server_enabled"):
            self.obs_state = "no-ws"
            return False
        try:
            self.obs = R.OBS().connect()
            self.obs_state = "connected"
            self.obs_error = ""
            log("connected to OBS")
        except (R.OBSError, OSError) as e:
            self.obs = None
            self.obs_state = "error"
            self.obs_error = str(e)
            return False
        if not self.obs_ready:
            try:
                done = R.setup_obs(self.obs, self.cfg)
                if done:
                    log("OBS set up:", ", ".join(done))
                self.obs_ready = True
                if "restart" in done:
                    self.restart_obs()
            except (R.OBSError, OSError) as e:
                self.obs_error = f"Kunde inte ställa in OBS: {e}"
                log(self.obs_error)
        return True

    def restart_obs(self):
        log("restarting OBS")
        self.obs.close()
        self.obs = None
        self.last_try = 0
        R.restart_obs()

    def call(self, *a, **kw):
        if not self.connect():
            raise R.OBSError("OBS är inte igång")
        try:
            return self.obs.call(*a, **kw)
        except (OSError, R.OBSError) as e:
            if isinstance(e, R.OBSError) and "stängde" not in str(e):
                raise
            self.obs.close()
            self.obs = None
            self.obs_ready = False
            self.screen_ok = None
            raise R.OBSError("Tappade kontakten med OBS") from e

    # ------------------------------------------------------------ combat log
    def follow(self):
        newest = R.newest_log()
        if newest and newest != self.path:
            self.path = newest
            self.fh = open(newest, "r", errors="replace")
            if newest.stat().st_ctime < time.time() - 60:
                self.catch_up()
                self.fh.seek(0, 2)  # an older file: only what comes from now on
            self.buf = ""
            log("following", newest.name)
        if not self.fh:
            return
        data = self.fh.read()
        if not data:
            return
        now = time.time()
        self.buf += data
        *lines, self.buf = self.buf.split("\n")
        for line in lines:
            p = R.parse_line(line)
            if p:
                self.delays = (self.delays + [now - p[0]])[-2000:]
                self.event(*p, now)

    def catch_up(self):
        """The service started while WoW runs (restarted, updated): the zone and a key that is
        already going are read from the log, so the rest of the key is still recorded."""
        zone = key = None
        try:
            with open(self.path, "rb") as f:
                for raw in f:
                    if b"ZONE_CHANGE" not in raw and b"CHALLENGE_MODE_" not in raw:
                        continue
                    p = R.parse_line(raw.decode("utf-8", "replace").rstrip("\r\n"))
                    if not p:
                        continue
                    if p[1] == "ZONE_CHANGE":
                        zone = p[2]
                    elif p[1] == "CHALLENGE_MODE_START":
                        key = p[2]
                    elif p[1] == "CHALLENGE_MODE_END":
                        key = None
        except OSError:
            return
        if zone:
            self.event(0, "ZONE_CHANGE", zone, 0)
        a = R.split_args(key) if key else []
        if len(a) > 1 and self.zone and a[1] == self.zone["id"]:
            self.resume = key  # starts with the next live line
            log("key already going:", a[0])

    def event(self, t, ev, rest, now):
        live = now - t < LIVE_LIMIT
        if self.resume and live:
            key, self.resume = self.resume, None
            if not ev.startswith("CHALLENGE_MODE_") and not self.current:
                self.event(t, "CHALLENGE_MODE_START", key, now)
        if rest.startswith("Player-") and ",0x511," in rest[:160]:
            m = ME.match(rest)
            if m and m.group(2) != self.me:
                self.me = m.group(2)
        if ev == "ZONE_CHANGE":
            a = R.split_args(rest)
            try:
                diff = int(a[2])
            except (IndexError, ValueError):
                diff = 0
            kind = "raid" if diff in R.RAID_DIFFICULTIES else "dungeon" if diff in R.DUNGEON_DIFFICULTIES else None
            self.zone_name = a[1] if len(a) > 1 else ""
            if self.current and not self.stop_at:
                if self.current["kind"] == "arena":
                    if self.current["zone"] and self.zone_name != self.current["zone"]:
                        self.finish(t, "abandoned")  # left the arena before the end
                elif kind is None or a[0] != (self.zone or {}).get("id"):
                    # by the zone id: some dungeons have parts with their own name (Murder Row → Den of Indulgence)
                    self.finish(t, "abandoned")  # left the dungeon/raid mid key or pull
            self.zone = {"id": a[0], "name": a[1], "difficulty": diff, "kind": kind} if kind else None
        elif ev == "ENCOUNTER_START":
            a = R.split_args(rest)
            diff = int(a[2]) if a[2].isdigit() else 0
            if self.current and self.current["kind"] == "mplus":
                self.marker(t, "boss", a[1])
            elif R.raid_level_wanted(self.cfg, diff) and live and (
                    not self.current or self.current["kind"] == "test"):
                if self.current:
                    self.stop_now()
                self.begin(t, now, {"kind": "raid", "name": a[1], "encounter": a[0],
                                    "difficulty": R.RAID_DIFFICULTIES[diff]})
        elif ev == "ENCOUNTER_END":
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "raid" and a[0] == self.current["encounter"]:
                self.finish(t, "kill" if a[4] == "1" else "wipe")
            elif self.current and self.current["kind"] == "mplus":
                self.marker(t, "boss-end", a[1] + (" ✓" if a[4] == "1" else " ✗"))
        elif ev == "CHALLENGE_MODE_START":
            a = R.split_args(rest)
            level = int(a[3]) if len(a) > 3 and a[3].isdigit() else 0
            if self.cfg["mplus"] and live and level >= max(int(self.cfg.get("mplusMin") or 2), 2):
                if self.current:
                    self.stop_now()
                self.begin(t, now, {"kind": "mplus", "name": a[0], "difficulty": "Mythic+", "level": level})
        elif ev == "CHALLENGE_MODE_END":
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "mplus":
                self.finish(t, "timed" if len(a) > 1 and a[1] == "1" else "depleted")
        elif ev == "ARENA_MATCH_START":
            # instance id, (unused), bracket ("2v2", "3v3", "Rated Solo Shuffle", "Skirmish" …), your team
            a = R.split_args(rest)
            if self.cfg.get("arena") and live:
                if self.current:
                    self.stop_now()
                self.begin(t, now, {"kind": "arena", "name": self.zone_name or "Arena",
                                    "difficulty": a[2] if len(a) > 2 else "Arena",
                                    "team": a[3] if len(a) > 3 else "", "zone": self.zone_name})
        elif ev == "ARENA_MATCH_END":
            # winning team, duration, new ratings – Solo Shuffle is won or lost per round, so
            # the whole match only gets "done"
            a = R.split_args(rest)
            if self.current and self.current["kind"] == "arena":
                if "shuffle" in self.current["difficulty"].lower() or not self.current["team"]:
                    self.finish(t, "done")
                else:
                    self.finish(t, "win" if a[0] == self.current["team"] else "loss")
        elif ev == "UNIT_DIED":
            a = R.split_args(rest)
            if len(a) > 5 and a[4].startswith("Player-"):
                self.marker(t, "death", a[5].split("-")[0])

    # ------------------------------------------------------------ Counter-Strike 2
    def cs2_listen(self):
        """The HTTP server for CS2 while CS2 recording is on in the settings."""
        if self.cfg.get("cs2") and not self.cs2_server:
            try:
                srv = HTTPServer(("127.0.0.1", R.CS2_PORT), GSIHandler)
            except OSError as e:
                if self.cs2_error != str(e):
                    self.cs2_error = f"Port {R.CS2_PORT} är upptagen ({e})"
                    log(self.cs2_error)
                return
            srv.token, srv.inbox = R.cs2_token(), self.cs2_inbox
            threading.Thread(target=srv.serve_forever, daemon=True).start()
            self.cs2_server, self.cs2_error = srv, ""
            log("listening for CS2 on port", R.CS2_PORT)
        elif not self.cfg.get("cs2") and self.cs2_server:
            self.cs2_server.shutdown()
            self.cs2_server.server_close()
            self.cs2_server = None
        elif self.cs2_server:
            self.cs2_server.token = self.cfg.get("cs2Token") or self.cs2_server.token
        while True:
            try:
                t, body = self.cs2_inbox.get_nowait()
            except queue.Empty:
                break
            self.cs2_last = t
            self.cs2_event(t, body)

    def cs2_event(self, t, b):
        """One message from CS2. Kills, deaths and the team only count from your own player
        (after your death CS2 sends the player you watch); rounds, the bomb and the score are
        the same for everyone."""
        gs = self.gs
        me = (b.get("provider") or {}).get("steamid")
        p = b.get("player") or {}
        own = bool(me) and p.get("steamid") == me
        m = b.get("map")
        rnd = b.get("round") or {}
        rec = self.current and self.current["kind"] == "cs2" and not self.stop_at
        if not m:  # back in the main menu
            self.cs2_map = ""
            if rec:
                self.finish(t, "abandoned")
            self.gs = {}
            return
        self.cs2_map = m.get("name", "")
        if own and p.get("team"):
            gs["team"] = p["team"]
            gs["playing"] = True
        phase = m.get("phase")
        if phase == "live" and not self.current or (phase == "live" and self.current
                                                     and self.current["kind"] == "test"):
            if self.cfg.get("cs2") and gs.get("playing"):
                if self.current:
                    self.stop_now()
                self.begin(t, t, {"kind": "cs2", "name": R.cs2_map_name(m.get("name", "")),
                                  "difficulty": R.CS2_MODES.get(m.get("mode"), m.get("mode", "")),
                                  "map": m.get("name", ""), "mode": m.get("mode", "")})
                if self.current:
                    self.current["player"] = p.get("name", "") if own else ""
                    self.current["steamid"] = me or ""  # finds you in the demo
                    self.current["tracks"] = R.track_names(self.cfg, "CS2")
                gs.update(kills=None, killhs=None, dead=False, round=None, bomb=None)
            rec = self.current and self.current["kind"] == "cs2" and not self.stop_at
        if not rec:
            return
        st = p.get("state") or {}
        if own and st:
            kills, hs = st.get("round_kills", 0), st.get("round_killhs", 0)
            if gs.get("kills") is not None and kills > gs["kills"]:
                rounds = R.cs2_has_rounds(self.current.get("mode"))  # deathmatch: no rounds, no 2K–ACE
                for n in range(gs["kills"] + 1, kills + 1):
                    self.marker(t, "kill", R.cs2_kill_text(n if rounds else 1, hs > (gs.get("killhs") or 0)))
            gs["kills"], gs["killhs"] = kills, hs
            health = st.get("health")
            if health == 0 and not gs.get("dead"):
                self.marker(t, "death", "Du dog")
            elif health and gs.get("dead"):  # alive again (deathmatch; a new round): the reel starts here
                self.current.setdefault("spawns", []).append(t)
            gs["dead"] = health == 0
            if not self.current.get("player"):
                self.current["player"] = p.get("name", "")
        elif p.get("steamid") and not own and not gs.get("dead"):
            # CS2 shows another player = you died (often no message with your own 0 health first)
            self.marker(t, "death", "Du dog")
            gs["dead"] = True
        bomb = rnd.get("bomb")
        if bomb != gs.get("bomb") and bomb in ("planted", "defused", "exploded"):
            self.marker(t, "bomb", {"planted": "Bomben placerad", "defused": "Bomben desarmerad",
                                    "exploded": "Bomben exploderade"}[bomb])
        gs["bomb"] = bomb
        # the last round's end only comes with the gameover (round phase "freezetime" then)
        if (rnd.get("phase") == "over" or phase == "gameover") and gs.get("round") != m.get("round") \
                and rnd.get("win_team"):
            gs["round"] = m.get("round")
            won = rnd["win_team"] == gs.get("team")
            self.marker(t, "round", f"Runda {m.get('round')} {'vunnen' if won else 'förlorad'}")
        ct = (m.get("team_ct") or {}).get("score", 0)
        tt = (m.get("team_t") or {}).get("score", 0)
        mine, theirs = (ct, tt) if gs.get("team") == "CT" else (tt, ct)
        if R.cs2_has_rounds(self.current.get("mode")):
            self.current["score"] = f"{mine}–{theirs}"
        if phase == "gameover":
            self.finish(t, "win" if mine > theirs else "loss" if mine < theirs else "tie")

    def marker(self, t, kind, text):
        m = {"t": t, "kind": kind, "text": text}
        if self.current and t >= self.current["wall"] - 5:
            self.current["markers"].append(m)
            return
        for meta in self.closing:  # a death that reached the log after the video was saved
            if meta["_wall"] - 5 <= t <= meta["_wall"] + meta["duration"]:
                meta["markers"].append({"t": round(max(t - meta["_wall"], 0), 2), "kind": kind, "text": text})
                self.write_meta(meta)

    # ------------------------------------------------------------ recording
    def begin(self, t, now, info):
        for attempt in (1, 2):
            try:
                wall = self.start_record(info["kind"])
                break
            except R.OBSError as e:
                # OBS was restarted since the last call: the old connection is only found dead
                # now – connect again at once and retry instead of losing the boss
                if attempt == 1 and "Tappade kontakten" in str(e):
                    log("OBS connection was stale, reconnecting")
                    self.last_try = 0
                    continue
                self.error = f"Kunde inte starta inspelningen: {e}"
                log(self.error)
                return
        if not wall:
            return
        info.update({"start": t, "wall": wall, "markers": [], "player": self.me,
                     "tracks": R.track_names(self.cfg)})
        self.current = info
        self.stop_at = 0
        self.error = ""
        log("recording", info["kind"], info["name"], f"(log {now - t:.2f} s late)")

    def start_record(self, kind=None):
        """Starts OBS's recording; the time of the first frame, or None (error set)."""
        if self.call("GetRecordStatus").get("outputActive"):
            self.error = "OBS spelar redan in (startat för hand) – GoblinRecorder hoppar över den här."
            return None
        if self.obs and self.cfg.get("overlays"):
            try:  # the boxes that are on for this game
                R.overlays_for_game(self.obs, self.cfg, None if kind == "test" else "cs2" if kind == "cs2" else "wow")
            except (R.OBSError, OSError) as e:
                log("overlays:", e)
        self.call("StartRecord")
        for _ in range(20):  # OBS answers at once and starts the output a moment later
            if self.call("GetRecordStatus").get("outputActive"):
                return time.time()  # the video's first frame
            time.sleep(0.25)
        self.error = "OBS startade inte inspelningen – titta i OBS-fönstret om en ruta väntar på svar."
        log(self.error)
        return None

    def finish(self, t, result):
        if not self.current or self.stop_at:
            return
        self.current.update({"end": t, "result": result})
        # The end line comes at once for bosses/keys; for "abandoned" it may be late
        self.stop_at = max(time.time(), t) + (self.cfg["postRoll"] if result != "abandoned" else 0)
        log("end", self.current["name"], result)

    def stop_now(self):
        cur, self.current, self.stop_at = self.current, None, 0
        if not cur:
            return
        cur.setdefault("end", time.time())
        cur.setdefault("result", "abandoned")
        try:
            out = self.call("StopRecord").get("outputPath")
        except R.OBSError as e:
            self.error = f"Kunde inte stoppa inspelningen: {e}"
            log(self.error)
            return
        if not out:
            self.error = "OBS sa inte var filmen hamnade."
            return
        try:
            self.save(cur, Path(out), time.time())
        except OSError as e:
            self.error = f"Kunde inte spara {cur['name']}: {e}"
            log(self.error)

    def save(self, cur, video, stopped):
        when = datetime.fromtimestamp(cur["start"])
        if cur["kind"] == "raid":
            title = f"{cur['name']} {cur['difficulty']}"
            result = {"kill": "KILL", "wipe": "WIPE"}.get(cur["result"], "AVBRUTEN")
        elif cur["kind"] == "test":
            title, result = "Testinspelning", cur["difficulty"]
        elif cur["kind"] == "arena":
            title = f"{cur['difficulty']} {cur['name']}"
            result = {"win": "VINST", "loss": "FÖRLUST", "done": "KLAR"}.get(cur["result"], "AVBRUTEN")
        elif cur["kind"] == "cs2":
            title = f"CS2 {cur['name']} {cur['difficulty']}"
            result = {"win": "VINST", "loss": "FÖRLUST", "tie": "OAVGJORT"}.get(cur["result"], "AVBRUTEN")
            if cur.get("score"):
                result += " " + cur["score"].replace("–", "-")
        else:
            title = f"+{cur['level']} {cur['name']}"
            result = {"timed": "I TID", "depleted": "FÖR SENT"}.get(cur["result"], "AVBRUTEN")
        dest = video.with_name(R.safe_name(f"{when:%Y-%m-%d %H.%M.%S} {title} {result}") + video.suffix)
        for _ in range(40):  # OBS finishes the file just after answering
            try:
                video.rename(dest)
                break
            except FileNotFoundError:
                time.sleep(0.25)
        wall = cur["wall"]
        meta = {
            "file": dest.name, "kind": cur["kind"], "name": cur["name"],
            "difficulty": cur["difficulty"], "level": cur.get("level"), "result": cur["result"],
            "started": cur["start"], "fight": cur["end"] - cur["start"], "duration": stopped - wall,
            "fightStart": round(max(cur["start"] - wall, 0), 2),
            "markers": [{"t": round(max(m["t"] - wall, 0), 2), "kind": m["kind"], "text": m["text"]}
                        for m in cur["markers"]],
            "codec": self.cfg["codec"], "fps": self.cfg["fps"], "tracks": cur.get("tracks", R.TRACK_NAMES),
            "player": cur.get("player", ""), "encounterId": cur.get("encounter"),
            **({"score": cur.get("score", ""), "map": cur.get("map", ""), "mode": cur.get("mode", ""),
                "spawns": [round(max(t - wall, 0), 2) for t in cur.get("spawns", [])],
                "steamid": cur.get("steamid", ""),
                # step 2: the whole video waits for the demo (Valve keeps those of these modes)
                **({"demo": "waiting"} if cur.get("mode") in R.DEMO_MODES and cur["result"] in ("win", "loss", "tie")
                   else {})}
               if cur["kind"] == "cs2" else {}),
            "_wall": wall, "_until": time.time() + LATE_MARKS,
        }
        self.write_meta(meta, dest)
        R.wow_history_add(meta)  # WoW Stats: every pull and key, also when the video goes later
        if cur["kind"] == "cs2":
            R.cs2_history_add([meta])  # CS2 Stats: the same
        # A live-logged fight is on Warcraft Logs within seconds – look at once, not in 5 minutes
        self.wcl_next = min(self.wcl_next, time.time() + 3)
        R.make_thumb(dest, min(max(meta["fightStart"] + 20, 0), max(meta["duration"] - 2, 0)),
                     dest.with_suffix(".jpg"))
        self.closing.append(meta)
        self.last_video = dest.name
        log("saved", dest.name)
        if not self.cfg.get("keepWipes"):
            for name in R.drop_old_wipes(dest.parent, dict(meta, path=str(dest))):
                log("older wipe removed:", name)
        if cur["kind"] == "test":
            for name in R.drop_old_tests(dest.parent, dest):
                log("older test removed:", name)
        if cur["kind"] == "cs2":
            threading.Thread(target=self.cs2_clips, args=(dest.with_suffix(".json"),), daemon=True).start()
        R.prune(dest.parent, self.cfg["maxGB"])

    def cs2_clips(self, meta_path):
        """2K–ACE and the reel – after the late marks have had their time (none come for CS2, but
        the .json is written once more when the video is saved)."""
        time.sleep(3)
        try:
            made, err = R.cs2_make_clips(meta_path, keep_match=bool(self.cfg.get("cs2KeepMatch")))
        except Exception as e:  # noqa: BLE001 – the match stays as it is
            made, err = [], str(e)
        log("CS2 clips:", len(made), err)
        if err:
            self.error = f"CS2-klippen: {err}"
        self.last_video = f"clips {time.time()}"  # the window reads the list again
    def write_meta(self, meta, dest=None):
        dest = dest or Path(self.cfg["folder"]) / meta["file"]
        meta["_path"] = str(dest.with_suffix(".json"))
        data = {k: v for k, v in meta.items() if not k.startswith("_")}
        try:  # keep what was added to the file since (Warcraft Logs link and numbers, kept)
            old = json.loads(Path(meta["_path"]).read_text())
            data.update({k: old[k] for k in ("wcl", "wclStats", "keep", "youtube", "clipsMade", "videoRemoved",
                                         "demo", "demoFile", "demoStats", "demoRounds") if k in old})
        except (OSError, ValueError):
            pass
        data["markers"] = sorted(data["markers"], key=lambda m: m["t"])
        Path(meta["_path"]).write_text(json.dumps(data, ensure_ascii=False, indent=1))

    def check_recording(self):
        if not self.current:
            return
        if self.stop_at and time.time() >= self.stop_at:
            self.stop_now()
            return
        if time.time() - self.current["wall"] > MAX_LENGTH[self.current["kind"]]:
            self.finish(time.time(), "abandoned")
            return
        try:
            if not self.call("GetRecordStatus").get("outputActive"):
                log("OBS stopped recording by itself")
                self.current = None
                self.stop_at = 0
                self.error = "OBS slutade spela in (stängt?) – filmen kan vara ofullständig."
        except R.OBSError:
            self.current = None
            self.stop_at = 0
            self.error = "OBS stängdes under inspelningen."

    # ------------------------------------------------------------ test recording
    def check_test(self):
        """The window asked for a test: OBS is started if needed, then TEST_SECONDS are
        recorded with the settings as they are – the same way a boss is recorded."""
        if self.current or not R.TEST_REQUEST.exists():
            return
        now = time.time()
        if not self.test_wait:
            self.test_wait = now
            log("test recording asked for")
            if not R.obs_running():
                err = R.start_obs()
                if err:
                    return self.test_failed(err)
        if now - self.test_wait > 90:
            return self.test_failed("Testinspelningen blev inte av – OBS kom inte igång"
                                    + (" (välj skärm först)." if self.obs and not self.screen_ok else "."))
        if not self.connect() or not self.screen_ok:
            return  # OBS is starting, being set up or waits for the screen choice
        R.TEST_REQUEST.unlink(missing_ok=True)
        self.test_wait = 0
        quality = R.QUALITY_NAMES.get(self.cfg.get("quality"), "Normal")
        self.begin(now, now, {"kind": "test", "name": "Testinspelning", "difficulty": quality})
        if self.current:
            self.current["result"] = "test"
            self.stop_at = self.current["wall"] + R.TEST_SECONDS

    def test_failed(self, message):
        self.error = message
        log(message)
        R.TEST_REQUEST.unlink(missing_ok=True)
        self.test_wait = 0

    def tidy_up(self):
        """WoW closed (or the computer shuts down): only kills stay – no heaps of wipes."""
        if self.cfg.get("keepWipes"):
            return
        for name in R.drop_non_kills(self.cfg["folder"]):
            log("removed (not a kill):", name)
        self.last_video = f"tidy {time.time()}"  # the window reloads its list

    def shutdown(self, *_):
        """Logout/shutdown: save what is being recorded, tidy up, quit."""
        log("stopping")
        if self.current:
            self.finish(time.time(), "abandoned")
            self.stop_now()
        if not R.wow_running():  # only restarted while WoW runs: wipes are tidied when WoW closes
            self.tidy_up()
        self.status()
        sys.exit(0)

    # ------------------------------------------------------------ Warcraft Logs
    def wcl_check(self):
        """Videos from the last day without a Warcraft Logs link: ask again (the upload
        comes some minutes after the fight). Runs beside the main loop."""
        if self.wcl_busy or time.time() < self.wcl_next or not R.wcl_configured():
            return
        live = time.time() - R.wcl_live_seen < WCL_LIVE_FOR
        self.wcl_next = time.time() + (WCL_LIVE_EVERY if live else WCL_EVERY)
        todo = [v for v in R.video_files(self.cfg["folder"])
                if v.get("kind") in ("raid", "mplus") and not v.get("wcl") and v.get("player") and time.time() - v["started"] < WCL_FOR]
        # Just recorded (from the pull: the start + the fight + a few minutes): only those, often
        fresh = [v for v in todo if time.time() - v["started"] - (v.get("fight") or 0) < WCL_FRESH]
        if fresh:
            todo = fresh
            self.wcl_next = time.time() + WCL_FRESH_EVERY
        # WoW Stats: your numbers from the log of each kill and key – at once, and once more when the
        # parses have settled (an hour after the end)
        now = time.time()
        stats = [v for v in R.video_files(self.cfg["folder"])
                 if v.get("kind") in ("raid", "mplus") and v.get("wcl") and v.get("result") in ("kill", "timed")
                 and now - v["started"] < WCL_FOR + 3600
                 and (not v.get("wclStats") or v["wclStats"].get("fetched", 0) < v["started"] + (v.get("fight") or 0) + 3600 <= now
                      or not v["wclStats"].get("ranked") and now - v["wclStats"].get("fetched", 0)
                      > (WCL_UNRANKED_SOON if now - v["started"] - (v.get("fight") or 0) < 3600 else 3600))]
        # a.ilvl on the card: every video with a link, old ones too (cheap)
        ilvl = [v for v in R.video_files(self.cfg["folder"])
                if v.get("kind") in ("raid", "mplus", "arena") and v.get("wcl") and "avgIlvl" not in v][:20]
        # WoW Stats: every pull in the reports your videos point to – wipes too, also deleted/unrecorded ones
        newest = {}
        for v in R.video_files(self.cfg["folder"]):
            if v.get("kind") == "raid" and v.get("wcl") and v.get("player"):
                c = v["wcl"]["code"]
                newest[c] = max(newest.get(c, (0, ""))[0], v["started"]), v["player"]
        seen = R.reports_read()
        reports = [(c, p) for c, (t, p) in newest.items()
                   if c not in seen or (now - t < REPORT_FRESH and now - seen[c] > REPORT_AGAIN)][:5]
        if not todo and not stats and not ilvl and not reports:
            return
        self.wcl_busy = True
        threading.Thread(target=self.wcl_run, args=(todo, stats, ilvl, reports), daemon=True).start()

    def wcl_run(self, todo, stats=(), ilvl=(), reports=()):
        try:
            for v in todo:
                found = R.wcl_find(v)
                if found:
                    R.set_meta(v["path"], wcl=found)
                    self.last_video = Path(v["path"]).name + "#wcl"
                    log("Warcraft Logs:", v["file"], found["url"])
            for v in stats:
                R.set_meta(v["path"], wclStats=R.wcl_stats(v["wcl"]))
                R.wow_history_add(json.loads(Path(v["path"]).with_suffix(".json").read_text()))
                log("Warcraft Logs numbers:", v["file"])
            for v in ilvl:
                R.set_meta(v["path"], **R.wcl_ilvl(v["wcl"], v.get("player", "")))
                R.wow_history_add(json.loads(Path(v["path"]).with_suffix(".json").read_text()))
                self.last_video = Path(v["path"]).name + "#ilvl"
            for code, player in reports:
                n = R.wcl_report_pulls(code, player)
                R.reports_read(code)
                log("Warcraft Logs report", code, "read for WoW Stats:", n, "new pulls")
        except Exception as e:  # noqa: BLE001 – no network etc.: try again later
            log("Warcraft Logs:", e)
        finally:
            self.wcl_busy = False

    # ------------------------------------------------------------ CS2 demos (step 2)
    def demo_check(self):
        """A new demo in CS2's folders → the match waiting for it; 3 days without one → the
        whole video goes (the clips and the card stay). Not while recording."""
        now = time.time()
        if self.demo_busy or now < self.demo_next or self.current or self.closing:  # closing: its .json is still written
            return
        self.demo_next = now + DEMO_EVERY
        waiting = []
        for v in R.cs2_waiting(self.cfg["folder"]):
            if now - v.get("started", 0) > R.DEMO_WAIT:
                R.cs2_demo_skip(v["path"], expired=True)
                log("no demo in 3 days, video removed:", v["file"])
                self.last_video = f"demo {now}"
            else:
                waiting.append(v)
        if not waiting or not R.demoparser_ok():
            return
        seen = load_seen()
        new = []
        for dem in R.cs2_demo_files():
            mtime = dem.stat().st_mtime
            if seen.get(str(dem)) != mtime and now - mtime > DEMO_SETTLE and mtime >= waiting[0]["started"]:
                new.append((dem, mtime))
        if new:
            self.demo_busy = True
            threading.Thread(target=self.demo_run, args=(new,), daemon=True).start()

    def demo_run(self, demos):
        try:
            for dem, mtime in demos:
                res = R.cs2_demo_process(dem)
                log("CS2 demo", dem.name + ":", res)
                if res.get("error") and "demoparser2" in res["error"]:
                    return  # not seen – read when the library is there
                seen = load_seen()
                seen[str(dem)] = mtime
                save_seen(seen)
                if res.get("match"):
                    notify(res["text"], "Siffrorna och klippen finns på matchens kort i GoblinRecorder.")
                    self.last_video = f"demo {time.time()}"
        finally:
            self.demo_busy = False

    # ------------------------------------------------------------ main loop
    def tick(self):
        now = time.time()
        # A change during a recording waits until it is done (OBS is not touched while recording)
        if self.mtime(R.CONFIG_FILE) != self.cfg_mtime and not self.current:
            self.cfg_mtime = self.mtime(R.CONFIG_FILE)
            self.cfg = R.load_config()
            if self.obs:
                try:
                    if R.apply_settings(self.obs, self.cfg) == "restart":
                        self.restart_obs()
                    log("settings applied")
                except R.OBSError as e:
                    self.obs_error = str(e)
        if now - self.wow_seen > 5:
            self.wow_seen = now
            running = R.wow_running()
            if running and not self.wow:
                log("WoW started")
                self.obs_close_at = 0
                if self.cfg["autoStartObs"] and not R.obs_running():
                    R.start_obs()
                    self.obs_ours = True
            if not running and self.wow:
                log("WoW stopped")
                self.finish(now, "abandoned")
                self.zone = None
                self.tidy = True
            self.wow = running
        if now - self.cs2_seen > 5:
            self.cs2_seen = now
            running = R.cs2_running()
            if running and not self.cs2:
                log("CS2 started")
                waiting = R.cs2_waiting(self.cfg["folder"])
                if waiting:  # the reminder: matches whose demo isn't downloaded yet
                    n = len(waiting)
                    notify(f"{n} CS2-match{'er' if n > 1 else ''} väntar på demon",
                           "Ladda ner i CS2: Watch → Your Matches. GoblinRecorder läser den själv.")
                self.obs_close_at = 0
                if self.cfg["autoStartObs"] and self.cfg.get("cs2") and not R.obs_running():
                    R.start_obs()
                    self.obs_ours = True
            if not running and self.cs2:
                log("CS2 stopped")
                if self.current and self.current["kind"] == "cs2":
                    self.finish(now, "abandoned")
                self.gs, self.cs2_map = {}, ""
            self.cs2 = running
        if self.obs_ours and not (self.wow or self.cs2) and not self.obs_close_at:
            self.obs_close_at = now + 60
        self.close_obs_after_game(now)
        self.cs2_listen()
        self.follow()
        self.check_recording()
        self.check_test()
        if self.tidy and not self.current:
            self.tidy = False
            self.tidy_up()
        self.closing = [m for m in self.closing if m["_until"] > now]
        self.wcl_check()
        self.demo_check()
        if self.wow or self.cs2 or self.current or self.test_wait or R.obs_running():
            self.connect()
            if self.obs and not self.screen_ok and now - self.screen_check > 5:
                self.screen_check = now
                self.screen_ok = R.screen_chosen_live(self.obs)
            # Screens away for a moment = the capture freezes on the desktop; OBS picks
            # the same screen again by itself when it starts (between fights only)
            if self.obs and self.screen_ok and not self.current and now - self.stall_check > 5:
                self.stall_check = now
                if R.screen_stalled():
                    self.stall_check = now + 55  # OBS needs a moment to start again
                    log("screen capture frozen (screens were away) – restarting OBS")
                    self.restart_obs()
        elif self.obs:
            self.obs.close()
            self.obs = None
        if now - self.last_status >= 1:
            self.last_status = now
            self.status()

    def close_obs_after_game(self, now):
        if not self.obs_close_at or now < self.obs_close_at:
            return
        if self.wow or self.cs2:
            self.obs_close_at = 0
            return
        if self.current or self.test_wait or self.demo_busy:
            return   # a recording is finished, a test or a demo first
        self.obs_close_at = 0
        self.obs_ours = False
        if not R.obs_running():
            return
        log("game closed a minute ago – closing the OBS we started")
        if self.obs:
            self.obs.close()
            self.obs = None
        self.last_try = now + 40   # no new connection (or frozen-capture restart) while it closes
        threading.Thread(target=R.stop_obs, daemon=True).start()

    def status(self):
        delays = self.delays[-500:]
        log_fresh = self.path is not None and time.time() - self.mtime(self.path) < 300
        R.write_status({
            "time": time.time(), "pid": os.getpid(), "wow": self.wow, "logging": log_fresh,
            "logFile": self.path.name if self.path else "",
            "logDelay": round(statistics.median(delays), 1) if delays else None,
            "obs": self.obs_state if self.obs or self.obs_state != "connected" else "stopped",
            "obsError": self.obs_error,
            "zone": self.zone["name"] if self.zone else "",
            "recording": bool(self.current),
            "current": {k: self.current.get(k) for k in ("kind", "name", "difficulty", "start", "score")
                        } if self.current else None,
            "lastVideo": self.last_video, "error": self.error, "player": self.me,
            "screen": self.screen_ok,
            "testWaiting": bool(self.test_wait),
            "stopAt": self.stop_at if self.current else 0,
            "cs2": self.cs2, "cs2Listening": bool(self.cs2_server), "cs2Error": self.cs2_error,
            "cs2Last": self.cs2_last, "cs2Map": self.cs2_map,
        })

    def run(self):
        log("GoblinRecorder service started")
        signal.signal(signal.SIGTERM, self.shutdown)
        while True:
            try:
                self.tick()
            except Exception:  # noqa: BLE001 – the service must keep going
                log(traceback.format_exc())
            time.sleep(0.25 if (self.wow or self.cs2 or self.current or self.test_wait) else 2)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        Service().run()
    elif cmd == "start-obs":
        err = R.start_obs()
        print(err or "OBS startat")
        sys.exit(1 if err else 0)
    elif cmd == "setup":
        with R.OBS() as obs:
            print(", ".join(R.setup_obs(obs, R.load_config())) or "redan klart")
    elif cmd == "cs2-demo" and len(sys.argv) > 2:  # by hand: goblincakes-recorder cs2-demo <demo> [<video>]
        print(json.dumps(R.cs2_demo_run(sys.argv[2], Path(sys.argv[3]).with_suffix(".json") if len(sys.argv) > 3 else None),
                         ensure_ascii=False))
    elif cmd == "cs2-clips" and len(sys.argv) > 2:  # again by hand: goblincakes-recorder cs2-clips <video>
        made, err = R.cs2_make_clips(Path(sys.argv[2]).with_suffix(".json"),
                                     keep_match=bool(R.load_config().get("cs2KeepMatch")))
        print("\n".join(made) or "inga klipp", err, sep="\n" if err else "")
        sys.exit(1 if err else 0)
    elif cmd == "status":
        print(json.dumps(R.read_status(), ensure_ascii=False, indent=1))
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
