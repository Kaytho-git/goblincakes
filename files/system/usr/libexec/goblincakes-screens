#!/usr/bin/python3
# GOBLINCAKES: screens with different refresh rates (e.g. 180 Hz + 144 Hz).
# Runs at every login, but does something only once for each new combination of screens:
#  - every screen gets its highest refresh rate at its current resolution
#    (Plasma picks the screen's "preferred" mode, which is sometimes only 60 Hz)
#  - with several screens, the fastest one becomes priority 1 (main screen: games open there)
# Changes made afterwards in System Settings → Display are kept.
# And at every login: the top bar's clock the same size as the rest (see clock_size), and the
# login screen gets the same screen setup (see sync_sddm).
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "goblincakes"
state = STATE_DIR / "screens-done"
CLOCK_STATE = STATE_DIR / "clock-size"  # the clock size this script set last
SDDM_STATE = STATE_DIR / "sddm-screens"  # the screen setup the login screen got last
CLOCK_PT = 11  # GOBLINCAKES' clock: 11 pt like the week number beside it (layout.js)


def plasma_js(script):
    return subprocess.run(["busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                           "org.kde.PlasmaShell", "evaluateScript", "s", script],
                          capture_output=True, text=True)


def clock_size(outputs):
    """Plasma's clock turns its point size into pixels with the screen's *physical* DPI
    (Screen.pixelDensity), everything else with 96 DPI – on a 24" 1080p screen (82 DPI)
    11 pt became 12.5 px instead of 14.7, smaller than "v41" beside it (11 Oct). So the
    clock gets the point size that gives 11 pt at 96 DPI on the top bar's screen. Only
    while it has our font and our size (11 or what this script set) – the user's own is kept."""
    out = None
    for _ in range(15):  # plasmashell may still be starting
        r = plasma_js("""panels().forEach(function (p) { if (p.location !== "top") return;
            p.widgets().forEach(function (w) { if (w.type !== "org.kde.plasma.digitalclock") return;
                w.currentConfigGroup = ["Appearance"];
                print(p.screen + "|" + w.readConfig("fontFamily") + "|" + w.readConfig("fontSize") + ";"); }); });""")
        if r.returncode == 0 and "|" in r.stdout:
            out = r.stdout
            break
        time.sleep(2)
    if not out:
        return
    screen, family, size = out.split('"')[1].split(";")[0].split("|")
    # Plasma's screen 0 = the main screen (priority 1), and so on
    o = next((o for o in outputs if o.get("priority") == int(screen) + 1), outputs[0])
    width_mm = (o.get("sizeMM") or {}).get("width", 0)
    width_px = o["size"]["width"] / (o.get("scale") or 1)
    if width_mm < 100:
        return  # unknown physical size (VM, projector): Qt guesses, leave it
    dpi = width_px / (width_mm / 25.4)
    target = max(6, min(30, round(CLOCK_PT * 96 / dpi)))
    ours = {str(CLOCK_PT), CLOCK_STATE.read_text().strip() if CLOCK_STATE.exists() else ""}
    if family != "IBM Plex Sans" or size not in ours or size == str(target):
        return
    plasma_js("""panels().forEach(function (p) { if (p.location !== "top") return;
        p.widgets().forEach(function (w) { if (w.type !== "org.kde.plasma.digitalclock") return;
            w.currentConfigGroup = ["Appearance"]; w.writeConfig("fontSize", %d); }); });""" % target)
    CLOCK_STATE.parent.mkdir(parents=True, exist_ok=True)
    CLOCK_STATE.write_text(f"{target}\n")


def legacy_modes(conf):
    """Plasma 6.8's KWin saves a screen's mode as {"basic": {width, height, refreshRate}};
    up to 6.7 it read width/height/refreshRate directly in "mode". Both are kept, so going back
    to an older GOBLINCAKES (rollback) keeps the resolution and Hz. 6.8 reads "basic" first."""
    try:
        data = json.loads(conf.read_text())
    except (OSError, ValueError):
        return
    changed = False
    for part in data if isinstance(data, list) else []:
        if not isinstance(part, dict) or part.get("name") != "outputs":
            continue
        for o in part.get("data") or []:
            mode = o.get("mode") if isinstance(o, dict) else None
            basic = mode.get("basic") if isinstance(mode, dict) else None
            if not isinstance(basic, dict):
                continue
            for key in ("width", "height", "refreshRate"):
                if isinstance(basic.get(key), int) and mode.get(key) != basic[key]:
                    mode[key] = basic[key]
                    changed = True
    if not changed:
        return
    tmp = conf.with_name(conf.name + ".goblincakes-new")
    try:
        tmp.write_text(json.dumps(data, indent=4) + "\n")
        os.replace(tmp, conf)
    except OSError:
        pass


def sync_sddm():
    """The login screen's KWin has no settings of its own and took the first connector as the
    main screen – the login box ended up on the wrong screen (13 Oct). It gets a copy of the
    desktop's screen setup (as KDE's "Apply Plasma settings" does), whenever it has changed."""
    conf = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "kwinoutputconfig.json"
    legacy_modes(conf)
    try:
        raw = conf.read_bytes()
    except OSError:
        return
    digest = hashlib.sha256(raw).hexdigest()
    if SDDM_STATE.exists() and SDDM_STATE.read_text().strip() == digest:
        return
    try:
        r = subprocess.run(["pkexec", "/usr/libexec/goblincakes-sddm-screens"], input=raw,
                           capture_output=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return
    if r.returncode == 0:
        SDDM_STATE.parent.mkdir(parents=True, exist_ok=True)
        SDDM_STATE.write_text(digest + "\n")


try:
    data = json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True).stdout)
    outputs = [o for o in data.get("outputs", []) if o.get("connected") and o.get("enabled", True)]
except (OSError, ValueError):
    sys.exit(0)
if not outputs:
    sys.exit(0)
clock_size(outputs)

combination = ",".join(sorted(o["name"] for o in outputs))
done = state.read_text().split() if state.exists() else []
if combination in done:
    sync_sddm()
    sys.exit(0)

args = []
fastest = None  # (name, refresh rate)
for o in outputs:
    modes = o.get("modes", [])
    current = next((m for m in modes if m.get("id") == o.get("currentModeId")), None)
    if not current:
        continue
    same_size = [m for m in modes if m.get("size") == current.get("size")]
    top = max(same_size, key=lambda m: m.get("refreshRate", 0))
    if top.get("refreshRate", 0) > current.get("refreshRate", 0) + 0.5:
        args.append(f"output.{o['name']}.mode.{top['id']}")
    if fastest is None or top.get("refreshRate", 0) > fastest[1]:
        fastest = (o["name"], top.get("refreshRate", 0))

if len(outputs) > 1 and fastest:
    args.append(f"output.{fastest[0]}.priority.1")

if args and subprocess.run(["kscreen-doctor", *args]).returncode != 0:
    sys.exit(1)  # try again at the next login

state.parent.mkdir(parents=True, exist_ok=True)
state.write_text("\n".join(done + [combination]) + "\n")
if args:
    time.sleep(2)  # KWin writes its file a moment after the change
sync_sddm()
