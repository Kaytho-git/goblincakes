#!/usr/bin/env bash
# Runs at boot until it has succeeded once: makes snaps work with Fedora Atomic's
# home folders (/var/home). Snaps themselves (Claude desktop) are picked in GOBLINCAKES Config.
set -euo pipefail

done_file=/var/lib/goblincakes/snapd-setup-done
[ -e "$done_file" ] && exit 0

snap wait system seed.loaded

# Home folders live in /var/home on Fedora Atomic; snaps only accept /home otherwise
snap set system homedirs=/var/home

mkdir -p "$(dirname "$done_file")"
touch "$done_file"
