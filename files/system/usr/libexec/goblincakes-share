#!/usr/bin/python3
"""GoblinShare's service and command line (the LocalSend protocol – /usr/share/goblincakes/share/share.py).

    goblincakes-share run                     the user service itself (goblincakes-share.service)
    goblincakes-share on | off                visible on the network or not (the flag + the service)
    goblincakes-share status                  name, address, devices, transfers (JSON with --json)
    goblincakes-share list                    the devices that can be sent to
    goblincakes-share send <namn> <fil|mapp>…  sends to a device (its name or part of it)
    goblincakes-share text <namn> <text>      sends a message
    goblincakes-share order <namn> <text>     an order to Goblin AI on another GOBLINCAKES computer
    goblincakes-share orders                  the orders that came here (start <nr> [chatgpt] = Goblin AI
                                              takes it, or the ChatGPT app draws it)
    goblincakes-share scan                    looks for devices again (multicast + the local network)
    goblincakes-share hjälp [avsluta]         Be om hjälp: a code to read out to the one helping (waits;
                                              Ctrl+C = out). "Hjälp via terminal" is switched on if needed
    goblincakes-share terminal <namn> [kod]   a terminal on that computer with the code it shows (ssh); while
                                              it is open `ssh <namn> <kommando>` works too (Claude Code).
                                              terminal = the list, terminal på|av = "Hjälp via terminal" here,
                                              terminal glöm <namn>
"""
import json
import os
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(os.environ.get("GOBLINCAKES_SHARE_DIR") or
                            Path(__file__).resolve().parents[1] / "share/goblincakes/share")))
import share as S  # noqa: E402


def need_service():
    st = S.call("status")
    if st is None:
        print("GoblinShare är avstängt – slå på det med: goblin share på", file=sys.stderr)
        sys.exit(2)
    return st


def wait_job(jid):
    """Prints the progress of a sending until it is done → exit code."""
    last = ""
    while True:
        st = S.call("status") or {}
        job = next((t for t in st.get("transfers", []) if t["id"] == jid), None)
        if not job:
            hist = next((h for h in st.get("history", []) if h.get("dir") == "out"), None)
            ok = bool(hist and hist.get("state") == "klart")
            print("Klart." if ok else (hist or {}).get("why") or "Avslutat.")
            return 0 if ok else 1
        line = job["state"]
        if job["state"] == "skickar" and job["total"]:
            line += f" {job['done'] * 100 // max(1, job['total'])} %"
        if line != last:
            print(line, flush=True)
            last = line
        if job["state"] in ("klart", "nekad", "avbruten", "fel"):
            if job["why"]:
                print(job["why"])
            return 0 if job["state"] == "klart" else 1
        time.sleep(0.5)


def _sshlink():
    sys.path.insert(0, str(Path(S.__file__).parent))
    import sshlink
    return sshlink


def allow(on):
    sshlink = _sshlink()
    why = sshlink.set_allowed(on)
    S.call("ssh_check")
    return why


def help_here(argv):
    """Be om hjälp: shows the code to read out, then who is in; Ctrl+C or `hjälp avsluta` = out."""
    if len(argv) > 2 and argv[2] in ("avsluta", "stopp", "stop", "slut"):
        res = S.call("help_stop") or {}
        print("Hjälpen är avslutad." if res.get("ok") else "GoblinShare är avstängt.")
        return 0
    need_service()
    if not _sshlink().allowed_here():
        print("Hjälp via terminal slås på först (skriv ditt lösenord) …", flush=True)
        why = allow(True)
        if why:
            print(why)
            return 1
    res = S.call("help_start") or {}
    if not res.get("ok"):
        print(res.get("error") or "Gick inte")
        return 1
    code = res["code"]
    print(f"\n    Din kod:  {code[:3]} {code[3:]}\n")
    print(f"Läs upp den för den som ska hjälpa dig – hen trycker Terminal på din ruta i GoblinShare och skriver in "
          f"den. Gäller i {res['seconds'] // 60} minuter. Ctrl+C = avbryt / avsluta hjälpen.", flush=True)
    last = "kod"
    try:
        while True:
            time.sleep(1)
            h = ((S.call("status") or {}).get("ssh") or {}).get("help")
            state = h["state"] if h else ""
            if state != last:
                if state == "inne":
                    print(f"{h['alias']} är inne i din dator nu. Ctrl+C = ut direkt.", flush=True)
                elif not state:
                    print("Hjälpen är slut." if last == "inne" else "Koden gäller inte längre.")
                    return 0
                last = state
    except KeyboardInterrupt:
        S.call("help_stop")
        print("\nAvslutat – ingen kommer in utan en ny kod.")
        return 0


def terminal(argv):
    sshlink = _sshlink()
    word = argv[2] if len(argv) > 2 else ""
    if word in ("på", "on", "av", "off"):
        on = word in ("på", "on")
        why = allow(on)
        print(why or ("Hjälp via terminal är på. När du behöver hjälp: goblin share hjälp (eller Be om hjälp i "
                      "GoblinShare) – ingen kommer in utan koden du läser upp." if on
                      else "Hjälp via terminal är av – SSH är som förut och ingen kommer in."))
        return 1 if why else 0
    st = need_service()
    ssh = st.get("ssh", {})
    if not word:
        print("Hjälp via terminal här: " + ("på (goblin share hjälp = be om hjälp)" if ssh.get("allowed")
                                            else "av (goblin share terminal på)"))
        h = ssh.get("help")
        if h:
            print(f"  {h['alias']} är inne i datorn nu" if h["state"] == "inne" else f"  koden {h['code']} väntar")
        for p in ssh.get("paired", []):
            on = sshlink.connected(p["host"])
            print(f"{p['alias']}: " + (f"ansluten – ssh {p['host']} <kommando>" if on else
                                       f"goblin share terminal {p['host']} <koden från hen>"))
        return 0
    if word in ("glöm", "glom", "forget") and len(argv) > 3:
        name = " ".join(argv[3:]).lower()
        group = ssh.get("paired", [])
        hit = next((x for x in group if x["alias"].lower() == name or x.get("host") == name), None) or \
            next((x for x in group if name in x["alias"].lower()), None)
        if not hit:
            print(f"Hittar ingen \"{name}\"")
            return 1
        S.call("ssh_forget", fingerprint=hit["fingerprint"])
        print(f"{hit['alias']}: glömd.")
        return 0
    args = argv[2:]
    code = "".join(args[-1].split()) if args and args[-1].replace(" ", "").isdigit() else ""
    if code:
        args = args[:-1]
    low = " ".join(args).lower()
    paired = next((p for p in ssh.get("paired", []) if low in (p["host"], p["alias"].lower())), None)
    peer = next((p for p in st["peers"] if p["alias"].lower() == low), None) or \
        next((p for p in st["peers"] if low and low in p["alias"].lower()), None)
    if not paired and peer:
        paired = next((p for p in ssh.get("paired", []) if p["fingerprint"] == peer["fingerprint"]), None)
    if paired and sshlink.connected(paired["host"]):   # a Terminal is open: one more on the same connection
        os.execvp("ssh", ["ssh", paired["host"]])
    if not peer:
        print(f"Hittar ingen \"{low}\". Enheterna: " + (", ".join(p["alias"] for p in st["peers"]) or "inga"))
        return 1
    while True:
        if not code:
            try:
                code = "".join(input(f"Koden som visas på {peer['alias']} (hen trycker Be om hjälp): ").split())
            except (EOFError, KeyboardInterrupt):
                print()
                return 1
        res = S.call("ssh_pair", to=peer["fingerprint"], code=code) or {}
        if not res.get("ok"):
            print(res.get("error") or "Gick inte")
            return 1
        while True:
            time.sleep(0.3)
            st = S.call("status") or {}
            job = next((j for j in st.get("ssh", {}).get("jobs", []) if j["fingerprint"] == peer["fingerprint"]), None)
            if not st:
                print("GoblinShare stannade")
                return 1
            if job and job["state"] != "väntar":
                break
        if job["state"] == "klar":
            break
        print(job["why"] or "Gick inte")
        if not job["why"].startswith("Fel kod") or not sys.stdin.isatty():
            return 1
        code = ""
    paired = next((p for p in st["ssh"]["paired"] if p["fingerprint"] == peer["fingerprint"]), None)
    print(f"Inne på {peer['alias']}. Medan den här terminalen är öppen fungerar också ssh {paired['host']} <kommando> "
          "(t.ex. åt Claude Code). Stäng den = ute.", flush=True)
    os.execvp("ssh", ["ssh", paired["host"]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "run":
        share = S.Share()
        signal.signal(signal.SIGTERM, lambda *_: (share.shutdown(), sys.exit(0)))
        share.run()
        return 0
    if cmd in ("on", "på"):
        why = S.turn_on()
        if why:
            print(why)
        for _ in range(30):
            if S.call("status"):
                break
            time.sleep(0.2)
        st = S.call("status")
        print(f"GoblinShare är på – andra ser dig som \"{st['alias']}\"." if st else
              "Tjänsten startade inte – se: journalctl --user -u goblincakes-share")
        return 0 if st else 1
    if cmd in ("off", "av"):
        S.turn_off()
        print("GoblinShare är av – ingen på nätverket ser dig.")
        return 0
    if cmd in ("terminal", "ssh"):
        return terminal(argv)
    if cmd in ("hjälp", "hjalp", "help-me"):
        return help_here(argv)
    if cmd == "scan":
        need_service()
        S.call("scan", sweep=True)
        time.sleep(4)
        cmd = "list"
    if cmd == "status":
        st = S.call("status")
        if "--json" in argv:
            print(json.dumps(st or {"running": False}, ensure_ascii=False, indent=1))
            return 0
        if not st:
            print("GoblinShare är avstängt (goblin share på).")
            return 0
        print(f"Synlig som \"{st['alias']}\" på {', '.join(st['addresses']) or 'inget nätverk'} "
              f"(port {st['port']}, {st['protocol'].upper()})")
        if st["error"]:
            print("FEL:", st["error"])
        print(f"Tar emot till {st['folder']}")
        print(f"{len(st['peers'])} enhet(er) syns.")
        for t in st["transfers"]:
            pct = f" {t['done'] * 100 // max(1, t['total'])} %" if t["total"] else ""
            print(f"  {'←' if t['dir'] == 'in' else '→'} {t['alias']}: {t['name']}  {t['state']}{pct}")
        for r in st["requests"]:
            print(f"  ? {r['alias']} vill skicka {r['count']} fil(er), {S.human_size(r['size'])} – svara i fönstret")
        return 0
    if cmd == "list":
        st = need_service()
        if not st["peers"]:
            print("Inga enheter hittade. Har de GoblinShare eller LocalSend öppet, på samma wifi? (goblin share leta)")
        for p in st["peers"]:
            kind = "GOBLINCAKES" if p["goblincakes"] else (p["model"] or p["type"])
            print(f"{p['alias']:<24} {kind:<16} {p['ip']:<16}" + ("  betrodd" if p["trusted"] else ""))
        return 0
    if cmd in ("orders", "beställningar", "bestallningar"):
        st = need_service()
        orders = st.get("orders", [])
        if len(argv) > 3 and argv[2] in ("start", "starta"):
            try:
                o = orders[int(argv[3]) - 1]
            except (ValueError, IndexError):
                print("Ingen beställning med det numret")
                return 1
            via = "chatgpt" if "chatgpt" in [a.lower() for a in argv[4:]] else "ai"
            res = S.call("order_start", id=o["id"], via=via) or {}
            print(("ChatGPT-appen öppnas med beställningen – tryck Enter där. Bilden" if via == "chatgpt"
                   else "Goblin AI tar beställningen – svaret") + " skickas till " + o["alias"] + " av sig självt."
                  if res.get("ok") else res.get("error") or "Gick inte")
            return 0 if res.get("ok") else 1
        if not orders:
            print("Inga beställningar väntar.")
        for n, o in enumerate(orders, 1):
            print(f"{n}. {o['alias']}: {o['text'][:80]}  [{o['state']}{' – ' + o['why'] if o.get('why') else ''}]")
        if any(o["state"] in ("väntar", "fel", "ej skickad") for o in orders):
            print("Starta: goblin share beställningar start <nr>  (eller start <nr> chatgpt)")
        return 0
    if cmd in ("send", "skicka", "text", "order", "beställ", "bestall"):
        if len(argv) < 4:
            print(__doc__.strip())
            return 1
        st = need_service()
        to = argv[2]
        peer = next((p for p in st["peers"] if p["alias"].lower() == to.lower()), None) or \
            next((p for p in st["peers"] if to.lower() in p["alias"].lower()), None)
        if not peer:
            print(f"Hittar ingen \"{to}\". Enheterna: " + (", ".join(p["alias"] for p in st["peers"]) or "inga"))
            return 1
        if cmd == "text":
            res = S.call("text", to=peer["fingerprint"], text=" ".join(argv[3:]))
        elif cmd in ("order", "beställ", "bestall"):
            res = S.call("order", to=peer["fingerprint"], text=" ".join(argv[3:]))
        else:
            paths = [str(Path(p).expanduser().resolve()) for p in argv[3:]]
            missing = [p for p in paths if not Path(p).exists()]
            if missing:
                print("Finns inte:", ", ".join(missing))
                return 1
            res = S.call("send", to=peer["fingerprint"], paths=paths)
        if not res or not res.get("ok"):
            print((res or {}).get("error") or "Gick inte att skicka")
            return 1
        print(f"Beställningen skickas till {peer['alias']} …" if cmd in ("order", "beställ", "bestall") else
              f"Till {peer['alias']} – väntar på att de tar emot …", flush=True)
        return wait_job(res["id"])
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
