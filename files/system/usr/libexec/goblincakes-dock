#!/usr/bin/env bash
# GOBLINCAKES: the dock at the bottom of the screen (`goblin dock`).
#   goblincakes-dock toggle     show the dock, or hide it again (the Meta key)
#   goblincakes-dock pin <id>   pin an app (desktop file name)
#   goblincakes-dock reset      put the GOBLINCAKES desktop layout back (dock included)
set -uo pipefail

plasma_js() { busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$1" >/dev/null; }

case ${1:-} in
    pin)
        id=${2:?desktop file}
        plasma_js "$(sed "s|%LAUNCHER%|applications:$id|" /usr/share/goblincakes/dock-add.js)" ;;
    toggle)
        # Plasma's own "move keyboard focus between panels" brings the hidden dock up with the
        # focus, and Plasma hides it again by itself when anything else is clicked – like the
        # Start menu. It steps through the panels one at a time, so a KWin script presses it and
        # steps past the top bar (/usr/share/goblincakes/dock-show.js). (Until 9 Oct this
        # switched the hiding mode; Plasma 6 has no "on top without taking space" mode, so
        # maximized windows shrank and the dock stayed up. Making the desktop active is not
        # enough to bring it up.)
        # Older versions could leave the dock always shown ("none"): back to hiding first
        plasma_js 'panels().forEach(function (p) {
            if (p.location === "bottom" && p.hiding === "none") p.hiding = "dodgewindows";
        });'
        # A new name every time: KWin removes an unloaded script a moment later, and loading one
        # with the same name before that silently did nothing (9 Oct). The previous one is
        # removed (it finished right away).
        kwin=(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting)
        state="${XDG_RUNTIME_DIR:-/tmp}/goblincakes-dock-script"
        "${kwin[@]}" unloadScript s goblincakes-dock-autohide >/dev/null 2>&1
        [ -s "$state" ] && "${kwin[@]}" unloadScript s "$(cat "$state")" >/dev/null 2>&1
        name="goblincakes-dock-show-$(date +%s%N)"
        echo "$name" > "$state"
        id=$("${kwin[@]}" loadScript ss "${GOBLINCAKES_DOCK_JS:-/usr/share/goblincakes/dock-show.js}" "$name" | awk '{print $2}')
        [ -n "$id" ] && [ "$id" -ge 0 ] && \
            busctl --user call org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script run >/dev/null ;;
    reset)
        rm -f "$HOME/.local/state/goblincakes/firstlogin-done"
        /usr/libexec/goblincakes-firstlogin
        echo "Skrivbordets layout och dockan är återställda." ;;
    *) echo "Använd: goblin dock toggle|reset" >&2; exit 2 ;;
esac
