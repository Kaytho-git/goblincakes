#!/usr/bin/python3
# GOBLINCAKES: are there updates? For the green arrow in the top bar (plasmoid
# org.goblincakes.updates), which reads the result from ~/.cache/goblincakes/updates.json.
#   goblincakes-updates check   look now (the user timer goblincakes-updates.timer: at login
#                               and every 4 hours; goblin update runs it when it's done)
# System: a newer GOBLINCAKES image on the registry than the newest one here ("new"), or a new
# version already fetched that is used after a restart ("staged"). Compared by the image
# digest, without downloading anything and without a password (skopeo, rpm-ostree status).
# Flatpak: programs with updates, user and system installations, plus how many runtimes and
# extensions (e.g. Nvidia's driver part for Flatpak games, which must follow the system's driver).
# The rest (11 Oct, the user's wish – each can be updated on its own in Config → Uppdatera):
# VS Code and Discord in the home folder, AppImages from Config (WowUp, Raider.IO, Archon),
# GE-Proton when it's used, and firmware (fwupd) – "other": [{part, name}].
# What a new version brings (10 Oct, the user's wish – shown by the arrow and in Config): the
# lines of nyheter.txt that the new image has and this one doesn't, read from GitHub at the
# newest commit before the image was built (the image has no commit label), plus a new Linux
# kernel or Fedora version from the image's labels. Fetched once per image ("newsFor").
# A check that can't be done (no network) keeps the last result.
import json
import os
import re
import subprocess
import urllib.parse
import urllib.request
import sys
import time
from pathlib import Path

STATE = Path.home() / ".cache/goblincakes/updates.json"
NEWS = "files/system/usr/share/goblincakes/nyheter.txt"
LOCAL_NEWS = Path("/usr/share/goblincakes/nyheter.txt")


def run(args, timeout=120):
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def system_state():
    """('staged' | 'new' | '' | None when it couldn't be checked, image name, remote digest);
    for 'staged' the third value is the fetched deployment's checksum instead"""
    out = run(["rpm-ostree", "status", "--json"])
    if out is None:
        return None, "", ""
    try:
        deps = json.loads(out).get("deployments", [])
    except ValueError:
        return None, "", ""
    if not deps:
        return None, "", ""
    newest = deps[0]  # rpm-ostree lists the one used at the next start first
    if not newest.get("booted"):
        return "staged", "", newest.get("checksum", "")
    ref = newest.get("container-image-reference", "")
    digest = newest.get("container-image-reference-digest", "")
    if "docker://" not in ref or not digest:
        return "", "", ""
    image = ref.split("docker://", 1)[1]
    # The registry's "latest" is an image index (one image per processor type): rpm-ostree has
    # the digest of the image inside it, skopeo's Digest is the index's – they never matched
    # (9 Oct). So: the raw manifest, and every digest in it.
    raw = run(["skopeo", "inspect", "--raw", f"docker://{image}"])
    if raw is None:
        return None, image, ""
    try:
        manifest = json.loads(raw)
    except ValueError:
        return None, image, ""
    known = {m.get("digest") for m in manifest.get("manifests", [])}
    remote = run(["skopeo", "inspect", "--no-tags", "--format", "{{.Digest}}", f"docker://{image}"])
    if remote:
        known.add(remote.strip())
    known.discard(None)
    if not known:
        return None, image, ""
    return ("" if digest in known else "new"), image, (remote or "").strip()


def entries(text):
    """[(date, text)] from a nyheter.txt, newest first."""
    out = []
    for line in text.splitlines():
        m = re.match(r"^(\d{4}-\d{2}-\d{2})\s{2,}(.+)$", line.strip())
        if m:
            out.append((m.group(1), m.group(2).strip()))
    return out


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "goblincakes-updates"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return r.read().decode("utf-8", "replace")


def news_for(image):
    """What the image on the registry brings that this computer doesn't have: a list of short
    Swedish lines, newest first – or None when it couldn't be found out."""
    out = run(["skopeo", "inspect", "--no-tags", f"docker://{image}"])
    if out is None:
        return None
    try:
        labels = json.loads(out).get("Labels") or {}
    except ValueError:
        return None
    lines = []
    # Fedora and the Linux kernel, straight from the image's labels
    fedora = str(labels.get("org.opencontainers.image.version", "")).split(".")[0]
    try:
        here = next(l.split("=", 1)[1].strip().strip('"') for l in
                    Path("/usr/lib/os-release").read_text().splitlines() if l.startswith("VERSION_ID="))
    except (OSError, StopIteration):
        here = ""
    if fedora.isdigit() and here.isdigit() and int(fedora) > int(here):
        lines.append(f"Fedora {fedora}")
    kernel = str(labels.get("ostree.linux", "")).split("-")[0]
    if kernel and kernel != os.uname().release.split("-")[0]:
        lines.append(f"Ny Linux-kärna {kernel}")
    # nyheter.txt as it was when the image was built
    source = labels.get("org.opencontainers.image.source", "")
    created = str(labels.get("org.opencontainers.image.created", ""))[:19]
    m = re.match(r"https://github\.com/([^/]+/[^/]+?)/?$", source)
    if not m or not created:
        return lines or None
    repo = m.group(1)
    try:
        query = urllib.parse.urlencode({"path": NEWS, "until": created + "Z", "per_page": 1})
        commits = json.loads(fetch(f"https://api.github.com/repos/{repo}/commits?{query}"))
        sha = commits[0]["sha"]
        remote = entries(fetch(f"https://raw.githubusercontent.com/{repo}/{sha}/{NEWS}"))
    except (OSError, ValueError, KeyError, IndexError):
        return lines or None
    try:
        local = {t for _, t in entries(LOCAL_NEWS.read_text())}
    except OSError:
        local = set()
    return [t for _, t in remote if t not in local] + lines


def staged_news(checksum):
    """What a version already fetched (waiting for a restart) brings, read straight from its
    deployment on disk like goblincakes-news does – nothing to download. None = not found."""
    roots = [r for r in Path("/ostree/deploy").glob(f"*/deploy/{checksum}.*")
             if checksum and r.is_dir()]
    if not roots:
        return None
    root = roots[0]
    lines = []
    try:
        fedora = next(l.split("=", 1)[1].strip().strip('"') for l in
                      (root / "usr/lib/os-release").read_text().splitlines() if l.startswith("VERSION_ID="))
        here = next(l.split("=", 1)[1].strip().strip('"') for l in
                    Path("/usr/lib/os-release").read_text().splitlines() if l.startswith("VERSION_ID="))
        if fedora.isdigit() and here.isdigit() and int(fedora) > int(here):
            lines.append(f"Fedora {fedora}")
    except (OSError, StopIteration):
        pass
    try:
        kernels = sorted(d.name for d in (root / "usr/lib/modules").iterdir() if d.is_dir())
        kernel = kernels[-1].split("-")[0] if kernels else ""
        if kernel and kernel != os.uname().release.split("-")[0]:
            lines.append(f"Ny Linux-kärna {kernel}")
    except OSError:
        pass
    try:
        new = entries((root / "usr/share/goblincakes/nyheter.txt").read_text())
    except OSError:
        return lines or None
    try:
        local = {t for _, t in entries(LOCAL_NEWS.read_text())}
    except OSError:
        local = set()
    return [t for _, t in new if t not in local] + lines


def flatpak_updates():
    """Names of programs with updates – or None when it couldn't be checked."""
    names, ok = set(), False
    for scope in ("--user", "--system"):
        out = run(["flatpak", "remote-ls", scope, "--updates", "--app", "--columns=name"])
        if out is None:
            continue
        ok = True
        names.update(line.strip() for line in out.splitlines() if line.strip())
    return sorted(names) if ok else None


def latest_json(url, headers=None):
    req = urllib.request.Request(url, headers={"User-Agent": "goblincakes-updates", **(headers or {})})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read().decode("utf-8", "replace")), r.geturl()


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


CATALOG = Path("/usr/share/goblincakes/config/apps.json")


def other_updates(old):
    """Everything outside the system image and Flatpak that has a newer version: a list of
    {"part": goblin update --only name, "name": shown text}. Parts that can't be checked now
    (no network) keep what the last check found."""
    found = []
    keep = lambda part: found.extend(o for o in old.get("other", []) if o["part"] == part)
    home = Path.home()

    # VS Code (Microsoft's own build in the home folder)
    if (home / ".local/share/vscode/code").exists():
        try:
            data, _ = latest_json("https://update.code.visualstudio.com/api/update/linux-x64/stable/latest")
            new = data.get("productVersion") or data.get("name") or ""
            if new and new != read(home / ".local/share/vscode/.goblincakes-version"):
                found.append({"part": "vscode", "name": f"VS Code {new}"})
        except (OSError, ValueError):
            keep("vscode")

    # Discord (its own Linux build in the home folder): the download link names the version
    if (home / ".local/share/discord-app/Discord").exists():
        try:
            req = urllib.request.Request("https://discord.com/api/download?platform=linux&format=tar.gz",
                                         method="HEAD", headers={"User-Agent": "goblincakes-updates"})
            with urllib.request.urlopen(req, timeout=20) as r:
                m = re.search(r"/discord-([0-9.]+)\.tar\.gz", r.geturl())
            if m and m.group(1) != read(home / ".local/share/discord-app/.goblincakes-version"):
                found.append({"part": "discord", "name": f"Discord {m.group(1)}"})
        except OSError:
            keep("discord")

    gh = {"Accept": "application/vnd.github+json"}
    # AppImages from Config: the download link of the newest release vs the one installed
    try:
        steps = [s for app in json.loads(CATALOG.read_text())["apps"] for s in app["steps"]
                 if s[0] == "appimage-github"]
    except (OSError, ValueError, KeyError):
        steps = []
    for _, repo, label in steps:
        if not (home / "AppImages" / f"{label}.AppImage").exists():
            continue
        try:
            data, _ = latest_json(f"https://api.github.com/repos/{repo}/releases/latest", gh)
            urls = [a["browser_download_url"] for a in data.get("assets", [])
                    if a["name"].endswith(".AppImage") and not re.search(r"arm64|aarch64|armv7", a["name"])]
            if urls and urls[0] != read(home / "AppImages" / f".{label}.release"):
                found.append({"part": "appimages", "name": f"{label} {data.get('tag_name', '').lstrip('v')}".strip()})
        except (OSError, ValueError, KeyError):
            found.extend(o for o in old.get("other", []) if o["part"] == "appimages" and o["name"].startswith(label))

    # GE-Proton, for those who use it (same rule as goblin update)
    compat = home / ".local/share/Steam/compatibilitytools.d"
    if list(compat.glob("GE-Proton*")) or run(["flatpak", "info", "net.davidotek.pupgui2"]) is not None:
        try:
            data, _ = latest_json("https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest", gh)
            tag = data.get("tag_name", "")
            # Unpacked as the archive's name: "GE-Proton11-7-x86_64" for the tag "GE-Proton11-7"
            # (11 Oct: only the tag was looked for, so it always looked new)
            have = (compat / tag).exists() or (compat / f"{tag}-x86_64").exists()
            if tag and not have:
                found.append({"part": "proton", "name": tag})
        except (OSError, ValueError):
            keep("proton")

    # Firmware (fwupd's own list, refreshed by the system's fwupd-refresh timer); 2 = nothing
    try:
        out = subprocess.run(["fwupdmgr", "get-updates", "--json"], capture_output=True, text=True, timeout=60)
        if out.returncode == 0:
            for dev in json.loads(out.stdout).get("Devices", []):
                rel = (dev.get("Releases") or [{}])[0]
                found.append({"part": "firmware", "name": f"{dev.get('Name', 'Firmware')} {rel.get('Version', '')}".strip()})
        elif out.returncode != 2:
            keep("firmware")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        keep("firmware")
    return found


def flatpak_runtimes():
    """How many runtimes/extensions have updates (not shown by name) – None when unknown."""
    count, ok = 0, False
    for scope in ("--user", "--system"):
        out = run(["flatpak", "remote-ls", scope, "--updates", "--runtime", "--columns=application"])
        if out is None:
            continue
        ok = True
        count += sum(1 for line in out.splitlines() if line.strip())
    return count if ok else None


def check():
    try:
        old = json.loads(STATE.read_text())
    except (OSError, ValueError):
        old = {}
    system, image, remote = system_state()
    flatpaks = flatpak_updates()
    runtimes = flatpak_runtimes()
    state = {
        "system": old.get("system", "") if system is None else system,
        "flatpaks": old.get("flatpaks", []) if flatpaks is None else flatpaks,
        "flatpakRuntimes": old.get("flatpakRuntimes", 0) if runtimes is None else runtimes,
        "other": other_updates(old),
        "checked": int(time.time()),
    }
    # What the new version brings: once per image; kept while it waits for a restart
    if state["system"] == "new" and remote and old.get("newsFor") == remote:
        state["news"], state["newsFor"] = old.get("news", []), remote
    elif state["system"] == "new" and image:
        news = news_for(image)
        if news is not None:
            state["news"], state["newsFor"] = news, remote
        elif old.get("system") == "new":
            state["news"], state["newsFor"] = old.get("news", []), old.get("newsFor", "")
    elif state["system"] == "staged" and remote and old.get("newsFor") == remote:
        state["news"], state["newsFor"] = old.get("news", []), remote
    elif state["system"] == "staged":
        # Read from the fetched version itself (also when it was fetched in the background
        # without the arrow ever having seen it as "new")
        news = staged_news(remote)
        if news is not None:
            state["news"], state["newsFor"] = news, remote
        elif old.get("news"):
            state["news"], state["newsFor"] = old["news"], old.get("newsFor", "")
    # Fetched and waiting for a restart: the arrow stays until the restart however it was fetched
    # (the widget looks at /run/ostree/staged-deployment itself). Fetched in the background by
    # the automatic updates, the user wouldn't know: one notice too. Not after goblin update /
    # Config (GOBLINCAKES_UPDATED=1 from goblin) – they say "Starta om nu" themselves.
    if state["system"] == "staged" and old.get("system") != "staged":
        if os.environ.get("GOBLINCAKES_UPDATED") != "1":
            subprocess.run(["notify-send", "--app-name=GOBLINCAKES", "--icon=goblincakes",
                            "Ny GOBLINCAKES-version hämtad",
                            "Den används nästa gång du startar om datorn."], capture_output=True)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False))
    tmp.replace(STATE)
    print(json.dumps(state, ensure_ascii=False))


if __name__ == "__main__":
    if sys.argv[1:] == ["check"]:
        check()
    else:
        print("Använd: goblincakes-updates check", file=sys.stderr)
        sys.exit(2)
