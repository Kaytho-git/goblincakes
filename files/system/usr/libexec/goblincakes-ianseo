#!/usr/bin/env bash
# Ianseo (archery results) in containers, for the current user.
#
#   goblincakes-ianseo install   set up (from the GOBLINCAKES setup window)
#   goblincakes-ianseo open      start if needed and open in the browser
#   goblincakes-ianseo backup    database backup (run every 30 minutes by a timer)
#   goblincakes-ianseo network on|off|status
#                                tournament mode: tablets/phones on the same network (Ianseo's
#                                scoring apps) reach Ianseo too (GOBLINCAKES Config → Optimering)
#
# Normally only reachable from this computer: http://127.0.0.1:8180/
# Lines starting with "@@ " are shown in the setup window.
set -euo pipefail

status() { echo "@@ $*"; }

share=/usr/share/goblincakes/ianseo
url=http://127.0.0.1:8180/ianseo/
layout=2  # bump when the container setup changes in a way an old install can't keep
layout_file="$HOME/.local/share/goblincakes/ianseo/layout"
home_dir="$HOME/Ianseo"
backup_dir="$home_dir/Backup"
www="$HOME/.local/share/goblincakes/ianseo/www"
env_file="$HOME/.config/goblincakes/ianseo.env"
quadlets="$HOME/.config/containers/systemd"

wait_for_web() {
    for _ in $(seq 120); do
        curl -fsS -o /dev/null "$url" && return 0
        sleep 2
    done
    return 1
}

start() {
    systemctl --user start ianseo-pod.service ianseo-db.service ianseo-web.service
}

release_url=https://ianseo.net/Release
# Newest Ianseo_YYYYMMDD.zip linked from ianseo.net (the date in the name = the version).
# If the site can't be read, the newest one we know of.
latest_release() {
    local page name
    name=$(for page in "$release_url/" https://www.ianseo.net/ https://www.ianseo.net/Releases.php; do
               curl -fsSL --max-time 20 "$page" 2>/dev/null | grep -oE 'Ianseo_[0-9]{8}\.zip' || true
           done | sort -u | sort -t_ -k2 -n | tail -n1)
    echo "${name:-Ianseo_20250210.zip}"
}

find_zip() {
    local dl
    dl=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
    find "$dl" "$HOME/Downloads" -maxdepth 1 -iname '*ianseo*.zip' -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | head -n1 | cut -d' ' -f2- || true
}

install() {
    mkdir -p "$home_dir" "$backup_dir" "$(dirname "$env_file")" "$quadlets" "$www"

    # An unfinished install from an older GOBLINCAKES: start over
    if [ -e "$env_file" ] && [ "$(cat "$layout_file" 2>/dev/null)" != "$layout" ]; then
        status "Tar bort den gamla, ofullständiga Ianseo-installationen…"
        systemctl --user stop ianseo-web.service ianseo-db.service ianseo-pod.service 2>/dev/null || true
        podman volume rm -f ianseo-db ianseo-socket >/dev/null 2>&1 || true
        podman unshare rm -rf "$www"
        rm -f "$env_file"
        mkdir -p "$www"
    fi

    # Database: user, password and database "ianseo", as in Ianseo's install guide.
    # It is only reachable from inside the Ianseo containers. The root password is random.
    if [ ! -e "$env_file" ]; then
        umask 077
        {
            echo "MARIADB_ROOT_PASSWORD=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)"
            echo "MARIADB_DATABASE=ianseo"
            echo "MARIADB_USER=ianseo"
            echo "MARIADB_PASSWORD=ianseo"
        } > "$env_file"
        umask 022
    fi
    echo "$layout" > "$layout_file"
    # shellcheck disable=SC1090
    . "$env_file"

    # Ianseo itself: the newest Ianseo_YYYYMMDD.zip from ianseo.net
    if [ ! -e "$www/index.php" ]; then
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        zip=
        status "Letar efter senaste Ianseo…"
        name=$(latest_release)
        status "Hämtar $name…"
        if curl -fL --progress-bar -o "$tmp/$name" "$release_url/$name"; then
            zip="$tmp/$name"
        else
            # Offline or moved: a zip the user already downloaded
            zip=$(find_zip)
        fi
        if [ -z "$zip" ]; then
            # Couldn't find it automatically: let the user download it
            status "Öppnar ianseo.net – ladda ner senaste Ianseo (zip-filen)…"
            xdg-open https://www.ianseo.net/ >/dev/null 2>&1 &
            for _ in $(seq 900); do
                zip=$(find_zip)
                # Wait until the download is finished (no .part file next to it)
                [ -n "$zip" ] && [ ! -e "$zip.part" ] && break
                zip=
                sleep 2
            done
            [ -n "$zip" ] || { status "Hittade ingen Ianseo-zip i Hämtade filer"; exit 1; }
        fi
        status "Packar upp $(basename "$zip")…"
        python3 -m zipfile -e "$zip" "$tmp"
        # Ianseo's own folder = the one with Install/apache-ianseo.conf (else the shallowest index.php)
        conf=$(find "$tmp" -maxdepth 4 -path '*/Install/apache-ianseo.conf' | head -n1 || true)
        if [ -n "$conf" ]; then
            root=$(dirname "$(dirname "$conf")")
        else
            index=$(find "$tmp" -maxdepth 3 -name index.php | awk '{ print length, $0 }' | sort -n | head -n1 | cut -d' ' -f2- || true)
            [ -n "$index" ] || { status "Zip-filen ser inte ut att vara Ianseo"; exit 1; }
            root=$(dirname "$index")
        fi
        cp -a "$root"/. "$www"/
        # Writable for everyone, as Ianseo's install guide says (the web server
        # inside the container runs as another user)
        chmod -R a+rwX "$www"
    fi

    status "Bygger Ianseos webbserver (tar några minuter första gången)…"
    podman build --quiet -t localhost/goblincakes-ianseo:latest "$share" >/dev/null

    status "Hämtar databasen…"
    podman pull --quiet docker.io/library/mariadb:11 >/dev/null

    status "Startar Ianseo…"
    cp "$share"/ianseo.pod "$share"/ianseo-db.container "$share"/ianseo-web.container "$quadlets"/
    systemctl --user daemon-reload
    # Restart, so a new web server image is used
    systemctl --user stop ianseo-web.service 2>/dev/null || true
    start
    systemctl --user enable --now goblincakes-ianseo-backup.timer

    mkdir -p "$HOME/.local/share/applications"
    cp "$share"/ianseo.desktop "$HOME/.local/share/applications/goblincakes-ianseo.desktop"

    cat > "$home_dir/Databas.txt" <<EOF
Ianseo körs på $url (bara från den här datorn).

Uppgifter till Ianseos installationssida (samma som Ianseos egen guide):
  Databasserver:  localhost
  Databas:        ianseo
  Användare:      ianseo
  Lösenord:       ianseo

  root-lösenord (om Ianseo frågar efter det): $MARIADB_ROOT_PASSWORD

Backuper av databasen sparas var 30:e minut i $backup_dir
(bara när något har ändrats). Starta Ianseo från AppGrid.
EOF

    status "Väntar på att Ianseo svarar…"
    wait_for_web || { status "Ianseo svarar inte – prova att starta om datorn"; exit 1; }
    xdg-open "$url" >/dev/null 2>&1 &
    status "Klart – databasuppgifterna finns i ~/Ianseo/Databas.txt"
}

open_ianseo() {
    systemctl --user is-active --quiet ianseo-web.service || start
    wait_for_web || true
    xdg-open "$url"
}

# Tournament mode: the pod's port on every network interface instead of only 127.0.0.1
network() {
    local pod="$quadlets/ianseo.pod" addresses ip
    [ -e "$pod" ] || { [ "${1:-}" = status ] && echo unavailable; return 0; }
    case ${1:-status} in
        status) grep -q '^PublishPort=127\.0\.0\.1:' "$pod" && echo off || echo on ;;
        on|off)
            if [ "$1" = on ]; then
                sed -i 's|^PublishPort=.*|PublishPort=8180:80|' "$pod"
            else
                sed -i 's|^PublishPort=.*|PublishPort=127.0.0.1:8180:80|' "$pod"
            fi
            # The firewall (if it's on) lets the port in, also after a restart; asks for the
            # password once through polkit. Off: closed again.
            if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
                local change=--add-port
                [ "$1" = off ] && change=--remove-port
                firewall-cmd --quiet --permanent "$change=8180/tcp" 2>/dev/null || true
                firewall-cmd --quiet "$change=8180/tcp" 2>/dev/null || true
            fi
            systemctl --user daemon-reload
            systemctl --user stop ianseo-web.service ianseo-db.service ianseo-pod.service 2>/dev/null || true
            start
            if [ "$1" = on ]; then
                addresses=""
                for ip in $(hostname -I 2>/dev/null); do
                    [[ $ip == *:* ]] || addresses+="http://$ip:8180/ianseo/"$'\n'
                done
                notify-send -a GOBLINCAKES -i goblincakes-ianseo "Ianseo i nätverket" \
                    "Surfplattor och mobiler på samma nätverk når Ianseo på:"$'\n'"${addresses:-(ingen nätverksanslutning)}"$'\n'"Stäng av efter tävlingen." 2>/dev/null || true
                # Icon in the system tray while network access is on (goes away by itself when off)
                (setsid /usr/libexec/goblincakes-ianseo-tray >/dev/null 2>&1 &)
                printf '%s' "$addresses"
            fi ;;
        *) echo "Use: network on|off|status" >&2; return 2 ;;
    esac
}

backup() {
    podman container exists ianseo-db 2>/dev/null || exit 0
    [ "$(podman inspect -f '{{.State.Running}}' ianseo-db)" = true ] || exit 0
    mkdir -p "$backup_dir"
    new="$backup_dir/ianseo-$(date +%F_%H%M).sql.gz"
    podman exec ianseo-db sh -c \
        'mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --single-transaction --skip-dump-date --databases ianseo' \
        | gzip > "$new.tmp"
    last=$(ls -1t "$backup_dir"/ianseo-*.sql.gz 2>/dev/null | head -n1 || true)
    # Nothing changed since the last backup: don't keep a copy
    if [ -n "$last" ] && cmp -s <(zcat "$last") <(zcat "$new.tmp"); then
        rm -f "$new.tmp"
    else
        mv "$new.tmp" "$new"
    fi
    # Keep the newest 200
    ls -1t "$backup_dir"/ianseo-*.sql.gz 2>/dev/null | tail -n +201 | xargs -r rm -f || true
}

case ${1:-} in
    install) install ;;
    open) open_ianseo ;;
    backup) backup ;;
    network) network "${2:-status}" ;;
    *) echo "Usage: $0 install|open|backup|network on|off|status" >&2; exit 2 ;;
esac
