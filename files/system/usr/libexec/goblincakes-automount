#!/usr/bin/env bash
# GOBLINCAKES: all disks always visible – runs at every login.
#  - mounts every partition with a normal file system that isn't mounted yet
#    (internal disks, a second SSD, external drives) through udisks, exactly as clicking
#    it in Dolphin does: /run/media/<user>/<name>. No password: polkit rule
#    50-goblincakes-mount.rules. Skips EFI/recovery partitions and encrypted disks.
#  - lets Steam, Lutris and Heroic (Flatpaks) reach those disks, for game libraries there.
# Disks plugged in later: KDE's own automounter (/etc/xdg/kded_device_automounterrc).
set -uo pipefail

lsblk -J -b -o PATH,TYPE,FSTYPE,PARTTYPE,MOUNTPOINTS,SIZE 2>/dev/null | python3 -c '
import json, sys
FILESYSTEMS = {"ext4", "ext3", "ext2", "btrfs", "xfs", "f2fs", "ntfs", "ntfs3", "exfat", "vfat"}
SKIP_PARTTYPES = {
    "c12a7328-f81f-11d2-ba4b-00a0c93ec93b",  # EFI system partition
    "de94bba4-06d1-4d40-a16a-bfd50179d6ac",  # Windows recovery
    "e3c9e316-0b5c-4db8-817d-f92df00215ae",  # Microsoft reserved
    "21686148-6449-6e6f-744e-656564454649",  # BIOS boot
    "0xef", "0x27",                          # EFI, hidden recovery (MBR disks)
}
def walk(devices):
    for d in devices:
        yield d
        yield from walk(d.get("children") or [])
for d in walk(json.load(sys.stdin)["blockdevices"]):
    if d["type"] not in ("part", "disk") or d.get("fstype") not in FILESYSTEMS:
        continue
    if any(d.get("mountpoints") or []):
        continue
    if (d.get("parttype") or "").lower() in SKIP_PARTTYPES:
        continue
    if d["fstype"] == "vfat" and int(d.get("size") or 0) < 1 << 30 and d["type"] == "part" and d.get("parttype"):
        continue  # small FAT partitions on internal disks are boot partitions
    print(d["path"])
' | while read -r dev; do
    udisksctl mount --no-user-interaction -b "$dev" >/dev/null 2>&1 || true
done

# Game launchers from Flathub can't see /run/media unless allowed
for app in com.valvesoftware.Steam net.lutris.Lutris com.heroicgameslauncher.hgl; do
    flatpak info "$app" >/dev/null 2>&1 || continue
    flatpak override --user --show "$app" 2>/dev/null | grep -q "/run/media/$USER" && continue
    flatpak override --user --filesystem="/run/media/$USER" "$app"
done
exit 0
