#!/usr/bin/env python3
"""GoblinShare – the window (files and messages to the computers and phones on the same network).

    goblin-share                    the window
    goblin-share --send <fil>…      the window with the files ready: click who gets them (Dolphin's
                                    "Skicka med GoblinShare", goblin share skicka <fil>)
    goblin-share --chat <id>        only the chat with a device (the notification's "Öppna chatten")

The sending and receiving is done by the user service (/usr/libexec/goblincakes-share run, the LocalSend
protocol in /usr/share/goblincakes/share/share.py); the window asks it over its Unix socket.
Window: /usr/share/goblincakes/share/Main.qml
"""
import json
import os
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QObject, QTimer, QUrl, Property, Signal, Slot
from PySide6.QtGui import QDesktopServices, QFontDatabase, QGuiApplication, QIcon
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtQml import QQmlApplicationEngine
from PySide6.QtWidgets import QApplication, QFileDialog

SHARE = Path(os.environ.get("GOBLINCAKES_SHARE_DIR") or
             Path(__file__).resolve().parents[1] / "share/goblincakes/share")
HELPER = Path(__file__).resolve().parents[1] / "libexec/goblincakes-share"   # /usr/libexec, or the repo's
sys.path.insert(0, str(SHARE))
import share as S  # noqa: E402
import sshlink  # noqa: E402
import threading  # noqa: E402
TERMINAL = Path(__file__).resolve().parents[1] / "libexec/goblincakes-terminal"


def use_accent(engine):
    """GOBLINCAKES' accent colour as the QML property "accent", followed live (accent.py)."""
    for d in (SHARE.parent, Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


class Backend(QObject):
    statusChanged = Signal()
    stagedChanged = Signal()
    message = Signal(str)
    chatRequested = Signal(str)     # open the chat window for a device (fingerprint)
    askCode = Signal(str, str)      # Terminal: the code box for a computer (fingerprint, name)
    codeResult = Signal(str, bool, str)  # … in, or why not (the box stays with the reason)

    def __init__(self, staged):
        super().__init__()
        self._status = json.dumps({"running": False})
        self._staged = [p for p in staged if Path(p).exists()]
        self._starting = False
        self._terminal_wanted = {}  # fingerprint → when Terminal was pressed (opens once the pairing is done)
        self._ssh_busy = False      # "Hjälp via terminal" is being switched (pkexec asks for the password)
        self._ssh_said = ""         # … and why it didn't work
        self.timer = QTimer(self, interval=700, timeout=self.poll)
        self.timer.start()
        self.scan_timer = QTimer(self, interval=30000, timeout=lambda: S.call("scan", sweep=False, timeout=1))
        self.scan_timer.start()
        self.poll()
        if self.running:
            S.call("scan", sweep=True, timeout=1)

    # ---------------------------------------------------------- state
    def poll(self):
        st = S.call("status", timeout=1)
        if st is None:
            st = {"running": False, "on": S.FLAG.exists(), "starting": self._starting}
        else:
            st["on"] = True
            self._starting = False
            self._terminal_after_pairing(st)
        st["sshBusy"] = self._ssh_busy
        if self._ssh_said:
            self.message.emit(self._ssh_said)
            self._ssh_said = ""
        text = json.dumps(st, ensure_ascii=False)
        if text != self._status:
            self._status = text
            self.statusChanged.emit()

    @property
    def running(self):
        return json.loads(self._status).get("running", False)

    @Property(str, notify=statusChanged)
    def status(self):
        return self._status

    @Property(str, notify=stagedChanged)
    def staged(self):
        return json.dumps([{"path": p, "name": Path(p).name, "folder": Path(p).is_dir(),
                            "size": 0 if Path(p).is_dir() else Path(p).stat().st_size}
                           for p in self._staged if Path(p).exists()], ensure_ascii=False)

    def stage(self, paths):
        self._staged = [p for p in paths if Path(p).exists()]
        self.stagedChanged.emit()

    # ---------------------------------------------------------- on/off
    @Slot()
    def turnOn(self):
        self._starting = True
        S.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        S.FLAG.touch()
        # The flag, the firewall (may ask for the password) and the service – not in the window's thread
        subprocess.Popen([sys.executable, str(HELPER), "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        QTimer.singleShot(2500, lambda: S.call("scan", sweep=True, timeout=1))
        self.poll()

    @Slot()
    def turnOff(self):
        S.FLAG.unlink(missing_ok=True)
        # The service, and "Hjälp via terminal" with it (may ask for the password) – not in the window's thread
        subprocess.Popen([sys.executable, str(HELPER), "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    @Slot()
    def scan(self):
        S.call("scan", sweep=True, timeout=1)
        self.poll()

    # ---------------------------------------------------------- sending
    def _send(self, fp, paths):
        if not paths:
            return
        res = S.call("send", to=fp, paths=[str(Path(p).resolve()) for p in paths], timeout=10)
        if not res or not res.get("ok"):
            self.message.emit((res or {}).get("error") or "GoblinShare svarar inte")
        self.poll()

    # The buttons and drops below sit in a device card. The file dialog's own event loop – and
    # poll() after sending – rebuild the cards (new peers list), and Qt aborts the whole window
    # when a card goes while its onClicked still runs (3 Nov: sending files crashed GoblinShare).
    # So the work starts once the click is over.
    @Slot(str)
    def sendFiles(self, fp):
        def pick():
            files, _ = QFileDialog.getOpenFileNames(None, "Välj filer att skicka", str(Path.home()))
            self._send(fp, files)
        QTimer.singleShot(0, pick)

    @Slot(str)
    def sendFolder(self, fp):
        def pick():
            folder = QFileDialog.getExistingDirectory(None, "Välj en mapp att skicka", str(Path.home()))
            self._send(fp, [folder] if folder else [])
        QTimer.singleShot(0, pick)

    @Slot(str, "QVariantList")
    def sendUrls(self, fp, urls):
        """Dropped on a device (QML gives file:// URLs)."""
        paths = [QUrl(u).toLocalFile() if isinstance(u, str) else u.toLocalFile() for u in urls]
        QTimer.singleShot(0, lambda: self._send(fp, [p for p in paths if p]))

    @Slot(str)
    def sendStaged(self, fp):
        paths, self._staged = self._staged, []
        def go():
            self.stagedChanged.emit()
            self._send(fp, paths)
        QTimer.singleShot(0, go)

    @Slot()
    def clearStaged(self):
        self.stage([])

    @Slot(str, str)
    def sendText(self, fp, text):
        if text.strip():
            res = S.call("text", to=fp, text=text, timeout=10)
            if not res or not res.get("ok"):
                self.message.emit((res or {}).get("error") or "GoblinShare svarar inte")
            self.poll()

    @Slot(str, bool, result=str)
    def chat(self, fp, looking):
        """The messages with a device (JSON list); looking = its chat window is on the screen (read)."""
        res = S.call("chat", fingerprint=fp, looking=looking, timeout=1)
        return json.dumps((res or {}).get("messages") or [], ensure_ascii=False)

    @Slot(str)
    def chatClear(self, fp):
        S.call("chat_clear", fingerprint=fp)
        self.poll()

    @Slot(str, str)
    def sendOrder(self, fp, text):
        """An order to Kakan on another GOBLINCAKES computer (3 Nov)."""
        if text.strip():
            res = S.call("order", to=fp, text=text, timeout=10)
            if not res or not res.get("ok"):
                self.message.emit((res or {}).get("error") or "GoblinShare svarar inte")
            self.poll()

    @Slot(str, str)
    def startOrder(self, oid, via):
        """via "ai" = Goblin AI here, "chatgpt" = the ChatGPT app draws it (3 Nov)."""
        res = S.call("order_start", id=oid, via=via, timeout=5)
        if not res or not res.get("ok"):
            self.message.emit((res or {}).get("error") or "GoblinShare svarar inte")
        self.poll()

    @Slot(str)
    def forgetOrder(self, oid):
        S.call("order_forget", id=oid)
        self.poll()

    @Slot(str, bool)
    def answer(self, rid, accept):
        S.call("answer", id=rid, accept=accept)
        self.poll()

    @Slot(str)
    def cancel(self, tid):
        S.call("cancel", id=tid)
        self.poll()

    # ---------------------------------------------------------- terminal (ssh, 4 Nov)
    # Help on another GOBLINCAKES computer: it presses Be om hjälp and reads out a code, Terminal here asks
    # for it (askCode → the code box) – the terminal that opens is the connection Claude Code rides on.
    def _launch(self, host):
        cmd = [str(TERMINAL) if TERMINAL.exists() else "/usr/libexec/goblincakes-terminal", "run", "ssh", host]
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            self.message.emit(f"Terminalen startade inte: {e}")

    def _terminal_after_pairing(self, st):
        if not self._terminal_wanted:
            return
        jobs = {j["fingerprint"]: j for j in st.get("ssh", {}).get("jobs", [])}
        hosts = {p["fingerprint"]: p["host"] for p in st.get("ssh", {}).get("paired", [])}
        for fp, t in list(self._terminal_wanted.items()):
            job = jobs.get(fp)
            if not job or job["t"] < t - 1 or job["state"] == "väntar":
                continue
            del self._terminal_wanted[fp]
            if job["state"] == "klar" and fp in hosts:
                self.codeResult.emit(fp, True, "")
                self.message.emit(f"Inne – medan terminalen är öppen fungerar också: ssh {hosts[fp]} <kommando>")
                self._launch(hosts[fp])
            else:
                self.codeResult.emit(fp, False, job["why"] or "Gick inte")

    @Slot(str)
    def terminal(self, fp):
        """Terminal on a GOBLINCAKES card: one more terminal if one is open there, else the code box."""
        st = json.loads(self._status)
        peer = next((p for p in st.get("peers", []) if p["fingerprint"] == fp), {})

        def go(host=peer.get("ssh", ""), alias=peer.get("alias", "")):
            if host and sshlink.connected(host):
                self._launch(host)
            else:
                self.askCode.emit(fp, alias)
        threading.Thread(target=go, daemon=True).start()

    @Slot(str, str)
    def connectWithCode(self, fp, code):
        import time
        self._terminal_wanted[fp] = time.time()
        res = S.call("ssh_pair", to=fp, code="".join(c for c in code if c.isdigit()), timeout=5)
        if not res or not res.get("ok"):
            self._terminal_wanted.pop(fp, None)
            self.codeResult.emit(fp, False, (res or {}).get("error") or "GoblinShare svarar inte")
        self.poll()

    def _root(self, on, then=None):
        """"Hjälp via terminal" on/off – pkexec asks for the password, so not in the window's thread."""
        if self._ssh_busy:
            return
        self._ssh_busy = True

        def run():
            why = sshlink.set_allowed(on)
            S.call("ssh_check", timeout=5)
            self._ssh_busy = False
            if why:
                self._ssh_said = why
            elif then:
                then()
        threading.Thread(target=run, daemon=True).start()
        self.poll()

    @Slot(bool)
    def setSshAllowed(self, on):
        self._root(on)

    @Slot()
    def helpStart(self):
        """Be om hjälp: switches "Hjälp via terminal" on the first time (password), then the code."""
        def start():
            res = S.call("help_start", timeout=5) or {}
            if not res.get("ok"):
                self._ssh_said = res.get("error") or "GoblinShare svarar inte"
        if sshlink.allowed_here():
            start()
            self.poll()
        else:
            self._root(True, start)

    @Slot()
    def helpStop(self):
        S.call("help_stop", timeout=5)
        self.poll()

    @Slot(str)
    def sshForget(self, fp):
        S.call("ssh_forget", fingerprint=fp)
        self.poll()

    # ---------------------------------------------------------- settings
    @Slot(str, bool)
    def trust(self, fp, on):
        S.call("trust", fingerprint=fp, on=on)
        self.poll()

    @Slot(str)
    def setAlias(self, text):
        S.call("set", key="alias", value=text)
        self.poll()

    @Slot()
    def chooseFolder(self):
        st = json.loads(self._status)
        folder = QFileDialog.getExistingDirectory(None, "Var ska mottagna filer sparas?", st.get("folder") or
                                                  str(Path.home()))
        if folder:
            S.call("set", key="folder", value=folder)
            self.poll()

    @Slot()
    def resetFolder(self):
        S.call("set", key="folder", value="")
        self.poll()

    @Slot(float)
    def forget(self, t):
        S.call("forget", t=t)
        self.poll()

    @Slot()
    def clearHistory(self):
        S.call("clear")
        self.poll()

    # ---------------------------------------------------------- files
    @Slot(str)
    def openPath(self, path):
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

    @Slot(str)
    def showFile(self, path):
        """The folder in Dolphin with the file chosen (FileManager1), else just the folder."""
        url = QUrl.fromLocalFile(path).toString()
        ok = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.FileManager1",
                             "--object-path", "/org/freedesktop/FileManager1", "--method",
                             "org.freedesktop.FileManager1.ShowItems", f"['{url}']", ""],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 \
            if Path(path).exists() else False
        if not ok:
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(path).parent if Path(path).is_file() else path)))

    @Slot(str)
    def copyText(self, text):
        QGuiApplication.clipboard().setText(text)
        self.message.emit("Kopierat")

    @Slot(str, result=str)
    def size(self, n):
        return S.human_size(float(n or 0))


def staged_from(argv):
    """--send <files>, or files as plain arguments (the menu entry's %F, dropped on the dock icon)."""
    args = argv[argv.index("--send") + 1:] if "--send" in argv else argv[1:]
    return [str(Path(p).expanduser().resolve()) for p in args if not p.startswith("-") and Path(p).expanduser().exists()]


def main():
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.8"
    app = QApplication(sys.argv[:1])
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblin-share")
    app.setApplicationDisplayName("GoblinShare")
    app.setDesktopFileName("goblin-share")
    icon = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-share.svg"
    app_icon = QIcon.fromTheme("goblincakes-share", QIcon(str(icon)))
    app.setWindowIcon(app_icon)
    for font in os.environ.get("GOBLINCAKES_CONFIG_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)
    staged = staged_from(sys.argv)
    chat = sys.argv[sys.argv.index("--chat") + 1] if "--chat" in sys.argv[:-1] else ""

    # One window at a time: a second start brings the first one forward (with its files)
    name = os.environ.get("GOBLINCAKES_SHARE_INSTANCE", f"goblin-share-{os.getuid()}")
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(300):
        sock.write(json.dumps({"send": staged, "chat": chat}).encode() + b"\n")
        sock.waitForBytesWritten(500)
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)

    backend = Backend(staged)
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("chatOnly", bool(chat))   # the main window stays hidden
    engine.rootContext().setContextProperty("iconUrl", QUrl.fromLocalFile(
        str(icon) if icon.exists() else "/usr/share/icons/hicolor/scalable/apps/goblincakes-share.svg"))
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    win = engine.rootObjects()[0]
    if chat:
        QTimer.singleShot(0, lambda: backend.chatRequested.emit(chat))

    def incoming():
        conn = server.nextPendingConnection()
        if not conn:
            return

        def read():
            try:
                req = json.loads(bytes(conn.readAll()).decode() or "{}")
            except ValueError:
                req = {}
            files, fp = req.get("send") or [], req.get("chat") or ""
            if files:
                backend.stage(files)
            conn.close()
            if fp:
                backend.chatRequested.emit(fp)
                return
            win.show()
            win.raise_()
            win.requestActivate()
        if conn.waitForReadyRead(500):
            read()
        else:
            conn.readyRead.connect(read)
    server.newConnection.connect(incoming)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
