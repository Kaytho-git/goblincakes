#!/usr/bin/env python3
"""GOBLINCAKES Barnläge – a sandbox in your own session for a small child (13 Nov, the user's wish: the son, 3,
plays Bluey and draws in Tux Paint – his games and nothing else).

    goblin-kids              Barnläge: the magic splash, then big pictures of the games and programs chosen in
                             Config → BARNLÄGE. The X at the top right asks for the PIN code.
    goblin-kids --restore    puts everything back after a crash (also run at every login; nothing to do = nothing)
    goblin-kids --stop       ends a running Barnläge without the PIN (from a terminal: Ctrl+Alt+F3, log in)

While it is on (kids.py lock): one screen (the main one – the others are covered), every other window
minimized, every global shortcut blocked (Meta, Alt+Tab, Alt+F4, Ctrl+Alt+Del …), no notifications, the power
button does nothing, our overlays hidden in the games, the volume capped. Everything comes back with the PIN.
Window: /usr/share/goblincakes/kids/Main.qml, KWin: kids/kwin-on.js.
"""
import json
import os
import signal
import sys
import threading
import time
from pathlib import Path

KIDS = Path(os.environ.get("GOBLINCAKES_KIDS_DIR") or Path(__file__).resolve().parents[1] / "share/goblincakes/kids")
sys.path.insert(0, str(KIDS))
import kids as K  # noqa: E402

SERVICE = "org.goblincakes.kids"
NOLOCK = os.environ.get("GOBLINCAKES_KIDS_NOLOCK") == "1"   # tests: the window only, nothing locked


def use_accent(engine):
    for d in (KIDS.parent, Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


def cached_qml(path):
    try:
        import importlib.util  # noqa: PLC0415
        spec = importlib.util.spec_from_file_location("qmlcache", Path(path).resolve().parents[1] / "qmlcache.py")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module.local(path)
    except Exception:  # noqa: BLE001
        return str(path)


def open_config():
    import subprocess  # noqa: PLC0415
    exe = Path(__file__).resolve().parent / "goblincakes-config"
    subprocess.Popen([str(exe) if exe.exists() else "goblincakes-config", "--tab", "kids"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if "--restore" in sys.argv:
        if K.running_pid():
            return 0          # Barnläge is on right now – nothing to put back
        K.restore()
        return 0

    from PySide6.QtCore import ClassInfo, QObject, QSize, Qt, QTimer, QUrl, Property, Signal, Slot
    from PySide6.QtDBus import QDBusConnection, QDBusInterface
    from PySide6.QtGui import QFontDatabase, QGuiApplication, QIcon, QPixmap
    from PySide6.QtNetwork import QLocalServer, QLocalSocket
    from PySide6.QtQml import QQmlApplicationEngine
    from PySide6.QtQuick import QQuickImageProvider

    name = f"goblin-kids-{os.getuid()}"
    if "--stop" in sys.argv:
        app = QGuiApplication(sys.argv[:1])
        sock = QLocalSocket()
        sock.connectToServer(name)
        if sock.waitForConnected(500):
            sock.write(b"stop\n")
            sock.waitForBytesWritten(500)
            print("Barnläget avslutas.")
            return 0
        if K.read_state():
            K.restore()
            print("Barnläget var inte igång – allt är återställt.")
        else:
            print("Barnläget är inte igång.")
        return 0

    settings = K.load()
    if not settings["pin"] or not settings["items"]:
        print("Välj spel och en PIN-kod först: GOBLINCAKES Config → BARNLÄGE.", file=sys.stderr)
        open_config()
        return 1

    app = QGuiApplication(sys.argv[:1])
    app.setApplicationName("goblin-kids")
    app.setApplicationDisplayName("Barnläge")
    app.setDesktopFileName("goblin-kids")
    icon = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-kids.svg"
    app.setWindowIcon(QIcon.fromTheme("goblincakes-kids", QIcon(str(icon))))
    app.setQuitOnLastWindowClosed(False)
    for font in os.environ.get("GOBLINCAKES_CONFIG_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)

    # One Barnläge at a time
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(300):
        sock.write(b"show\n")
        sock.waitForBytesWritten(500)
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)
    if not NOLOCK and K.read_state():
        K.restore()           # left from a crash

    class IconProvider(QQuickImageProvider):
        """image://icon/<name or path> – a program's own icon, big."""
        def __init__(self):
            super().__init__(QQuickImageProvider.Pixmap)

        def requestPixmap(self, icon_name, size, requested):
            ic = QIcon(icon_name) if icon_name.startswith("/") else QIcon.fromTheme(icon_name)
            side = max(requested.width(), requested.height(), 256)
            pixmap = ic.pixmap(QSize(side, side)) if not ic.isNull() else QPixmap()
            if pixmap.isNull():
                pixmap = QPixmap(1, 1)
                pixmap.fill(Qt.GlobalColor.transparent)
            if size is not None:
                size.setWidth(pixmap.width())
                size.setHeight(pixmap.height())
            return pixmap

    class Backend(QObject):
        itemsChanged = Signal()
        backgroundChanged = Signal()
        backgroundsChanged = Signal()
        leaving = Signal()

        def __init__(self):
            super().__init__()
            self.settings = settings
            self._items = [dict(i, **K.picture_for(i, download=False)) for i in settings["items"]]
            self._backgrounds = K.backgrounds()
            ids = [b["id"] for b in self._backgrounds]
            self._background = settings["background"] if settings["background"] in ids else "natt"
            self.locked = False
            self.state = None
            self.cookie = None
            self._stop = threading.Event()
            self._last_launch = {}
            threading.Thread(target=self._fetch_covers, daemon=True).start()

        def _fetch_covers(self):
            changed = False
            for item in self._items:
                if item["kind"] == "steam" and not item["cover"]:
                    item.update(K.picture_for(item, download=True))
                    changed = True
            if changed:
                self.itemsChanged.emit()

        @Property(str, notify=itemsChanged)
        def items(self):
            return json.dumps(self._items, ensure_ascii=False)

        @Property(str, notify=backgroundsChanged)
        def backgrounds(self):
            return json.dumps(self._backgrounds, ensure_ascii=False)

        @Property(str, notify=backgroundChanged)
        def background(self):
            return self._background

        @Slot(str)
        def setBackground(self, bg):
            self._background = bg
            self.backgroundChanged.emit()
            threading.Thread(target=K.update, kwargs={"background": bg}, daemon=True).start()

        @Slot()
        def refreshBackgrounds(self):
            """New drawings from Tux Paint show up when the picture chooser opens."""
            self._backgrounds = K.backgrounds()
            self.backgroundsChanged.emit()

        @Slot(int, result=bool)
        def launch(self, index):
            if not 0 <= index < len(self._items):
                return False
            now = time.time()
            if now - self._last_launch.get(index, 0) < 8:    # small hands click many times
                return False
            self._last_launch[index] = now
            item = self._items[index]
            threading.Thread(target=K.launch, args=(item,), daemon=True).start()
            return True

        @Slot(str)
        def sound(self, which):
            threading.Thread(target=K.play, args=(which,), daemon=True).start()

        @Slot(str, result=bool)
        def checkPin(self, pin):
            return K.check_pin(pin, self.settings["pin"])

        @Slot()
        def leave(self):
            self.unlock()
            self.leaving.emit()
            QTimer.singleShot(150, app.quit)

        # ── the locks
        def lock(self):
            if NOLOCK or self.locked:
                return
            self.locked = True
            notes = QDBusInterface("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                                   "org.freedesktop.Notifications")
            reply = notes.call("Inhibit", "goblin-kids", "Barnläge", {})
            args = reply.arguments() if reply is not None else []
            self.cookie = args[0] if args else None
            # kwriteconfig6/busctl take a second or two – not in the splash's thread
            threading.Thread(target=self._lock_and_watch, daemon=True).start()

        def _lock_and_watch(self):
            self.state = K.lock(self.settings, SERVICE)
            if self._stop.is_set():      # ended while locking: undo what was just done
                K.restore()
                return
            self._watch()

        def _watch(self):
            """Every 1.5 s: the volume cap, and the shortcuts blocked again (KWin unblocks them when no window
            with the rule is active)."""
            n = 0
            while not self._stop.wait(1.5):
                K.cap_volume(self.settings["volume"])
                n += 1
                if n % 2 == 0:
                    K.block_shortcuts(True)

        def unlock(self):
            if not self.locked:
                return
            self.locked = False
            self._stop.set()
            if self.cookie is not None:
                QDBusInterface("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                               "org.freedesktop.Notifications").call("UnInhibit", self.cookie)
            K.restore()

    @ClassInfo({"D-Bus Interface": "org.goblincakes.kids"})
    class Service(QObject):
        """For kids/kwin-on.js: is Barnläge on, and which windows it hid."""
        @Slot(result=bool)
        def active(self):
            return backend.locked

        @Slot(str)
        def hidden(self, window_id):
            K.remember_hidden(window_id)

    backend = Backend()
    service = Service()
    bus = QDBusConnection.sessionBus()
    if not NOLOCK:
        bus.registerService(SERVICE)
        bus.registerObject("/kids", service, QDBusConnection.ExportAllSlots)

    engine = QQmlApplicationEngine()
    engine.addImageProvider("icon", IconProvider())
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("testMode", NOLOCK)
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(cached_qml(KIDS / "Main.qml")))
    if not engine.rootObjects():
        return 1
    win = engine.rootObjects()[0]

    def incoming():
        conn = server.nextPendingConnection()
        if not conn:
            return

        def read():
            text = bytes(conn.readAll()).decode(errors="replace").strip()
            conn.close()
            if text == "stop":
                backend.leave()
            else:
                win.raise_()
                win.requestActivate()
        if conn.waitForReadyRead(500):
            read()
        else:
            conn.readyRead.connect(read)
    server.newConnection.connect(incoming)

    # The locks once the window covers the screen (the splash is already showing)
    QTimer.singleShot(400, backend.lock)
    app.aboutToQuit.connect(backend.unlock)
    # Ended from outside (logout, kill): everything back first
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: QTimer.singleShot(0, backend.leave))
    tick = QTimer(interval=400)       # lets Python see the signals while Qt's loop runs
    tick.timeout.connect(lambda: None)
    tick.start()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
