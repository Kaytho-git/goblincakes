#!/usr/bin/env python3
"""Goblin AI – the window (Meta+A, AppGrid, or "goblin ai").

Chat with free (and optionally paid) AI services (see /usr/share/goblincakes/ai/goblinai.py): questions,
texts, recipes, help with the computer. Attach a text file to have it corrected
and saved back. Suggested commands are cards with a Run button; their output goes
back to the AI. Conversations are kept in ~/.local/share/goblincakes/ai/.
Only one window: starting it again brings the open one to the front.
"""
import json
import re
import os
import shutil
import subprocess
import tempfile
import sys
import threading
import time
from pathlib import Path

SHARE = Path(os.environ.get("GOBLIN_AI_SHARE", "/usr/share/goblincakes/ai"))
sys.path.insert(0, str(SHARE))
import goblinai  # noqa: E402
import learn  # noqa: E402

from PySide6.QtCore import QObject, QProcess, QProcessEnvironment, QUrl, Property, Signal, Slot  # noqa: E402
from PySide6.QtGui import QDesktopServices, QFontDatabase, QGuiApplication, QIcon  # noqa: E402
from PySide6.QtNetwork import QLocalServer, QLocalSocket  # noqa: E402
from PySide6.QtQml import QQmlApplicationEngine  # noqa: E402

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "goblincakes" / "ai"
SOCKET_NAME = f"goblin-ai-{os.getuid()}"
KEEP_CONVERSATIONS = 50


def season_logo():
    """The logo – in its look for the time of year when there is one."""
    default = "/usr/share/icons/hicolor/scalable/apps/goblincakes.svg"
    try:
        sys.path.insert(0, "/usr/share/goblincakes/seasons")
        import season
        return season.asset("logo.svg", default)
    except Exception:  # noqa: BLE001
        return default


class Backend(QObject):
    """Talks to Main.qml. Display messages: {role, text, segments, service, file}."""

    conversationChanged = Signal()  # the whole message list changed (new/loaded)
    messageAdded = Signal(str)  # JSON of one display message
    messageUpdated = Signal(int, str)  # index, JSON
    busyChanged = Signal()
    statusChanged = Signal()
    notice = Signal(str)
    conversationsChanged = Signal()
    keysChanged = Signal()
    keyTested = Signal(str, bool, str)  # provider id, ok, message
    raiseWindow = Signal()
    # From worker threads to the GUI thread
    _answered = Signal(str, str)  # answer, service
    _failed = Signal(str)
    _statusText = Signal(str)
    _keyResult = Signal(str, str, bool, str)  # provider id, key, ok, message

    def __init__(self):
        super().__init__()
        self._keys = goblinai.load_keys()
        self._project = ""  # the project chosen in the sidebar ("" = no project)
        self._projects = goblinai.load_projects()
        self._busy = False
        self._status = ""
        self._new_conversation()
        self._answered.connect(self._on_answer)
        self._failed.connect(self._on_failure)
        self._statusText.connect(lambda text: self._set_busy(True, text))
        self._keyResult.connect(self._on_key_result)
        self._procs = {}
        self._local = "{}"
        self._local_proc = None
        self._localInfo.connect(self._on_local_info)
        self.refreshLocal()
        self._learnDone.connect(self._on_learn_done)

    # ── Conversation ──────────────────────────────────────────

    def _new_conversation(self):
        self._id = time.strftime("%Y%m%d-%H%M%S")
        self._api = [{"role": "system", "content": goblinai.system_prompt()}]
        self._display = []
        self._file = None  # the attached file of this conversation (path)
        self._cwd = str(Path.home())  # where the next command card runs (follows `cd`, like a terminal)

    @Property(str, notify=conversationChanged)
    def messages(self):
        return json.dumps(self._display)

    @Property(bool, notify=busyChanged)
    def busy(self):
        return self._busy

    def _set_busy(self, busy, status=""):
        self._busy, self._status = busy, status
        self.busyChanged.emit()
        self.statusChanged.emit()

    @Property(str, notify=statusChanged)
    def status(self):
        return self._status

    @Property(str, notify=conversationChanged)
    def conversationId(self):
        return self._id

    @Slot()
    def newConversation(self):
        if self._busy:
            return
        self._new_conversation()
        self.conversationChanged.emit()

    @Slot(str, str)
    def send(self, text, attachment):
        text = text.strip()
        if self._busy or not (text or attachment):
            return
        content = text or "Titta på den här filen."
        shown = {"role": "user", "text": text, "segments": [], "service": "", "file": ""}
        if attachment:
            path = QUrl(attachment).toLocalFile() if attachment.startswith("file:") else attachment
            try:
                content = goblinai.file_message(path, content)
            except (OSError, ValueError) as e:
                self.notice.emit(str(e))
                return
            self._file = path
            shown["file"] = Path(path).name
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._api.append({"role": "user", "content": content})
        self._ask()

    def _project_of(self, project_id):
        return next((p for p in self._projects if p["id"] == project_id), None)

    def _ask(self):
        self._set_busy(True, "Tänker…")
        project = self._project_of(self._project)
        messages = list(self._api)
        # The project's instructions and fixed files, read now (changed files are seen at once)
        messages[0] = {"role": "system", "content": goblinai.system_prompt() + goblinai.project_prompt(project)}

        def work():
            try:
                answer, service = goblinai.ask(
                    messages, self._keys,
                    status=self._statusText.emit,
                    notice=self.notice.emit,
                    project=project)
                self._answered.emit(answer, service)
            except goblinai.ServiceError as e:
                self._failed.emit(str(e))
            except Exception as e:  # never leave the window hanging
                self._failed.emit(f"Något gick fel: {e}")

        threading.Thread(target=work, daemon=True).start()

    def _on_answer(self, answer, service):
        self._api.append({"role": "assistant", "content": answer})
        shown = {"role": "assistant", "text": answer, "segments": goblinai.segments(answer),
                 "service": service, "file": ""}
        for seg in shown["segments"]:
            if seg["type"] == "file":
                seg["canOverwrite"] = bool(self._file) and Path(self._file).name == seg["name"]
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._set_busy(False)
        self._save()

    def _on_failure(self, message):
        shown = {"role": "error", "text": message, "segments": [], "service": "", "file": ""}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        # Let the user ask again: drop the unanswered question from what the AI sees
        if self._api and self._api[-1]["role"] == "user":
            self._api.pop()
        self._set_busy(False)

    def _update(self, index):
        self.messageUpdated.emit(index, json.dumps(self._display[index]))

    # ── Commands ──────────────────────────────────────────────

    @Slot(int, int)
    def runCommand(self, index, seg):
        part = self._display[index]["segments"][seg]
        if part["state"] != "new" or self._busy:
            return
        code = part["code"]
        if "sudo" in code or "read " in code:
            # Needs a password or answers: run it in a terminal the user can type in
            script = (goblinai.command_script(code, self._cwd)
                      + "\necho\nread -rp 'Klart – tryck Enter för att stänga… ' _")
            QProcess.startDetached("/usr/libexec/goblincakes-terminal", ["run", "bash", "-c", script])
            part.update(state="done", output="Körs i ett terminalfönster (behöver ditt lösenord eller svar).")
            self._update(index)
            return self._command_done(index, ran_in_terminal=True)
        part["state"] = "running"
        self._update(index)
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)
        fd, cwd_file = tempfile.mkstemp(prefix="goblin-ai-cwd-")
        os.close(fd)
        env = QProcessEnvironment.systemEnvironment()
        env.insert("GOBLIN_CWD_FILE", cwd_file)
        proc.setProcessEnvironment(env)
        self._procs[(index, seg)] = proc

        def finished(exit_code, _status, index=index, seg=seg):
            p = self._procs.pop((index, seg))
            self._cwd = goblinai.read_cwd(cwd_file, self._cwd)
            Path(cwd_file).unlink(missing_ok=True)
            out = bytes(p.readAllStandardOutput()).decode(errors="replace")
            part = self._display[index]["segments"][seg]
            part.update(state="done", output=out.strip(), code_result=exit_code)
            self._update(index)
            self._command_done(index)

        proc.finished.connect(finished)
        proc.start("bash", ["-c", goblinai.command_script(code, self._cwd)])

    @Slot(int, int)
    def skipCommand(self, index, seg):
        part = self._display[index]["segments"][seg]
        if part["state"] == "new":
            part["state"] = "skipped"
            self._update(index)
            self._command_done(index)

    def _command_done(self, index, ran_in_terminal=False):
        """When every command card in the answer is run or skipped: tell the AI how it went."""
        parts = [s for s in self._display[index]["segments"] if s["type"] == "command"]
        if any(s["state"] in ("new", "running") for s in parts):
            return
        if all(s["state"] == "skipped" for s in parts):
            return
        report = []
        for s in parts:
            if s["state"] == "skipped":
                report.append(f"$ {s['code']}\n(användaren valde att inte köra det)")
            else:
                out = s.get("output", "")
                if len(out) > 6000:
                    out = "…(början utelämnad)…\n" + out[-6000:]
                report.append(f"$ {s['code']}\n{out}\n(avslutskod {s.get('code_result', '?')})")
        self._api.append({"role": "user", "content": "Så här gick det:\n\n" + "\n\n".join(report)
                          + f"\n\n(Mappen nu: {self._cwd})"
                          + "\n\nFortsätt med nästa steg, eller säg kort att det är klart."})
        self._ask()

    # ── Files and copying ─────────────────────────────────────

    @Slot(int, int)
    def saveFile(self, index, seg):
        """Writes the new version over the attached file, keeping the old one as <name>.bak."""
        part = self._display[index]["segments"][seg]
        if not self._file:
            return
        path = Path(self._file)
        try:
            if path.exists():
                shutil.copy2(path, path.with_name(path.name + ".bak"))
            path.write_text(part["code"] + "\n")
            part["state"] = "saved"
            part["savedTo"] = str(path)
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    @Slot(int, int, str)
    def saveFileAs(self, index, seg, url):
        part = self._display[index]["segments"][seg]
        path = Path(QUrl(url).toLocalFile() if url.startswith("file:") else url)
        try:
            path.write_text(part["code"] + "\n")
            part["state"] = "saved"
            part["savedTo"] = str(path)
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    @Slot(str)
    def copy(self, text):
        QGuiApplication.clipboard().setText(text)
        self.notice.emit("Kopierat")

    @Slot(str, result=str)
    def fileName(self, url):
        return Path(QUrl(url).toLocalFile() if url.startswith("file:") else url).name

    # ── Saved conversations ───────────────────────────────────

    def _save(self):
        DATA.mkdir(parents=True, exist_ok=True)
        first = next((m["text"] for m in self._display if m["role"] == "user" and m["text"]), "")
        title = (first or next((m["file"] for m in self._display if m["file"]), "Samtal"))[:80]
        data = {"id": self._id, "title": title, "updated": time.time(), "file": self._file,
                "cwd": self._cwd, "project": self._project, "api": self._api[1:], "display": self._display}
        (DATA / f"{self._id}.json").write_text(json.dumps(data, ensure_ascii=False))
        # The latest 50 outside projects are kept; a project's chats stay until removed
        loose = [f for f in sorted(DATA.glob("2*.json"), reverse=True) if not self._chat_project(f)]
        for old in loose[KEEP_CONVERSATIONS:]:
            old.unlink(missing_ok=True)
        self.conversationsChanged.emit()

    @staticmethod
    def _chat_project(path):
        try:
            return json.loads(path.read_text()).get("project", "")
        except (OSError, ValueError):
            return ""

    @Property(str, notify=conversationsChanged)
    def conversations(self):
        """The chats of the chosen project (or those outside projects when none is chosen)."""
        items = []
        for f in sorted(DATA.glob("2*.json"), reverse=True) if DATA.exists() else []:
            try:
                d = json.loads(f.read_text())
                if d.get("project", "") == self._project:
                    items.append({"id": d["id"], "title": d["title"]})
            except (OSError, ValueError, KeyError):
                continue
        return json.dumps(items)

    @Slot(str)
    def openConversation(self, conv_id):
        if self._busy:
            return
        try:
            d = json.loads((DATA / f"{conv_id}.json").read_text())
        except (OSError, ValueError):
            return
        self._id = d["id"]
        if d.get("project", "") != self._project:
            self._project = d.get("project", "")
            self.projectsChanged.emit()
        self._api = [{"role": "system", "content": goblinai.system_prompt()}] + d["api"]
        self._display = d["display"]
        self._file = d.get("file")
        self._cwd = d.get("cwd") or str(Path.home())
        self.conversationChanged.emit()

    @Slot(str)
    def deleteConversation(self, conv_id):
        (DATA / f"{conv_id}.json").unlink(missing_ok=True)
        if conv_id == self._id:
            self._new_conversation()
            self.conversationChanged.emit()
        self.conversationsChanged.emit()

    # ── Services and keys ─────────────────────────────────────

    @Property(str, notify=keysChanged)
    def providers(self):
        return json.dumps([{"id": p["id"], "name": p["name"], "how": p["how"], "page": p["keys_page"],
                            "hasKey": bool(self._keys.get(p["env"]))} for p in goblinai.SERVICES])

    @Property(bool, notify=keysChanged)
    def hasKeys(self):
        return goblinai.has_keys(self._keys)

    @Slot(str)
    def openKeyPage(self, provider_id):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        QDesktopServices.openUrl(QUrl(p["keys_page"]))

    @Slot(str, str)
    def setKey(self, provider_id, key):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        key = key.strip()
        if not key:
            return

        def work():
            try:
                self._keyResult.emit(provider_id, key, True, f"Fungerar – {goblinai.test_key(p, key)}")
            except goblinai.ServiceError as e:
                self._keyResult.emit(provider_id, key, False, f"Fungerade inte: {e}")

        self.keyTested.emit(provider_id, True, "Testar nyckeln…")
        threading.Thread(target=work, daemon=True).start()

    def _on_key_result(self, provider_id, key, ok, message):
        if ok:
            p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
            self._keys[p["env"]] = key
            goblinai.EXHAUSTED.discard(provider_id)
            goblinai.save_keys(self._keys)
            self.keysChanged.emit()
        self.keyTested.emit(provider_id, ok, message)

    @Slot(str)
    def removeKey(self, provider_id):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        self._keys.pop(p["env"], None)
        goblinai.save_keys(self._keys)
        self.keysChanged.emit()


    # ── Projects (sidebar) ─────────────────────────────────────

    projectsChanged = Signal()

    @Property(str, notify=projectsChanged)
    def projects(self):
        return json.dumps(self._projects, ensure_ascii=False)

    @Property(str, notify=projectsChanged)
    def currentProject(self):
        return self._project

    @Property(str, constant=True)
    def templates(self):
        return json.dumps([dict(t, id=k) for k, t in goblinai.TEMPLATES.items()], ensure_ascii=False)

    @Slot(str)
    def selectProject(self, project_id):
        """Shows the project's chats; a new chat is started in it."""
        if self._busy:
            return
        self._project = project_id if self._project_of(project_id) else ""
        self._new_conversation()
        self.projectsChanged.emit()
        self.conversationChanged.emit()
        self.conversationsChanged.emit()

    @Slot(str, result=str)
    def createProject(self, template):
        t = goblinai.TEMPLATES.get(template, goblinai.TEMPLATES["vardag"])
        names = {p["name"] for p in self._projects}
        name, n = t["name"], 2
        while name in names:
            name, n = f"{t['name']} {n}", n + 1
        project = goblinai.clean_project(dict(t, id=time.strftime("p%Y%m%d%H%M%S-") + os.urandom(3).hex(), name=name))
        self._projects.append(project)
        goblinai.save_projects(self._projects)
        self.selectProject(project["id"])
        return project["id"]

    @Slot(str)
    def saveProject(self, text):
        try:
            new = goblinai.clean_project(json.loads(text))
        except (ValueError, KeyError):
            return
        self._projects = [new if p["id"] == new["id"] else p for p in self._projects]
        goblinai.save_projects(self._projects)
        self.projectsChanged.emit()

    @Slot(str, bool)
    def deleteProject(self, project_id, with_chats):
        self._projects = [p for p in self._projects if p["id"] != project_id]
        goblinai.save_projects(self._projects)
        for f in DATA.glob("2*.json") if DATA.exists() else []:
            if self._chat_project(f) == project_id:
                if with_chats:
                    f.unlink(missing_ok=True)
                else:  # the chats stay, outside projects
                    d = json.loads(f.read_text())
                    d["project"] = ""
                    f.write_text(json.dumps(d, ensure_ascii=False))
        if self._project == project_id:
            self._project = ""
            self._new_conversation()
            self.conversationChanged.emit()
        self.projectsChanged.emit()
        self.conversationsChanged.emit()

    @Slot(str, result=str)
    def localPath(self, url):
        return QUrl(url).toLocalFile() if url.startswith("file:") else url

    @Slot(int, int)
    def saveToProject(self, index, seg):
        """A file card straight into the project's folder (same name; the old one becomes .bak)."""
        project = self._project_of(self._project)
        part = self._display[index]["segments"][seg]
        if not project or not project["folder"]:
            return
        path = Path(project["folder"]).expanduser() / Path(part.get("name") or "fil.txt").name
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.exists():
                shutil.copy2(path, path.with_name(path.name + ".bak"))
            path.write_text(part["code"] + "\n")
            part.update(state="saved", savedTo=str(path))
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    # ── Learning mode ("Lär dig koda", learn.py) ──────────────────

    learnChanged = Signal()
    learnResult = Signal(str, str)  # task id, JSON {ok, output, message}
    learnBusy = Signal(str)  # status text while running/building, "" = done
    _learnDone = Signal(str, str)
    LEARN_PROJECT = "learn"

    @Property(str, notify=learnChanged)
    def learnState(self):
        return json.dumps(learn.state(), ensure_ascii=False)

    @Slot(str, result=str)
    def learnModule(self, module_id):
        learn.set_current(module_id)
        return json.dumps(learn.module_view(module_id) or {}, ensure_ascii=False)

    @Slot(str, str, str, str, str)
    def startCourse(self, goal, tracks, level, own_goal, order):
        tracks = [t for t in json.loads(tracks or "[]") if isinstance(t, str)]
        if goal or tracks or not own_goal.strip():
            learn.start_course(goal, tracks, level, own_goal, order)
            self._learn_project(order)
            self.learnChanged.emit()
            return

        def work():
            # Only the user's own words: the AI picks tracks from the course base (never invents any)
            base = learn.load_base()
            listing = "\n".join(f"{t['id']}: {t['name']} – {t['desc']}" for t in base["tracks"])
            question = [{"role": "system", "content": "Du väljer spår ur en kurslista. Svara BARA med en JSON-lista med spårens id, i den ordning de ska läras, t.ex. [\"html\", \"php\"]."},
                        {"role": "user", "content": f"Spåren:\n{listing}\n\nAnvändarens mål: {own_goal}"}]
            try:
                answer, _ = goblinai.ask_once(question, self._keys, project={"order": order, "prefer": "vardag", "models": {}})
                picked = [t for t in json.loads(re.search(r"\[.*?\]", answer, re.S).group(0))
                          if any(x["id"] == t for x in base["tracks"])]
            except Exception:  # noqa: BLE001 – no AI or no answer: the user picks the tracks
                picked = []
            if picked:
                learn.start_course("", picked, level, own_goal, order)
                self._learn_project(order)
                self._learnDone.emit("", "")
            else:
                self._learnDone.emit("", "Kunde inte koppla målet till spår – välj spåren själv nedan.")
        self.learnBusy.emit("Gör en läroplan…")
        threading.Thread(target=work, daemon=True).start()

    def _on_learn_done(self, task_id, payload):
        self.learnBusy.emit("")
        if task_id:
            self.learnResult.emit(task_id, payload)
        elif payload:
            self.notice.emit(payload)
        self.learnChanged.emit()

    @Slot(str, str, bool)
    def runTask(self, task_id, code, is_test):
        def work():
            if not learn.sandbox_ready():
                self.learnBusy.emit("Gör i ordning övningsdatorn (en gång, behöver internet, några minuter)…")
                ok, last = learn.build_sandbox(lambda line: self.learnBusy.emit("Övningsdatorn: " + line))
                if not ok:
                    self._learnDone.emit(task_id, json.dumps({"ok": False, "output": last,
                                                               "message": "Övningsdatorn gick inte att göra i ordning (nätverket?)."}))
                    return
            self.learnBusy.emit("Kör…")
            result = learn.check_task(task_id, code)
            if result["ok"] and is_test:
                module, _ = learn.find_task(learn.load_base(), task_id)
                learn.passed_test(module["id"])
                result["message"] = "Provet klarat – momentet är avbockat."
            self._learnDone.emit(task_id, json.dumps(result, ensure_ascii=False))
        self.learnBusy.emit("Kör…")
        threading.Thread(target=work, daemon=True).start()

    @Slot(str)
    def learnHint(self, task_id):
        learn.next_hint(task_id)
        self.learnChanged.emit()

    @Slot(str)
    def learnSolution(self, task_id):
        learn.show_solution(task_id)
        self.learnChanged.emit()

    @Slot(str, str)
    def learnDraft(self, task_id, code):
        learn.save_draft(task_id, code)

    @Slot(str, result=str)
    def learnTestTask(self, module_id):
        return learn.test_out(module_id)

    @Slot()
    def learnReset(self):
        learn.reset_course()
        self.learnChanged.emit()

    @Slot(str)
    def previewHtml(self, code):
        """The page in the browser (a file in the user's own cache folder)."""
        folder = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "goblincakes/learn-preview"
        folder.mkdir(parents=True, exist_ok=True)
        page = folder / "index.html"
        page.write_text(code)
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(page)))

    def _learn_project(self, order):
        """Goblin AI's project "Lärläge": the teacher's rules; only local AI unless the user chose otherwise."""
        project = {"id": self.LEARN_PROJECT, "name": "Lärläge", "instructions": learn.TUTOR_PROMPT,
                   "order": order or "local-only", "prefer": "kod", "search": False}
        old = self._project_of(self.LEARN_PROJECT)
        if old:
            project = dict(old, instructions=learn.TUTOR_PROMPT, order=order or old["order"])
        self._projects = [p for p in self._projects if p["id"] != self.LEARN_PROJECT] + [goblinai.clean_project(project)]
        goblinai.save_projects(self._projects)
        self.projectsChanged.emit()

    @Slot(str, str, str, str)
    def askTutor(self, task_id, code, output, question):
        """The teacher, in the project "Lärläge": one chat per task, with the lesson and the code."""
        if self._busy:
            return
        state = learn.state().get("course") or {}
        if not self._project_of(self.LEARN_PROJECT):
            self._learn_project(state.get("order", "local-only"))
        p = learn.load_progress()
        conv = p.get("tutor", {}).get(task_id)
        if conv and (DATA / f"{conv}.json").exists():
            self.openConversation(conv)
        else:
            self.selectProject(self.LEARN_PROJECT)
            p = learn.load_progress()
            p.setdefault("tutor", {})[task_id] = self._id
            learn.save_progress(p)
        context = learn.tutor_context(task_id, code, output)
        text = question.strip() or ("Förklara felet." if output else "Jag behöver hjälp med uppgiften.")
        self._display.append({"role": "user", "text": text, "segments": [], "service": "", "file": ""})
        self.messageAdded.emit(json.dumps(self._display[-1]))
        self._api.append({"role": "user", "content": f"{text}\n\n(Underlag från lärläget – det här skrev inte användaren:)\n{context}"})
        self.conversationChanged.emit()
        self._ask()

    # ── Local AI (Ollama, /usr/libexec/goblincakes-ollama) ──────

    localChanged = Signal()
    localProgress = Signal(str, float)  # status line, 0–1 (-1 = unknown)
    localDone = Signal(bool, str)  # ok, message
    _localInfo = Signal(str)

    @Property(str, notify=localChanged)
    def local(self):
        return self._local

    @Property(bool, notify=localChanged)
    def localBusy(self):
        return self._local_proc is not None

    @Slot()
    def refreshLocal(self):
        """Status, places and suggestions together (in a thread – nvidia-smi and the server take a moment)."""
        def work():
            out = {}
            for key, args in (("status", ["status"]), ("places", ["places"]), ("recommend", ["recommend"])):
                try:
                    r = subprocess.run([goblinai.OLLAMA_HELPER, *args], capture_output=True, text=True, timeout=30)
                    out[key] = json.loads(r.stdout)
                except (OSError, ValueError, subprocess.SubprocessError):
                    out[key] = None
            self._localInfo.emit(json.dumps(out))
        threading.Thread(target=work, daemon=True).start()

    def _on_local_info(self, text):
        self._local = text
        self.localChanged.emit()
        self.keysChanged.emit()  # the chat can be used with only the local AI

    def _local_run(self, args, done_text):
        if self._local_proc is not None:
            return
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.SeparateChannels)
        errors = []

        def read():
            while proc.canReadLine():
                line = bytes(proc.readLine()).decode(errors="replace").rstrip("\n")
                if line.startswith("@@progress "):
                    try:
                        ev = json.loads(line[11:])
                    except ValueError:
                        continue
                    total, done = ev.get("total") or 0, ev.get("completed") or 0
                    gb = f"{done / 1024 ** 3:.1f} av {total / 1024 ** 3:.1f} GB" if total else ev.get("status", "")
                    self.localProgress.emit(gb, done / total if total else -1.0)
                elif line.startswith("@@ "):
                    self.localProgress.emit(line[3:], -1.0)

        def finished(code, _status):
            read()
            errors.append(bytes(proc.readAllStandardError()).decode(errors="replace").strip())
            ok = code == 0
            self._local_proc = None
            self.localDone.emit(ok, done_text if ok else (errors[-1].splitlines() or ["Något gick fel"])[-1])
            self.refreshLocal()
            proc.deleteLater()
        proc.readyReadStandardOutput.connect(read)
        proc.finished.connect(finished)
        self._local_proc = proc
        self.localChanged.emit()
        proc.start(goblinai.OLLAMA_HELPER, args)

    @Slot(str)
    def installLocal(self, place):
        self._local_run(["install", place], "Lokal AI är installerad. Hämta en modell nedan.")

    @Slot(str, str)
    def pullLocal(self, model, role):
        model = model.strip()
        if model:
            self._local_run(["pull", model] + ([role] if role else []), f"{model} är hämtad.")

    @Slot(str)
    def removeLocalModel(self, model):
        self._local_run(["rm", model], f"{model} är borttagen.")

    @Slot(str)
    def moveLocal(self, place):
        self._local_run(["move", place], "Lokal AI är flyttad.")

    @Slot()
    def updateLocal(self):
        self._local_run(["update"], "Ollama är uppdaterat.")

    @Slot(bool)
    def uninstallLocal(self, models_too):
        self._local_run(["uninstall"] + (["--models"] if models_too else []), "Lokal AI är borttagen.")

    @Slot(str)
    def setLocalOrder(self, order):
        subprocess.run([goblinai.OLLAMA_HELPER, "order", order], capture_output=True)
        self.refreshLocal()


def use_accent(engine):
    """GOBLINCAKES' accent colour (Config → Utseende) as the QML property "accent", followed
    live: /usr/share/goblincakes/accent.py. Without it: the standard blue."""
    for d in (SHARE.parent, Path(__file__).resolve().parents[1] / "share/goblincakes", Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


def main():
    # The QML uses fixed pixel sizes: drawn at 80 % (still sharp – Qt renders at that size),
    # matching GOBLINCAKES' 9 pt interface. Not passed on to programs started from here.
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.8"
    app = QGuiApplication(sys.argv)
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblin-ai")
    app.setApplicationDisplayName("Goblin AI")
    app.setDesktopFileName("goblin-ai")
    # Its own icon (the goblin above what the program does); the file next to /usr when the icon
    # theme doesn't know it yet (started from the repo)
    icon = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-ai.svg"
    app.setWindowIcon(QIcon.fromTheme("goblincakes-ai", QIcon(str(icon))))
    for font in os.environ.get("GOBLIN_AI_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)

    # Already open: bring that window to the front instead
    probe = QLocalSocket()
    probe.connectToServer(SOCKET_NAME)
    if probe.waitForConnected(300):
        probe.write(b"show")
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(SOCKET_NAME)
    server = QLocalServer()
    server.listen(SOCKET_NAME)

    backend = Backend()
    server.newConnection.connect(lambda: (server.nextPendingConnection(), backend.raiseWindow.emit()))

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("logoUrl", QUrl.fromLocalFile(
        os.environ.get("GOBLINCAKES_LOGO") or season_logo()))
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
