def prepare_image(path):
    """A copy of a picture for the chat: at most PICTURE_SIDE px, JPEG; returns its path."""
    return prepare_qimage(QImage(str(path)))


def prepare_qimage(image):
    if image.isNull():
        raise ValueError("Bilden går inte att läsa.")
    if max(image.width(), image.height()) > PICTURE_SIDE:
        image = image.scaled(PICTURE_SIDE, PICTURE_SIDE, Qt.KeepAspectRatio, Qt.SmoothTransformation)
    PICTURES.mkdir(parents=True, exist_ok=True)
    out = PICTURES / f"{time.strftime('%Y%m%d-%H%M%S')}-{time.time_ns() % 1000000}.jpg"
    if not image.convertToFormat(QImage.Format_RGB888).save(str(out), "JPEG", 88):
        raise ValueError("Bilden gick inte att spara.")
    return str(out)


PDF_TEXT_LIMIT = 150_000  # characters of a PDF's text sent along
PDF_PICTURE_PAGES = 4  # pages of a scanned PDF sent as pictures


def read_pdf(path):
    """(text, pages, pictures): the PDF's text with page markers; a scanned PDF (hardly any text)
    gives its first pages as pictures instead (for a model that sees pictures)."""
    doc = QPdfDocument()
    if doc.load(str(path)) != QPdfDocument.Error.None_:
        raise ValueError("PDF:en går inte att öppna (skadad eller lösenordsskyddad?).")
    pages = doc.pageCount()
    parts = [f"--- Sida {i + 1} ---\n{doc.getAllText(i).text().strip()}" for i in range(pages)]
    text = "\n\n".join(parts)
    if len(text) - sum(len(f"--- Sida {i + 1} ---") + 2 for i in range(pages)) < 80 * max(pages, 1):
        pictures = []
        for i in range(min(pages, PDF_PICTURE_PAGES)):
            size = doc.pagePointSize(i)
            scale = PICTURE_SIDE / max(size.width(), size.height(), 1)
            image = doc.render(i, QSize(int(size.width() * scale), int(size.height() * scale)))
            pictures.append(prepare_qimage(image))
        doc.close()
        return "", pages, pictures
    doc.close()
    if len(text) > PDF_TEXT_LIMIT:
        text = text[:PDF_TEXT_LIMIT] + "\n\n…(resten av PDF:en är utelämnad – den var för lång)"
    return text, pages, []


def save_pdf(markdown, path, title):
    """An answer as a PDF (A4, IBM Plex Sans, black on white) – made here, nothing is sent anywhere."""
    doc = QTextDocument()
    doc.setDefaultFont(QFont("IBM Plex Sans", 10))
    doc.setMarkdown(markdown)
    writer = QPdfWriter(str(path))
    writer.setTitle(title)
    writer.setCreator("Goblin AI – GOBLINCAKES")
    writer.setPageSize(QPageSize(QPageSize.PageSizeId.A4))
    writer.setPageMargins(QMarginsF(20, 20, 20, 20), QPageLayout.Unit.Millimeter)
    doc.print_(writer)


def answer_document(markdown):
    doc = QTextDocument()
    doc.setDefaultFont(QFont("IBM Plex Sans", 10))
    doc.setMarkdown(markdown)
    return doc


def xml_text(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def docx_runs(block):
    """A paragraph's text as Word runs: bold, italic and code kept."""
    runs = []
    it = block.begin()
    while not it.atEnd():
        frag = it.fragment()
        if frag.isValid() and frag.text():
            f = frag.charFormat()
            props = ""
            if f.fontWeight() >= 600:
                props += "<w:b/>"
            if f.fontItalic():
                props += "<w:i/>"
            if f.fontFixedPitch() or "monospace" in (f.fontFamilies() or []):
                props += '<w:rFonts w:ascii="Courier New" w:hAnsi="Courier New"/>'
            if f.isAnchor():
                props += '<w:color w:val="2F6FED"/><w:u w:val="single"/>'
            for i, part in enumerate(frag.text().replace("\u2029", "\n").replace("\u2028", "\n").split("\n")):
                if i:
                    runs.append("<w:r><w:br/></w:r>")
                if part:
                    runs.append(f'<w:r>{f"<w:rPr>{props}</w:rPr>" if props else ""}'
                                f'<w:t xml:space="preserve">{xml_text(part)}</w:t></w:r>')
        it += 1
    return "".join(runs)


def docx_paragraph(block):
    fmt = block.blockFormat()
    props, prefix = "", ""
    level = fmt.headingLevel()
    if level:
        props += f'<w:pStyle w:val="Heading{min(level, 3)}"/>'
    lst = block.textList()
    if lst:
        depth = max(1, lst.format().indent())
        props += f'<w:ind w:left="{360 * depth + 360}" w:hanging="360"/>'
        style = lst.format().style()
        numbered = style in (QTextListFormat.Style.ListDecimal, QTextListFormat.Style.ListLowerAlpha,
                             QTextListFormat.Style.ListUpperAlpha)
        prefix = f"{lst.itemNumber(block) + 1}.\t" if numbered else "•\t"
    if fmt.nonBreakableLines():  # a code block
        props += '<w:spacing w:after="0"/><w:shd w:val="clear" w:fill="F0F2F5"/>'
    align = fmt.alignment()
    if align & Qt.AlignmentFlag.AlignRight:
        props += '<w:jc w:val="right"/>'
    elif align & Qt.AlignmentFlag.AlignHCenter:
        props += '<w:jc w:val="center"/>'
    body = (f'<w:r><w:t xml:space="preserve">{xml_text(prefix)}</w:t></w:r>' if prefix else "") + docx_runs(block)
    return f'<w:p>{f"<w:pPr>{props}</w:pPr>" if props else ""}{body}</w:p>'


DOCX_STYLES = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
<w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="IBM Plex Sans" w:hAnsi="IBM Plex Sans" w:cs="Arial"/><w:sz w:val="21"/></w:rPr></w:rPrDefault>
<w:pPrDefault><w:pPr><w:spacing w:after="120"/></w:pPr></w:pPrDefault></w:docDefaults>
<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/></w:style>
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:pPr><w:spacing w:before="240"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:sz w:val="32"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:pPr><w:spacing w:before="200"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:sz w:val="27"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:pPr><w:spacing w:before="160"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:sz w:val="23"/></w:rPr></w:style>
<w:style w:type="table" w:styleId="Grid"><w:name w:val="Table Grid"/><w:tblPr><w:tblBorders>
<w:top w:val="single" w:sz="4" w:color="BFC6D2"/><w:left w:val="single" w:sz="4" w:color="BFC6D2"/><w:bottom w:val="single" w:sz="4" w:color="BFC6D2"/>
<w:right w:val="single" w:sz="4" w:color="BFC6D2"/><w:insideH w:val="single" w:sz="4" w:color="BFC6D2"/><w:insideV w:val="single" w:sz="4" w:color="BFC6D2"/>
</w:tblBorders></w:tblPr></w:style>
</w:styles>"""


def save_docx(markdown, path, title):
    """An answer as a Word document (.docx): headings, paragraphs, bold/italic/code, lists and tables –
    written here with the standard library (Qt has no Word writer), nothing is sent anywhere."""
    import zipfile
    doc = answer_document(markdown)
    body, block = [], doc.begin()
    while block.isValid():
        table = QTextCursor(block).currentTable()
        if table:
            rows = []
            for r in range(table.rows()):
                cells = []
                for col in range(table.columns()):
                    cell = table.cellAt(r, col)
                    paras, b = [], cell.firstCursorPosition().block()
                    while b.isValid() and b.position() <= cell.lastCursorPosition().position():
                        paras.append(docx_paragraph(b))
                        b = b.next()
                    head = '<w:tcPr><w:shd w:val="clear" w:fill="E6ECF5"/></w:tcPr>' if r == 0 else ""
                    cells.append(f"<w:tc>{head}{''.join(paras) or '<w:p/>'}</w:tc>")
                rows.append(f"<w:tr>{''.join(cells)}</w:tr>")
            grid = "".join(f'<w:gridCol w:w="{9638 // table.columns()}"/>' for _ in range(table.columns()))
            body.append('<w:tbl><w:tblPr><w:tblStyle w:val="Grid"/><w:tblW w:w="5000" w:type="pct"/></w:tblPr>'
                        f"<w:tblGrid>{grid}</w:tblGrid>" + "".join(rows) + "</w:tbl><w:p/>")
            block = table.lastCursorPosition().block().next()
            continue
        if block.text().strip() or block.blockFormat().headingLevel():
            body.append(docx_paragraph(block))
        block = block.next()
    document = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body>'
                + "".join(body) + '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/>'
                '<w:pgMar w:top="1134" w:right="1134" w:bottom="1134" w:left="1134" w:header="0" w:footer="0" w:gutter="0"/>'
                "</w:sectPr></w:body></w:document>")
    core = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><cp:coreProperties '
            'xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>' + xml_text(title) + "</dc:title>"
            "<dc:creator>Goblin AI – GOBLINCAKES</dc:creator></cp:coreProperties>")
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                   '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
                   '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
                   '<Default Extension="xml" ContentType="application/xml"/>'
                   '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
                   '<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>'
                   '<Override PartName="/docProps/core.xml" ContentType="application/vnd.openxmlformats-package.core-properties+xml"/>'
                   "</Types>")
        z.writestr("_rels/.rels",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                   '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                   '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>'
                   '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/>'
                   "</Relationships>")
        z.writestr("word/_rels/document.xml.rels",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                   '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                   '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>'
                   "</Relationships>")
        z.writestr("word/document.xml", document)
        z.writestr("word/styles.xml", DOCX_STYLES)
        z.writestr("docProps/core.xml", core)


def save_answer(markdown, path, title):
    """Spara som…: the format follows the file ending – .pdf, .docx (Word), .odt, .txt, .md or .html."""
    ext = Path(path).suffix.lower()
    if ext == ".pdf":
        save_pdf(markdown, path, title)
    elif ext == ".docx":
        save_docx(markdown, path, title)
    elif ext == ".odt":
        writer = QTextDocumentWriter(str(path), b"odf")
        if not writer.write(answer_document(markdown)):
            raise OSError("kunde inte skriva filen")
    elif ext in (".md", ".markdown"):
        Path(path).write_text(markdown.rstrip() + "\n")
    elif ext in (".html", ".htm"):
        Path(path).write_text(answer_document(markdown).toHtml())
    else:  # text: the Markdown without its marks (lists, tables and line breaks stay readable)
        text = re.sub(r"\[([^\]]+)\]\((\S+?)\)", r"\1 (\2)", markdown)
        text = re.sub(r"(\*\*|__|(?<!`)`(?!`))", "", text)
        text = re.sub(r"^```\w*\n?", "", text, flags=re.M)
        text = re.sub(r"^#{1,6}\s+", "", text, flags=re.M)
        Path(path).write_text(text.rstrip() + "\n")


def kwin_script(code):
    """Runs a short KWin script (Plasma): minimizes/brings back this program's window."""
    fd, name = tempfile.mkstemp(prefix="goblin-ai-", suffix=".js")
    os.write(fd, code.encode())
    os.close(fd)
    plugin = f"goblin-ai-{os.getpid()}-{time.time_ns()}"
    call = ["busctl", "--user", "call", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting"]
    try:
        subprocess.run(call + ["loadScript", "ss", name, plugin], capture_output=True, timeout=5)
        subprocess.run(call + ["start"], capture_output=True, timeout=5)
        time.sleep(0.2)
        subprocess.run(call + ["unloadScript", "s", plugin], capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass
    finally:
        os.unlink(name)


def take_screenshot(scope):
    """Goblin AI's window steps aside, Spectacle takes the screen with the pointer (or both), the window
    comes back; returns the prepared picture. scope: "screen" | "all" | "region" (drag a box; Esc = none)."""
    mine = f"w.pid == {os.getpid()} && w.normalWindow"
    kwin_script(f"for (const w of workspace.windowList()) if ({mine}) w.minimized = true;")
    time.sleep(0.6)  # the minimize animation
    fd, raw = tempfile.mkstemp(prefix="goblin-ai-shot-", suffix=".png")
    os.close(fd)
    try:
        mode = {"all": "--fullscreen", "region": "--region"}.get(scope, "--current")
        proc = subprocess.run(["spectacle", "--background", "--nonotify", mode, "--output", raw],
                              capture_output=True, text=True, timeout=180 if scope == "region" else 30)
        if proc.returncode != 0 or os.path.getsize(raw) == 0:
            raise ValueError("Ingen skärmbild togs." if scope == "region" else "Skärmbilden gick inte att ta (Spectacle).")
        return prepare_image(raw)
    except (OSError, subprocess.SubprocessError) as e:
        raise ValueError(f"Skärmbilden gick inte att ta: {e}") from None
    finally:
        os.unlink(raw)
        kwin_script(f"for (const w of workspace.windowList()) if ({mine}) "
                    "{ w.minimized = false; workspace.activeWindow = w; }")


def season_logo():
    """The logo – in its look for the time of year when there is one."""
    default = "/usr/share/icons/hicolor/scalable/apps/goblincakes.svg"
    try:
        sys.path.insert(0, "/usr/share/goblincakes/seasons")
        import season
        return season.asset("logo.svg", default)
    except Exception:  # noqa: BLE001
        return default


class Backend(QObject):
    """Talks to Main.qml. Display messages: {role, text, segments, service, file}."""

    conversationChanged = Signal()  # the whole message list changed (new/loaded)
    messageAdded = Signal(str)  # JSON of one display message
    messageUpdated = Signal(int, str)  # index, JSON
    busyChanged = Signal()
    statusChanged = Signal()
    stepsChanged = Signal()
    notice = Signal(str)
    conversationsChanged = Signal()
    keysChanged = Signal()
    keyTested = Signal(str, bool, str)  # provider id, ok, message
    raiseWindow = Signal()
    # From worker threads to the GUI thread
    _answered = Signal(str, str)  # answer, service
    _failed = Signal(str)
    _statusText = Signal(str)
    _stepsText = Signal(str)  # the work loop's steps (JSON)
    _keyResult = Signal(str, str, bool, str)  # provider id, key, ok, message
    modelChanged = Signal()
    _modelsLoaded = Signal(str)
    screenshotReady = Signal(str)  # the button's screenshot (a path), for the attachment
    shootingChanged = Signal()
    _shotDone = Signal(str, str, str)  # what it was for (JSON), path, error
    searchNextChanged = Signal()
    lessonsChanged = Signal()
    _hearted = Signal(str, int, str)  # conversation id, message index, the saved lesson (JSON, "" = failed)
    commandLogChanged = Signal()
    sidePinnedChanged = Signal()
    _undone = Signal(str)  # log entry id

    def __init__(self):
        super().__init__()
        self._keys = goblinai.load_keys()
        self._project = ""  # the project chosen in the sidebar ("" = no project)
        self._projects = goblinai.load_projects()
        self._busy = False
        self._status = ""
        self._new_conversation()
        self._answered.connect(self._on_answer)
        self._failed.connect(self._on_failure)
        self._search_next = False  # "Sök på nätet": the next question is searched first
        self._pending_tools = []  # the tools the answer on its way used (for the ♥)
        self._pending_done = []  # …and what they gave, short (saved with the answer, the AI sees it next time)
        if AVATAR.exists() and not goblinai.avatar_description():  # an avatar from before 24 Oct: describe it once
            threading.Thread(target=goblinai.describe_avatar, daemon=True).start()
        self._hearted.connect(self._on_hearted)
        self._statusText.connect(lambda text: self._set_busy(True, text))
        self._steps = "[]"  # what the AI has done for the question it works on (goblinai.Steps)
        self._stop = None  # the STOPP button's threading.Event for that question
        self._stepsText.connect(self._set_steps)
        self._keyResult.connect(self._on_key_result)
        self._procs = {}
        self._local = "{}"
        self._local_proc = None
        self._localInfo.connect(self._on_local_info)
        self.refreshLocal()
        self._learnDone.connect(self._on_learn_done)
        self._image = "{}"
        self._image_proc = None
        self._image_lock = threading.Lock()  # one picture at a time (the graphics card)
        self._image_jobs = {}  # (conversation, message, segment) -> the segment being drawn
        self._imageInfo.connect(self._on_image_info)
        self._imageEvent.connect(self._on_image_event)
        self.refreshImage()
        self._quick_waiting = False
        self._model = goblinai.chosen_model()  # "" = automatic
        self._model_choices = "[]"
        self._models_loading = False
        self._modelsLoaded.connect(self._on_models)
        self._shooting = False
        self._shotDone.connect(self._on_shot)
        self._auto_count = 0  # reading commands run at once since the user last asked
        self._blocked_told = False  # the AI was told about a stopped command for this question
        self._undoing = set()
        self._undone.connect(self._on_undone)

    # ── Conversation ──────────────────────────────────────────

    def _new_conversation(self):
        self._id = time.strftime("%Y%m%d-%H%M%S")
        self._api = [{"role": "system", "content": goblinai.system_prompt()}]
        self._display = []
        self._file = None  # the attached file of this conversation (path)
        self._cwd = str(Path.home())  # where the next command card runs (follows `cd`, like a terminal)

    @Property(str, notify=conversationChanged)
    def messages(self):
        return json.dumps(self._display)

    @Property(bool, notify=busyChanged)
    def busy(self):
        return self._busy

    def _set_busy(self, busy, status=""):
        self._busy, self._status = busy, status
        self.busyChanged.emit()
        self.statusChanged.emit()

    @Property(str, notify=statusChanged)
    def status(self):
        return self._status

    @Property(str, notify=stepsChanged)
    def steps(self):
        return self._steps

    @Property(bool, notify=stepsChanged)
    def stoppable(self):
        """A question is being worked on (STOPP) – not a picture, a ♥ or the like."""
        return self._stop is not None

    def _set_steps(self, steps):
        self._steps = steps
        self.stepsChanged.emit()

    @Slot()
    def stop(self):
        """STOPP (the work loop, 25 Oct): the AI stops after the step it is on – the window doesn't wait for it."""
        if not self._busy or self._stop is None or self._stop.is_set():
            return
        self._stop.set()
        steps = [{**s, "state": "stopp" if s["state"] == "run" else s["state"]} for s in json.loads(self._steps)]
        steps.append({"text": "Stoppad av dig", "state": "stopp"})
        self._stop = None
        self._set_steps("[]")
        self._api.append({"role": "assistant", "content": "(Användaren stoppade frågan innan jag svarade.)"})
        shown = {"role": "assistant", "text": "", "segments": goblinai.segments("*Stoppad – inget svar.*"),
                 "service": "", "file": "", "stopped": True, "steps": steps}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._set_busy(False)
        self._save()
        self._quick_answered()
        self._daily_done(failed=True)

    @Property(str, notify=conversationChanged)
    def conversationId(self):
        return self._id

    @Slot()
    def newConversation(self):
        if self._busy:
            return
        self._new_conversation()
        self.conversationChanged.emit()

    @Slot(str, str)
    def send(self, text, attachment):
        text = text.strip()
        if self._busy or not (text or attachment):
            return
        content = text or "Titta på den här filen."
        shown = {"role": "user", "text": text, "segments": [], "service": "", "file": ""}
        images = []
        if attachment:
            path = QUrl(attachment).toLocalFile() if attachment.startswith("file:") else attachment
            if path.lower().endswith(".pdf"):
                # A PDF: its text – or, when it is scanned (no text), its first pages as pictures
                try:
                    pdf_text, pages, images = read_pdf(path)
                except ValueError as e:
                    self.notice.emit(str(e))
                    return
                name = Path(path).name
                if images:
                    content = (f"{text or 'Titta på PDF:en.'}\n\nBifogad PDF: {name} ({pages} sidor, inskannad – "
                               f"de första {len(images)} sidorna som bilder).")
                else:
                    content = f"{text or 'Titta på PDF:en.'}\n\nBifogad PDF: {name} ({pages} sidor):\n```\n{pdf_text}\n```"
                shown["file"] = name
                shown["images"] = images
            elif goblinai.is_image(path):
                # A picture: a copy in Goblin AI's folder (smaller, JPEG) so the chat keeps it
                try:
                    images = [path if Path(path).parent == PICTURES else prepare_image(path)]
                except (OSError, ValueError) as e:
                    self.notice.emit(str(e))
                    return
                content = text or "Titta på bilden."
                shown["images"] = images
            else:
                try:
                    content = goblinai.file_message(path, content)
                except (OSError, ValueError) as e:
                    self.notice.emit(str(e))
                    return
                self._file = path
                shown["file"] = Path(path).name
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._auto_count, self._blocked_told = 0, False
        question = {"role": "user", "content": content}
        if images:
            question["images"] = images
        if self._search_next:
            question["search"] = True
            shown["searched"] = True
            self._search_next = False
            self.searchNextChanged.emit()
        if self._daily_running:  # a daily update: the AI is told what it is (the chat shows only the wish)
            question["content"] += goblinai.DAILY_PROMPT
            question["button"] = True  # its links and sports teams are read in the ask thread (goblinai.read_links)
        self._api.append(question)
        self._ask()

    def _project_of(self, project_id):
        return next((p for p in self._projects if p["id"] == project_id), None)

    def _ask(self):
        self._set_busy(True, "Tänker…")
        project = self._project_of(self._project)
        messages = list(self._api)
        # The project's instructions and fixed files, read now (changed files are seen at once)
        prompt = goblinai.system_prompt() + goblinai.project_prompt(project)
        if goblinai.sees_images(self._model):
            prompt += goblinai.SHOT_PROMPT
        messages[0] = {"role": "system", "content": prompt}
        stop = self._stop = threading.Event()
        self._set_steps("[]")
        steps = goblinai.Steps(report=lambda items: stop.is_set() or self._stepsText.emit(json.dumps(items)), stop=stop)

        def work():
            try:
                answer, service = goblinai.ask(
                    messages, self._keys,
                    status=lambda text: stop.is_set() or self._statusText.emit(text),
                    notice=self.notice.emit,
                    project=project,
                    choice=self._daily_model if self._daily_running else self._model,
                    steps=steps)
                if stop.is_set():  # STOPP was pressed while the last answer was on its way
                    return
                self._pending_tools = goblinai.last_tools()
                self._pending_done = goblinai.last_done()
                self._answered.emit(answer, service)
            except goblinai.Stopped:
                pass  # stop() has shown it already
            except goblinai.ServiceError as e:
                if not stop.is_set():
                    self._failed.emit(str(e))
            except Exception as e:  # never leave the window hanging
                if not stop.is_set():
                    self._failed.emit(f"Något gick fel: {e}")

        threading.Thread(target=work, daemon=True).start()

    def _on_answer(self, answer, service):
        self._api.append({"role": "assistant", "content": answer, **({"done": self._pending_done} if self._pending_done else {})})
        shown = {"role": "assistant", "text": answer, "segments": goblinai.segments(answer),
                 "service": service, "file": "", "tools": self._pending_tools}
        if self._steps != "[]":
            shown["steps"] = json.loads(self._steps)
        self._stop = None
        self._set_steps("[]")
        self._pending_tools = []
        for seg in shown["segments"]:
            if seg["type"] == "file":
                seg["canOverwrite"] = bool(self._file) and Path(self._file).name == seg["name"]
        self._apply_memory(shown)
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._set_busy(False)
        self._save()
        self._start_images(len(self._display) - 1)
        self._quick_answered()
        self._daily_done()
        self._autorun(len(self._display) - 1)
        self._command_done(len(self._display) - 1)  # only stopped commands: the AI hears why at once

    def _on_failure(self, message):
        self._stop = None
        self._set_steps("[]")
        shown = {"role": "error", "text": message, "segments": [], "service": "", "file": ""}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        # Let the user ask again: drop the unanswered question from what the AI sees
        if self._api and self._api[-1]["role"] == "user":
            self._api.pop()
        self._set_busy(False)
        self._quick_answered()
        self._daily_done(failed=True)

    def _update(self, index):
        self.messageUpdated.emit(index, json.dumps(self._display[index]))

    # ── Commands ──────────────────────────────────────────────

    @Slot(int, int)
    def runCommand(self, index, seg):
        """Tillåt / Kör on a command card."""
        self._run_command(index, seg, auto=False)

    def _run_command(self, index, seg, auto):
        part = self._display[index]["segments"][seg]
        if part["state"] != "new" or (self._busy and not auto):
            return
        if any(s.get("state") == "running" for s in self._display[index]["segments"]):
            return  # one at a time: they run in order, in the same folder
        code = part["code"]
        cmdlevel = goblinai.cmd_level()
        lvl = part.get("level") or cmdlevel.level(code)[0]  # cards saved before 25 Oct have no level
        if lvl == "danger":
            return
        plan = cmdlevel.prepare(code, self._cwd) if lvl == "change" else None
        by = "auto" if auto else "du"
        if "sudo" in code or "read " in code:
            # Needs a password or answers: run it in a terminal the user can type in
            script = (goblinai.command_script(code, self._cwd)
                      + "\necho\nread -rp 'Klart – tryck Enter för att stänga… ' _")
            QProcess.startDetached("/usr/libexec/goblincakes-terminal", ["run", "bash", "-c", script])
            part.update(state="done", output="Körs i ett terminalfönster (behöver ditt lösenord eller svar).")
            part["log"] = cmdlevel.log(code, lvl, by, None, "(i ett terminalfönster)", plan, self._id)
            self._update(index)
            self.commandLogChanged.emit()
            return self._command_done(index, ran_in_terminal=True)
        part["state"] = "running"
        if auto:
            part["auto"] = True
        self._update(index)
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)
        fd, cwd_file = tempfile.mkstemp(prefix="goblin-ai-cwd-")
        os.close(fd)
        env = QProcessEnvironment.systemEnvironment()
        env.insert("GOBLIN_CWD_FILE", cwd_file)
        proc.setProcessEnvironment(env)
        self._procs[(index, seg)] = proc
        timed_out = []
        if auto:  # run at once: a reading command that hangs (ping, tail -f …) is stopped after a while
            def too_long(proc=proc):
                if proc.state() != QProcess.NotRunning:
                    timed_out.append(True)
                    proc.kill()
            QTimer.singleShot(cmdlevel.AUTO_TIMEOUT * 1000, too_long)

        def finished(exit_code, _status, index=index, seg=seg):
            p = self._procs.pop((index, seg))
            self._cwd = goblinai.read_cwd(cwd_file, self._cwd)
            Path(cwd_file).unlink(missing_ok=True)
            out = bytes(p.readAllStandardOutput()).decode(errors="replace").strip()
            if timed_out:
                out += f"\n(stoppat efter {cmdlevel.AUTO_TIMEOUT} s)"
            if plan and plan["trash"]:
                plan["undo"] = cmdlevel.trash_restore(plan["trash"]) + plan["undo"]
            part = self._display[index]["segments"][seg]
            part.update(state="done", output=out.strip(), code_result=exit_code)
            part["log"] = cmdlevel.log(code, lvl, by, exit_code, out, plan, self._id)
            self._update(index)
            self.commandLogChanged.emit()
            self._save()  # the card is done also in the saved chat (it stayed "new" there, 25 Oct)
            self._autorun(index)
            self._command_done(index)

        proc.finished.connect(finished)
        proc.start("bash", ["-c", goblinai.command_script(code, self._cwd)])

    def _autorun(self, index):
        """Reading commands (cmdlevel "read") run at once, in order: the next card that's waiting, if it only reads
        and none before it is still running – up to STEP_LIMIT in a row per question (AI-tjänster can turn it off)."""
        parts = self._display[index]["segments"]
        if not goblinai.cmd_level().autorun() or any(s.get("state") == "running" for s in parts):
            return
        seg = next((k for k, s in enumerate(parts) if s["type"] == "command" and s["state"] == "new"), None)
        if seg is None or parts[seg].get("level") != "read":
            return
        if self._auto_count >= goblinai.STEP_LIMIT:
            parts[seg]["note"] = f"{goblinai.STEP_LIMIT} kommandon i rad – tryck Kör för att fortsätta"
            return self._update(index)
        self._auto_count += 1
        self._run_command(index, seg, auto=True)

    @Slot(int, int)
    def skipCommand(self, index, seg):
        part = self._display[index]["segments"][seg]
        if part["state"] == "new":
            part["state"] = "skipped"
            self._update(index)
            self._autorun(index)
            self._command_done(index)

    def _command_done(self, index, ran_in_terminal=False):
        """When every command card in the answer is run or skipped: tell the AI how it went."""
        segs = self._display[index]["segments"]
        parts = [s for s in segs if s["type"] in ("command", "blocked")]
        if any(s["state"] in ("new", "running") for s in parts):
            return
        if all(s["state"] in ("skipped", "blocked") for s in parts):
            # Only stopped (can't be undone) or skipped: the AI hears about the stopped ones once per question,
            # so it can do it the safe way (gio trash) or say it's something for the user and Claude
            if not any(s["state"] == "blocked" for s in parts) or self._blocked_told:
                return
            self._blocked_told = True
        report = []
        for s in parts:
            if s["state"] == "blocked":
                report.append(f"$ {s['code']}\n(STOPPAT, kördes inte: {s.get('why', 'går inte att ångra')}. "
                              "Gör det på ett sätt som går att ångra – ta bort med gio trash – eller säg att det är "
                              "något för användaren och Claude.)")
            elif s["state"] == "skipped":
                report.append(f"$ {s['code']}\n(användaren valde att inte köra det)")
            else:
                out = s.get("output", "")
                out = goblinai.cmd_level().shorten(out)
                report.append(f"$ {s['code']}\n{out}\n(avslutskod {s.get('code_result', '?')})")
        self._api.append({"role": "user", "content": "Så här gick det:\n\n" + "\n\n".join(report)
                          + f"\n\n(Mappen nu: {self._cwd})"
                          + "\n\nFortsätt med nästa steg, eller säg kort att det är klart."})
        self._ask()

    # ── The command log (AI-tjänster → Körda kommandon) and running reading commands at once ─────

    @Property(str, notify=commandLogChanged)
    def commandLog(self):
        return json.dumps(goblinai.cmd_level().load_log())

    @Property(bool, notify=commandLogChanged)
    def autorun(self):
        return goblinai.cmd_level().autorun()

    @Slot(bool)
    def setAutorun(self, on):
        goblinai.cmd_level().set_autorun(on)
        self.commandLogChanged.emit()

    @Property(bool, notify=sidePinnedChanged)
    def sidePinned(self):
        return SIDE_PINNED.exists()

    @Slot(bool)
    def setSidePinned(self, on):
        try:
            if on:
                SIDE_PINNED.parent.mkdir(parents=True, exist_ok=True)
                SIDE_PINNED.write_text("")
            else:
                SIDE_PINNED.unlink(missing_ok=True)
        except OSError:
            pass
        self.sidePinnedChanged.emit()

    @Slot(str)
    def undoCommand(self, entry_id):
        """Ångra in the log: its undo commands run (the click is the Tillåt), and the log says it was undone."""
        cmdlevel = goblinai.cmd_level()
        entry = next((e for e in cmdlevel.load_log(10_000) if e.get("id") == entry_id), None)
        if not entry or not entry.get("undo") or entry.get("undone") or entry_id in self._undoing:
            return
        self._undoing.add(entry_id)
        self.commandLogChanged.emit()

        def work():
            try:
                proc, _ = goblinai.run_in_folder(entry["undo"], str(Path.home()), capture_output=True, text=True,
                                                 timeout=120)
                out, code = ((proc.stdout or "") + (proc.stderr or "")).strip(), proc.returncode
            except (OSError, subprocess.TimeoutExpired) as e:
                out, code = f"Gick inte: {e}", -1
            if code == 0:
                cmdlevel.mark_undone(entry_id, out or "Klart.")
            else:  # not marked as undone: the button stays, the log shows why
                self.notice.emit(f"Ångra gick inte (fel {code}): {out[-300:]}")
            cmdlevel.log(entry["undo"], "change", "ångra", code, out, None, entry.get("conv", ""))
            self._undone.emit(entry_id)

        threading.Thread(target=work, daemon=True).start()

    def _on_undone(self, entry_id):
        self._undoing.discard(entry_id)
        self.commandLogChanged.emit()

    @Property(str, notify=commandLogChanged)
    def undoing(self):
        return json.dumps(sorted(self._undoing))

    # ── Screenshots (16 Oct): the button by Skicka, or the AI's card (Tillåt / Nej) ─────────

    @Property(bool, notify=shootingChanged)
    def shooting(self):
        return self._shooting

    @Property(str, notify=modelChanged)
    def shotTarget(self):
        """Where a screenshot goes with the chosen model – said on the card before it is taken."""
        chosen = goblinai.chosen_provider(self._model)
        if chosen and not chosen[0].get("local"):
            return f"{chosen[0]['name'].replace(' (betald)', '')} (på nätet)"
        return "din lokala AI – den lämnar inte datorn"

    @Slot(str)
    def takeScreenshot(self, scope):
        self._shoot({"for": "attach"}, scope)

    @Slot(int, int, str)
    def allowShot(self, index, seg, scope):
        part = self._display[index]["segments"][seg]
        if part["state"] not in ("new", "error") or self._shooting or self._busy:
            return
        part["state"] = "running"
        self._update(index)
        self._shoot({"for": "card", "conv": self._id, "index": index, "seg": seg}, scope)

    @Slot(int, int)
    def skipShot(self, index, seg):
        part = self._display[index]["segments"][seg]
        if part["state"] == "new":
            part["state"] = "skipped"
            self._update(index)
            self._save()

    def _shoot(self, purpose, scope):
        if self._shooting:
            return
        self._shooting = True
        self.shootingChanged.emit()

        def work():
            try:
                self._shotDone.emit(json.dumps(purpose), take_screenshot(scope), "")
            except Exception as e:  # noqa: BLE001 – told on the card / as a notice
                self._shotDone.emit(json.dumps(purpose), "", str(e))

        threading.Thread(target=work, daemon=True).start()

    def _on_shot(self, purpose, path, error):
        self._shooting = False
        self.shootingChanged.emit()
        purpose = json.loads(purpose)
        if purpose["for"] == "attach":
            if error:
                self.notice.emit(error)
            else:
                self.screenshotReady.emit(path)
            return
        if purpose["conv"] != self._id:  # another chat was opened meanwhile
            return
        index, seg = purpose["index"], purpose["seg"]
        part = self._display[index]["segments"][seg]
        if error:
            part.update(state="error", error=error)
            self._update(index)
            return
        part.update(state="done", image=path)
        self._update(index)
        shown = {"role": "user", "text": "", "segments": [], "service": "", "file": "", "images": [path]}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._api.append({"role": "user", "content": "Här är skärmbilden du bad om (tagen nyss).", "images": [path]})
        self._ask()

    # ── Files and copying ─────────────────────────────────────

    @Slot(int, int)
    def saveFile(self, index, seg):
        """Writes the new version over the attached file, keeping the old one as <name>.bak."""
        part = self._display[index]["segments"][seg]
        if not self._file:
            return
        path = Path(self._file)
        try:
            if path.exists():
                shutil.copy2(path, path.with_name(path.name + ".bak"))
            path.write_text(part["code"] + "\n")
            part["state"] = "saved"
            part["savedTo"] = str(path)
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    @Slot(int, int, str)
    def saveFileAs(self, index, seg, url):
        part = self._display[index]["segments"][seg]
        path = Path(QUrl(url).toLocalFile() if url.startswith("file:") else url)
        try:
            path.write_text(part["code"] + "\n")
            part["state"] = "saved"
            part["savedTo"] = str(path)
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    @Slot(str)
    def copy(self, text):
        QGuiApplication.clipboard().setText(text)
        self.notice.emit("Kopierat")

    @Slot(str, result=str)
    def fileName(self, url):
        return Path(QUrl(url).toLocalFile() if url.startswith("file:") else url).name

    # ── Saved conversations ───────────────────────────────────

    def _save(self):
        DATA.mkdir(parents=True, exist_ok=True)
        first = next((m["text"] for m in self._display if m["role"] == "user" and m["text"]), "")
        title = " ".join((first or next((m["file"] for m in self._display if m["file"]), "Samtal")).split())[:80]
        data = {"id": self._id, "title": title, "updated": time.time(), "file": self._file,
                "cwd": self._cwd, "project": self._project, "api": self._api[1:], "display": self._display}
        (DATA / f"{self._id}.json").write_text(json.dumps(data, ensure_ascii=False))
        # The latest 50 outside projects are kept; a project's chats stay until removed
        loose = [f for f in sorted(DATA.glob("2*.json"), reverse=True) if not self._chat_project(f)]
        for old in loose[KEEP_CONVERSATIONS:]:
            old.unlink(missing_ok=True)
        self.conversationsChanged.emit()

    @staticmethod
    def _chat_project(path):
        try:
            return json.loads(path.read_text()).get("project", "")
        except (OSError, ValueError):
            return ""

    @Property(str, notify=conversationsChanged)
    def conversations(self):
        """The chats of the chosen project (or those outside projects when none is chosen)."""
        items = []
        for f in sorted(DATA.glob("2*.json"), reverse=True) if DATA.exists() else []:
            try:
                d = json.loads(f.read_text())
                if d.get("project", "") == self._project:
                    # One line in the list (older chats were saved with line breaks)
                    items.append({"id": d["id"], "title": " ".join(d["title"].split()) or "Samtal"})
            except (OSError, ValueError, KeyError):
                continue
        return json.dumps(items)

    @Slot(str)
    def openConversation(self, conv_id):
        if self._busy:
            return
        try:
            d = json.loads((DATA / f"{conv_id}.json").read_text())
        except (OSError, ValueError):
            return
        self._id = d["id"]
        if d.get("project", "") != self._project:
            self._project = d.get("project", "")
            self.projectsChanged.emit()
        self._api = [{"role": "system", "content": goblinai.system_prompt()}] + d["api"]
        self._display = d["display"]
        for i, m in enumerate(self._display):  # a picture that was being drawn when the window closed
            for j, part in enumerate(m.get("segments") or []):
                if (part.get("type") == "image" and part.get("state") in ("new", "waiting", "running")
                        and (self._id, i, j) not in self._image_jobs):
                    part.update(state="error", error="Avbröts – tryck på Försök igen.")
                if part.get("type") == "shot" and part.get("state") == "running" and not self._shooting:
                    part.update(state="error", error="Avbröts – be om skärmbilden igen.")
        self._file = d.get("file")
        self._cwd = d.get("cwd") or str(Path.home())
        self.conversationChanged.emit()

    @Slot(str)
    def deleteConversation(self, conv_id):
        (DATA / f"{conv_id}.json").unlink(missing_ok=True)
        if conv_id == self._id:
            self._new_conversation()
            self.conversationChanged.emit()
        self.conversationsChanged.emit()

    # ── The input's history (26 Oct, the user's wish: like a terminal) ──

    @Slot(result=str)
    def inputHistory(self):
        """Everything typed, oldest first. The first time: the questions in the saved chats."""
        try:
            items = json.loads(HISTORY.read_text())
        except (OSError, ValueError):
            items = []
            for f in sorted(DATA.glob("2*.json")) if DATA.exists() else []:
                try:
                    items += [m["text"] for m in json.loads(f.read_text())["display"]
                              if m.get("role") == "user" and m.get("text")]
                except (OSError, ValueError, KeyError, TypeError):
                    continue
        return json.dumps([t for t in items if isinstance(t, str)][-HISTORY_MAX:], ensure_ascii=False)

    @Slot(str)
    def addHistory(self, text):
        text = text.strip()
        if not text:
            return
        items = [t for t in json.loads(self.inputHistory()) if t != text] + [text]
        try:
            DATA.mkdir(parents=True, exist_ok=True)
            HISTORY.write_text(json.dumps(items[-HISTORY_MAX:], ensure_ascii=False))
        except OSError:
            pass

    # ── The model to talk to (the button by Skicka) ───────────

    @Property(str, notify=modelChanged)
    def model(self):
        return self._model

    @Property(str, notify=modelChanged)
    def modelChoices(self):
        return self._model_choices

    @Property(bool, notify=modelChanged)
    def modelsLoading(self):
        return self._models_loading

    @Slot()
    def refreshModels(self):
        """The list is read when it is opened (Ollama and the services' lists may take a moment)."""
        if self._models_loading:
            return
        self._models_loading = True
        self.modelChanged.emit()

        def work():
            try:
                items = goblinai.model_choices(self._keys)
            except Exception:  # noqa: BLE001 – the list must never hang the window
                items = []
            self._modelsLoaded.emit(json.dumps(items))

        threading.Thread(target=work, daemon=True).start()

    def _on_models(self, text):
        self._model_choices, self._models_loading = text, False
        self.modelChanged.emit()

    @Slot(str)
    def setModel(self, choice):
        self._model = choice
        goblinai.set_chosen_model(choice)
        self.modelChanged.emit()

    # ── "Sök på nätet" and the ♥ on good answers ───────────────

    @Property(bool, notify=searchNextChanged)
    def searchNext(self):
        return self._search_next

    @Slot(bool)
    def setSearchNext(self, on):
        self._search_next = bool(on)
        self.searchNextChanged.emit()

    @Property(bool, notify=keysChanged)
    def canSearch(self):
        return bool(self._keys.get(goblinai.SEARCH["env"]))

    @Slot(int)
    def heart(self, index):
        """♥ under an answer: the AI writes a lesson from it (saved, can be undone); again = undone."""
        self._lesson(index, "good", "")

    @Slot(int, str)
    def thumbDown(self, index, reason):
        """👎 under an answer (21 Oct): the AI writes what to avoid next time (with the user's reason, if any)."""
        self._lesson(index, "avoid", reason)

    @Slot(int)
    def undoLesson(self, index):
        try:
            m = self._display[index]
        except IndexError:
            return
        if m.get("heart") and m["heart"] != "busy":
            goblinai.remove_lesson(m["heart"])
        for key in ("heart", "lesson", "thumb"):
            m.pop(key, None)
        self._update(index)
        self._save()
        self.lessonsChanged.emit()

    def _lesson(self, index, kind, reason):
        try:
            m = self._display[index]
        except IndexError:
            return
        if m.get("role") != "assistant" or m.get("heart") == "busy":
            return
        if m.get("heart"):  # the same mark again = undone (the other kind replaces it)
            same = (m.get("thumb") == "down") == (kind == "avoid")
            self.undoLesson(index)
            if same:
                return
        question = next((d["text"] for d in reversed(self._display[:index]) if d["role"] == "user" and d["text"]), "")
        tools = [tuple(t) for t in m.get("tools") or []]
        m["heart"] = "busy"
        if kind == "avoid":
            m["thumb"] = "down"
        self._update(index)
        cid, project, keys, choice = self._id, self._project_of(self._project), dict(self._keys), self._model

        def work():
            try:
                lesson = goblinai.make_lesson(question, m["text"], tools, keys, project, choice, kind, reason)
                entry = goblinai.add_lesson(question, lesson, tools, m.get("service", ""), project, kind)
                self._hearted.emit(cid, index, json.dumps(entry, ensure_ascii=False))
            except Exception:  # noqa: BLE001 – never leave the mark spinning
                self._hearted.emit(cid, index, "")

        threading.Thread(target=work, daemon=True).start()

    @Slot(int, str)
    def rewrite(self, index, kind):
        """The quick buttons under an answer: shorter, more formal, spelling, English – a new answer in the chat."""
        if self._busy or kind not in goblinai.REWRITES:
            return
        try:
            m = self._display[index]
        except IndexError:
            return
        last = all(d["role"] != "assistant" for d in self._display[index + 1:])
        label, content = goblinai.rewrite_message(kind, m["text"], last)
        shown = {"role": "user", "text": label, "segments": [], "service": "", "file": "", "rewrite": kind}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        self._api.append({"role": "user", "content": content, "rewrite": True})
        self._ask()

    @Slot(int)
    def copyAnswer(self, index):
        """Kopiera svaret: with formatting (HTML for Word, mail, LibreOffice) and as plain Markdown."""
        try:
            text = self._display[index]["text"]
        except (IndexError, KeyError):
            return
        data = QMimeData()
        data.setText(text)
        data.setHtml(answer_document(text).toHtml())
        QGuiApplication.clipboard().setMimeData(data)
        self.notice.emit("Svaret är kopierat – med formatering")

    def _on_hearted(self, cid, index, entry):
        if cid != self._id or index >= len(self._display):
            # Another chat is shown now: the lesson is kept, the old chat's file gets the mark
            if entry:
                self._mark_saved_heart(cid, index, json.loads(entry))
            self.lessonsChanged.emit()
            return
        m = self._display[index]
        if entry:
            e = json.loads(entry)
            m.update(heart=e["id"], lesson=e["lesson"])
        else:
            m.pop("heart", None)
            self.notice.emit("Tummen kunde inte sparas" if m.pop("thumb", None) else "Hjärtat kunde inte sparas")
        self._update(index)
        self._save()
        self.lessonsChanged.emit()

    def _mark_saved_heart(self, cid, index, entry):
        path = DATA / f"{cid}.json"
        try:
            data = json.loads(path.read_text())
            data["display"][index].update(heart=entry["id"], lesson=entry["lesson"])
            path.write_text(json.dumps(data, ensure_ascii=False))
        except (OSError, ValueError, IndexError, KeyError):
            pass

    @Property(str, notify=lessonsChanged)
    def lessons(self):
        return json.dumps(list(reversed(goblinai.load_lessons())), ensure_ascii=False)

    @Slot(str)
    def removeLesson(self, lesson_id):
        goblinai.remove_lesson(lesson_id)
        for i, m in enumerate(self._display):  # the open chat's ♥ goes out too
            if m.get("heart") == lesson_id:
                for key in ("heart", "lesson", "thumb"):
                    m.pop(key, None)
                self._update(i)
                self._save()
        self.lessonsChanged.emit()

    @Slot(str, str)
    def editLesson(self, lesson_id, text):
        goblinai.edit_lesson(lesson_id, text)
        self.lessonsChanged.emit()

    # ── The memory: ```minne / ```glöm in an answer, the list in AI-tjänster ─────

    memoryChanged = Signal()

    def _apply_memory(self, shown):
        changed = False
        for part in shown["segments"]:
            if part["type"] == "memory" and part["state"] == "new":
                part.update(state="saved", done=goblinai.remember(part["items"]))
                changed = True
            elif part["type"] == "forget" and part["state"] == "new":
                part.update(state="saved", done=goblinai.forget(part["items"]))
                changed = True
        if changed:
            self.memoryChanged.emit()

    @Slot(int, int)
    def undoMemory(self, index, seg):
        part = self._display[index]["segments"][seg]
        if part.get("state") != "saved":
            return
        if part["type"] == "memory":
            items = goblinai.load_memory()
            done = {t.casefold() for t in part.get("done", [])}
            goblinai.save_memory([i for i in items if i["text"].casefold() not in done])
        else:
            goblinai.remember(part.get("done", []))
        part["state"] = "undone"
        self._update(index)
        self._save()
        self.memoryChanged.emit()

    @Property(str, notify=memoryChanged)
    def memory(self):
        return json.dumps(goblinai.load_memory(), ensure_ascii=False)

    @Slot(str)
    def addMemory(self, text):
        goblinai.remember([text])
        self.memoryChanged.emit()

    @Slot(int)
    def removeMemory(self, index):
        items = goblinai.load_memory()
        if 0 <= index < len(items):
            del items[index]
            goblinai.save_memory(items)
            self.memoryChanged.emit()

    # ── The AI's own name (AI-tjänster → Namn) ────────────────

    nameChanged = Signal()

    @Property(str, notify=nameChanged)
    def aiName(self):
        return goblinai.ai_name()

    @Slot(str)
    def setAiName(self, name):
        goblinai.set_ai_name(name)
        self.nameChanged.emit()

    @Property(str, notify=nameChanged)
    def aiGender(self):
        return goblinai.ai_gender()

    @Slot(str)
    def setAiGender(self, gender):
        goblinai.set_ai_gender(gender)
        self.nameChanged.emit()

    # ── The AI's avatar (20 Oct): a picture of its own, shown at every answer ──

    avatarChanged = Signal()

    @Property(str, notify=avatarChanged)
    def avatar(self):
        """file:// URL of the avatar (with its time, so a new one is not taken from Qt's cache), or ""."""
        try:
            return QUrl.fromLocalFile(str(AVATAR)).toString() + f"?v={AVATAR.stat().st_mtime_ns}"
        except OSError:
            return ""

    @Property(str, notify=avatarChanged)
    def avatarThinking(self):
        try:
            return QUrl.fromLocalFile(str(AVATAR_THINKING)).toString() + f"?v={AVATAR_THINKING.stat().st_mtime_ns}"
        except OSError:
            return ""

    def _save_avatar(self, source, target):
        """The middle square of a picture (path or file:// URL), AVATAR_SIDE px, PNG → target. False if not."""
        path = QUrl(source).toLocalFile() if source.startswith("file:") else source
        image = QImage(path)
        if image.isNull():
            self.notice.emit("Bilden går inte att läsa.")
            return False
        side = min(image.width(), image.height())
        image = image.copy((image.width() - side) // 2, (image.height() - side) // 2, side, side)
        if side > AVATAR_SIDE:
            image = image.scaled(AVATAR_SIDE, AVATAR_SIDE, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        DATA.mkdir(parents=True, exist_ok=True)
        if not image.save(str(target), "PNG"):
            self.notice.emit("Avataren gick inte att spara.")
            return False
        self.avatarChanged.emit()
        return True

    @Slot(str)
    def setAvatar(self, source):
        """A picture (chosen or drawn in a chat) becomes the avatar."""
        if not self._save_avatar(source, AVATAR):
            return
        self.notice.emit(f"{goblinai.ai_name() or 'Goblin AI'} har fått en ny avatar.")
        threading.Thread(target=goblinai.describe_avatar, daemon=True).start()  # so the AI knows how it looks

    @Slot(str)
    def setAvatarThinking(self, source):
        """A picture becomes the thinking avatar – shown while the AI works, instead of "tänker…"."""
        if self._save_avatar(source, AVATAR_THINKING):
            self.notice.emit(f"{goblinai.ai_name() or 'Goblin AI'} har fått en tänkande avatar.")

    @Slot()
    def removeAvatarThinking(self):
        AVATAR_THINKING.unlink(missing_ok=True)
        self.avatarChanged.emit()

    @Slot(result=str)
    def thinkingAvatarAsk(self):
        """The question for "Rita den" at the thinking avatar: the same person as the avatar, thinking."""
        look = goblinai.avatar_description()
        return ("Rita en tänkande avatar åt dig själv – samma person som din vanliga avatar"
                + (f" ({look})" if look else "") + ", men som tänker: blicken lite uppåt, handen mot hakan, "
                "samma stil, bakgrund och bildutsnitt. Format: 1:1.")

    @Slot()
    def removeAvatar(self):
        AVATAR.unlink(missing_ok=True)
        goblinai.AVATAR_TEXT.unlink(missing_ok=True)
        self.avatarChanged.emit()

    # ── Own buttons (20 Oct): a named instruction, asked by its own model in a new chat ──

    dailyChanged = Signal()
    _daily_running = False
    _daily_model = ""

    @Property(str, notify=dailyChanged)
    def daily(self):
        return json.dumps(goblinai.load_daily(), ensure_ascii=False)

    @Slot(str, str, str)
    def addDaily(self, name, text, model):
        name, text = " ".join(name.split()), " ".join(text.split())
        items = goblinai.load_daily()
        if text and len(items) < goblinai.DAILY_MAX:
            items.append({"name": name[:20] or " ".join(text.split()[:2])[:20], "text": text[:300], "model": model})
            goblinai.save_daily(items)
            self.dailyChanged.emit()

    @Slot(int)
    def removeDaily(self, index):
        items = goblinai.load_daily()
        if 0 <= index < len(items):
            del items[index]
            goblinai.save_daily(items)
            self.dailyChanged.emit()

    @Slot(int, str)
    def setDailyModel(self, index, model):
        items = goblinai.load_daily()
        if 0 <= index < len(items):
            items[index]["model"] = model
            goblinai.save_daily(items)
            self.dailyChanged.emit()

    @Slot(int)
    def runButton(self, index):
        """A button above the input: its instruction in a new chat (this one if it is empty), its own model."""
        items = goblinai.load_daily()
        if self._busy or not 0 <= index < len(items):
            return
        item = items[index]
        if self._display:
            self._new_conversation()
            self.conversationChanged.emit()
        self._daily_running, self._daily_model = True, item.get("model", "")
        self.send(item["text"], "")
        self._daily_conv, self._daily_tries = self._id, 0
        self._daily_question = self._api[-1] if self._api else None

    def _daily_done(self, failed=False):
        if not self._daily_running:
            return
        if failed and self._daily_tries < 2 and self._daily_question:
            # A busy service should not cost today's update: the same model again in a minute,
            # then Automatiskt (the next service that answers)
            self._daily_tries += 1
            if self._daily_tries == 2:
                self._daily_model = ""
            QTimer.singleShot(60000 if self._daily_tries == 1 else 3000, self._daily_retry)
            return
        self._daily_running, self._daily_model = False, ""

    def _daily_retry(self):
        if self._busy or self._id != self._daily_conv or (self._api and self._api[-1]["role"] == "user"):
            self._daily_running, self._daily_model = False, ""  # the user took over the chat
            return
        self.notice.emit("Försöker igen"
                         + (" – med Automatiskt" if not self._daily_model else ""))
        self._api.append(self._daily_question)
        self._ask()

    # ── Services and keys ─────────────────────────────────────

    @Property(str, notify=keysChanged)
    def providers(self):
        return json.dumps([{"id": p["id"], "name": p["name"], "how": p["how"], "page": p["keys_page"],
                            "hasKey": bool(self._keys.get(p["env"]))} for p in goblinai.SERVICES])

    @Property(bool, notify=keysChanged)
    def hasKeys(self):
        return goblinai.has_keys(self._keys)

    @Slot(str)
    def openKeyPage(self, provider_id):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        QDesktopServices.openUrl(QUrl(p["keys_page"]))

    @Slot(str, str)
    def setKey(self, provider_id, key):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        key = key.strip()
        if not key:
            return

        def work():
            try:
                self._keyResult.emit(provider_id, key, True, f"Fungerar – {goblinai.test_key(p, key)}")
            except goblinai.ServiceError as e:
                self._keyResult.emit(provider_id, key, False, f"Fungerade inte: {e}")

        self.keyTested.emit(provider_id, True, "Testar nyckeln…")
        threading.Thread(target=work, daemon=True).start()

    def _on_key_result(self, provider_id, key, ok, message):
        if ok:
            p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
            self._keys[p["env"]] = key
            goblinai.EXHAUSTED.discard(provider_id)
            goblinai.save_keys(self._keys)
            self.keysChanged.emit()
        self.keyTested.emit(provider_id, ok, message)

    @Slot(str)
    def removeKey(self, provider_id):
        p = next(p for p in goblinai.SERVICES if p["id"] == provider_id)
        self._keys.pop(p["env"], None)
        goblinai.save_keys(self._keys)
        self.keysChanged.emit()


    # ── Projects (sidebar) ─────────────────────────────────────

    projectsChanged = Signal()

    @Property(str, notify=projectsChanged)
    def projects(self):
        return json.dumps(self._projects, ensure_ascii=False)

    @Property(str, notify=projectsChanged)
    def currentProject(self):
        return self._project

    @Property(str, constant=True)
    def templates(self):
        return json.dumps([dict(t, id=k) for k, t in goblinai.TEMPLATES.items()], ensure_ascii=False)

    @Slot(str)
    def selectProject(self, project_id):
        """Shows the project's chats; a new chat is started in it."""
        if self._busy:
            return
        self._project = project_id if self._project_of(project_id) else ""
        self._new_conversation()
        self.projectsChanged.emit()
        self.conversationChanged.emit()
        self.conversationsChanged.emit()

    @Slot(str, result=str)
    def createProject(self, template):
        t = goblinai.TEMPLATES.get(template, goblinai.TEMPLATES["vardag"])
        names = {p["name"] for p in self._projects}
        name, n = t["name"], 2
        while name in names:
            name, n = f"{t['name']} {n}", n + 1
        project = goblinai.clean_project(dict(t, id=time.strftime("p%Y%m%d%H%M%S-") + os.urandom(3).hex(), name=name))
        self._projects.append(project)
        goblinai.save_projects(self._projects)
        self.selectProject(project["id"])
        return project["id"]

    @Slot(str)
    def saveProject(self, text):
        try:
            new = goblinai.clean_project(json.loads(text))
        except (ValueError, KeyError):
            return
        self._projects = [new if p["id"] == new["id"] else p for p in self._projects]
        goblinai.save_projects(self._projects)
        self.projectsChanged.emit()

    @Slot(str, bool)
    def deleteProject(self, project_id, with_chats):
        self._projects = [p for p in self._projects if p["id"] != project_id]
        goblinai.save_projects(self._projects)
        for f in DATA.glob("2*.json") if DATA.exists() else []:
            if self._chat_project(f) == project_id:
                if with_chats:
                    f.unlink(missing_ok=True)
                else:  # the chats stay, outside projects
                    d = json.loads(f.read_text())
                    d["project"] = ""
                    f.write_text(json.dumps(d, ensure_ascii=False))
        if self._project == project_id:
            self._project = ""
            self._new_conversation()
            self.conversationChanged.emit()
        self.projectsChanged.emit()
        self.conversationsChanged.emit()

    @Slot(str, result=str)
    def localPath(self, url):
        return QUrl(url).toLocalFile() if url.startswith("file:") else url

    @Slot(int, int)
    def saveToProject(self, index, seg):
        """A file card straight into the project's folder (same name; the old one becomes .bak)."""
        project = self._project_of(self._project)
        part = self._display[index]["segments"][seg]
        if not project or not project["folder"]:
            return
        path = Path(project["folder"]).expanduser() / Path(part.get("name") or "fil.txt").name
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.exists():
                shutil.copy2(path, path.with_name(path.name + ".bak"))
            path.write_text(part["code"] + "\n")
            part.update(state="saved", savedTo=str(path))
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")
        self._update(index)

    # ── Learning mode ("Lär dig koda", learn.py) ──────────────────

    learnChanged = Signal()
    learnResult = Signal(str, str)  # task id, JSON {ok, output, message}
    learnBusy = Signal(str)  # status text while running/building, "" = done
    _learnDone = Signal(str, str)
    LEARN_PROJECT = "learn"

    @Property(str, notify=learnChanged)
    def learnState(self):
        return json.dumps(learn.state(), ensure_ascii=False)

    @Slot(str, result=str)
    def learnModule(self, module_id):
        learn.set_current(module_id)
        return json.dumps(learn.module_view(module_id) or {}, ensure_ascii=False)

    @Slot(str, str, str, str, str)
    def startCourse(self, goal, tracks, level, own_goal, order):
        tracks = [t for t in json.loads(tracks or "[]") if isinstance(t, str)]
        if goal or tracks or not own_goal.strip():
            learn.start_course(goal, tracks, level, own_goal, order)
            self._learn_project(order)
            self.learnChanged.emit()
            return

        def work():
            # Only the user's own words: the AI picks tracks from the course base (never invents any)
            base = learn.load_base()
            listing = "\n".join(f"{t['id']}: {t['name']} – {t['desc']}" for t in base["tracks"])
            question = [{"role": "system", "content": "Du väljer spår ur en kurslista. Svara BARA med en JSON-lista med spårens id, i den ordning de ska läras, t.ex. [\"html\", \"php\"]."},
                        {"role": "user", "content": f"Spåren:\n{listing}\n\nAnvändarens mål: {own_goal}"}]
            try:
                answer, _ = goblinai.ask_once(question, self._keys, project={"order": order, "prefer": "vardag", "models": {}})
                picked = [t for t in json.loads(re.search(r"\[.*?\]", answer, re.S).group(0))
                          if any(x["id"] == t for x in base["tracks"])]
            except Exception:  # noqa: BLE001 – no AI or no answer: the user picks the tracks
                picked = []
            if picked:
                learn.start_course("", picked, level, own_goal, order)
                self._learn_project(order)
                self._learnDone.emit("", "")
            else:
                self._learnDone.emit("", "Kunde inte koppla målet till spår – välj spåren själv nedan.")
        self.learnBusy.emit("Gör en läroplan…")
        threading.Thread(target=work, daemon=True).start()

    def _on_learn_done(self, task_id, payload):
        self.learnBusy.emit("")
        if task_id:
            self.learnResult.emit(task_id, payload)
        elif payload:
            self.notice.emit(payload)
        self.learnChanged.emit()

    @Slot(str, str, bool)
    def runTask(self, task_id, code, is_test):
        def work():
            if not learn.sandbox_ready():
                self.learnBusy.emit("Gör i ordning övningsdatorn (en gång, behöver internet, några minuter)…")
                ok, last = learn.build_sandbox(lambda line: self.learnBusy.emit("Övningsdatorn: " + line))
                if not ok:
                    self._learnDone.emit(task_id, json.dumps({"ok": False, "output": last,
                                                               "message": "Övningsdatorn gick inte att göra i ordning (nätverket?)."}))
                    return
            self.learnBusy.emit("Kör…")
            result = learn.check_task(task_id, code)
            if result["ok"] and is_test:
                module, _ = learn.find_task(learn.load_base(), task_id)
                learn.passed_test(module["id"])
                result["message"] = "Provet klarat – momentet är avbockat."
            self._learnDone.emit(task_id, json.dumps(result, ensure_ascii=False))
        self.learnBusy.emit("Kör…")
        threading.Thread(target=work, daemon=True).start()

    @Slot(str)
    def learnHint(self, task_id):
        learn.next_hint(task_id)
        self.learnChanged.emit()

    @Slot(str)
    def learnSolution(self, task_id):
        learn.show_solution(task_id)
        self.learnChanged.emit()

    @Slot(str, str)
    def learnDraft(self, task_id, code):
        learn.save_draft(task_id, code)

    @Slot(str, result=str)
    def learnTestTask(self, module_id):
        return learn.test_out(module_id)

    @Slot()
    def learnReset(self):
        learn.reset_course()
        self.learnChanged.emit()

    @Slot(str)
    def previewHtml(self, code):
        """The page in the browser (a file in the user's own cache folder)."""
        folder = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "goblincakes/learn-preview"
        folder.mkdir(parents=True, exist_ok=True)
        page = folder / "index.html"
        page.write_text(code)
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(page)))

    def _learn_project(self, order):
        """Goblin AI's project "Lärläge": the teacher's rules; only local AI unless the user chose otherwise."""
        project = {"id": self.LEARN_PROJECT, "name": "Lärläge", "instructions": learn.TUTOR_PROMPT,
                   "order": order or "local-only", "prefer": "kod", "search": False}
        old = self._project_of(self.LEARN_PROJECT)
        if old:
            project = dict(old, instructions=learn.TUTOR_PROMPT, order=order or old["order"])
        self._projects = [p for p in self._projects if p["id"] != self.LEARN_PROJECT] + [goblinai.clean_project(project)]
        goblinai.save_projects(self._projects)
        self.projectsChanged.emit()

    @Slot(str, str, str, str)
    def askTutor(self, task_id, code, output, question):
        """The teacher, in the project "Lärläge": one chat per task, with the lesson and the code."""
        if self._busy:
            return
        state = learn.state().get("course") or {}
        if not self._project_of(self.LEARN_PROJECT):
            self._learn_project(state.get("order", "local-only"))
        p = learn.load_progress()
        conv = p.get("tutor", {}).get(task_id)
        if conv and (DATA / f"{conv}.json").exists():
            self.openConversation(conv)
        else:
            self.selectProject(self.LEARN_PROJECT)
            p = learn.load_progress()
            p.setdefault("tutor", {})[task_id] = self._id
            learn.save_progress(p)
        context = learn.tutor_context(task_id, code, output)
        text = question.strip() or ("Förklara felet." if output else "Jag behöver hjälp med uppgiften.")
        self._display.append({"role": "user", "text": text, "segments": [], "service": "", "file": ""})
        self.messageAdded.emit(json.dumps(self._display[-1]))
        self._api.append({"role": "user", "content": f"{text}\n\n(Underlag från lärläget – det här skrev inte användaren:)\n{context}"})
        self.conversationChanged.emit()
        self._ask()

    # ── Local AI (Ollama, /usr/libexec/goblincakes-ollama) ──────

    localChanged = Signal()
    localProgress = Signal(str, float)  # status line, 0–1 (-1 = unknown)
    localDone = Signal(bool, str)  # ok, message
    _localInfo = Signal(str)

    @Property(str, notify=localChanged)
    def local(self):
        return self._local

    @Property(bool, notify=localChanged)
    def localBusy(self):
        return self._local_proc is not None

    @Slot()
    def refreshLocal(self):
        """Status, places and suggestions together (in a thread – nvidia-smi and the server take a moment)."""
        def work():
            out = {}
            for key, args in (("status", ["status"]), ("places", ["places"]), ("recommend", ["recommend"])):
                try:
                    r = subprocess.run([goblinai.OLLAMA_HELPER, *args], capture_output=True, text=True, timeout=30)
                    out[key] = json.loads(r.stdout)
                except (OSError, ValueError, subprocess.SubprocessError):
                    out[key] = None
            self._localInfo.emit(json.dumps(out))
        threading.Thread(target=work, daemon=True).start()

    def _on_local_info(self, text):
        self._local = text
        self.localChanged.emit()
        self.keysChanged.emit()  # the chat can be used with only the local AI

    def _local_run(self, args, done_text):
        self._helper_run("local", args, done_text)

    def _helper_run(self, kind, args, done_text):
        """A helper (goblincakes-ollama / goblincakes-image) with its progress lines shown in the window."""
        attr = "_local_proc" if kind == "local" else "_image_proc"
        if getattr(self, attr) is not None:
            return
        progress = self.localProgress if kind == "local" else self.imageProgress
        done = self.localDone if kind == "local" else self.imageDone
        changed = self.localChanged if kind == "local" else self.imageChanged
        refresh = self.refreshLocal if kind == "local" else self.refreshImage
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.SeparateChannels)
        errors = []

        def read():
            while proc.canReadLine():
                line = bytes(proc.readLine()).decode(errors="replace").rstrip("\n")
                if line.startswith("@@progress "):
                    try:
                        ev = json.loads(line[11:])
                    except ValueError:
                        continue
                    total, done = ev.get("total") or 0, ev.get("completed") or 0
                    gb = f"{done / 1024 ** 3:.1f} av {total / 1024 ** 3:.1f} GB" if total else ev.get("status", "")
                    progress.emit(gb, done / total if total else -1.0)
                elif line.startswith("@@ "):
                    progress.emit(line[3:], -1.0)

        def finished(code, _status):
            read()
            errors.append(bytes(proc.readAllStandardError()).decode(errors="replace").strip())
            ok = code == 0
            setattr(self, attr, None)
            done.emit(ok, done_text if ok else (errors[-1].splitlines() or ["Något gick fel"])[-1])
            refresh()
            proc.deleteLater()
        proc.readyReadStandardOutput.connect(read)
        proc.finished.connect(finished)
        setattr(self, attr, proc)
        changed.emit()
        proc.start(goblinai.OLLAMA_HELPER if kind == "local" else goblinai.IMAGE_HELPER, args)

    @Slot(str)
    def installLocal(self, place):
        self._local_run(["install", place], "Lokal AI är installerad. Hämta en modell nedan.")

    @Slot(str, str)
    def pullLocal(self, model, role):
        model = model.strip()
        if model:
            self._local_run(["pull", model] + ([role] if role else []), f"{model} är hämtad.")

    @Slot(str)
    def removeLocalModel(self, model):
        self._local_run(["rm", model], f"{model} är borttagen.")

    @Slot(str)
    def moveLocal(self, place):
        self._local_run(["move", place], "Lokal AI är flyttad.")

    @Slot()
    def updateLocal(self):
        self._local_run(["update"], "Ollama är uppdaterat.")

    @Slot(bool)
    def uninstallLocal(self, models_too):
        self._local_run(["uninstall"] + (["--models"] if models_too else []), "Lokal AI är borttagen.")

    @Slot(str, str)
    def setLocalRole(self, role, model):
        subprocess.run([goblinai.OLLAMA_HELPER, "role", role, model], capture_output=True)
        self.refreshLocal()

    @Slot(str)
    def setLocalOrder(self, order):
        subprocess.run([goblinai.OLLAMA_HELPER, "order", order], capture_output=True)
        self.refreshLocal()

    # ── Pictures (16 Oct): ```bild blocks and the Skapa bild button ─────────
    # The program on this computer is /usr/libexec/goblincakes-image; the order (computer, Cloudflare,
    # paid services) is goblinai.make_image's.

    imageChanged = Signal()
    imageProgress = Signal(str, float)
    imageDone = Signal(bool, str)
    _imageInfo = Signal(str)
    _imageEvent = Signal(str, int, int)  # conversation id, message, segment (from the drawing thread)

    @Property(str, notify=imageChanged)
    def image(self):
        return self._image

    @Property(bool, notify=imageChanged)
    def imageBusy(self):
        return self._image_proc is not None

    @Property(bool, notify=keysChanged)
    def canDraw(self):
        return goblinai.images_possible(self._keys)

    @Slot()
    def refreshImage(self):
        def work():
            try:
                r = subprocess.run([goblinai.IMAGE_HELPER, "status"], capture_output=True, text=True, timeout=30)
                self._imageInfo.emit(r.stdout)
            except (OSError, subprocess.SubprocessError):
                self._imageInfo.emit("{}")
        threading.Thread(target=work, daemon=True).start()

    def _on_image_info(self, text):
        self._image = text or "{}"
        self.imageChanged.emit()
        self.keysChanged.emit()  # canDraw

    @Slot(str)
    def installImage(self, place):
        self._helper_run("image", ["install", place], "Bildprogrammet är installerat. Hämta en modell nedan.")

    @Slot(str, str)
    def pullImage(self, model, variant):
        self._helper_run("image", ["pull", model] + ([variant] if variant else []),
                         "Modellen är hämtad – nu kan Goblin AI rita på din dator.")

    @Slot(str)
    def useImageModel(self, model):
        subprocess.run([goblinai.IMAGE_HELPER, "use", model], capture_output=True)
        self.refreshImage()

    @Slot(str)
    def removeImageModel(self, model):
        self._helper_run("image", ["rm", model], "Modellen är borttagen.")

    @Slot()
    def updateImage(self):
        self._helper_run("image", ["update"], "Bildprogrammet är uppdaterat.")

    @Slot(bool)
    def uninstallImage(self, models_too):
        self._helper_run("image", ["uninstall"] + (["--models"] if models_too else []), "Bildprogrammet är borttaget.")

    def _start_images(self, index):
        for seg, part in enumerate(self._display[index]["segments"]):
            if part["type"] == "image" and part["state"] == "new":
                self._draw(index, seg)

    def _draw(self, index, seg):
        """Draws a picture card in a thread; the card follows along (and is saved when done, also when
        another chat is open by then)."""
        conv, part = self._id, self._display[index]["segments"][seg]
        project = self._project_of(self._project)
        if part.get("report"):  # a ```rapport block: drawn here at once with Qt (well under a second)
            try:
                path = goblinai.make_report(part["markdown"], project, self._display[index].get("service", ""))
                part.update(state="done", path=path, service="Rapport gjord på datorn", error="")
            except Exception as e:  # noqa: BLE001 – ValueError, OSError: shown on the card
                part.update(state="error", error=f"Rapporten gick inte att göra: {e}")
            self._update(index)
            self._save()
            return
        part.update(state="waiting", progress="Väntar på bilden före…" if self._image_lock.locked() else "Ritar bilden…",
                    fraction=-1.0, error="")
        self._image_jobs[(conv, index, seg)] = part
        self._update(index)

        def emit():
            self._imageEvent.emit(conv, index, seg)

        def work():
            with self._image_lock:
                part.update(state="running", progress="Ritar bilden…")
                emit()
                last = [0.0]

                def progress(text, fraction):
                    part.update(progress=text, fraction=fraction)
                    if time.time() - last[0] > 0.25:
                        last[0] = time.time()
                        emit()
                try:
                    path, where = goblinai.make_image(part["prompt"], part.get("format", "1:1"), self._keys,
                                                      project=project, status=lambda t: progress(t, -1.0),
                                                      notice=self.notice.emit, progress=progress)
                    part.update(state="done", path=str(path), service=where, progress="", fraction=-1.0)
                except goblinai.ServiceError as e:
                    part.update(state="error", error=str(e))
                except Exception as e:  # noqa: BLE001 – never leave the card hanging
                    part.update(state="error", error=f"Något gick fel: {e}")
            emit()
        threading.Thread(target=work, daemon=True).start()

    def _on_image_event(self, conv, index, seg):
        part = self._image_jobs.get((conv, index, seg))
        if part is None:
            return
        finished = part["state"] in ("done", "error")
        if finished:
            del self._image_jobs[(conv, index, seg)]
        if conv == self._id:
            self._update(index)
            if finished:
                self._save()
        elif finished:  # that chat isn't open any more: into its file
            path = DATA / f"{conv}.json"
            try:
                d = json.loads(path.read_text())
                d["display"][index]["segments"][seg] = part
                path.write_text(json.dumps(d, ensure_ascii=False))
            except (OSError, ValueError, IndexError, KeyError):
                pass

    @Slot(str)
    def createImage(self, text):
        """The Skapa bild button: the words go straight to the picture (the AI sees it, so "make it
        darker" afterwards works)."""
        text = text.strip()
        if not text:
            return
        if goblinai.LOOK_UP_FIRST.search(text) and not self._busy:
            # "Kolla online hur den ser ut": the AI searches first and writes the description itself
            self.send(f"Skapa en bild: {text}", "")
            return
        _, fmt = goblinai.image_request(text)
        fmt = next((f for w, f in goblinai.FORMAT_WORDS.items() if re.search(rf"\b{w}\b", text, re.I)), fmt)
        shown = {"role": "user", "text": text, "segments": [], "service": "", "file": "", "picture": True}
        self._display.append(shown)
        self.messageAdded.emit(json.dumps(shown))
        block = f"```bild\nFormat: {fmt}\n{text}\n```"
        self._api += [{"role": "user", "content": f"Skapa en bild: {text}"},
                      {"role": "assistant", "content": block}]
        answer = {"role": "assistant", "text": block, "service": "", "file": "",
                  "segments": [{"type": "image", "prompt": text, "format": fmt, "state": "new"}]}
        self._display.append(answer)
        self.messageAdded.emit(json.dumps(answer))
        self._save()
        self._start_images(len(self._display) - 1)

    @Slot(int, int)
    def retryImage(self, index, seg):
        if self._display[index]["segments"][seg].get("state") == "error":
            self._draw(index, seg)

    @Slot(int, int)
    def anotherImage(self, index, seg):
        """One more with the same description (a new picture every time)."""
        old = self._display[index]["segments"][seg]
        answer = {"role": "assistant", "text": "", "service": "", "file": "",
                  "segments": [{"type": "image", "prompt": old["prompt"], "format": old.get("format", "1:1"), "state": "new"}]}
        self._display.append(answer)
        self.messageAdded.emit(json.dumps(answer))
        self._start_images(len(self._display) - 1)

    @Slot()
    def sharpText(self):
        """After a file dialog: Qt's own text again (KDE's dialog style switches to native text, which
        gets coloured and blurry when the window is zoomed)."""
        QQuickWindow.setTextRenderType(QQuickWindow.TextRenderType.QtTextRendering)

    @Slot(str)
    def openImage(self, path):
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

    @Slot(str)
    def showInFolder(self, path):
        """A file link in an answer: the file selected in the user's own file manager (the freedesktop
        FileManager1 interface – Dolphin and the others have it), else Dolphin, else the folder."""
        uri = QUrl.fromLocalFile(path).toString()
        if QProcess.execute("gdbus", ["call", "--session", "--dest", "org.freedesktop.FileManager1",
                                      "--object-path", "/org/freedesktop/FileManager1",
                                      "--method", "org.freedesktop.FileManager1.ShowItems", f"['{uri}']", ""]) == 0:
            return
        self.showImageInFolder(path)

    @Slot(str)
    def showImageInFolder(self, path):
        if not QProcess.startDetached("dolphin", ["--select", path]):
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(path).parent)))

    # ── ChatGPT (OpenAI's own app, GOBLINCAKES Config → System, 23 Oct) ──
    # The app opens a new chat with the text already in the box (its codex:// link, see
    # goblincakes-chatgpt open); the text is copied too, in case a later app version drops the link.

    @Property(bool, constant=True)
    def chatgpt(self):
        return (Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
                / "chatgpt-app/.goblincakes.json").is_file()

    def _to_chatgpt(self, text):
        QGuiApplication.clipboard().setText(text)
        if QProcess.startDetached("/usr/libexec/goblincakes-chatgpt", ["open", text]):
            self.notice.emit("Ny chatt i ChatGPT – tryck Enter där för att skicka")
        else:
            self.notice.emit("Kopierat – ChatGPT gick inte att starta")

    @Slot(int)
    def askChatGPT(self, index):
        """Skicka till ChatGPT: the question this answer was to."""
        question = next((m["text"] for m in reversed(self._display[:index])
                         if m["role"] == "user" and m.get("text")), "")
        if question:
            self._to_chatgpt(question)

    @Slot(int, int)
    def imageChatGPT(self, index, seg):
        """Gör om i ChatGPT: the picture's description as a request for a picture."""
        try:
            prompt = self._display[index]["segments"][seg]["prompt"]
        except (IndexError, KeyError):
            return
        self._to_chatgpt(f"Skapa en bild: {prompt}")

    @Slot(str)
    def drawChatGPT(self, text):
        """Rita i ChatGPT, by Rita when Skapa bild is on."""
        if text.strip():
            self._to_chatgpt(f"Skapa en bild: {text.strip()}")

    @Slot(str)
    def copyImage(self, path):
        QGuiApplication.clipboard().setImage(QImage(path))
        self.notice.emit("Bilden är kopierad")

    @Slot(int, str, str)
    def savePdf(self, index, url, ext="pdf"):
        """Spara som…: PDF, Word, OpenDocument, text or Markdown – by the file ending, else the chosen filter."""
        path = QUrl(url).toLocalFile() if url.startswith("file:") else url
        ext = "." + ext.lstrip("*.").lower()
        if Path(path).suffix.lower() not in (".pdf", ".docx", ".odt", ".txt", ".md", ".markdown", ".html", ".htm"):
            path += ext
        elif Path(path).suffix.lower() == ".pdf" and ext in (".docx", ".odt", ".txt", ".md"):
            path = str(Path(path).with_suffix(ext))  # the name still has the first filter's ending
        try:
            save_answer(self._display[index]["text"], path, Path(path).stem)
            self.notice.emit(f"Sparad: {Path(path).name}")
            self.pdfSaved.emit(path)
        except (OSError, IndexError, KeyError) as e:
            self.notice.emit(f"Kunde inte spara: {e}")

    pdfSaved = Signal(str)

    @Slot(int)
    def saveReport(self, index):
        """Spara som bild: the answer as a report picture (report.py) in the pictures folder, then opened."""
        try:
            m = self._display[index]
            text = "\n\n".join(p["markdown"] if p.get("report") else p["text"] if p["type"] == "text" else ""
                                 for p in m.get("segments") or []) or m["text"]
            path = goblinai.make_report(text, self._project_of(self._project), m.get("service", ""))
        except Exception as e:  # noqa: BLE001
            self.notice.emit(f"Kunde inte göra bilden: {e}")
            return
        self.notice.emit(f"Sparad: {Path(path).name}")
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

    @Slot(int, result=str)
    def pdfName(self, index):
        """A file name for "Spara som PDF": the question before the answer, in the documents folder."""
        question = next((m["text"] for m in reversed(self._display[:index]) if m["role"] == "user" and m["text"]), "Svar")
        name = re.sub(r"[^\w åäöÅÄÖ.,-]", "", question.split("\n")[0])[:60].strip() or "Svar"
        try:
            docs = subprocess.run(["xdg-user-dir", "DOCUMENTS"], capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            docs = ""
        return QUrl.fromLocalFile(str(Path(docs or Path.home()) / f"{name}.pdf")).toString()

    @Slot(str, str)
    def saveImageAs(self, path, url):
        try:
            shutil.copy2(path, QUrl(url).toLocalFile() if url.startswith("file:") else url)
            self.notice.emit("Sparad")
        except OSError as e:
            self.notice.emit(f"Kunde inte spara: {e}")

    # ── Quick question (Meta+Space): a small box, the window opens when the answer is there ──

    quickShow = Signal()

    @Slot(str)
    def askNew(self, text):
        """A new chat with this question (goblin-ai --ask); waits if an answer is being written."""
        if self._busy:
            self.notice.emit("Svarar redan på något – frågan står i rutan, skicka den sedan.")
            self.pendingQuestion.emit(text)
            return
        if self._display:
            self._new_conversation()
            self.conversationChanged.emit()
        self.send(text, "")

    pendingQuestion = Signal(str)

    @Slot(result=str)
    def clipboard(self):
        """What was copied, offered once per copy in the quick box (16 Oct):
        {"kind": "text", "text"} / {"kind": "image", "path"} / {} (nothing new)."""
        board = QGuiApplication.clipboard()
        data = board.mimeData()
        if data is None:
            return "{}"
        if data.hasImage() and not board.image().isNull():
            image = board.image()
            key = "image:" + hashlib.sha1(bytes(image.scaled(64, 64).constBits())).hexdigest()
            item = {"kind": "image"}
        else:
            text = board.text().strip()
            if not text:
                return "{}"
            key = "text:" + hashlib.sha1(text.encode()).hexdigest()
            item = {"kind": "text", "text": text[:CLIP_LIMIT]}
        try:
            if CLIP_STATE.read_text() == key:
                return "{}"  # already offered: an old copy isn't sent along by mistake
        except OSError:
            pass
        CLIP_STATE.parent.mkdir(parents=True, exist_ok=True)
        CLIP_STATE.write_text(key)
        if item["kind"] == "image":
            try:
                item["path"] = prepare_qimage(image)
            except ValueError:
                return "{}"
        return json.dumps(item)

    @Slot(str, str, result=bool)
    def quickSend(self, text, clip):
        """A new chat with the question (and what was copied); False when Goblin AI is busy."""
        clip = json.loads(clip or "{}")
        text = text.strip()
        if self._busy or not (text or clip):
            return False
        if self._display:
            self._new_conversation()
            self.conversationChanged.emit()
        self._quick_waiting = True
        if clip.get("kind") == "image":
            self.send(text or "Titta på bilden.", clip["path"])
        elif clip.get("kind") == "text":
            self.send((text or "Förklara det här.") + "\n\nUrklipp:\n```\n" + clip["text"] + "\n```", "")
        else:
            self.send(text, "")
        return True

    def _quick_answered(self):
        if self._quick_waiting:
            self._quick_waiting = False
            self.raiseWindow.emit()


def use_accent(engine):
    """GOBLINCAKES' accent colour (Config → Utseende) as the QML property "accent", followed
    live: /usr/share/goblincakes/accent.py. Without it: the standard blue."""
    for d in (SHARE.parent, Path(__file__).resolve().parents[1] / "share/goblincakes", Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


def main():
    # The QML uses fixed pixel sizes: drawn at 80 % (still sharp – Qt renders at that size),
    # matching GOBLINCAKES' 9 pt interface. Not passed on to programs started from here.
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.8"
    app = QGuiApplication(sys.argv)
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblin-ai")
    app.setApplicationDisplayName("Goblin AI")
    app.setDesktopFileName("goblin-ai")
    # Its own icon (the goblin above what the program does); the file next to /usr when the icon
    # theme doesn't know it yet (started from the repo)
    icon = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-ai.svg"
    app.setWindowIcon(QIcon.fromTheme("goblincakes-ai", QIcon(str(icon))))
    for font in os.environ.get("GOBLIN_AI_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)

    quick = "--quick" in sys.argv[1:]
    # --ask <question>: a new chat with the question, the window shown (GoblinRecorder's "Fråga Kakan")
    ask = sys.argv[sys.argv.index("--ask") + 1] if "--ask" in sys.argv[1:-1] else ""
    # --open <id>: a saved chat, shown (/app in goblin ai in the terminal: the chat goes along, 26 Oct)
    conv = sys.argv[sys.argv.index("--open") + 1] if "--open" in sys.argv[1:-1] else ""
    # Already open: bring that window (or the quick box) to the front instead
    probe = QLocalSocket()
    probe.connectToServer(SOCKET_NAME)
    if probe.waitForConnected(300):
        probe.write(b"ask:" + ask.encode() if ask else b"open:" + conv.encode() if conv
                    else b"quick" if quick else b"show")
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(SOCKET_NAME)
    server = QLocalServer()
    server.listen(SOCKET_NAME)
    # The window may be hidden (only the quick box): quitting is Main.qml's job when the window closes
    app.setQuitOnLastWindowClosed(False)

    backend = Backend()

    def connection():
        sock = server.nextPendingConnection()
        if sock.bytesAvailable() or sock.waitForReadyRead(300):
            wish = bytes(sock.readAll())
        else:
            wish = b"show"
        if wish.startswith(b"ask:"):
            backend.askNew(wish[4:].decode(errors="replace"))
            backend.raiseWindow.emit()
            return
        if wish.startswith(b"open:"):
            backend.conversationsChanged.emit()  # the chat was saved by the terminal: into the list too
            backend.openConversation(wish[5:].decode(errors="replace"))
            backend.raiseWindow.emit()
            return
        (backend.quickShow if wish == b"quick" else backend.raiseWindow).emit()
    server.newConnection.connect(connection)

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("startQuick", quick)
    engine.rootContext().setContextProperty("logoUrl", QUrl.fromLocalFile(
        os.environ.get("GOBLINCAKES_LOGO") or season_logo()))
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    if ask:
        backend.askNew(ask)
    elif conv:
        backend.openConversation(conv)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
