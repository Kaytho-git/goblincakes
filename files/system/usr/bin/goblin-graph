#!/usr/bin/python3
"""goblin graph – bars that move with the sound the computer plays, in World of Warcraft's
class colours (12 Oct, the user's wish). A window without a frame or background, among the
other windows: only the bars show on the desktop.

  goblin graph            start (or bring the open one forward)
  goblin graph alla       every bar in a class colour, Death Knight → Warrior
  goblin graph klass      your character's class (read from WoW's combat log)
  goblin graph mage …     a class of your choice (also: death-knight, demon-hunter, …)
  goblin graph lås | lås upp  can't be moved or resized by accident (also the padlock)
  goblin graph auto on|off opens by itself when a music player plays, closes when it stops
  goblin graph staplar | våg | cirkel | explosion
                          bars (bass left, treble right, moving up), an oscilloscope (the
                          sound wave itself, live), bars in a circle growing outwards from the middle,
                          or an explosion (every beat sends a ring and sparks outwards)

In the window: drag to move, the bottom-right corner to resize, double-click switches the
view (the circle and the explosion get a square window of their own), right-click switches
between all classes and one class, the scroll wheel picks
another class, Esc closes.
Position, size and choice are kept in ~/.config/goblincakes/graph.json.

Sound: only music (the user's wish 12 Oct – not games, Netflix and so on): pw-record with a
capture node that links to nothing by itself, and every 2 s the output streams of music
players (MUSIC_APPS – the same list as the Now playing widget – or media.role Music) are
linked to it with pw-link. Music in a web browser doesn't count (YouTube Music can't be told
apart from Netflix there). Nothing but the standard library and PySide6.
"""
import array
import random
import cmath
import json
import math
import os
import re
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

# ---- goblin-graph --watch (goblincakes-graph.service, goblin graph auto on): opens the window
# when a music player starts playing and closes it when the music has been gone a while.
# Before the PySide6 imports, so the watcher stays small.

# Programs whose sound the graph follows (as org.goblincakes.nowplaying's musicPlayers, without
# mpv – it plays films too). Matched against the stream's application name, node name, binary
# and icon/app id.
MUSIC_APPS = ("spotify", "quodlibet", "quod libet", "elisa", "strawberry", "audacious",
              "rhythmbox", "lollypop", "amberol", "clementine", "deadbeef", "tauon", "cmus",
              "g4music", "gapless", "harmonoid", "cider", "tidal", "deezer", "youtube-music",
              "youtubemusic", "nuclear", "museeks", "sayonara", "juk", "qmmp", "mpd")
def is_music(props):
    if props.get("media.role") == "Music":
        return True
    name = " ".join(str(props.get(k, "")) for k in (
        "application.name", "node.name", "application.process.binary", "application.icon-name",
        "application.id", "pipewire.access.portal.app_id")).lower()
    return any(app in name for app in MUSIC_APPS)


def music_playing():
    """A music stream that is playing right now (a paused player's stream is idle)."""
    out = subprocess.run(["pw-dump"], capture_output=True, timeout=5).stdout or b"[]"
    for o in json.loads(out):
        info = o.get("info") or {}
        props = info.get("props") or {}
        if (props.get("media.class") == "Stream/Output/Audio" and info.get("state") == "running"
                and is_music(props)):
            return True
    return False


def now_playing():
    """"Artist – Title" from the music players' MPRIS (12 Oct, the user's wish: the hover shows
    what is playing) – a playing player before a paused one, "" when nothing plays. busctl's
    JSON, so it runs in the watcher's thread and never in the window's."""
    def busctl(*args):
        out = subprocess.run(["busctl", "--user", "--json=short", *args], capture_output=True,
                             text=True, timeout=3).stdout
        return json.loads(out) if out.strip() else None
    try:
        names = [n["name"] for n in busctl("list") or [] if n.get("name", "").startswith("org.mpris.MediaPlayer2.")]
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    best = ("", 0)
    for name in names:
        if not any(app.replace(" ", "") in name.lower() for app in MUSIC_APPS):
            continue  # not a music player (a browser, a video player)
        try:
            status = busctl("get-property", name, "/org/mpris/MediaPlayer2",
                            "org.mpris.MediaPlayer2.Player", "PlaybackStatus")["data"]
            meta = busctl("get-property", name, "/org/mpris/MediaPlayer2",
                          "org.mpris.MediaPlayer2.Player", "Metadata")["data"]
        except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
            continue
        rank = {"Playing": 2, "Paused": 1}.get(status, 0)
        title = (meta.get("xesam:title") or {}).get("data") or ""
        artists = (meta.get("xesam:artist") or {}).get("data") or []
        artist = ", ".join(artists) if isinstance(artists, list) else str(artists)
        text = " – ".join(t for t in (artist, title) if t)
        if text and rank > best[1]:
            best = (text + (" (pausad)" if rank == 1 else ""), rank)
    return best[0]


SESSION_VARS = ("WAYLAND_DISPLAY", "DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
                "XDG_SESSION_DESKTOP", "QT_QPA_PLATFORMTHEME", "QT_WAYLAND_RECONNECT")
def session_env():
    """The desktop session's environment now (12 Oct: the watcher started before Plasma had told
    systemd about the screen, so the window it opened found no display and Qt aborted).
    None = no screen yet."""
    env = dict(os.environ)
    try:
        out = subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True,
                             text=True, timeout=5).stdout
        for line in out.splitlines():
            key, _, value = line.partition("=")
            if key in SESSION_VARS:
                env[key] = value
    except Exception:
        pass
    return env if env.get("WAYLAND_DISPLAY") or env.get("DISPLAY") else None


def watch():
    """Every 2 s: music playing and no window of ours → start one; music gone 15 s → close the
    one we started. Closed by hand while the music plays = stays closed until the music stops
    and starts again."""
    child, dismissed, quiet = None, False, 0.0
    while True:
        try:
            playing = music_playing()
        except Exception:
            playing = False
        running = child is not None and child.poll() is None
        if child is not None and not running:
            child = None
            dismissed = playing          # closed while the music played
        if playing:
            quiet = 0.0
            env = session_env() if child is None and not dismissed else None
            if env:
                child = subprocess.Popen([sys.executable, os.path.abspath(__file__)], env=env,
                                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL, start_new_session=True)
        else:
            quiet += 2
            if quiet >= 15:
                dismissed = False
                if child is not None:
                    child.terminate()
                    try:
                        child.wait(5)
                    except subprocess.TimeoutExpired:
                        child.kill()
                    child = None
        time.sleep(2)


if __name__ == "__main__" and sys.argv[1:2] == ["--watch"]:
    sys.exit(watch())

from PySide6.QtCore import (ClassInfo, Property, QObject, QTimer, QUrl, Signal, Slot)
from PySide6.QtDBus import QDBusConnection, QDBusInterface
from PySide6.QtGui import QAction, QIcon, QSurfaceFormat
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtQml import QQmlApplicationEngine
from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

SHARE = Path(os.environ.get("GOBLINCAKES_GRAPH_SHARE", "/usr/share/goblincakes/graph"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "goblincakes/graph.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "goblincakes/graph-class"
WOW_LOGS = Path.home() / "Games/WoW"  # <Version>/Logs (goblincakes-wow-links)
SOCKET = f"goblin-graph-{os.getuid()}"

# World of Warcraft Retail's class colours, in the game's own (alphabetical) order
CLASSES = [
    ("deathknight", "Death Knight", "#C41E3A"), ("demonhunter", "Demon Hunter", "#A330C9"),
    ("druid", "Druid", "#FF7C0A"), ("evoker", "Evoker", "#33937F"), ("hunter", "Hunter", "#AAD372"),
    ("mage", "Mage", "#3FC7EB"), ("monk", "Monk", "#00FF98"), ("paladin", "Paladin", "#F48CBA"),
    ("priest", "Priest", "#FFFFFF"), ("rogue", "Rogue", "#FFF468"), ("shaman", "Shaman", "#0070DD"),
    ("warlock", "Warlock", "#8788EE"), ("warrior", "Warrior", "#C69B6D"),
]
KEYS = [c[0] for c in CLASSES]
# Specialisation id (COMBATANT_INFO in the combat log) → class
SPECS = {
    **dict.fromkeys((250, 251, 252), "deathknight"), **dict.fromkeys((577, 581, 1480), "demonhunter"),
    **dict.fromkeys((102, 103, 104, 105), "druid"), **dict.fromkeys((1467, 1468, 1473), "evoker"),
    **dict.fromkeys((253, 254, 255), "hunter"), **dict.fromkeys((62, 63, 64), "mage"),
    **dict.fromkeys((268, 269, 270), "monk"), **dict.fromkeys((65, 66, 70), "paladin"),
    **dict.fromkeys((256, 257, 258), "priest"), **dict.fromkeys((259, 260, 261), "rogue"),
    **dict.fromkeys((262, 263, 264), "shaman"), **dict.fromkeys((265, 266, 267), "warlock"),
    **dict.fromkeys((71, 72, 73), "warrior"),
}

RATE = 48000
SIZE = 1024          # samples per spectrum (21 ms) – 2 ms per transform in plain Python
RING = 2048          # kept samples: the oscilloscope looks for a rising zero crossing first
VIEWS = ["bars", "scope", "circle", "burst"]
ROUND = ("circle", "burst")   # views with a square window (own size/position in graph.json)
CIRCLE_BARS = 24     # a quarter of the circle: bass at the top and bottom, treble at the sides
RING_LIFE = 36       # ticks (1.2 s) a ring of the explosion lives
SPARK_LIFE = 27      # ticks (0.9 s) a spark lives
ONSET_BANDS = 32     # bands the explosion watches for new notes and hits
ONSET_GAP = 4        # ticks at least between two explosions (at most 7.5 a second)
LOW, HIGH = 40, 16000
LINK_EVERY = 2.0     # seconds between looks for new music streams
TILT, TILT_FROM = 3.5, 150   # dB per octave lift for the treble, from this frequency up


def class_key(word):
    """'mage', 'Death Knight', 'dk', 'dh' … → the class key, or None."""
    w = re.sub(r"[^a-z]", "", word.lower())
    return {"dk": "deathknight", "dh": "demonhunter", "lock": "warlock", "pala": "paladin"}.get(w) or (
        w if w in KEYS else next((k for k in KEYS if k.startswith(w) and len(w) >= 3), None))


def detect_class():
    """The class of the character that played last: their own GUID (source flags 0x511) and
    their COMBATANT_INFO line (written at a boss pull / key start) in the newest combat log."""
    logs = sorted(WOW_LOGS.glob("*/Logs/WoWCombatLog*.txt"), key=lambda p: p.stat().st_mtime, reverse=True)
    for log in logs[:3]:
        try:
            with open(log, "rb") as fh:
                fh.seek(max(0, fh.seek(0, 2) - 32 * 1024 * 1024))
                text = fh.read().decode("utf-8", "replace")
        except OSError:
            continue
        me = re.findall(r",(Player-[0-9A-F-]+),\"[^\"]*\",0x511,", text)
        if not me:
            continue
        guid = me[-1]
        for line in reversed(text.splitlines()):
            i = line.find("COMBATANT_INFO," + guid + ",")
            if i < 0:
                continue
            args = line[i:].split(",", 30)[1:]
            for cand in [args[23] if len(args) > 23 else ""] + args[20:28]:
                if cand.isdigit() and int(cand) in SPECS:
                    return SPECS[int(cand)]
    return None


class Spectrum:
    """Plain-Python FFT (radix 2) with a Hann window, levels per bar on a log frequency scale."""

    def __init__(self):
        bits = SIZE.bit_length() - 1
        self.rev = [int(format(i, f"0{bits}b")[::-1], 2) for i in range(SIZE)]
        self.win = [0.5 - 0.5 * math.cos(2 * math.pi * i / (SIZE - 1)) for i in range(SIZE)]
        self.tw = {}
        size = 2
        while size <= SIZE:
            self.tw[size] = [cmath.exp(-2j * math.pi * k / size) for k in range(size // 2)]
            size *= 2
        self.bars = 0
        self.edges = []

    def layout(self, bars):
        if bars == self.bars:
            return
        self.bars = bars
        hz = SIZE / RATE
        edges = [max(1, int(LOW * (HIGH / LOW) ** (i / bars) * hz)) for i in range(bars + 1)]
        # Every bar its own frequencies: at the low end several bars would share one bin
        for i in range(1, len(edges)):
            edges[i] = max(edges[i], edges[i - 1] + 1)
        self.edges = [min(e, SIZE // 2 - 1) for e in edges]
        # Music is quieter the higher the tone: lift each bar by TILT dB per octave above
        # TILT_FROM Hz (its middle frequency), so the treble bars move as much as the bass
        self.tilt = []
        for i in range(bars):
            mid = math.sqrt(self.edges[i] * max(self.edges[i] + 1, self.edges[i + 1])) / hz
            self.tilt.append(10 ** (TILT * max(0.0, math.log2(mid / TILT_FROM)) / 20))

    def levels(self, samples, bars):
        self.layout(bars)
        rev, win = self.rev, self.win
        a = [samples[rev[i]] * win[rev[i]] for i in range(SIZE)]
        size = 2
        while size <= SIZE:
            h, t = size // 2, self.tw[size]
            for s in range(0, SIZE, size):
                for k in range(h):
                    u, v = a[s + k], a[s + k + h] * t[k]
                    a[s + k], a[s + k + h] = u + v, u - v
            size *= 2
        out = []
        for i in range(bars):
            lo, hi = self.edges[i], max(self.edges[i] + 1, self.edges[i + 1])
            peak = max(abs(a[k]) for k in range(lo, min(hi, SIZE // 2)))
            out.append(peak / (SIZE / 4) * self.tilt[i])
        return out


class Linker(threading.Thread):
    """Every LINK_EVERY seconds: links the output ports of music streams to the graph's capture
    node (same channel, or every input when the channels differ). PipeWire removes the links
    itself when a stream ends."""

    def __init__(self):
        super().__init__(daemon=True)
        self.alive = True

    def run(self):
        while self.alive:
            try:
                self.link_music()
            except Exception:
                pass
            time.sleep(LINK_EVERY)

    def link_music(self):
        dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, timeout=5).stdout or b"[]")
        nodes, ports, links = {}, [], set()
        for o in dump:
            kind = o.get("type", "").rsplit(":", 1)[-1]
            props = (o.get("info") or {}).get("props") or {}
            if kind == "Node":
                nodes[o["id"]] = props
            elif kind == "Port":
                ports.append((o["id"], props))
            elif kind == "Link":
                info = o.get("info") or {}
                links.add((info.get("output-port-id"), info.get("input-port-id")))
        mine = next((i for i, p in nodes.items() if p.get("node.name") == "goblin-graph"
                     and p.get("media.class") == "Stream/Input/Audio"), None)
        if mine is None:
            return
        inputs = {}
        for pid, p in ports:
            if p.get("node.id") == mine and p.get("port.direction") == "in":
                inputs[str(p.get("port.name", "")).rsplit("_", 1)[-1]] = pid
        for pid, p in ports:
            node = nodes.get(p.get("node.id"), {})
            if (p.get("port.direction") != "out" or p.get("port.monitor")
                    or node.get("media.class") != "Stream/Output/Audio" or not is_music(node)):
                continue
            channel = str(p.get("port.name", "")).rsplit("_", 1)[-1]
            for target in ([inputs[channel]] if channel in inputs else inputs.values()):
                if (pid, target) not in links:
                    subprocess.run(["pw-link", str(pid), str(target)], capture_output=True, timeout=5)

    def stop(self):
        self.alive = False


class Listener(threading.Thread):
    """Reads the music (see Linker) into a ring buffer (mono floats). Nothing linked = no data
    comes; then samples() gives silence, so the bars fall."""

    def __init__(self):
        super().__init__(daemon=True)
        self.lock = threading.Lock()
        self.ring = [0.0] * RING
        self.proc = None
        self.alive = True
        self.last = 0.0      # when sound last came
        self.linker = Linker()
        self.linker.start()

    def run(self):
        cmd = ["pw-record", "-P", "{ node.autoconnect = false node.name = goblin-graph "
               "media.name = \"goblin graph\" }", "--rate", str(RATE), "--channels", "1",
               "--format", "s16", "-"]
        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            return
        out = self.proc.stdout
        head = out.read(4)
        if head == b"RIFF":          # a WAV header first: skip it
            out.read(40)
            head = b""
        pending = head
        while self.alive:
            chunk = out.read(1024)
            if not chunk:
                break
            data = pending + chunk
            n = len(data) // 2 * 2
            pending = data[n:]
            vals = array.array("h", data[:n])
            with self.lock:
                self.ring = (self.ring + [v / 32768 for v in vals])[-RING:]
                self.last = time.monotonic()

    def samples(self):
        with self.lock:
            if time.monotonic() - self.last > 0.25:   # no music linked (or paused)
                return [0.0] * RING
            return list(self.ring)

    def stop(self):
        self.alive = False
        self.linker.stop()
        if self.proc:
            self.proc.terminate()


@ClassInfo({"D-Bus Interface": "org.goblincakes.graph"})
class PlaceBus(QObject):
    """KWin's goblincakes-windows script calls placed("wide=x,y") after the window was moved:
    Wayland doesn't tell a window where it is. Kept in graph.json and in kwinrc graphPlace,
    where the script reads it when the window opens."""

    def __init__(self, graph):
        super().__init__()
        self.graph = graph

    @Slot(str)
    def placed(self, place):
        shape, _, xy = place.partition("=")
        try:
            x, y = (int(v) for v in xy.split(","))
        except ValueError:
            return
        if shape not in ("wide", "round"):
            return
        # only places KWin reported (x/y in graph.json from before were Qt's guesses)
        places = self.graph.cfg.setdefault("place", {})
        places[shape] = f"{x},{y}"
        self.graph.save()
        places = [f"{name}={xy}" for name, xy in places.items()]
        subprocess.run(["kwriteconfig6", "--file", "kwinrc", "--group", "Script-goblincakes-windows",
                        "--key", "graphPlace", ";".join(places)], capture_output=True)
        QDBusInterface("org.kde.KWin", "/KWin", "org.kde.KWin").call("reconfigure")


class Graph(QObject):
    levelsChanged = Signal()
    styleChanged = Signal()
    nowPlayingChanged = Signal()
    raiseWindow = Signal()

    def __init__(self, settings):
        super().__init__()
        self.cfg = settings
        self._levels = []
        self._wave = []
        self._rings = []     # [age, strength, colour index]
        self._sparks = []    # [age, angle, speed, colour index]
        self._glow = 0.0
        self.onset_gain = 1e-3   # the explosion's note/hit detection (onset())
        self.onset_prev = []
        self.flux_hist = []
        self.since_beat = 99
        self.ring_colour = 0
        self._bars = 48
        self.wave_gain = 0.02
        self.loud_gain = 1e-3
        self.spec = Spectrum()
        self.gain = 1e-3
        self.listener = Listener()
        self.listener.start()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(33)
        # What is playing, for the hover and the tray icon: asked every 3 s in a thread
        self._now = ""
        self._now_new = None
        self.now_timer = QTimer(self)
        self.now_timer.timeout.connect(self.ask_now_playing)
        self.now_timer.start(3000)
        self.ask_now_playing()

    def ask_now_playing(self):
        if self._now_new is not None and self._now_new != self._now:  # the thread's last answer
            self._now = self._now_new
            self.nowPlayingChanged.emit()
        threading.Thread(target=lambda: setattr(self, "_now_new", now_playing()), daemon=True).start()

    @Property(str, notify=nowPlayingChanged)
    def nowPlaying(self):
        return self._now

    # ---- what the window shows
    @Property(list, notify=levelsChanged)
    def levels(self):
        return self._levels

    @Property(list, notify=levelsChanged)
    def wave(self):
        return self._wave

    @Property(list, notify=levelsChanged)
    def rings(self):
        """[radius 0..1, opacity, strength, colour index] per ring, oldest first."""
        out = []
        for age, strength, colour in self._rings:
            t = age / RING_LIFE
            out.append([1 - (1 - t) ** 2, (1 - t) ** 1.5, strength, colour])
        return out

    @Property(list, notify=levelsChanged)
    def sparks(self):
        """[angle, distance 0..1, opacity, colour index] per spark."""
        out = []
        for age, angle, speed, colour in self._sparks:
            t = age / SPARK_LIFE
            out.append([angle, speed * (1 - (1 - t) ** 3), 1 - t, colour])
        return out

    @Property(float, notify=levelsChanged)
    def glow(self):
        return self._glow

    @Property(str, notify=styleChanged)
    def view(self):
        v = self.cfg.get("view", "bars")
        return v if v in VIEWS else "bars"

    @Slot()
    def cycleView(self):
        self.cfg["view"] = VIEWS[(VIEWS.index(self.view) + 1) % len(VIEWS)]
        self.save()
        self.styleChanged.emit()

    @Property(str, notify=styleChanged)
    def mode(self):
        return self.cfg.get("mode", "all")

    @Property(str, notify=styleChanged)
    def className(self):
        key = self.cfg.get("class") or "mage"
        return next(c[1] for c in CLASSES if c[0] == key)

    @Property(str, notify=styleChanged)
    def classColor(self):
        key = self.cfg.get("class") or "mage"
        return next(c[2] for c in CLASSES if c[0] == key)

    @Property(list, constant=True)
    def classColors(self):
        return [c[2] for c in CLASSES]

    @Slot(int)
    def setBars(self, n):
        self._bars = max(12, min(160, n))

    @Property(bool, notify=styleChanged)
    def locked(self):
        """Locked = can't be moved or resized by accident (the padlock, goblin graph lås)."""
        return bool(self.cfg.get("locked"))

    @Slot()
    def toggleLock(self):
        self.cfg["locked"] = not self.locked
        self.save()
        self.styleChanged.emit()

    @Slot()
    def toggleMode(self):
        self.cfg["mode"] = "class" if self.mode == "all" else "all"
        self.save()
        self.styleChanged.emit()

    @Slot(int)
    def stepClass(self, step):
        i = KEYS.index(self.cfg.get("class") or "mage")
        self.cfg["class"] = KEYS[(i + step) % len(KEYS)]
        self.cfg["mode"] = "class"
        self.cfg["chosen"] = True
        self.save()
        self.styleChanged.emit()

    @Property(str, notify=styleChanged)
    def shape(self):
        return "round" if self.view in ROUND else "wide"

    @Slot(str, result=list)
    def geometryFor(self, shape):
        g = self.cfg.get("round") if shape == "round" else self.cfg
        g = g if isinstance(g, dict) else {}
        return [g[k] for k in ("x", "y", "w", "h")] if all(k in g for k in ("x", "y", "w", "h")) else []

    @Slot(str, int, int, int, int)
    def saveGeometry(self, shape, x, y, w, h):
        geo = {"x": x, "y": y, "w": w, "h": h}
        if shape == "round":
            self.cfg["round"] = geo
        else:
            self.cfg.update(geo)
        self.save()

    def save(self):
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(self.cfg))

    def apply_args(self, args):
        """goblin graph alla / klass / <class> / lås / lås upp – also sent to an open window."""
        words = [a.lower() for a in args]
        if words[:2] in (["lås", "upp"], ["las", "upp"]) or words[:1] in (["låsupp"], ["unlock"]):
            self.cfg["locked"] = False
            args = args[2 if len(words) > 1 and words[1] == "upp" else 1:]
        elif words[:1] in (["lås"], ["las"], ["lock"]):
            self.cfg["locked"] = True
            args = args[1:]
        for a in args:
            if a in ("alla", "all"):
                self.cfg["mode"] = "all"
            elif a in ("klass", "class", "min", "mine"):
                self.cfg["mode"] = "class"
                self.cfg.pop("chosen", None)
                self.cfg["class"] = detect_class() or self.cfg.get("class") or "mage"
            elif a in ("staplar", "bars", "stapel"):
                self.cfg["view"] = "bars"
            elif a in ("våg", "vag", "oscilloskop", "scope", "wave"):
                self.cfg["view"] = "scope"
            elif a in ("cirkel", "ring", "circle", "rund"):
                self.cfg["view"] = "circle"
            elif a in ("explosion", "explodera", "burst", "boom", "smäll"):
                self.cfg["view"] = "burst"
            elif class_key(a):
                self.cfg.update(mode="class", **{"class": class_key(a)}, chosen=True)
        self.save()
        self.styleChanged.emit()

    # ---- sound → bars
    def tick(self):
        samples = self.listener.samples()
        view = self.view
        if view == "scope":
            self.scope(samples)
        elif view == "burst":
            self.burst(samples)
        elif view == "circle":
            self.spectrum(samples[-SIZE:], CIRCLE_BARS)
        else:
            self.spectrum(samples[-SIZE:])
        self.levelsChanged.emit()

    def scope(self, s):
        """The sound wave itself, still: starts at a rising zero crossing (like an oscilloscope's
        trigger), 240 points, scaled to the loudest recent peak."""
        span = SIZE
        start = len(s) - span
        for i in range(len(s) - span - 1, 0, -1):
            if s[i - 1] <= 0 < s[i]:
                start = i
                break
        part = s[start:start + span]
        peak = max((abs(v) for v in part), default=0)
        self.wave_gain = max(peak, self.wave_gain * 0.99, 0.02)
        step = span / 240
        self._wave = [max(-1.0, min(1.0, part[int(k * step)] / self.wave_gain)) for k in range(240)]

    def onset(self, s):
        """A new note or hit: how much the bands of the spectrum rose since the last tick
        (spectral flux), compared with the last second – so it keeps going in dense, loud music
        too, and a high note counts as much as a drum (the treble is lifted, see TILT).
        Returns the strength 0.35..1, or 0."""
        raw = self.spec.levels(s[-SIZE:], ONSET_BANDS)
        self.onset_gain = max(max(raw, default=0), self.onset_gain * 0.995, 1e-3)
        lv = [max(0.0, 1 + 20 * math.log10(max(v / self.onset_gain, 1e-6)) / 40) for v in raw]
        prev = self.onset_prev or lv
        flux = sum(max(0.0, a - b) for a, b in zip(lv, prev)) / ONSET_BANDS
        self.onset_prev = lv
        hist = self.flux_hist
        mean = sum(hist) / len(hist) if hist else flux
        std = math.sqrt(sum((f - mean) ** 2 for f in hist) / len(hist)) if hist else 0
        self.flux_hist = (hist + [flux])[-30:]
        self.since_beat += 1
        if flux > mean + std and flux > 0.006 and self.since_beat >= ONSET_GAP:
            self.since_beat = 0
            return max(0.35, min(1.0, flux / (mean + 2.5 * std + 1e-6)))
        return 0.0

    def burst(self, s):
        """Every new note or hit (onset()): a new ring from the middle and sparks in every
        direction. The glow in the middle follows the loudness."""
        part = s[-RATE // 30:]
        rms = math.sqrt(sum(v * v for v in part) / len(part)) if part else 0
        self.loud_gain = max(rms, self.loud_gain * 0.997, 1e-3)
        level = max(0.0, min(1.0, 1 + 20 * math.log10(max(rms / self.loud_gain, 1e-6)) / 40))
        self._glow = level if level > self._glow else self._glow * 0.85 + level * 0.15
        for r in self._rings:
            r[0] += 1
        for sp in self._sparks:
            sp[0] += 1
        self._rings = [r for r in self._rings if r[0] < RING_LIFE]
        self._sparks = [sp for sp in self._sparks if sp[0] < SPARK_LIFE]
        strength = self.onset(s)
        if strength:
            self.ring_colour = (self.ring_colour + 1) % len(CLASSES)
            self._rings.append([0, strength, self.ring_colour])
            for _ in range(int(10 + 22 * strength)):
                angle = random.uniform(0, 2 * math.pi)
                self._sparks.append([0, angle, random.uniform(0.55, 1.0),
                                     int(angle / (2 * math.pi) * len(CLASSES)) % len(CLASSES)])
            self._rings = self._rings[-8:]
            self._sparks = self._sparks[-160:]

    def spectrum(self, samples, bars=None):
        bars = bars or self._bars
        if len(self._levels) != bars:
            self._levels = self._levels[:bars]
        raw = self.spec.levels(samples, bars)
        top = max(raw) if raw else 0
        # automatic gain: follows loud sound at once, quiet sound slowly
        self.gain = max(top, self.gain * 0.995, 1e-3)
        new = []
        for i, v in enumerate(raw):
            db = 20 * math.log10(max(v / self.gain, 1e-6))
            level = max(0.0, min(1.0, 1 + db / 40))   # the top 40 dB fill the window
            old = self._levels[i] if i < len(self._levels) else 0.0
            new.append(level if level > old else old * 0.82 + level * 0.18)
        self._levels = new


def use_accent(engine):
    """GOBLINCAKES' accent colour (Config → Utseende) as the QML property "accent", followed
    live: /usr/share/goblincakes/accent.py. Without it: the standard blue."""
    for d in (SHARE.parent, Path(__file__).resolve().parents[1] / "share/goblincakes", Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    QSurfaceFormat.setDefaultFormat(_alpha_format())
    app = QApplication(sys.argv[:1])  # widgets for the system tray icon and its menu
    app.setQuitOnLastWindowClosed(True)
    app.setApplicationName("goblin-graph")
    app.setApplicationDisplayName("goblin graph")
    app.setDesktopFileName("goblin-graph")
    app.setWindowIcon(graph_icon())

    # One window: a second start hands its words to the open one and brings it forward
    probe = QLocalSocket()
    probe.connectToServer(SOCKET)
    if probe.waitForConnected(300):
        probe.write(json.dumps(args).encode())
        probe.waitForBytesWritten(1000)
        probe.disconnectFromServer()
        return 0
    # goblin graph lås / lås upp without an open window: only remember it, open nothing
    if args and all(a.lower() in ("lås", "las", "lock", "upp", "låsupp", "unlock") for a in args):
        try:
            settings = json.loads(CONFIG.read_text())
        except (OSError, ValueError):
            settings = {}
        settings["locked"] = args[0].lower() in ("lås", "las", "lock") and "upp" not in args[1:2]
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(settings))
        return 0
    QLocalServer.removeServer(SOCKET)
    server = QLocalServer()
    server.listen(SOCKET)

    try:
        settings = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        settings = {}
    graph = Graph(settings)
    if not settings.get("chosen"):
        found = detect_class()
        if found:
            settings["class"] = found
    graph.apply_args(args)

    def incoming():
        sock = server.nextPendingConnection()
        if sock is None:
            return

        def read():
            try:
                graph.apply_args(json.loads(bytes(sock.readAll()).decode()))
            except ValueError:
                pass
            graph.raiseWindow.emit()
        sock.readyRead.connect(read)
        sock.disconnected.connect(sock.deleteLater)
    server.newConnection.connect(incoming)

    # KWin's goblincakes-windows script reports where the window was moved to (PlaceBus)
    bus = QDBusConnection.sessionBus()
    place = PlaceBus(graph)
    if bus.registerService("org.goblincakes.graph"):
        bus.registerObject("/graph", place, QDBusConnection.ExportAllSlots)

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("graph", graph)
    saved = graph.geometryFor(graph.shape)
    saved = dict(zip(("x", "y", "w", "h"), saved)) if saved else (
        {"w": 320, "h": 320} if graph.shape == "round" else {})
    engine.rootContext().setContextProperty("saved", saved)
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    tray = make_tray(app, graph)  # kept alive until exit
    # goblin-graph --watch closes the window with SIGTERM (Python sees it at the next tick)
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    code = app.exec()
    graph.listener.stop()
    return code


def graph_icon():
    """The goblin above class-coloured bars. Read from the file next to /usr/bin (also works from
    the repo): on ostree every file has the same date, so a stale icon cache could hide a new icon."""
    path = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-graph.svg"
    return QIcon(str(path)) if path.exists() else QIcon.fromTheme("goblincakes")


VIEW_NAMES = {"bars": "Staplar", "scope": "Våg", "circle": "Cirkel", "burst": "Explosion"}
def make_tray(app, graph):
    """In the system tray instead of among the programs (12 Oct, the user's wish – KWin's
    goblincakes-windows script keeps the window out of the task bar, dock and Alt+Tab).
    Left click = bring the window forward; the menu = what the window's mouse does, and also
    works while it is locked."""
    tray = QSystemTrayIcon(graph_icon(), app)
    tray.setToolTip("goblin graph")
    menu = QMenu()
    show = menu.addAction("Visa goblin graph")
    show.triggered.connect(graph.raiseWindow.emit)
    menu.addSeparator()
    views = {}
    for key, name in VIEW_NAMES.items():
        act = QAction(name, menu, checkable=True)
        act.triggered.connect(lambda _=False, k=key: graph.apply_args([k]))
        menu.addAction(act)
        views[key] = act
    menu.addSeparator()
    colours = QAction("Alla klassfärger", menu, checkable=True)
    colours.triggered.connect(graph.toggleMode)
    menu.addAction(colours)
    lock = QAction("Låst", menu, checkable=True)
    lock.triggered.connect(graph.toggleLock)
    menu.addAction(lock)
    menu.addSeparator()
    menu.addAction("Stäng").triggered.connect(app.quit)

    def sync():
        for key, act in views.items():
            act.setChecked(graph.view == key)
        colours.setChecked(graph.mode == "all")
        lock.setChecked(graph.locked)
        tray.setToolTip(f"goblin graph – {VIEW_NAMES.get(graph.view, graph.view)}, "
                        + ("alla klassfärger" if graph.mode == "all" else graph.className)
                        + (f"\n♪ {graph.nowPlaying}" if graph.nowPlaying else ""))
    graph.styleChanged.connect(sync)
    graph.nowPlayingChanged.connect(sync)
    sync()
    tray.setContextMenu(menu)
    tray.activated.connect(lambda reason: graph.raiseWindow.emit()
                           if reason == QSystemTrayIcon.ActivationReason.Trigger else None)
    tray.show()
    tray.menu = menu  # the menu has no parent: keep it alive with the icon
    return tray


def _alpha_format():
    fmt = QSurfaceFormat.defaultFormat()
    fmt.setAlphaBufferSize(8)
    return fmt


if __name__ == "__main__":
    sys.exit(main())
