#!/usr/bin/env python3
"""GOBLINCAKES Dashboard – a full-screen overview: the open programs at the top, the own programs at the
bottom, frames with projects, the system, the quota and what is playing, and in the middle every program
(type = search) or what was pressed in a frame. Step 1–3 of the dashboard (10 Nov): started by hand or from the
menu; step 4: the layout "Dashboard" (goblincakes-desktop-layout) takes the top bar and the dock away and Meta opens it. Several views (SPEL, JOBB, …), each with its own frames
(Config → Dashboard, dashboard.json "views"); the wheel over the dots, a sideways swipe or Ctrl+← → changes view.

    goblin-dashboard            show it – or hide it when it is already showing (one window, kept running
                                hidden so it comes up at once)
    goblin-dashboard --quit     end the hidden process
    goblin-dashboard --hidden   start without showing (at login in the dashboard layout, and when D-Bus starts it)

Step 4 (10 Nov): with the layout "Dashboard" (goblincakes-desktop-layout) Meta calls org.goblincakes.dashboard
/dashboard toggle (kwinrc [ModifierOnlyShortcuts]); /usr/share/dbus-1/services/org.goblincakes.dashboard.service
starts it hidden first when it isn't running. The KWin script goblincakes-windows puts it on the active screen.

What it shows is read by /usr/share/goblincakes/dashboard/dash.py; the open windows are asked from KWin
(dashboard/windows.js). Window: /usr/share/goblincakes/dashboard/Main.qml
Trying it without a desktop: GOBLINCAKES_DASHBOARD_TEST=<json> gives the windows/player/quota/bottom to show.
"""
import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

from PySide6.QtCore import ClassInfo, QObject, QSize, Qt, QTimer, QUrl, Property, Signal, Slot
from PySide6.QtDBus import QDBusConnection
from PySide6.QtGui import QFontDatabase, QGuiApplication, QIcon, QPixmap
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtQml import QQmlApplicationEngine
from PySide6.QtQuick import QQuickImageProvider, QQuickWindow
from PySide6.QtWidgets import QApplication

USR = Path(__file__).resolve().parents[1]
SHARE = Path(os.environ.get("GOBLINCAKES_DASHBOARD_DIR") or USR / "share/goblincakes/dashboard")
sys.path.insert(0, str(SHARE))
import dash  # noqa: E402

TEST = os.environ.get("GOBLINCAKES_DASHBOARD_TEST", "")


def test_data():
    try:
        return json.loads(Path(TEST).read_text()) if TEST else {}
    except (OSError, ValueError):
        return {}


def use_accent(engine):
    """GOBLINCAKES' accent colour as the QML property "accent", followed live (accent.py)."""
    for d in (SHARE.parent, Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


class IconProvider(QQuickImageProvider):
    """image://icon/<name or path> – a program's own icon from the icon theme; 1×1 when there is none (the
    window then draws the program's first letter)."""

    def __init__(self):
        super().__init__(QQuickImageProvider.Pixmap)

    def requestPixmap(self, name, size, requested):
        icon = QIcon(name) if name.startswith("/") else QIcon.fromTheme(name)
        side = max(requested.width(), requested.height(), 64)
        pixmap = icon.pixmap(QSize(side, side)) if not icon.isNull() else QPixmap()
        if pixmap.isNull():
            pixmap = QPixmap(1, 1)
            pixmap.fill(Qt.GlobalColor.transparent)
        if size is not None:
            size.setWidth(pixmap.width())
            size.setHeight(pixmap.height())
        return pixmap


@ClassInfo({"D-Bus Interface": "org.goblincakes.win"})
class KWinBridge(QObject):
    """Runs dashboard/windows.js in KWin and gets its answer back over D-Bus (report on /win)."""
    answered = Signal(str)

    def __init__(self):
        super().__init__()
        self.service = f"org.goblincakes.dashboard.p{os.getpid()}"
        self.count = 0
        bus = QDBusConnection.sessionBus()
        self.ok = bool(bus.isConnected() and bus.registerService(self.service)
                       and bus.registerObject("/win", self, QDBusConnection.ExportAllSlots))

    @Slot(str)
    def report(self, text):
        self.answered.emit(text)

    def run(self, payload):
        if not self.ok:
            return
        self.count += 1
        name = f"goblincakes-dashboard-{os.getpid()}-{self.count}"
        script = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / f"{name}.js"

        def work():
            def kwin(*args):
                return subprocess.run(["busctl", "--user", "call", "org.kde.KWin", "/Scripting",
                                       "org.kde.kwin.Scripting", *args], capture_output=True, text=True, timeout=5)
            try:
                script.write_text((SHARE / "windows.js").read_text()
                                  .replace("__DATA__", json.dumps(dict(payload, service=self.service))))
                if kwin("loadScript", "ss", str(script), name).returncode == 0:
                    kwin("start")
                    time.sleep(1.0)   # the script answers at once; then it is taken away again
                    kwin("unloadScript", "s", name)
            except (OSError, subprocess.SubprocessError):
                pass
            finally:
                script.unlink(missing_ok=True)
        threading.Thread(target=work, daemon=True).start()


@ClassInfo({"D-Bus Interface": "org.goblincakes.dashboard"})
class DashboardBus(QObject):
    """org.goblincakes.dashboard /dashboard: toggle (Meta in the dashboard layout), show, hide."""
    wanted = Signal(str)

    @Slot()
    def toggle(self):
        self.wanted.emit("toggle")

    @Slot()
    def show(self):
        self.wanted.emit("show")

    @Slot()
    def hide(self):
        self.wanted.emit("hide")


class Backend(QObject):
    changed = Signal(str)            # which property (the window reads them as JSON text)
    arrived = Signal(str, str)       # from a worker thread: key, JSON
    said = Signal(str)               # a line to show for a moment (why something could not be started)
    hideWanted = Signal()

    KEYS = ("apps", "bottom", "windows", "system", "top", "player", "quota", "projects", "project", "trayBox", "tools",
            "wow", "cs2", "builds", "reports")

    def __init__(self):
        super().__init__()
        self.test = test_data()
        self.data = {k: "[]" if k in ("apps", "bottom", "windows", "top", "projects") else "{}" for k in self.KEYS}
        self.busy = set()
        self.system = dash.System()
        self.kwin = KWinBridge()
        self.kwin.answered.connect(self._windows_answer)
        self.arrived.connect(self._arrived)
        saved = dash.settings()
        self._views = dash.views(saved)             # SPEL, JOBB, … (Config → Dashboard)
        self._view = dash.view_index(saved, self._views)
        self._mid = self._views[self._view]["mid"]  # apps | system | project:<path> | raid | … – one per view
        self._tray = ""
        self.visible = False
        self.timers = [QTimer(self, interval=ms, timeout=fn) for ms, fn in (
            (2000, self.read_system), (1000, self.read_player), (3000, self.read_windows),
            (30000, self.read_quota), (5000, self.read_tray), (60000, self.read_stats))]

    # ── Reading in the background ──
    def job(self, key, fn, into=""):
        """fn() in a thread; its result becomes the property `key` (one at a time per key) – or the property
        `into`, for a second, slower reading of the same thing."""
        if key in self.busy:
            return
        self.busy.add(key)

        def work():
            try:
                text = json.dumps(fn(), ensure_ascii=False)
            except Exception:  # noqa: BLE001 – a broken reading must not take the window down
                text = ""
            self.arrived.emit(f"{key}>{into}" if into else key, text)
        threading.Thread(target=work, daemon=True).start()

    def _arrived(self, key, text):
        key, _, into = key.partition(">")
        self.busy.discard(key)
        key = into or key
        if text and text != self.data.get(key):
            self.data[key] = text
            self.changed.emit(key)

    def used(self):
        """The frames in any view – the others are not read at all."""
        return {f for v in self._views for f in v["left"] + v["right"]}

    def read_stats(self):
        """WOW STATS, CS2 STATS, BYGGEN, KAKAN (dashboard/stats.py): what is saved on the computer at once, then
        what Warcraft Logs says about the latest raid's wipes. Only the frames some view shows."""
        import stats  # noqa: PLC0415 – reads GoblinRecorder's code: not before the window is up
        test, used = self.test, self.used()
        if "wow" in used:
            self.job("wow", stats.wow)
            if not test:
                QTimer.singleShot(1500, lambda: self.job("wowfetch", lambda: stats.wow(True), into="wow"))
        if "cs2" in used:
            self.job("cs2", stats.cs2)
        if "builds" in used:
            self.job("builds", (lambda: stats.builds(test_runs=test["builds"])) if "builds" in test else stats.builds)
        if "reports" in used:
            seen = float(dash.settings().get("reportsSeen") or 0)
            self.job("reports", lambda: stats.reports(seen))

    def read_apps(self):
        def both():
            rows = dash.apps()
            bottom = self.test.get("bottom")
            by_id = {a["id"]: a for a in rows}
            self.arrived.emit("bottom", json.dumps([by_id[i] for i in bottom if i in by_id] if bottom is not None
                                                   else dash.bottom_apps(rows), ensure_ascii=False))
            return rows
        self.job("apps", both)

    def read_system(self):
        self.job("system", self.system.sample)
        if self._mid == "system":
            self.job("top", dash.top_processes)

    def read_player(self):
        self.job("player", (lambda: self.test["player"]) if "player" in self.test else dash.player)

    def read_quota(self):
        self.job("quota", (lambda: self.test["quota"]) if "quota" in self.test else dash.quota)

    def read_projects(self):
        self.job("projects", dash.projects)
        self.job("tools", dash.project_tools)
        if self._mid.startswith("project:"):
            path = self._mid.split(":", 1)[1]
            self.job("project", lambda: dash.project(path))

    def read_windows(self):
        if "windows" in self.test:
            self._windows_answer(json.dumps({"windows": self.test["windows"]}))
        else:
            self.kwin.run({"mode": "list"})

    def _windows_answer(self, text):
        try:
            rows = json.loads(text).get("windows")
        except (ValueError, AttributeError):
            return
        if rows is None:
            return
        try:
            apps = {a["id"]: a for a in json.loads(self.data["apps"])}
        except ValueError:
            apps = {}
        out = []
        for w in rows:
            app = apps.get(f"{w.get('desktop')}.desktop") or next(
                (a for a in apps.values() if Path(a["id"]).stem.lower() == str(w.get("app", "")).lower()), None)
            out.append({"id": w.get("id", ""), "caption": w.get("caption", ""), "min": bool(w.get("min")),
                        "name": app["name"] if app else (w.get("caption") or w.get("app") or "?"),
                        "icon": app["icon"] if app else (w.get("desktop") or w.get("app") or "")})
        self._arrived("windows", json.dumps(out, ensure_ascii=False))

    def read_tray(self):
        if self._tray:
            name = self._tray
            self.job("trayBox", lambda: dict(self.test.get("tray") or dash.tray(name), name=name))

    def read_all(self):
        self.read_apps()
        self.read_system()
        self.read_player()
        self.read_quota()
        self.read_projects()
        QTimer.singleShot(400, self.read_stats)     # after the first picture
        QTimer.singleShot(150, self.read_windows)   # after the programs, for their names and icons

    # ── Shown / hidden: nothing is read while it is hidden ──
    @Slot(bool)
    def setVisible(self, on):
        if on == self.visible:
            return
        self.visible = on
        for t in self.timers:
            t.start() if on else t.stop()
        if on:
            self.reload_views()      # Config → Dashboard may have changed them while it was hidden
            self.system = dash.System()
            self.read_all()
        elif self._tray:
            self.closeTray()

    # ── What the window reads ──
    @Slot(str, result=str)
    def get(self, key):
        return self.data.get(key, "{}")

    viewsChanged = Signal()

    def reload_views(self):
        saved = dash.settings()
        rows = dash.views(saved)
        if rows != self._views:
            self._views = rows
            self._view = dash.view_index(saved, rows)
            self.viewsChanged.emit()
            self._go_mid(rows[self._view]["mid"])

    @Property(str, notify=viewsChanged)
    def views(self):
        return json.dumps(self._views, ensure_ascii=False)

    @Property(int, notify=viewsChanged)
    def view(self):
        return self._view

    @Slot(int)
    def stepView(self, step):
        """The next/previous view (round and round) – wheel, swipe, Ctrl+← →, the dots."""
        if len(self._views) > 1 and step:
            self.setView((self._view + step) % len(self._views))

    @Slot(int)
    def setView(self, index):
        if not 0 <= index < len(self._views) or index == self._view:
            return
        self._view = index
        saved = dash.settings()
        saved["view"] = index
        try:
            dash.save_settings(saved)
        except OSError:
            pass
        self.viewsChanged.emit()
        mid = self._views[index]["mid"]
        self._go_mid(mid if dash.mid_fits(mid, self._views[index]) else "apps")

    midChanged = Signal()

    @Property(str, notify=midChanged)
    def mid(self):
        return self._mid

    @Slot(str)
    def setMid(self, mid):
        if mid == self._mid:
            return
        # The middle opens where it was left – in each view (dashboard.json views[n].mid). Read again first:
        # Config → Dashboard may have changed the views since they were read
        self._views[self._view]["mid"] = mid
        saved = dash.settings()
        rows = dash.views(saved)
        if [v["name"] for v in rows] == [v["name"] for v in self._views]:
            rows[self._view]["mid"] = mid
            saved["views"] = rows
        else:
            saved["views"] = self._views
        saved["view"] = self._view
        saved.pop("mid", None)
        if mid == "reports":       # looked at: the next ones are the new ones
            saved["reportsSeen"] = time.time()
        try:
            dash.save_settings(saved)
        except OSError:
            pass
        self._go_mid(mid)

    def _go_mid(self, mid):
        if mid == self._mid:
            return
        self._mid = mid
        self.midChanged.emit()
        if mid == "system":
            self.job("top", dash.top_processes)
        elif mid.startswith("project:"):
            path = mid.split(":", 1)[1]
            self.data["project"] = json.dumps(dict(dash.project(path, 0), loading=True), ensure_ascii=False)
            self.changed.emit("project")
            self.job("project", lambda: dash.project(path))

    @Property(str, constant=True)
    def trayIcons(self):
        return json.dumps([{"id": i, "name": n} for i, n in dash.TRAY], ensure_ascii=False)

    trayChanged = Signal()

    @Property(str, notify=trayChanged)
    def tray(self):
        return self._tray

    @Slot(str)
    def openTray(self, name):
        if name == self._tray:
            return self.closeTray()
        self._tray = name
        self.data["trayBox"] = json.dumps({"name": name, "title": dict(dash.TRAY).get(name, name).upper(), "rows": []},
                                          ensure_ascii=False)
        self.changed.emit("trayBox")
        self.trayChanged.emit()
        self.busy.discard("trayBox")
        self.read_tray()

    @Slot()
    def closeTray(self):
        self._tray = ""
        self.trayChanged.emit()

    # ── What the window does ──
    def _later(self, fn):
        def work():
            why = fn()
            if why:
                self.said.emit(why)
        threading.Thread(target=work, daemon=True).start()

    @Slot(str)
    def launch(self, path):
        why = dash.launch(path)
        if why:
            self.said.emit(why)
        else:
            self.hideWanted.emit()

    @Slot(str)
    def activate(self, window_id):
        self.kwin.run({"mode": "activate", "id": window_id})
        self.hideWanted.emit()

    @Slot(str)
    def media(self, what):
        try:
            name = json.loads(self.data["player"]).get("name", "")
        except ValueError:
            name = ""
        if name:
            self._later(lambda: dash.control(name, what))
            QTimer.singleShot(300, self.read_player)

    @Slot(int)
    def setVolume(self, percent):
        self._later(lambda: dash.set_volume(percent=percent))
        QTimer.singleShot(250, self.read_tray)

    @Slot()
    def toggleMute(self):
        self._later(lambda: dash.set_volume(mute="toggle"))
        QTimer.singleShot(250, self.read_tray)

    @Slot(str)
    def copyClip(self, text):
        self._later(lambda: dash.set_clipboard(text))
        self.said.emit("Kopierat – klistra in med Ctrl+V")

    @Slot(str)
    def addProject(self, url):
        path = QUrl(url).toLocalFile() if url.startswith("file:") else url
        path = str(Path(path).expanduser()).rstrip("/") or "/"
        rows = dash.folders()
        if path and Path(path).is_dir() and path not in rows:
            dash.save_folders(rows + [path])
        self.read_projects()
        self.setMid("project:" + path)

    @Slot(str)
    def removeProject(self, path):
        dash.save_folders([p for p in dash.folders() if p != path])
        self.read_projects()
        if self._mid == "project:" + path:
            self.setMid("apps")

    @Slot(str, str)
    def openProject(self, path, how):
        why = dash.open_project(path, how)
        if why:
            self.said.emit(why)
        else:
            self.hideWanted.emit()

    @Slot()
    def customize(self):
        """Anpassa: GOBLINCAKES Config on the page Dashboard (the views, the frames, the programs at the bottom)."""
        exe = USR / "bin/goblincakes-config"
        try:
            subprocess.Popen([str(exe) if exe.exists() else "goblincakes-config", "--tab", "dashboard"],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            return self.said.emit(f"Kunde inte öppna GOBLINCAKES Config: {e}")
        self.hideWanted.emit()

    @Slot(str)
    def askKakan(self, question):
        """A new chat in Goblin AI with the question (goblin-ai --ask, as GoblinRecorder's Fråga Kakan)."""
        exe = USR / "bin/goblin-ai"
        try:
            subprocess.Popen([str(exe) if exe.exists() else "goblin-ai", "--ask", question], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            return self.said.emit(f"Kunde inte starta Goblin AI: {e}")
        self.hideWanted.emit()

    def _open(self, target):
        try:
            subprocess.Popen(["xdg-open", target], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            return self.said.emit(f"Kunde inte öppna: {e}")
        self.hideWanted.emit()

    @Slot(str)
    def openUrl(self, url):
        if url.startswith("https://"):
            self._open(url)

    @Slot(str)
    def openFile(self, path):
        if Path(path).is_file():
            self._open(path)

    @Slot(str)
    def watchBuild(self, sha):
        """Kakan tells when the build of this commit is done (the same as reminders.py bevaka bygge <hash>)."""
        def work():
            try:
                out = subprocess.run([sys.executable, str(SHARE.parent / "ai/reminders.py"), "bevaka", "bygge", sha],
                                     capture_output=True, text=True, timeout=30)
                line = (out.stdout or out.stderr).strip().splitlines()
                return line[-1][:120] if line else "Kakan säger till när bygget är klart"
            except (OSError, subprocess.SubprocessError) as e:
                return f"Gick inte: {e}"
        self._later(work)

    @Slot(str, result=bool)
    def hasIcon(self, name):
        """Whether the icon theme (or the file) has the program's icon – else the window draws its first letter."""
        return bool(name) and (Path(name).is_file() if name.startswith("/") else QIcon.hasThemeIcon(name))

    @Slot()
    def sharpText(self):
        """After a file dialog: Qt's own text again (KDE's dialog style switches to native text)."""
        QQuickWindow.setTextRenderType(QQuickWindow.TextRenderType.QtTextRendering)

    @Property(bool, constant=True)
    def stays(self):
        """Trying it out: the window does not hide when it loses the focus."""
        return bool(TEST) or bool(os.environ.get("GOBLINCAKES_DASHBOARD_STAY"))


def main():
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.9"   # 90 % as GOBLINCAKES' other windows
    app = QApplication(sys.argv[:1])
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblin-dashboard")
    app.setApplicationDisplayName("GOBLINCAKES Dashboard")
    app.setDesktopFileName("goblin-dashboard")
    app.setQuitOnLastWindowClosed(False)
    icons = USR / "share/icons/hicolor/scalable/apps"
    app.setWindowIcon(QIcon.fromTheme("goblincakes-dashboard", QIcon(str(icons / "goblincakes-dashboard.svg"))))
    for font in os.environ.get("GOBLINCAKES_CONFIG_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)

    # One window: a second start shows/hides the first one (or ends it with --quit)
    name = os.environ.get("GOBLINCAKES_DASHBOARD_INSTANCE", f"goblin-dashboard-{os.getuid()}")
    quit_it = "--quit" in sys.argv
    hidden = "--hidden" in sys.argv
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(300):
        if not hidden:   # already running: --hidden has nothing to do
            sock.write(b"quit\n" if quit_it else b"toggle\n")
            sock.waitForBytesWritten(500)
        return 0
    if quit_it:
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)

    backend = Backend()
    engine = QQmlApplicationEngine()
    engine.addImageProvider("icon", IconProvider())
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("logoUrl", QUrl.fromLocalFile(
        os.environ.get("GOBLINCAKES_LOGO") or str(icons / "goblincakes.svg")))
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    win = engine.rootObjects()[0]

    def show():
        win.showFullScreen()
        win.raise_()
        win.requestActivate()

    def act(word):
        if word == "quit":
            app.quit()
        elif word == "hide" or (word == "toggle" and win.isVisible()):
            win.hide()
        else:
            show()

    def incoming():
        conn = server.nextPendingConnection()
        if not conn:
            return
        conn.waitForReadyRead(300)
        word = bytes(conn.readAll()).decode().strip()
        conn.close()
        act(word)
    server.newConnection.connect(incoming)
    backend.hideWanted.connect(win.hide)

    # The fixed D-Bus name for Meta (not in the test mode: a test must not answer the real Meta)
    bus_obj = DashboardBus()
    bus_obj.wanted.connect(act)
    bus = QDBusConnection.sessionBus()
    if not TEST and bus.isConnected() and bus.registerObject("/dashboard", bus_obj, QDBusConnection.ExportAllSlots):
        bus.registerService("org.goblincakes.dashboard")
    if not hidden:
        show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
