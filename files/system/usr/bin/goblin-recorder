#!/usr/bin/env python3
"""GoblinRecorder – automatic WoW recordings (the window).

Shows what the service sees (WoW, combat log, OBS), starts OBS, lets you pick the folder,
fps and codec, and plays the saved videos with the deaths as marks on the timeline and
a choice of audio track (everything / the game / Discord). The recording itself is done
by the user service /usr/libexec/goblincakes-recorder. Window: /usr/share/goblincakes/recorder/Main.qml
"""
import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

from PySide6.QtCore import QObject, QProcess, QTimer, QUrl, Property, Signal, Slot
from PySide6.QtGui import QDesktopServices, QFontDatabase, QIcon
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtQml import QQmlApplicationEngine
from PySide6.QtWidgets import QApplication, QFileDialog

SHARE = Path(os.environ.get("GOBLINCAKES_RECORDER_SHARE", "/usr/share/goblincakes/recorder"))
SERVICE = os.environ.get("GOBLINCAKES_RECORDER_SERVICE", "/usr/libexec/goblincakes-recorder")
sys.path.insert(0, str(SHARE))
import recorder as R  # noqa: E402


def season_logo():
    """The logo – in its look for the time of year when there is one."""
    default = "/usr/share/icons/hicolor/scalable/apps/goblincakes.svg"
    try:
        sys.path.insert(0, "/usr/share/goblincakes/seasons")
        import season
        return season.asset("logo.svg", default)
    except Exception:  # noqa: BLE001
        return default


class Backend(QObject):
    statusChanged = Signal()
    configChanged = Signal()
    videosChanged = Signal()
    message = Signal(str)
    wclChanged = Signal()
    previewChanged = Signal()
    wclBusy = Signal(bool)

    def __init__(self):
        super().__init__()
        self._status = "{}"
        self._config = json.dumps(R.load_config())
        self._videos = "[]"
        self._encoders = json.dumps(R.obs_encoders())
        self._last_video = None
        self._folder_time = None
        self._preview = ""
        self.refreshLater.connect(self.refreshVideos)
        self._openLink.connect(self.openUrl)  # the browser from the main thread
        self._yt_cancel = False
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.timer.start(1000)
        self.poll()
        self.refreshVideos()

    # ---------------------------------------------------------- status
    @Property(str, notify=statusChanged)
    def status(self):
        return self._status

    def poll(self):
        st = R.read_status()
        alive = bool(st) and time.time() - st.get("time", 0) < 10
        st["service"] = alive
        if not alive:  # the window's own look at OBS when the service is not running
            st["obs"] = ("missing" if not R.obs_installed() else
                         "stopped" if not R.obs_running() else
                         "connected" if R.ws_settings().get("server_enabled") else "no-ws")
        st["audioPlugin"] = R.audio_plugin_installed()
        text = json.dumps(st, ensure_ascii=False)
        if text != self._status:
            self._status = text
            self.statusChanged.emit()
        # A new video from the service. 12 Oct: the first poll may see no lastVideo at all ("" –
        # nothing saved since the service started), and the first video after that was taken
        # for the starting point, so it never showed until the window was reopened.
        last = st.get("lastVideo") or ""
        if self._last_video is None:
            self._last_video = last
        elif last != self._last_video:
            self._last_video = last
            self.refreshVideos()
        # … and anything else that changes the folder (a video removed by hand, another folder)
        folder_time = R.folder_mtime(json.loads(self._config).get("folder", ""))
        if folder_time != self._folder_time:
            if self._folder_time is not None:
                self.refreshVideos()
            self._folder_time = folder_time

    @Slot()
    def startObs(self):
        err = R.start_obs()
        self.message.emit(err or "OBS startas – det lägger sig i systemfältet.")
        self._encoders = json.dumps(R.obs_encoders())
        self.configChanged.emit()

    @Slot()
    def restartObs(self):
        """OBS is running without its remote control: close it, turn it on, start again."""
        threading.Thread(target=lambda: (R.stop_obs(), self.startObs()), daemon=True).start()

    @Slot()
    def pickScreen(self):
        def work():
            try:
                with R.OBS(timeout=3) as obs:
                    R.pick_screen(obs)
                self.message.emit("Välj skärmen där WoW är i rutan från KDE.")
            except Exception:  # noqa: BLE001
                self.message.emit("OBS svarar inte – tryck Starta OBS först.")
        threading.Thread(target=work, daemon=True).start()

    @Slot()
    def startService(self):
        flag = R.CONFIG_DIR / "recorder-on"  # the user unit only runs with it
        flag.parent.mkdir(parents=True, exist_ok=True)
        flag.touch()
        if subprocess.run(["systemctl", "--user", "start", "goblincakes-recorder.service"],
                          capture_output=True).returncode != 0:
            QProcess.startDetached(SERVICE, ["run"])

    @Slot()
    def installAudioPlugin(self):
        self.message.emit("Hämtar ljudtillägget till OBS …")
        proc = QProcess(self)
        proc.finished.connect(lambda code, _s: self.message.emit(
            "Ljudtillägget är installerat – starta om OBS." if code == 0 else "Kunde inte hämta ljudtillägget."))
        proc.start("flatpak", ["install", "--user", "-y", "--noninteractive", "flathub", R.OBS_AUDIO_PLUGIN])

    # ---------------------------------------------------------- settings
    @Property(str, notify=configChanged)
    def config(self):
        return self._config

    @Property(str, notify=configChanged)
    def encoders(self):
        return self._encoders

    @Slot(str, str)
    def setConfig(self, key, value_json):
        cfg = R.load_config()
        cfg[key] = json.loads(value_json)
        R.save_config(cfg)
        self._config = json.dumps(cfg)
        self.configChanged.emit()
        if key == "folder":
            self.refreshVideos()

    @Slot()
    def chooseFolder(self):
        cfg = R.load_config()
        folder = QFileDialog.getExistingDirectory(None, "Var ska filmerna sparas?", cfg["folder"])
        if folder:
            self.setConfig("folder", json.dumps(folder))

    # ---------------------------------------------------------- videos
    @Property(str, notify=videosChanged)
    def videos(self):
        return self._videos

    @Slot()
    def refreshVideos(self):
        cfg = R.load_config()
        self._videos = json.dumps(R.video_files(cfg["folder"]), ensure_ascii=False)
        self.videosChanged.emit()

    @Slot(str)
    def removeVideo(self, path):
        R.remove_video(path)
        self.refreshVideos()

    @Slot(str, bool)
    def setKeep(self, path, keep):
        meta = Path(path).with_suffix(".json")
        try:
            data = json.loads(meta.read_text())
            data["keep"] = keep
            meta.write_text(json.dumps(data, ensure_ascii=False, indent=1))
        except (OSError, ValueError):
            pass
        self.refreshVideos()

    @Slot()
    def openFolder(self):
        folder = Path(R.load_config()["folder"])
        folder.mkdir(parents=True, exist_ok=True)
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(folder)))

    # ---------------------------------------------------------- boxes over the video
    @Property(str, notify=previewChanged)
    def preview(self):
        return self._preview

    @Slot()
    def refreshPreview(self):
        """The screen as OBS sees it; without OBS the newest video's thumbnail."""
        def work():
            img = ""
            try:
                with R.OBS(timeout=3) as obs:
                    img = R.preview_image(obs)
            except Exception:  # noqa: BLE001 – OBS not running
                vids = [v for v in R.video_files(R.load_config()["folder"]) if v.get("thumb")]
                img = QUrl.fromLocalFile(vids[0]["thumb"]).toString() if vids else ""
            self._preview = img
            self.previewChanged.emit()
        threading.Thread(target=work, daemon=True).start()

    def _save_overlays(self, overlays):
        cfg = R.load_config()
        cfg["overlays"] = overlays
        R.save_config(cfg)
        R.remove_unused_overlay_images(cfg)
        self._config = json.dumps(cfg)
        self.configChanged.emit()

        def apply():  # at once in OBS (the service does it too, but not while recording)
            try:
                with R.OBS(timeout=3) as obs:
                    if not obs.call("GetRecordStatus").get("outputActive"):
                        video = obs.call("GetVideoSettings")
                        R.set_overlays(obs, cfg, video["baseWidth"], video["baseHeight"])
            except Exception:  # noqa: BLE001 – OBS not running: applied when it starts
                pass
        threading.Thread(target=apply, daemon=True).start()

    def _pick_image(self):
        path, _ = QFileDialog.getOpenFileName(None, "Välj en bild", str(Path.home()),
                                              "Bilder (*.png *.jpg *.jpeg *.webp *.bmp *.gif)")
        return R.add_overlay_image(path) if path else None

    @Slot(bool)
    def addOverlay(self, with_image):
        file = ""
        if with_image:
            file = self._pick_image()
            if not file:
                return
        overlays = R.load_config().get("overlays") or []
        n = len(overlays)
        overlays.append({"file": file, "x": 0.05 + 0.03 * (n % 5), "y": 0.05 + 0.03 * (n % 5), "w": 0.25, "h": 0.2})
        self._save_overlays(overlays)

    @Slot(int)
    def changeOverlayImage(self, index):
        file = self._pick_image()
        overlays = R.load_config().get("overlays") or []
        if file and 0 <= index < len(overlays):
            overlays[index]["file"] = file
            self._save_overlays(overlays)

    @Slot(int)
    def removeOverlay(self, index):
        overlays = R.load_config().get("overlays") or []
        if 0 <= index < len(overlays):
            overlays.pop(index)
            self._save_overlays(overlays)

    @Slot(int, str)
    def setOverlayText(self, index, text):
        overlays = R.load_config().get("overlays") or []
        if 0 <= index < len(overlays) and overlays[index].get("text", "") != text:
            overlays[index]["text"] = text
            self._save_overlays(overlays)

    @Slot(int, float, float, float, float)
    def moveOverlay(self, index, x, y, w, h):
        overlays = R.load_config().get("overlays") or []
        if 0 <= index < len(overlays):
            overlays[index].update({"x": x, "y": y, "w": w, "h": h})
            self._save_overlays(overlays)

    # ---------------------------------------------------------- Warcraft Logs
    @Property(bool, notify=wclChanged)
    def wclConfigured(self):
        return R.wcl_configured()

    @Slot()
    def openWclClients(self):
        QDesktopServices.openUrl(QUrl(R.WCL_CLIENTS_PAGE))

    @Slot(str)
    def openUrl(self, url):
        QDesktopServices.openUrl(QUrl(url))

    @Slot(str, str)
    def setWcl(self, client_id, secret):
        def work():
            try:
                R.wcl_set_client(client_id, secret)
                self.message.emit("Warcraft Logs är kopplat – filmerna får länkar när loggen laddats upp.")
            except Exception as e:  # noqa: BLE001
                self.message.emit(f"Warcraft Logs: {e}")
            self.wclChanged.emit()
            self.wclBusy.emit(False)
        self.wclBusy.emit(True)
        threading.Thread(target=work, daemon=True).start()

    @Slot()
    def forgetWcl(self):
        R.wcl_forget()
        self.wclChanged.emit()

    @Slot(str)
    def wclFind(self, path):
        """Look up the video's fight now (the service also does it every 5 minutes)."""
        def work():
            try:
                meta = json.loads(Path(path).with_suffix(".json").read_text())
                if not meta.get("player"):
                    self.message.emit("Filmen vet inte vilken karaktär som spelade – går inte att söka.")
                    return
                found = R.wcl_find(meta)
                if found:
                    R.set_meta(path, wcl=found)
                    self.message.emit("Hittad i Warcraft Logs.")
                else:
                    self.message.emit("Inte i Warcraft Logs än – har loggen laddats upp (Archon)?")
            except Exception as e:  # noqa: BLE001
                self.message.emit(f"Warcraft Logs: {e}")
            finally:
                self.refreshLater.emit()
                self.wclBusy.emit(False)
        self.wclBusy.emit(True)
        threading.Thread(target=work, daemon=True).start()

    refreshLater = Signal()
    statsBusy = Signal(str)  # the video whose players are being fetched, "" = done

    @Slot(str)
    def wclStats(self, path):
        """The players of the video's fight from Warcraft Logs, kept in the video's .json.
        Fetched again until an hour after the fight – parses come a while after the upload,
        and a live-logged report is still growing."""
        def work():
            try:
                meta = json.loads(Path(path).with_suffix(".json").read_text())
                old = meta.get("wclStats") or {}
                if old.get("fetched", 0) > meta.get("started", 0) + meta.get("fight", 0) + 3600:
                    return
                R.set_meta(path, wclStats=R.wcl_stats(meta["wcl"]))
            except Exception as e:  # noqa: BLE001
                self.message.emit(f"Warcraft Logs: {e}")
            finally:
                self.statsBusy.emit("")
                self.refreshLater.emit()
        self.statsBusy.emit(path)
        threading.Thread(target=work, daemon=True).start()

    # ---------------------------------------------------------- YouTube
    youtubeDone = Signal(str)  # JSON: {"file": …} or {"error": …}

    @Slot(str, float, float, result=str)
    def youtubeText(self, path, start, end):
        try:
            meta = json.loads(Path(path).with_suffix(".json").read_text())
        except (OSError, ValueError):
            return json.dumps({"title": "", "description": ""})
        return json.dumps(R.youtube_text(meta, start, end), ensure_ascii=False)

    @Slot(str, float, float, str)
    def youtubeMake(self, path, start, end, title):
        dest = Path(R.load_config()["folder"]) / "YouTube" / (R.safe_name(title) + ".mp4")

        def work():
            err = R.youtube_clip(path, start, end, dest)
            self.youtubeDone.emit(json.dumps({"error": err} if err else {"file": str(dest)}, ensure_ascii=False))
        threading.Thread(target=work, daemon=True).start()

    # ---------------------------------------------------------- YouTube upload (API)
    youtubeChanged = Signal()
    youtubeLoginBusy = Signal(bool)
    youtubeProgress = Signal(float, float)  # sent, total (bytes; total 0 = cutting the video)
    youtubeUploaded = Signal(str)  # JSON: {"url": …} or {"error": …}
    _openLink = Signal(str)

    @Property(str, notify=youtubeChanged)
    def youtubeState(self):
        return json.dumps(R.yt_state())

    @Slot()
    def openYoutubeConsole(self):
        QDesktopServices.openUrl(QUrl(R.YT_CONSOLE))

    @Slot()
    def openYoutubeAudit(self):
        QDesktopServices.openUrl(QUrl(R.YT_AUDIT))

    @Slot(str, str)
    def setYoutubeClient(self, client_id, secret):
        try:
            R.yt_set_client(client_id, secret)
            self.youtubeChanged.emit()
            self.youtubeLogin()
        except RuntimeError as e:
            self.message.emit(f"YouTube: {e}")

    @Slot()
    def youtubeLogin(self):
        def work():
            try:
                email = R.yt_login(self._openLink.emit)
                self.message.emit("Inloggad på YouTube" + (f" som {email}." if email else "."))
            except Exception as e:  # noqa: BLE001
                self.message.emit(f"YouTube: {e}")
            self.youtubeChanged.emit()
            self.youtubeLoginBusy.emit(False)
        self.youtubeLoginBusy.emit(True)
        threading.Thread(target=work, daemon=True).start()

    @Slot(bool)
    def youtubeLogout(self, forget_client):
        threading.Thread(target=lambda: (R.yt_forget(keep_client=not forget_client),
                                         self.youtubeChanged.emit()), daemon=True).start()

    @Slot(str, float, float, str, str, str)
    def youtubeUpload(self, path, start, end, title, description, privacy):
        """Cut (as for YouTube Studio), then straight up to the channel. The cut file goes when
        it's up – the video itself stays in GoblinRecorder."""
        dest = Path(R.load_config()["folder"]) / "YouTube" / (R.safe_name(title) + ".mp4")
        self._yt_cancel = False

        def work():
            last = [0.0]

            def progress(sent, total):
                if time.time() - last[0] > 0.3 or sent >= total:
                    last[0] = time.time()
                    self.youtubeProgress.emit(float(sent), float(total))
            try:
                self.youtubeProgress.emit(0.0, 0.0)
                err = R.youtube_clip(path, start, end, dest)
                if err:
                    raise RuntimeError(f"Det gick inte att göra filmen: {err}")
                vid = R.yt_upload(str(dest), title, description, privacy, progress, lambda: self._yt_cancel)
                url = f"https://youtu.be/{vid}"
                R.set_meta(path, youtube={"id": vid, "url": url, "privacy": privacy,
                                          "title": title, "uploaded": time.time()})
                try:
                    dest.unlink()
                except OSError:
                    pass
                self.youtubeUploaded.emit(json.dumps({"url": url}))
            except Exception as e:  # noqa: BLE001
                self.youtubeUploaded.emit(json.dumps({"error": str(e)}, ensure_ascii=False))
            finally:
                self.refreshLater.emit()
        threading.Thread(target=work, daemon=True).start()

    @Slot()
    def youtubeCancel(self):
        self._yt_cancel = True

    @Slot(str)
    def copyText(self, text):
        QApplication.clipboard().setText(text)

    @Slot()
    def openYoutube(self):
        QDesktopServices.openUrl(QUrl("https://www.youtube.com/upload"))

    @Slot(str)
    def showFile(self, path):
        """The file manager with the file selected (to drag into YouTube Studio)."""
        if not QProcess.startDetached("dolphin", ["--select", path]):
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(path).parent)))

    @Slot(str)
    def openExternal(self, path):
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

    @Slot(str, result=str)
    def fileUrl(self, path):
        return QUrl.fromLocalFile(path).toString() if path else ""


def use_accent(engine):
    """GOBLINCAKES' accent colour (Config → Utseende) as the QML property "accent", followed
    live: /usr/share/goblincakes/accent.py. Without it: the standard blue."""
    for d in (SHARE.parent, Path(__file__).resolve().parents[1] / "share/goblincakes", Path("/usr/share/goblincakes")):
        if (d / "accent.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import accent
        accent.install(engine)
    except Exception:  # noqa: BLE001 – an old or broken file must not stop the window
        engine.rootContext().setContextProperty("accent", {
            "color": "#2F6FED", "hover": "#4A82F0", "on": "#E6ECF5", "text": "#2F6FED",
            "dim": "#1B3A78", "error": "#A4262C", "errorBright": "#E5484D"})


def main():
    own_scale = "QT_SCALE_FACTOR" not in os.environ
    if own_scale:
        os.environ["QT_SCALE_FACTOR"] = "0.8"
    app = QApplication(sys.argv)
    if own_scale:
        del os.environ["QT_SCALE_FACTOR"]
    app.setApplicationName("goblin-recorder")
    app.setApplicationDisplayName("GoblinRecorder")
    app.setDesktopFileName("goblin-recorder")
    # The goblin above a recording screen (REC light, timeline); the file next to /usr/bin when
    # the icon theme doesn't know it yet (started from the repo)
    icon = Path(__file__).resolve().parents[1] / "share/icons/hicolor/scalable/apps/goblincakes-recorder.svg"
    app.setWindowIcon(QIcon.fromTheme("goblincakes-recorder", QIcon(str(icon))))
    for font in os.environ.get("GOBLINCAKES_CONFIG_FONTS", "").split(":"):
        if font:
            QFontDatabase.addApplicationFont(font)

    # One window at a time: a second start brings the first one forward
    name = os.environ.get("GOBLINCAKES_RECORDER_INSTANCE", f"goblin-recorder-{os.getuid()}")  # tests: own name
    sock = QLocalSocket()
    sock.connectToServer(name)
    if sock.waitForConnected(300):
        sock.write(b"show\n")
        sock.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(name)
    server = QLocalServer()
    server.listen(name)

    backend = Backend()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("backend", backend)
    engine.rootContext().setContextProperty("logoUrl", QUrl.fromLocalFile(
        os.environ.get("GOBLINCAKES_LOGO") or season_logo()))
    use_accent(engine)
    engine.load(QUrl.fromLocalFile(str(SHARE / "Main.qml")))
    if not engine.rootObjects():
        return 1
    win = engine.rootObjects()[0]

    def raise_window():
        conn = server.nextPendingConnection()
        if conn:
            conn.close()
        win.show()
        win.raise_()
        win.requestActivate()
    server.newConnection.connect(raise_window)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
