#!/usr/bin/env bash
# GOBLINCAKES TV mode from the desktop (AppGrid "TV-läge", goblin tv).
#   goblincakes-tv           log out and start Steam Big Picture in full screen
#   goblincakes-tv cleanup   at desktop login: the normal login screen again next time
set -uo pipefail

notify() { notify-send -a "GOBLINCAKES" -i goblincakes "TV-läge" "$1" 2>/dev/null || echo "$1"; }

case ${1:-start} in
    start)
        pkexec /usr/libexec/goblincakes-session-select tv || { notify "Kunde inte byta till TV-läge."; exit 1; }
        # Log out without the dialog; SDDM then starts TV mode
        dbus-send --session --type=method_call --dest=org.kde.Shutdown /Shutdown org.kde.Shutdown.logout \
            || qdbus org.kde.Shutdown /Shutdown logout ;;
    cleanup)
        [ -e /etc/sddm.conf.d/zz-goblincakes-autologin.conf ] || exit 0
        pkexec /usr/libexec/goblincakes-session-select clear ;;
    *) echo "Använd: goblincakes-tv [cleanup]" >&2; exit 2 ;;
esac
