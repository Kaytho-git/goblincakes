#!/usr/bin/env bash
# goblin – GOBLINCAKES' own commands in the terminal (like Bazzite's ujust).
#
#   goblin update      update everything: system, Flatpaks, AppImages, GE-Proton, firmware
#   goblin ai          the Goblin AI window (Meta+A); with a question: answer in the terminal
#   goblin tv          TV mode (Steam Big Picture in full screen)
#   goblin wow         links every WoW version under ~/Games/WoW, updates WowUp
#   goblin dock        reset – the desktop layout and dock back to the start (Meta shows the dock)
#   goblin fast        system info with the GOBLINCAKES logo
#   goblin motd        the command list shown in every new terminal (on/off)
#   goblin help        list the commands
#
# New commands: add a cmd_<name> function, a line in COMMANDS and the case at the bottom.
set -uo pipefail

config_install=/usr/libexec/goblincakes-config-install
catalog=/usr/share/goblincakes/config/apps.json

# GOBLINCAKES palette: Accent #2F6FED, Frost #E6ECF5, muted #8B98AD, red #A4262C
if [ -t 1 ]; then
    accent=$'\e[1;38;2;47;111;237m' frost=$'\e[38;2;230;236;245m' muted=$'\e[38;2;139;152;173m'
    red=$'\e[1;38;2;220;70;76m' bold=$'\e[1m' reset=$'\e[0m'
else
    accent= frost= muted= red= bold= reset=
fi

heading() { printf '\n%s▌ %s%s\n' "$accent" "$1" "$reset"; }
info() { printf '%s  %s%s\n' "$muted" "$1" "$reset"; }

failed=()
step() { # name, command… – runs it, remembers failures, carries on
    local name=$1; shift
    if ! "$@"; then
        failed+=("$name")
        printf '%s  %s gick inte att uppdatera%s\n' "$red" "$name" "$reset"
    fi
}

# The setup helper prints "@@ status" lines for the GOBLINCAKES Config window
config_step() {
    "$config_install" "$@" 2>&1 | sed -u -n 's/^@@ /  /p'
    return "${PIPESTATUS[0]}"
}

update_system() {
    heading "System (GOBLINCAKES-imagen)"
    # Network hiccups during the big download (e.g. "tls: bad record MAC") are common,
    # especially in VMs: try again – the layers already fetched are kept
    local code try
    for try in 1 2 3; do
        rpm-ostree upgrade --unchanged-exit-77
        code=$?
        case $code in 0|77) break ;; esac
        [ "$try" = 3 ] && break
        info "Nedladdningen avbröts – försöker igen ($((try + 1)) av 3)…"
        sleep 5
    done
    case $code in
        0) system_updated=1 ;;
        77) info "Redan senaste versionen" ;;
        *) return "$code" ;;
    esac
}

update_flatpaks() {
    heading "Flatpak-program"
    flatpak update --assumeyes --noninteractive && flatpak uninstall --unused --assumeyes --noninteractive >/dev/null
}

update_appimages() {
    # WowUp, Raider.IO, Archon – the ones GOBLINCAKES Config installed
    local any=0 id repo label
    [ -r "$catalog" ] || return 0
    while IFS=$'\t' read -r id repo label; do
        [ -x "$HOME/AppImages/$label.AppImage" ] || continue
        [ "$any" = 1 ] || heading "AppImage-program"
        any=1
        step "$label" config_step appimage-github "$repo" "$label"
    done < <(python3 -c '
import json, sys
for app in json.load(open(sys.argv[1]))["apps"]:
    for step in app["steps"]:
        if step[0] == "appimage-github":
            print(app["id"], step[1], step[2], sep="\t")
' "$catalog")
}

update_proton() {
    # Only for those who use it (ProtonUp-Qt chosen in GOBLINCAKES Config, or GE-Proton already there)
    if flatpak info net.davidotek.pupgui2 >/dev/null 2>&1 \
        || ls -d "$HOME"/.local/share/Steam/compatibilitytools.d/GE-Proton* >/dev/null 2>&1; then
        heading "GE-Proton"
        config_step ge-proton
    fi
}

update_firmware() {
    command -v fwupdmgr >/dev/null || return 0
    heading "Firmware"
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    fwupdmgr update --assume-yes --no-reboot-check
    local code=$?
    # 2 = nothing to update
    [ "$code" = 0 ] || [ "$code" = 2 ]
}

cmd_update() {
    printf '%s%sGOBLINCAKES%s %suppdaterar allt%s\n' "$bold" "$frost" "$reset" "$muted" "$reset"
    system_updated=0
    step "Systemet" update_system
    step "Flatpak-program" update_flatpaks
    update_appimages
    step "GE-Proton" update_proton
    # GTK theme copy for Flatpak programs (Quod Libet): follow the theme in the image
    [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/themes/GoblinCakes" ] && "$config_install" gtk-theme >/dev/null 2>&1
    step "Firmware" update_firmware

    echo
    if [ ${#failed[@]} -eq 0 ]; then
        printf '%s▌ Klart.%s\n' "$accent" "$reset"
    else
        printf '%s▌ Klart, men det här gick inte: %s%s\n' "$red" "${failed[*]}" "$reset"
        info "Meddelandena ovanför visar vad som hände. Kör goblin update igen – eller fråga Goblin AI (Meta+A)."
    fi

    if [ "$system_updated" = 1 ]; then
        echo
        printf '%sDen nya GOBLINCAKES-versionen används efter en omstart. Starta om nu? [j/N] %s' "$frost" "$reset"
        read -r answer
        case $answer in
            j|J|ja|Ja|y|Y) systemctl reboot ;;
            *) info "Den startar nästa gång du startar om datorn." ;;
        esac
    fi
    [ ${#failed[@]} -eq 0 ]
}

# name | description – used by help and by the list in new terminals
COMMANDS=(
    "update|Uppdatera allt: system, Flatpaks, AppImages, GE-Proton, firmware"
    "ai|Öppna Goblin AI-fönstret (eller tryck Meta+A)"
    "ai [fråga]|Fråga Goblin AI direkt här – föreslagna kommandon körs bara om du säger ja"
    "ai setup|Ställ in gratis AI-tjänster (Gemini, Groq, OpenRouter, Mistral)"
    "tv|TV-läge: Steam Big Picture i helskärm, som en Steam Deck"
    "wow|Länka alla WoW-versioner i ~/Games/WoW och uppdatera WowUp"
    "dock reset|Återställ skrivbordet och dockan (Meta visar dockan, Shift+Meta appmenyn)"
    "gamemode|Testa GameMode och visa hur du slår på det i Steam och Lutris"
    "fast|Systeminfo med GOBLINCAKES-loggan"
    "motd off|Sluta visa den här listan i nya terminaler (on = visa igen)"
    "help|Visa alla goblin-kommandon"
)

command_list() {
    local entry name pad
    for entry in "${COMMANDS[@]}"; do
        name=${entry%%|*}
        # Pad by characters, not bytes (å, ä, ö)
        printf -v pad '%*s' $((11 - ${#name})) ''
        printf '  %sgoblin %s%s%s %s%s%s\n' "$accent" "$name" "$pad" "$reset" "$muted" "${entry#*|}" "$reset"
    done
}

cmd_help() {
    printf '%sgoblin%s – GOBLINCAKES kommandon\n\n' "$bold" "$reset"
    command_list
}

cmd_gamemode() {
    heading "GameMode"
    info "Ger spel mer prestanda medan de körs (CPU, prioritet). Testar att det fungerar…"
    echo
    if gamemoded -t; then
        echo
        printf '%s▌ GameMode fungerar.%s\n' "$accent" "$reset"
    else
        echo
        printf '%s▌ Något i testet gick inte igenom – se ovan.%s\n' "$red" "$reset"
    fi
    cat <<EOF

${bold}Slå på det för ett spel${reset}
  ${frost}Steam:${reset}   högerklicka på spelet → Egenskaper → Startalternativ:
           ${accent}gamemoderun %command%${reset}
           (med Gamescope också: ${accent}gamemoderun gamescope -f -- %command%${reset})
  ${frost}Lutris:${reset}  Inställningar → Systemalternativ → slå på Feral GameMode
           (för alla spel), eller per spel under Konfigurera.
  ${frost}Heroic:${reset}  Spelets inställningar → Använd GameMode.

${muted}Medan ett spel kör: gamemoded -s visar om GameMode är aktivt.${reset}
EOF
}

cmd_fastfetch() {
    exec fastfetch "$@"
}

motd_off_file="${XDG_CONFIG_HOME:-$HOME/.config}/goblincakes/motd-off"

cmd_motd() {
    case ${1:-show} in
        off) mkdir -p "$(dirname "$motd_off_file")" && touch "$motd_off_file"
             info "Listan visas inte längre i nya terminaler. Slå på igen med: goblin motd on" ;;
        on) rm -f "$motd_off_file"
            info "Listan visas i nya terminaler igen." ;;
        show)
            # Shown by /etc/profile.d/goblincakes-motd.sh in every new terminal
            [ -e "$motd_off_file" ] && return 0
            printf '%s▌ GOBLINCAKES%s %s– kommandon i terminalen:%s\n' "$accent" "$reset" "$muted" "$reset"
            command_list
            echo ;;
        *) printf 'Använd: goblin motd on|off\n' >&2; return 2 ;;
    esac
}

case ${1:-help} in
    update|upgrade) cmd_update ;;
    ai) shift
        # Without a question, on the desktop: the Goblin AI window (also Meta+A)
        if [ $# -eq 0 ] && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
            (setsid goblin-ai >/dev/null 2>&1 &)
            exit 0
        fi
        exec /usr/libexec/goblincakes-ai "$@" ;;
    tv) exec goblincakes-tv ;;
    wow) heading "World of Warcraft"; exec /usr/libexec/goblincakes-wow-links --verbose ;;
    dock) shift; exec /usr/libexec/goblincakes-dock "${1:-}" ;;
    gamemode) cmd_gamemode ;;
    fast|fastfetch|info) shift; cmd_fastfetch "$@" ;;
    motd) shift; cmd_motd "$@" ;;
    help|-h|--help) cmd_help ;;
    *) printf 'Okänt kommando: %s\n\n' "$1" >&2; cmd_help >&2; exit 2 ;;
esac
