#!/usr/bin/env bash
# goblin – GOBLINCAKES' own commands in the terminal (like Bazzite's ujust).
#
#   goblin update      update everything: system, Flatpaks, AppImages, GE-Proton, firmware
#   goblin ai          the Goblin AI window (Meta+A); with a question: answer in the terminal
#   goblin tv          TV mode (Steam Big Picture in full screen)
#   goblin wow         links every WoW version under ~/Games/WoW, updates WowUp
#   goblin dock        reset – the desktop layout and dock back to the start (Meta shows the dock)
#   goblin apps        Fedora programs hidden from AppGrid; show/hide them again
#   goblin remove      window to uninstall Fedora programs (with a name: straight away)
#   goblin old         uninstalled programs, and how to bring them back
#   goblin fast        system info with the GOBLINCAKES logo
#   goblin motd        the command list shown in every new terminal (on/off)
#   goblin help        list the commands
#
# New commands: add a cmd_<name> function, a line in COMMANDS and the case at the bottom.
set -uo pipefail

config_install=/usr/libexec/goblincakes-config-install
catalog=/usr/share/goblincakes/config/apps.json

# GOBLINCAKES palette: Accent #2F6FED, Frost #E6ECF5, muted #8B98AD, red #A4262C
if [ -t 1 ]; then
    accent=$'\e[1;38;2;47;111;237m' frost=$'\e[38;2;230;236;245m' muted=$'\e[38;2;139;152;173m'
    red=$'\e[1;38;2;220;70;76m' bold=$'\e[1m' reset=$'\e[0m'
else
    accent= frost= muted= red= bold= reset=
fi

# GUI=1: `goblin update --gui` for GOBLINCAKES Config's Uppdatera tab – plain "@@" lines
# it reads (@@step, @@result, @@reboot, @@news; "@@ text" = status), no questions asked.
GUI=0
heading() { if [ "$GUI" = 1 ]; then echo "@@step $1"; else printf '\n%s▌ %s%s\n' "$accent" "$1" "$reset"; fi; }
info() { if [ "$GUI" = 1 ]; then echo "@@ $1"; else printf '%s  %s%s\n' "$muted" "$1" "$reset"; fi; }

failed=()
step() { # name, command… – runs it, remembers failures, carries on
    local name=$1; shift
    if ! "$@"; then
        failed+=("$name")
        if [ "$GUI" = 1 ]; then echo "@@result $name|fail"; else
            printf '%s  %s gick inte att uppdatera%s\n' "$red" "$name" "$reset"; fi
    else
        [ "$GUI" = 1 ] && echo "@@result $name|ok"
    fi
    return 0
}

# The setup helper prints "@@ status" lines for the GOBLINCAKES Config window
config_step() {
    if [ "$GUI" = 1 ]; then
        "$config_install" "$@" 2>&1 | grep --line-buffered '^@@ '
    else
        "$config_install" "$@" 2>&1 | sed -u -n 's/^@@ /  /p'
    fi
    return "${PIPESTATUS[0]}"
}

update_system() {
    heading "System (GOBLINCAKES-imagen)"
    # Network hiccups during the big download (e.g. "tls: bad record MAC") are common,
    # especially in VMs: try again – the layers already fetched are kept
    local code try
    for try in 1 2 3; do
        rpm-ostree upgrade --unchanged-exit-77
        code=$?
        case $code in 0|77) break ;; esac
        [ "$try" = 3 ] && break
        info "Nedladdningen avbröts – försöker igen ($((try + 1)) av 3)…"
        sleep 5
    done
    case $code in
        0) system_updated=1; info "Ny GOBLINCAKES-version hämtad – används efter en omstart" ;;
        77)
            # Automatic updates may already have fetched it in the background: then
            # it's waiting for a restart, and "nothing new" would be misleading
            if rpm-ostree status --json 2>/dev/null | python3 -c '
import json, sys
sys.exit(0 if any(d.get("staged") for d in json.load(sys.stdin).get("deployments", [])) else 1)'; then
                info "Den nya versionen är redan hämtad i bakgrunden – den används efter en omstart"
                system_updated=1
            else
                info "Redan senaste versionen"
            fi ;;
        *) return "$code" ;;
    esac
}

flatpak_apps() { flatpak list --app --columns=application,name,version,active 2>/dev/null | sort; }

update_flatpaks() {
    heading "Flatpak-program"
    local before after changed
    before=$(flatpak_apps)
    flatpak update --assumeyes --noninteractive || return 1
    flatpak uninstall --unused --assumeyes --noninteractive >/dev/null
    after=$(flatpak_apps)
    # Programs whose installed commit changed: name and new version
    changed=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
        | awk -F'\t' 'NF { print $2 ($3 != "" ? " " $3 : "") }' | paste -sd, - | sed 's/,/, /g')
    if [ -n "$changed" ]; then info "Uppdaterat: $changed"; else info "Inget nytt"; fi
}

update_appimages() {
    # WowUp, Raider.IO, Archon – the ones GOBLINCAKES Config installed
    local any=0 id repo label
    [ -r "$catalog" ] || return 0
    while IFS=$'\t' read -r id repo label; do
        [ -x "$HOME/AppImages/$label.AppImage" ] || continue
        [ "$any" = 1 ] || heading "AppImage-program"
        any=1
        step "$label" config_step appimage-github "$repo" "$label"
    done < <(python3 -c '
import json, sys
for app in json.load(open(sys.argv[1]))["apps"]:
    for step in app["steps"]:
        if step[0] == "appimage-github":
            print(app["id"], step[1], step[2], sep="\t")
' "$catalog")
}

update_proton() {
    # Only for those who use it (ProtonUp-Qt chosen in GOBLINCAKES Config, or GE-Proton already there)
    if flatpak info net.davidotek.pupgui2 >/dev/null 2>&1 \
        || ls -d "$HOME"/.local/share/Steam/compatibilitytools.d/GE-Proton* >/dev/null 2>&1; then
        heading "GE-Proton"
        config_step ge-proton
    fi
}

update_firmware() {
    command -v fwupdmgr >/dev/null || return 0
    heading "Firmware"
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    fwupdmgr update --assume-yes --no-reboot-check
    local code=$?
    # 2 = nothing to update
    case $code in
        0) info "Ny firmware installerad" ;;
        2) info "Ingen ny firmware" ;;
        *) return 1 ;;
    esac
}

cmd_update() {
    [ "${1:-}" = --gui ] && GUI=1
    [ "$GUI" = 1 ] || printf '%s%sGOBLINCAKES%s %suppdaterar allt%s\n' "$bold" "$frost" "$reset" "$muted" "$reset"
    system_updated=0
    step "Systemet" update_system
    step "Flatpak-program" update_flatpaks
    update_appimages
    step "GE-Proton" update_proton
    # GTK theme copy for Flatpak programs (Quod Libet): follow the theme in the image
    [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/themes/GoblinCakes" ] && "$config_install" gtk-theme >/dev/null 2>&1
    step "Firmware" update_firmware
    # The green arrow in the top bar follows right away (in the background: skopeo takes a moment)
    setsid -f /usr/libexec/goblincakes-updates check >/dev/null 2>&1 < /dev/null || true

    if [ "$GUI" = 1 ]; then
        if [ "$system_updated" = 1 ]; then
            /usr/libexec/goblincakes-news update 2>/dev/null \
                | sed -n 's/^ *• */@@news /p; s/^ *Fedora: /@@news Fedora: /p'
            echo "@@reboot"
        fi
        [ ${#failed[@]} -eq 0 ]
        return
    fi
    echo
    if [ ${#failed[@]} -eq 0 ]; then
        printf '%s▌ Klart.%s\n' "$accent" "$reset"
    else
        printf '%s▌ Klart, men det här gick inte: %s%s\n' "$red" "${failed[*]}" "$reset"
        info "Meddelandena ovanför visar vad som hände. Kör goblin update igen – eller fråga Goblin AI (Meta+A)."
    fi

    if [ "$system_updated" = 1 ]; then
        # What the new version brings (GOBLINCAKES' own news in Swedish + Fedora's packages)
        /usr/libexec/goblincakes-news update 2>/dev/null || true
        echo
        printf '%sDen nya GOBLINCAKES-versionen används efter en omstart. Starta om nu? [j/N] %s' "$frost" "$reset"
        read -r answer
        case $answer in
            j|J|ja|Ja|y|Y) systemctl reboot ;;
            *) info "Den startar nästa gång du startar om datorn." ;;
        esac
    fi
    [ ${#failed[@]} -eq 0 ]
}

# name | description – used by help and by the list in new terminals
# Descriptions at most 76 characters: the list must fit Ghostty's 100 columns (2 + "goblin " + 11 + 1 = 21)
COMMANDS=(
    "update|Uppdatera allt: system, Flatpaks, AppImages, GE-Proton, firmware"
    "ai|Öppna Goblin AI-fönstret (eller tryck Meta+A)"
    "ai [fråga]|Fråga Goblin AI direkt här – föreslagna kommandon körs bara om du säger ja"
    "ai setup|Ställ in gratis AI-tjänster (Gemini, Groq, OpenRouter, Mistral)"
    "tv|TV-läge: Steam Big Picture i helskärm, som en Steam Deck"
    "wow|Länka alla WoW-versioner i ~/Games/WoW och uppdatera WowUp"
    "dock reset|Återställ hela GOBLINCAKES-utseendet (tema, typsnitt, toppfält, docka)"
    "apps|Dolda Fedora-program – visa igen: goblin apps show konsole"
    "remove|Avinstallera Fedora-program (fönster, eller: goblin remove konsole)"
    "old|Visa avinstallerade program och hur du får tillbaka dem"
    "play|Dina Steam-spel – skriv namnet (t.ex. wow, cs2) direkt i terminalen"
    "gamemode|Testa GameMode och visa hur du slår på det i Steam och Lutris"
    "nyheter|Vad som är nytt i GOBLINCAKES (goblin update visar det automatiskt)"
    "fast|Systeminfo med GOBLINCAKES-loggan"
    "motd off|Sluta visa den här listan i nya terminaler (on = visa igen)"
    "help|Visa alla goblin-kommandon"
)

command_list() {
    local entry name pad
    for entry in "${COMMANDS[@]}"; do
        name=${entry%%|*}
        # Pad by characters, not bytes (å, ä, ö)
        printf -v pad '%*s' $((11 - ${#name})) ''
        printf '  %sgoblin %s%s%s %s%s%s\n' "$accent" "$name" "$pad" "$reset" "$muted" "${entry#*|}" "$reset"
    done
}

cmd_help() {
    printf '%sgoblin%s – GOBLINCAKES kommandon\n\n' "$bold" "$reset"
    command_list
}

cmd_gamemode() {
    heading "GameMode"
    info "Ger spel mer prestanda medan de körs (CPU, prioritet). Testar att det fungerar…"
    echo
    if gamemoded -t; then
        echo
        printf '%s▌ GameMode fungerar.%s\n' "$accent" "$reset"
    else
        echo
        printf '%s▌ Något i testet gick inte igenom – se ovan.%s\n' "$red" "$reset"
    fi
    cat <<EOF

${bold}Slå på det för ett spel${reset}
  ${frost}Steam:${reset}   högerklicka på spelet → Egenskaper → Startalternativ:
           ${accent}gamemoderun %command%${reset}
           (med Gamescope också: ${accent}gamemoderun gamescope -f -- %command%${reset})
  ${frost}Lutris:${reset}  Inställningar → Systemalternativ → slå på Feral GameMode
           (för alla spel), eller per spel under Konfigurera.
  ${frost}Heroic:${reset}  Spelets inställningar → Använd GameMode.

${muted}Medan ett spel kör: gamemoded -s visar om GameMode är aktivt.${reset}
EOF
}

hidden_list=/usr/share/goblincakes/hidden-apps
user_apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

short_name() { tr '[:upper:]' '[:lower:]' <<< "${1##*.}"; }
app_name() { grep -m1 '^Name=' "/usr/share/applications/$1.desktop" 2>/dev/null | cut -d= -f2-; }

# A hidden program by its id (org.kde.konsole), last part (konsole) or name (Konsole)
find_hidden() {
    local want=${1,,} id name
    while read -r id; do
        [ -n "$id" ] || continue
        name=$(app_name "$id")
        if [ "${id,,}" = "$want" ] || [ "$(short_name "$id")" = "$want" ] || [ "${name,,}" = "$want" ]; then
            printf '%s\n' "$id"
            return 0
        fi
    done < "$hidden_list"
    return 1
}

cmd_apps() {
    local action=${1:-list} id
    if [ ! -s "$hidden_list" ]; then
        info "Inga program är dolda i den här versionen."
        return 0
    fi
    case $action in
        list)
            heading "Dolda Fedora-program"
            info "Finns kvar i systemet och fungerar, men syns inte i appmenyn."
            info "Vill du bli av med ett helt: goblin remove <namn>"
            echo
            while read -r id; do
                [ -n "$id" ] || continue
                if [ -e "$user_apps/$id.desktop" ]; then
                    printf '  %s●%s %-28s %svisas (goblin apps hide %s)%s\n' "$accent" "$reset" "$(app_name "$id")" "$muted" "$(short_name "$id")" "$reset"
                else
                    printf '  %s○%s %-28s %sdold  (goblin apps show %s)%s\n' "$muted" "$reset" "$(app_name "$id")" "$muted" "$(short_name "$id")" "$reset"
                fi
            done < "$hidden_list"
            ;;
        show|hide)
            if [ -z "${2:-}" ]; then
                printf 'Använd: goblin apps %s <namn>   (se namnen med: goblin apps)\n' "$action" >&2
                return 2
            fi
            if ! id=$(find_hidden "$2"); then
                printf '%s▌ Hittar inget dolt program som heter %s.%s Se listan med: goblin apps\n' "$red" "$2" "$reset" >&2
                return 1
            fi
            if [ "$action" = show ]; then
                # Your own copy without NoDisplay wins over the system's hidden one
                mkdir -p "$user_apps"
                sed '/^NoDisplay=/d' "/usr/share/applications/$id.desktop" > "$user_apps/$id.desktop"
                info "$(app_name "$id") syns i appmenyn igen. Dölj igen med: goblin apps hide $(short_name "$id")"
            else
                rm -f "$user_apps/$id.desktop"
                info "$(app_name "$id") är dold i appmenyn igen."
            fi
            ;;
        *) printf 'Använd: goblin apps [show|hide <namn>]\n' >&2; return 2 ;;
    esac
}

# ---- goblin remove / goblin old: Fedora programs out of the system image and back ----
# The work is done by /usr/libexec/goblincakes-remove (also used by the window, goblin remove apps)
remove_helper=/usr/libexec/goblincakes-remove

ask_reboot() {
    echo
    printf '%sÄndringen gäller efter en omstart. Starta om nu? [j/N] %s' "$frost" "$reset"
    read -r answer
    case $answer in
        j|J|ja|Ja|y|Y) systemctl reboot ;;
        *) info "Det gäller nästa gång du startar om datorn." ;;
    esac
}

# Uninstalled programs – goblin old (and goblin remove without a name)
cmd_old() {
    heading "Avinstallerade program"
    local pkg name state any=0
    while IFS=$'\t' read -r pkg name state; do
        [ -n "$pkg" ] || continue
        any=1
        case $state in
            removing) printf '  %s✕%s %-28s %sförsvinner vid omstart · ångra: goblin remove --undo %s%s\n' "$red" "$reset" "$name" "$muted" "$pkg" "$reset" ;;
            restoring) printf '  %s↺%s %-28s %skommer tillbaka vid omstart%s\n' "$accent" "$reset" "$name" "$muted" "$reset" ;;
            *) printf '  %s✕%s %-28s %såterställ: goblin remove --undo %s%s\n' "$red" "$reset" "$name" "$muted" "$pkg" "$reset" ;;
        esac
    done < <("$remove_helper" removed)
    [ "$any" = 1 ] || info "Inga – allt från GOBLINCAKES-imagen finns kvar."
    echo
    info "Klicka i vad som ska bort eller tillbaka: goblin remove"
}

cmd_remove() {
    local undo=0 found pkg name answer
    case ${1:-} in
        # No name: the window (tick what goes and what comes back). Without a desktop
        # (e.g. over SSH): the list, like goblin old.
        ""|apps|app|fönster)
            if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
                (setsid /usr/libexec/goblincakes-remove-apps >/dev/null 2>&1 &)
                info "Öppnar fönstret Avinstallera program…"
            else
                cmd_old
                info "Avinstallera: goblin remove <namn>   (t.ex. konsole, discover, kwrite)"
            fi
            return 0 ;;
        --undo|undo|restore) undo=1; shift ;;
    esac
    if [ -z "${1:-}" ]; then
        printf 'Använd: goblin remove --undo <namn>   (se namnen med: goblin old)\n' >&2
        return 2
    fi

    if ! found=$("$remove_helper" find "$1"); then
        printf '%s▌ Hittar inget program som heter %s i systemet.%s\n' "$red" "$1" "$reset" >&2
        if [ "$undo" = 1 ]; then
            info "Se vad som är avinstallerat: goblin old"
        else
            info "Program från Config (Flatpak) tar du bort med: flatpak uninstall <namn>"
        fi
        return 1
    fi
    pkg=${found%%$'\t'*}
    name=${found#*$'\t'}

    if [ "$undo" = 1 ]; then
        if ! "$remove_helper" removed | cut -f1,3 | grep -qx "$pkg"$'\t'"removed\|$pkg"$'\t'"removing"; then
            printf '%s▌ %s är inte avinstallerat.%s Se listan med: goblin old\n' "$red" "$name" "$reset" >&2
            return 1
        fi
        heading "Återställ $name"
        if "$remove_helper" restore "$pkg"; then
            ask_reboot
        else
            printf '%s▌ Det gick inte – se meddelandet ovanför.%s\n' "$red" "$reset" >&2
            return 1
        fi
        return 0
    fi

    if "$remove_helper" protected "$pkg"; then
        printf '%s▌ %s behövs av skrivbordet eller GOBLINCAKES och kan inte avinstalleras.%s\n' "$red" "$name" "$reset" >&2
        info "Dölj det i appmenyn i stället (goblin apps), eller fråga Goblin AI."
        return 1
    fi
    if "$remove_helper" removed | cut -f1,3 | grep -qx "$pkg"$'\t'"removed\|$pkg"$'\t'"removing"; then
        info "$name är redan avinstallerat. Ångra: goblin remove --undo $pkg"
        return 0
    fi

    heading "Avinstallera $name"
    info "Paketet $pkg tas bort ur systemet efter nästa omstart."
    info "Det går att få tillbaka: goblin remove --undo $pkg (eller goblin old)"
    printf '%sFortsätt? [j/N] %s' "$frost" "$reset"
    read -r answer
    case $answer in
        j|J|ja|Ja|y|Y) ;;
        *) info "Inget ändrades."; return 0 ;;
    esac
    if "$remove_helper" remove "$pkg"; then
        ask_reboot
    else
        echo
        printf '%s▌ Det gick inte att avinstallera %s.%s\n' "$red" "$name" "$reset" >&2
        info "Oftast för att andra delar av systemet behöver det. Dölj det i stället: goblin apps"
        return 1
    fi
}

cmd_fastfetch() {
    exec fastfetch "$@"
}

motd_off_file="${XDG_CONFIG_HOME:-$HOME/.config}/goblincakes/motd-off"

cmd_motd() {
    case ${1:-show} in
        off) mkdir -p "$(dirname "$motd_off_file")" && touch "$motd_off_file"
             info "Listan visas inte längre i nya terminaler. Slå på igen med: goblin motd on" ;;
        on) rm -f "$motd_off_file"
            info "Listan visas i nya terminaler igen." ;;
        show)
            # Shown by /etc/profile.d/goblincakes-motd.sh in every new terminal
            [ -e "$motd_off_file" ] && return 0
            printf '%s▌ GOBLINCAKES%s %s– kommandon i terminalen:%s\n' "$accent" "$reset" "$muted" "$reset"
            command_list
            echo ;;
        *) printf 'Använd: goblin motd on|off\n' >&2; return 2 ;;
    esac
}

case ${1:-help} in
    update|upgrade) shift; cmd_update "$@" ;;
    ai) shift
        # Without a question, on the desktop: the Goblin AI window (also Meta+A)
        if [ $# -eq 0 ] && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
            (setsid goblin-ai >/dev/null 2>&1 &)
            exit 0
        fi
        exec /usr/libexec/goblincakes-ai "$@" ;;
    tv) exec goblincakes-tv ;;
    wow) heading "World of Warcraft"; exec /usr/libexec/goblincakes-wow-links --verbose ;;
    dock) shift; exec /usr/libexec/goblincakes-dock "${1:-}" ;;
    apps) shift; cmd_apps "$@" ;;
    remove|uninstall) shift; cmd_remove "$@" ;;
    old) cmd_old ;;
    play|games|spel) shift
        if [ $# -gt 0 ]; then
            /usr/libexec/goblincakes-games run "$1"; [ $? -eq 3 ] && { echo "Hittar inget spel i Steam som heter $1. Se listan: goblin play" >&2; exit 1; }; exit 0
        fi
        heading "Spel i Steam – skriv ordet i terminalen för att starta"
        exec /usr/libexec/goblincakes-games list ;;
    nyheter|news) shift; heading "Nytt i GOBLINCAKES"; exec /usr/libexec/goblincakes-news latest "${1:-15}" ;;
    gamemode) cmd_gamemode ;;
    fast|fastfetch|info) shift; cmd_fastfetch "$@" ;;
    motd) shift; cmd_motd "$@" ;;
    help|-h|--help) cmd_help ;;
    *) printf 'Okänt kommando: %s\n\n' "$1" >&2; cmd_help >&2; exit 2 ;;
esac
