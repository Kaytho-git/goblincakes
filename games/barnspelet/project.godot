; Barnspelet – GOBLINCAKES barnläge (Godot 4.5). Plan och beslut: docs/anteckningar.md "Barnspelet – planen".
config_version=5

[application]

config/name="A Boy to the Rescue"
run/main_scene="res://bana.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Spel="*res://spel.gd"
Bilder="*res://bilder.gd"
Prov="*res://prov.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
; helskärm: i ett fönster blev det bara ×1 (titelraden tar plats från 1080)
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60
; mjuk rörelse på 144/180 Hz-skärmar: lägen mellan fysikstegen räknas ut (annars ryckte pojken – användaren 15 nov)
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.69, 0.85, 0.97, 1)
